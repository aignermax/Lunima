<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             x:Class="CAP.Avalonia.Controls.TourAnchor.TourAnchorOverlay">

  <!-- Guided-tour anchor overlay (#1167): dims everything except the spotlighted
       target control, pulses an outline around it, points an arrow at it and
       places the tour card next to it. The root must stay hit-test visible (a
       disabled parent would kill the card's buttons too); non-modality comes
       from every decoration below being hit-test transparent and the canvas
       having a null background, so clicks land on the control underneath. -->
  <Canvas x:Name="RootCanvas" Background="{x:Null}">

    <!-- Dim: four rectangles around the spotlight hole -->
    <Rectangle x:Name="DimTop" Fill="{DynamicResource Brush.Scrim}" IsHitTestVisible="False"/>
    <Rectangle x:Name="DimBottom" Fill="{DynamicResource Brush.Scrim}" IsHitTestVisible="False"/>
    <Rectangle x:Name="DimLeft" Fill="{DynamicResource Brush.Scrim}" IsHitTestVisible="False"/>
    <Rectangle x:Name="DimRight" Fill="{DynamicResource Brush.Scrim}" IsHitTestVisible="False"/>

    <!-- Static target outline; only the active demonstration pointer animates. -->
    <Border x:Name="Spotlight" BorderBrush="{DynamicResource Brush.Success}" BorderThickness="2"
            CornerRadius="{DynamicResource Radius.S}" IsHitTestVisible="False"/>

    <!-- Arrow pointing from the card at the target -->
    <Path x:Name="Arrow" Fill="{DynamicResource Brush.Success}" Data="M0,0 L16,8 L0,16 Z"
          RenderTransformOrigin="50%,50%"
          IsHitTestVisible="False"/>

    <!-- Tour card, positioned by the code-behind -->
    <Line x:Name="GuideTrail" Stroke="{DynamicResource Brush.Success}" StrokeThickness="1.5"
          StrokeDashArray="3,4" Opacity="0.5" IsVisible="False" IsHitTestVisible="False"/>
    <Ellipse x:Name="GuideDestination" Stroke="{DynamicResource Brush.Success}" StrokeThickness="2"
             Width="14" Height="14" IsVisible="False" IsHitTestVisible="False"/>
    <Ellipse x:Name="GuideClick" Stroke="{DynamicResource Brush.Success}" StrokeThickness="2"
             IsVisible="False" IsHitTestVisible="False"/>
    <Path x:Name="GuidePointer" Data="M1,1 L1,28 L8,21 L14,33 L20,30 L14,19 L25,19 Z"
          Fill="{DynamicResource Brush.Text.Primary}" Stroke="{DynamicResource Brush.Success}"
          StrokeThickness="2" IsVisible="False" IsHitTestVisible="False"/>
    <ContentControl x:Name="CardHost" IsHitTestVisible="True"/>
    <Button x:Name="GuideShowTarget" IsVisible="False"
            Content="{loc:Localize Tutorial.ShowTarget}" Click="ShowTarget_Click"/>
  </Canvas>
</UserControl>
