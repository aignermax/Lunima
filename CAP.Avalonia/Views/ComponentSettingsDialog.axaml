<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CAP.Avalonia.ViewModels.ComponentSettings"
        xmlns:io="using:CAP.Avalonia.ViewModels.ComponentSettings.InstanceOverride"
        xmlns:behaviors="using:CAP.Avalonia.Behaviors"
        xmlns:services="using:CAP.Avalonia.Services"
        xmlns:solvers="using:CAP.Avalonia.ViewModels.Solvers"
        xmlns:edit="using:AvaloniaEdit"
        xmlns:controls="using:CAP.Avalonia.Controls"
        xmlns:loc="using:CAP.Avalonia.Services.Localization"
        x:Class="CAP.Avalonia.Views.ComponentSettingsDialog"
        x:Name="DialogRoot"
        x:DataType="vm:ComponentSettingsDialogViewModel"
        Title="{Binding Title}"
        Width="620" Height="760"
        MinWidth="400" MinHeight="350"
        CanResize="True"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24" Spacing="16">

                <Border Classes="empty-state"
                        IsVisible="{Binding HasSMatrices, Converter={x:Static BoolConverters.Not}}">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <controls:Icon Data="{StaticResource Icon.Table}" Size="24"
                                       Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                        <TextBlock Classes="secondary" HorizontalAlignment="Center" TextAlignment="Center"
                                   MaxWidth="420" TextWrapping="Wrap"
                                   Text="{loc:Localize ComponentSettings.NoCustomSMatrix}"/>
                    </StackPanel>
                </Border>

                <!-- Effective S-matrix: what the simulation actually uses -->
                <StackPanel Spacing="8" IsVisible="{Binding HasEffectiveEntries}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="label" Text="{loc:Localize ComponentSettings.EffectiveSMatrix}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Classes="caption success" Text="{Binding EffectiveProvenanceText}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding EffectiveProvenanceText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <Button Classes="danger" Content="{loc:Localize CompSettings.ResetToPdkOriginal}"
                                Command="{Binding ResetToPdkOriginalCommand}"
                                VerticalAlignment="Center"
                                IsVisible="{Binding CanResetToPdkOriginal}"/>
                    </StackPanel>
                    <Border Classes="card" Padding="12,8" MaxHeight="160">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding EffectiveEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EffectiveSMatrixEntryViewModel">
                                        <!-- Last column Auto: the source tag carries provenance
                                             (e.g. "Override active — FDTD Meep 2D") and must not clip. -->
                                        <Grid ColumnDefinitions="80,60,*,Auto" Margin="0,2">
                                            <TextBlock Grid.Column="0" Text="{Binding WavelengthLabel}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Dimensions}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Classes="caption mono success"
                                                       Text="{Binding MagnitudePreview}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <!-- Two rows toggled by IsOverridden: compiled bindings can't set Foreground from a binding here. -->
                                            <TextBlock Grid.Column="3" Classes="caption warning strong"
                                                       Text="{Binding SourceTag}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       IsVisible="{Binding IsOverridden}"
                                                       ToolTip.Tip="{loc:Localize ComponentSettings.OverriddenTip}"/>
                                            <TextBlock Grid.Column="3" Classes="caption"
                                                       Text="{Binding SourceTag}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       IsVisible="{Binding !IsOverridden}"
                                                       ToolTip.Tip="{loc:Localize ComponentSettings.PdkDefaultTip}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <!-- Stored S-matrices -->
                <StackPanel Spacing="8" IsVisible="{Binding HasSMatrices}">
                    <Grid ColumnDefinitions="110,80,*,36" Margin="12,0">
                        <TextBlock Grid.Column="0" Classes="label" Text="{loc:Localize ComponentSettings.Wavelength}"/>
                        <TextBlock Grid.Column="1" Classes="label" Text="{loc:Localize ComponentSettings.Size}"/>
                        <TextBlock Grid.Column="2" Classes="label" Text="{loc:Localize ComponentSettings.StrongestCouplings}"
                                   ToolTip.Tip="{loc:Localize ComponentSettings.CouplingsTip}"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding SMatrixEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SMatrixEntryViewModel">
                                <Border Classes="card" Padding="12,8" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="110,80,*,36">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Classes="strong" Text="{Binding WavelengthLabel}"/>
                                            <TextBlock Classes="caption" Text="{Binding SourceNote}"
                                                       IsVisible="{Binding SourceNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding Dimensions}"
                                                   VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Classes="caption mono success" Text="{Binding MagnitudePreview}"
                                                       TextWrapping="NoWrap"/>
                                            <TextBlock Classes="caption" Text="{Binding PortNamesDisplay}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Bind via #DialogRoot: the $parent cast form fails in deferred DataTemplate scope (XamlIl namespace resolution). -->
                                        <Button Grid.Column="3" Classes="icon ghost"
                                                CommandParameter="{Binding}"
                                                Command="{Binding #DialogRoot.DataContext.DeleteEntryCommand}"
                                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                                ToolTip.Tip="{loc:Localize ComponentSettings.RemoveEntryTip}">
                                            <controls:Icon Data="{StaticResource Icon.Trash2}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer: status banners above the action row -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0"
                Padding="24,12">
            <StackPanel Spacing="8">

                <TextBlock Classes="caption" Text="{Binding StatusText}" TextWrapping="Wrap"
                           IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <!-- Grid (not StackPanel): a star column bounds text width so long messages wrap. -->
                <Grid ColumnDefinitions="Auto,*"
                      IsVisible="{Binding SolverStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <controls:Icon Grid.Column="0" Data="{StaticResource Icon.Clock}" Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding IsComputing}"/>
                    <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding SolverStatus}"
                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Grid>

                <!-- Hint when the selected backend can't run yet (Docker down / no API key). -->
                <Border Classes="card" Background="{DynamicResource Brush.Warning.Subtle}" Padding="12,8"
                        IsVisible="{Binding BackendSelection.HasAvailabilityHint, FallbackValue=False}">
                    <StackPanel Spacing="4"
                                DataContext="{Binding BackendSelection}"
                                x:DataType="solvers:FdtdBackendSelectionViewModel">
                        <TextBlock Classes="warning" Text="{Binding AvailabilityHint}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Button Classes="link" Content="{loc:Localize CompSettings.Tidy3dGetKeyLink}"
                                    Command="{Binding OpenTidy3dPortalCommand}"
                                    HorizontalAlignment="Left"
                                    IsVisible="{Binding ShowMissingKeyLink}"/>
                            <Button Classes="link" Content="{loc:Localize CompSettings.OpenTidy3dSettings}"
                                    Command="{Binding OpenTidy3dSettingsCommand}"
                                    HorizontalAlignment="Left"
                                    IsVisible="{Binding ShowOpenSettingsLink}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Cloud cost confirmation: Tidy3D runs consume credits, so nothing is
                     submitted until the user reviews the estimate and confirms. -->
                <Border Classes="card" Background="{DynamicResource Brush.Warning.Subtle}" Padding="12,8"
                        IsVisible="{Binding IsAwaitingCloudConfirmation}">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="warning" Text="{Binding CloudCostText}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{loc:Localize CompSettings.CloudSubmit}"
                                    Command="{Binding ConfirmCloudSubmitCommand}"/>
                            <Button Classes="ghost" Content="{loc:Localize Common.Cancel}"
                                    Command="{Binding CancelCloudSubmitCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="{loc:Localize ComponentSettings.LoadFromFile}"
                            Command="{Binding LoadFromFileCommand}"
                            ToolTip.Tip="{loc:Localize ComponentSettings.LoadTip}"
                            IsEnabled="{Binding IsImporting, Converter={x:Static BoolConverters.Not}}"/>
                    <!-- Split button: recalculate with the selected backend; the chevron picks the backend. -->
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding CanRecalculate}">
                        <Button Classes="primary" Content="{Binding RecalculateButtonLabel}"
                                Command="{Binding RecalculateSMatrixCommand}"
                               />
                        <Button Classes="primary"
                                IsVisible="{Binding HasBackendSelection}"
                                ToolTip.Tip="{loc:Localize CompSettings.BackendPickerTip}">
                            <Button.IsEnabled>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsComputing" Converter="{x:Static BoolConverters.Not}"/>
                                    <Binding Path="IsAwaitingCloudConfirmation" Converter="{x:Static BoolConverters.Not}"/>
                                </MultiBinding>
                            </Button.IsEnabled>
                            <controls:Icon Data="{StaticResource Icon.ChevronDown}" Size="12"/>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <StackPanel MinWidth="280" Margin="6" Spacing="4">
                                        <TextBlock Classes="label" Margin="0,0,0,4"
                                                   Text="{loc:Localize CompSettings.ChooseFdtdBackend}"/>
                                        <ItemsControl ItemsSource="{Binding BackendSelection.BackendItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="solvers:FdtdBackendItemViewModel">
                                                    <Button Classes="ghost" HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Margin="0,2"
                                                            Command="{Binding SelectCommand}">
                                                        <Grid ColumnDefinitions="22,*">
                                                            <TextBlock Grid.Column="0" Classes="success"
                                                                       Text="{Binding SelectionMark}"
                                                                       VerticalAlignment="Top"/>
                                                            <StackPanel Grid.Column="1">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <TextBlock Text="{Binding Icon}"/>
                                                                    <TextBlock Classes="strong"
                                                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                                                               Text="{Binding Name}"
                                                                               VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                                <TextBlock Classes="caption" Text="{Binding Description}"
                                                                           TextWrapping="Wrap" MaxWidth="230"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
