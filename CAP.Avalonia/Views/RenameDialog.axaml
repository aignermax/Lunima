<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:CAP.Avalonia.Services.Localization"
        x:Class="CAP.Avalonia.Views.RenameDialog"
        Title="{loc:Localize Rename.Title}"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <StackPanel Margin="{DynamicResource Padding.Dialog}" Spacing="12">
        <TextBlock Classes="secondary" Text="{loc:Localize Rename.EnterNewName}"/>
        <TextBox x:Name="NameTextBox"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
            <Button Content="{loc:Localize Common.Cancel}" MinWidth="80" Click="OnCancelClicked"/>
            <Button Classes="primary" Content="{loc:Localize Common.Ok}" MinWidth="80" IsDefault="True" Click="OnOkClicked"/>
        </StackPanel>
    </StackPanel>
</Window>
