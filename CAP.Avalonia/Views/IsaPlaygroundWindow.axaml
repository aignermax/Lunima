<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="using:CAP.Avalonia.Controls"
        xmlns:loc="using:CAP.Avalonia.Services.Localization"
        xmlns:isa="using:CAP.Avalonia.ViewModels.Logic.IsaPlayground"
        xmlns:views="using:CAP.Avalonia.Views"
        xmlns:panels="using:CAP.Avalonia.Views.Panels"
        xmlns:tour="using:CAP.Avalonia.Controls.TourAnchor"
        x:Class="CAP.Avalonia.Views.IsaPlaygroundWindow"
        x:DataType="isa:IsaPlaygroundViewModel"
        Title="{loc:Localize IsaPlayground.WindowTitle}"
        Width="940" Height="600"
        MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterOwner">

    <!-- Root grid: the tour overlay floats above the whole window for
         the "Run a program on your chip" steps that anchor here. -->
    <Grid>
    <DockPanel Margin="24" LastChildFill="True">

        <!-- Header: title + intro on the left, help flyout on the right -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Classes="headline" Text="{Binding HeaderTitle}"/>
                <TextBlock Classes="caption" Text="{loc:Localize IsaPlayground.Intro}" TextWrapping="Wrap"/>
            </StackPanel>
            <ctrl:HelpFlyoutButton Grid.Column="1" VerticalAlignment="Top"
                                   Title="{loc:Localize IsaPlayground.HelpTitle}">
                <ctrl:HelpFlyoutButton.HelpContent>
                    <views:IsaPlaygroundHelpFlyout/>
                </ctrl:HelpFlyoutButton.HelpContent>
            </ctrl:HelpFlyoutButton>
        </Grid>

        <!-- Button row pinned to the bottom -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
            <Button Command="{Binding AssembleCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ctrl:Icon Data="{StaticResource Icon.Binary}"/>
                    <TextBlock Text="{loc:Localize IsaPlayground.AssembleButton}"/>
                </StackPanel>
            </Button>
            <Button x:Name="IsaStepButton" Command="{Binding StepCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ctrl:Icon Data="{StaticResource Icon.StepForward}"/>
                    <TextBlock Text="{loc:Localize IsaPlayground.StepButton}"/>
                </StackPanel>
            </Button>
            <Button Classes="primary" Command="{Binding ToggleRunCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ctrl:Icon Data="{StaticResource Icon.Play}" IsVisible="{Binding !IsRunning}"/>
                    <ctrl:Icon Data="{StaticResource Icon.CircleStop}" IsVisible="{Binding IsRunning}"/>
                    <TextBlock Text="{Binding RunStopText}"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding ResetCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ctrl:Icon Data="{StaticResource Icon.RotateCcw}"/>
                    <TextBlock Text="{loc:Localize IsaPlayground.ResetButton}"/>
                </StackPanel>
            </Button>
            <StackPanel VerticalAlignment="Center" Spacing="2" Margin="16,0,0,0">
                <CheckBox x:Name="IsaPhotonicToggle"
                          Content="{Binding PhotonicToggleLabel}"
                          IsChecked="{Binding UsePhotonicAdder}"
                          IsEnabled="{Binding IsPhotonicToggleEnabled}"
                          VerticalAlignment="Center"/>
                <TextBlock Classes="caption" Text="{loc:Localize IsaPlayground.PhotonicAdderHint}"
                           TextWrapping="Wrap" MaxWidth="260"
                           IsVisible="{Binding !IsAnyPhotonicAvailable}"/>
                <StackPanel Spacing="4" MaxWidth="260" IsVisible="{Binding !IsAnyPhotonicAvailable}">
                    <Button x:Name="OpenSuitableIsaExampleButton" Content="{loc:Localize IsaPlayground.OpenSuitableExample}"
                            Command="{Binding OpenSuitableExampleCommand}" IsVisible="{Binding !HasOpenedSuitableExample}"/>
                    <Button x:Name="BuildIsaExampleNetworkButton" Content="{loc:Localize IsaPlayground.BuildExampleNetwork}"
                            Command="{Binding BuildExampleNetworkCommand}" IsVisible="{Binding HasOpenedSuitableExample}"/>
                    <TextBlock Classes="caption" Text="{Binding ExampleActionStatus}" TextWrapping="Wrap"
                               IsVisible="{Binding ExampleActionStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
                <TextBlock Classes="caption success" Text="{Binding PhotonicStatusText}"
                           TextWrapping="Wrap" MaxWidth="260"
                           IsVisible="{Binding PhotonicStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </StackPanel>

        <!-- Main area: editor on the left, machine state on the right -->
        <Grid ColumnDefinitions="3*,2*">

            <DockPanel Grid.Column="0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                    <TextBlock Classes="secondary" Text="{loc:Localize IsaPlayground.SamplesLabel}"
                               VerticalAlignment="Center"/>
                    <ComboBox x:Name="IsaSamplePicker"
                              ItemsSource="{Binding Samples}"
                              SelectedItem="{Binding SelectedSample}"
                              MinWidth="180">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="isa:IsaSampleProgram">
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <ctrl:IsaProgramEditor x:Name="ProgramEditor"
                                       Code="{Binding ProgramText}"
                                       CurrentLine="{Binding CurrentSourceLine}"
                                       IsReadOnly="{Binding IsEditorReadOnly}"
                                       FontFamily="{DynamicResource Font.Mono}" FontSize="13"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       LineNumbersForeground="{DynamicResource Brush.Text.Tertiary}"
                                       Background="{DynamicResource Brush.Surface.Input}"
                                       BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1"
                                       HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
            </DockPanel>

            <DockPanel Grid.Column="1" Margin="24,0,0,0" LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Classes="label" Text="{loc:Localize IsaPlayground.StateTitle}"
                           Margin="0,0,0,8"/>
                <Border DockPanel.Dock="Top" Classes="card" Padding="12">
                    <Grid ColumnDefinitions="Auto,16,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Classes="secondary" Text="{loc:Localize IsaPlayground.PcLabel}" Margin="0,3"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Classes="mono" Text="{Binding ProgramCounter}" Margin="0,3"/>
                        <TextBlock Grid.Row="1" Classes="secondary" Text="{loc:Localize IsaPlayground.AccLabel}" Margin="0,3"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Classes="mono" Text="{Binding Accumulator}" Margin="0,3"/>
                        <TextBlock Grid.Row="2" Classes="secondary" Text="{loc:Localize IsaPlayground.AccBinaryLabel}" Margin="0,3"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Classes="mono" Text="{Binding AccumulatorBinary}" Margin="0,3"/>
                        <TextBlock Grid.Row="3" Classes="secondary" Text="{loc:Localize IsaPlayground.RamLabel}" Margin="0,3"/>
                        <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="mono" Text="{Binding RamText}" Margin="0,3"/>
                            <Border Classes="chip success" IsVisible="{Binding IsPhotonicDataMemoryActive}">
                                <TextBlock Text="{loc:Localize IsaPlayground.RamOnLightChip}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Row="4" Classes="secondary" Text="{loc:Localize IsaPlayground.StatusLabel}" Margin="0,3"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Classes="mono" Text="{Binding MachineStatusText}" Margin="0,3"/>
                    </Grid>
                </Border>

                <!-- "What runs on light": one chip per machine unit, green while the
                     photonic network computes it, neutral while it is simulated
                     electronically. The (?) flyout explains the colors. -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,12,0,0">
                    <ItemsControl ItemsSource="{Binding UnitChips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="isa:IsaUnitChipViewModel">
                                <Border Classes="chip" Classes.success="{Binding IsOnLight}">
                                    <TextBlock Text="{Binding UnitName}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ctrl:HelpFlyoutButton VerticalAlignment="Center"
                                           Title="{loc:Localize IsaPlayground.UnitChipsTitle}">
                        <ctrl:HelpFlyoutButton.HelpContent>
                            <TextBlock Text="{loc:Localize IsaPlayground.UnitChipsHint}"
                                       TextWrapping="Wrap" MaxWidth="280"/>
                        </ctrl:HelpFlyoutButton.HelpContent>
                    </ctrl:HelpFlyoutButton>
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Classes="caption danger" Text="{Binding ErrorText}"
                           TextWrapping="Wrap" Margin="0,12,0,0"
                           IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            </DockPanel>
        </Grid>
    </DockPanel>

    <!-- "Run a program on your chip" tour overlay (#1267): hosts the card for
         the steps anchored in this window (sample picker, photonic toggle,
         Step button). The DataContext is the tour ViewModel, assigned by the
         code-behind via the Tour property; without a tour it stays hidden. -->
    <tour:TourAnchorOverlay x:Name="RunProgramTourOverlay"
                            IsVisible="{Binding ShowCardInPlayground, FallbackValue=False}"
                            TargetName="{Binding CurrentTargetName}">
        <tour:TourAnchorOverlay.Card>
            <panels:RunProgramTourPanel x:Name="RunProgramTourCard"/>
        </tour:TourAnchorOverlay.Card>
    </tour:TourAnchorOverlay>
    </Grid>

</Window>
