<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="using:CAP.Avalonia.Controls"
        xmlns:loc="using:CAP.Avalonia.Services.Localization"
        xmlns:isa="using:CAP.Avalonia.ViewModels.Logic.IsaPlayground"
        xmlns:views="using:CAP.Avalonia.Views"
        xmlns:panels="using:CAP.Avalonia.Views.Panels"
        xmlns:tour="using:CAP.Avalonia.Controls.TourAnchor"
        x:Class="CAP.Avalonia.Views.IsaPlaygroundWindow"
        x:DataType="isa:IsaPlaygroundViewModel"
        Title="{loc:Localize IsaPlayground.WindowTitle}"
        Width="940" Height="600"
        MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#1e1e1e"
        Foreground="White">

    <!-- Root grid: the tour overlay (#1267) floats above the whole window for
         the "Run a program on your chip" steps that anchor here. -->
    <Grid>
    <DockPanel Margin="14" LastChildFill="True">

        <!-- Header: title + intro on the left, help flyout on the right -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="{Binding HeaderTitle}" Foreground="DeepSkyBlue"
                           FontWeight="SemiBold" FontSize="16"/>
                <TextBlock Text="{loc:Localize IsaPlayground.Intro}" Foreground="Gray"
                           FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
            <ctrl:HelpFlyoutButton Grid.Column="1" VerticalAlignment="Top"
                                   Title="{loc:Localize IsaPlayground.HelpTitle}">
                <ctrl:HelpFlyoutButton.HelpContent>
                    <views:IsaPlaygroundHelpFlyout/>
                </ctrl:HelpFlyoutButton.HelpContent>
            </ctrl:HelpFlyoutButton>
        </Grid>

        <!-- Button row pinned to the bottom -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
            <Button Content="{loc:Localize IsaPlayground.AssembleButton}"
                    Command="{Binding AssembleCommand}"
                    Background="#3d3d5d" Padding="12,6"/>
            <Button x:Name="IsaStepButton"
                    Content="{loc:Localize IsaPlayground.StepButton}"
                    Command="{Binding StepCommand}"
                    Background="#3d3d5d" Padding="12,6"/>
            <Button Content="{Binding RunStopText}"
                    Command="{Binding ToggleRunCommand}"
                    Background="#3d3d5d" Padding="12,6"/>
            <Button Content="{loc:Localize IsaPlayground.ResetButton}"
                    Command="{Binding ResetCommand}"
                    Background="#3d3d5d" Padding="12,6"/>
            <StackPanel VerticalAlignment="Center" Spacing="2" Margin="8,0,0,0">
                <CheckBox x:Name="IsaPhotonicToggle"
                          Content="{Binding PhotonicToggleLabel}"
                          IsChecked="{Binding UsePhotonicAdder}"
                          IsEnabled="{Binding IsPhotonicToggleEnabled}"
                          FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text="{loc:Localize IsaPlayground.PhotonicAdderHint}"
                           Foreground="Gray" FontSize="10" TextWrapping="Wrap" MaxWidth="260"
                           IsVisible="{Binding !IsAnyPhotonicAvailable}"/>
                <TextBlock Text="{Binding PhotonicStatusText}" Foreground="#7ec87e" FontSize="10"
                           TextWrapping="Wrap" MaxWidth="260"
                           IsVisible="{Binding PhotonicStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </StackPanel>

        <!-- Main area: editor on the left, machine state + trace on the right -->
        <Grid ColumnDefinitions="3*,2*">

            <DockPanel Grid.Column="0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                    <TextBlock Text="{loc:Localize IsaPlayground.SamplesLabel}" Foreground="Gray"
                               FontSize="12" VerticalAlignment="Center"/>
                    <ComboBox x:Name="IsaSamplePicker"
                              ItemsSource="{Binding Samples}"
                              SelectedItem="{Binding SelectedSample}"
                              MinWidth="180" FontSize="12"
                              Background="#252525">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="isa:IsaSampleProgram">
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <TextBox AcceptsReturn="True" TextWrapping="NoWrap" AcceptsTab="True"
                         Text="{Binding ProgramText}"
                         IsReadOnly="{Binding IsEditorReadOnly}"
                         FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="13"
                         Background="#252525" BorderBrush="#3e3e3e"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </DockPanel>

            <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="4">
                <TextBlock Text="{loc:Localize IsaPlayground.StateTitle}" Foreground="DeepSkyBlue"
                           FontWeight="SemiBold" FontSize="13"/>
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,2,0,4">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Localize IsaPlayground.PcLabel}"
                               Foreground="Gray" FontSize="12" Margin="0,1,10,1"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProgramCounter}"
                               FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="12" Margin="0,1"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Localize IsaPlayground.AccLabel}"
                               Foreground="Gray" FontSize="12" Margin="0,1,10,1"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Accumulator}"
                               FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="12" Margin="0,1"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Localize IsaPlayground.AccBinaryLabel}"
                               Foreground="Gray" FontSize="12" Margin="0,1,10,1"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AccumulatorBinary}"
                               FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="12" Margin="0,1"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Localize IsaPlayground.RamLabel}"
                               Foreground="Gray" FontSize="12" Margin="0,1,10,1"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RamText}"
                               FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="12" Margin="0,1"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Localize IsaPlayground.StatusLabel}"
                               Foreground="Gray" FontSize="12" Margin="0,1,10,1"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding MachineStatusText}"
                               FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="12" Margin="0,1"/>
                </Grid>

                <TextBlock Text="{Binding ErrorText}" Foreground="#ff6b6b" FontSize="11"
                           TextWrapping="Wrap"
                           IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <TextBlock Text="{loc:Localize IsaPlayground.TraceTitle}" Foreground="DeepSkyBlue"
                           FontWeight="SemiBold" FontSize="13" Margin="0,6,0,2"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding TraceLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="isa:IsaTraceLineViewModel">
                                <Border Classes.current="{Binding IsCurrent}" Padding="4,1" CornerRadius="3">
                                    <Border.Styles>
                                        <Style Selector="Border.current">
                                            <Setter Property="Background" Value="#3d5d3d"/>
                                        </Style>
                                    </Border.Styles>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding LineNumber}"
                                                   Foreground="Gray" MinWidth="30"
                                                   FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="11"/>
                                        <TextBlock Text="{Binding Text}" Foreground="White"
                                                   FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="11"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Grid>
    </DockPanel>

    <!-- "Run a program on your chip" tour overlay (#1267): hosts the card for
         the steps anchored in this window (sample picker, photonic toggle,
         Step button). The DataContext is the tour ViewModel, assigned by the
         code-behind via the Tour property; without a tour it stays hidden. -->
    <tour:TourAnchorOverlay x:Name="RunProgramTourOverlay"
                            IsVisible="{Binding ShowCardInPlayground, FallbackValue=False}"
                            TargetName="{Binding CurrentTargetName}">
        <tour:TourAnchorOverlay.Card>
            <panels:RunProgramTourPanel x:Name="RunProgramTourCard"/>
        </tour:TourAnchorOverlay.Card>
    </tour:TourAnchorOverlay>
    </Grid>

</Window>
