<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="using:CAP.Avalonia.ViewModels.Settings"
        xmlns:vmCanvas="using:CAP.Avalonia.ViewModels.Canvas"
        xmlns:vmUpdate="using:CAP.Avalonia.ViewModels.Update"
        xmlns:vmExport="using:CAP.Avalonia.ViewModels.Export"
        xmlns:vmAi="using:CAP.Avalonia.ViewModels.AI"
        xmlns:vmSolvers="using:CAP.Avalonia.ViewModels.Solvers"
        xmlns:vmAgent="using:CAP.Avalonia.ViewModels.Settings.AgentBridge"
        xmlns:vmPyEnv="using:CAP.Avalonia.ViewModels.Export.PythonEnvironmentManager"
        xmlns:panels="using:CAP.Avalonia.Views.Panels"
        xmlns:loc="using:CAP.Avalonia.Services.Localization"
        xmlns:controls="using:CAP.Avalonia.Controls"
        xmlns:conv="using:CAP.Avalonia.Converters"
        x:Class="CAP.Avalonia.Views.SettingsWindow"
        x:DataType="settings:SettingsWindowViewModel"
        Title="{loc:Localize Settings.WindowTitle}"
        Width="820" Height="680"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <conv:IconKeyConverter x:Key="IconKey"/>
    </Window.Resources>

    <Window.Styles>
        <!-- A settings row: label + description on the left, the control on the right. -->
        <Style Selector="Border.setting">
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.group">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Subtitle}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,24,0,0"/>
        </Style>
        <Style Selector="TextBlock.unit">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="200,1,*">

        <!-- Navigation sidebar -->
        <DockPanel Grid.Column="0" Background="{DynamicResource Brush.Surface.Panel}">
            <TextBlock DockPanel.Dock="Top" Classes="title"
                       Text="{loc:Localize Settings.WindowTitle}"
                       Margin="20,20,16,16"/>
            <ListBox ItemsSource="{Binding Pages}"
                     SelectedItem="{Binding SelectedPage}"
                     Margin="8,0,8,8"
                     BorderThickness="0">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="Margin" Value="0,0,0,2"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected controls|Icon">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Hover}"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type settings:ISettingsPage}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <controls:Icon Data="{Binding Icon, Converter={StaticResource IconKey}}"
                                           VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSize.BodyLarge}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Border Grid.Column="1" Classes="divider"/>

        <!-- Content area -->
        <!-- Padding belongs on the content, not the ScrollViewer: ScrollContentPresenter
             measures its child with the full viewport width without subtracting its own
             Padding, so wrapping text would be laid out too wide and clip at the right edge. -->
        <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled">
            <ContentControl Padding="24,20" Content="{Binding SelectedPage.ViewModel}">
                <ContentControl.DataTemplates>

                    <!-- Grid Snap & Alignment -->
                    <DataTemplate DataType="{x:Type settings:GridSnapSettingsViewModel}">
                        <StackPanel>
                            <TextBlock Classes="headline" Text="{loc:Localize Settings.GridSnap.Title}" Margin="0,0,0,8"/>
                            <Border Classes="setting">
                                <Grid ColumnDefinitions="*,24,Auto">
                                    <TextBlock Classes="strong" Text="{loc:Localize Settings.GridSnap.Enable}"
                                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    <ToggleSwitch Grid.Column="2" OnContent="" OffContent=""
                                                  IsChecked="{Binding GridSnap.IsEnabled}"/>
                                </Grid>
                            </Border>
                            <Border Classes="setting">
                                <Grid ColumnDefinitions="*,24,Auto">
                                    <TextBlock Classes="strong" Text="{loc:Localize Settings.GridSnap.GridSize}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                        <NumericUpDown Value="{Binding GridSnap.GridSizeMicrometers}"
                                                       Minimum="1" Maximum="1000" Increment="10"
                                                       Width="130" FormatString="F0"/>
                                        <TextBlock Classes="unit" Text="µm"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Classes="group" Text="{loc:Localize Settings.GridSnap.AlignmentTitle}"/>
                            <Border Classes="setting">
                                <Grid ColumnDefinitions="*,24,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="strong" Text="{loc:Localize Settings.GridSnap.ShowGuides}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Classes="caption" Text="{loc:Localize Settings.GridSnap.GuidesDescription}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="2" OnContent="" OffContent=""
                                                  VerticalAlignment="Top"
                                                  IsChecked="{Binding AlignmentGuide.IsEnabled}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </DataTemplate>

                    <!-- Routing -->
                    <DataTemplate DataType="{x:Type settings:RoutingSettingsViewModel}">
                        <StackPanel>
                            <TextBlock Classes="headline" Text="{loc:Localize Settings.Routing.Title}" Margin="0,0,0,8"/>
                            <Border Classes="setting">
                                <Grid ColumnDefinitions="*,24,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="strong" Text="{loc:Localize Settings.Routing.DirectFirst}" TextWrapping="Wrap"/>
                                        <TextBlock Classes="caption" Text="{loc:Localize Settings.Routing.DirectFirstDescription}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="2" OnContent="" OffContent="" VerticalAlignment="Top"
                                                  IsChecked="{Binding Canvas.PreferDirectStyledRoutes}"/>
                                </Grid>
                            </Border>
                            <Border Classes="setting">
                                <Grid ColumnDefinitions="*,24,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="strong" Text="{loc:Localize Settings.Routing.EnableDiagonal}" TextWrapping="Wrap"/>
                                        <TextBlock Classes="caption" Text="{loc:Localize Settings.Routing.DiagonalDescription}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="2" OnContent="" OffContent="" VerticalAlignment="Top"
                                                  IsChecked="{Binding Canvas.UseDiagonalRouting}"/>
                                </Grid>
                            </Border>

                            <TextBlock Classes="group" Text="{loc:Localize Settings.Routing.CrossingsTitle}"/>
                            <Border Classes="setting">
                                <Grid ColumnDefinitions="*,24,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="strong" Text="{loc:Localize Settings.Routing.AdaptiveCrossing}" TextWrapping="Wrap"/>
                                        <TextBlock Classes="caption" Text="{loc:Localize Settings.Routing.CrossingDescription}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="2" OnContent="" OffContent="" VerticalAlignment="Top"
                                                  IsChecked="{Binding CrossingInsertionEnabled}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </DataTemplate>

                    <!-- Software Updates -->
                    <DataTemplate DataType="{x:Type vmUpdate:UpdateViewModel}">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="headline" Text="{loc:Localize Settings.Updates.Title}"/>
                            <TextBlock Classes="mono secondary" Text="{Binding CurrentVersionText}"/>

                            <Button Content="{loc:Localize Settings.Updates.Check}"
                                    Command="{Binding CheckForUpdatesCommand}"
                                    HorizontalAlignment="Left"
                                    IsEnabled="{Binding IsChecking, Converter={x:Static BoolConverters.Not}}"/>

                            <TextBlock Classes="caption" Text="{Binding StatusText}" TextWrapping="Wrap"
                                       IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                            <Border Classes="card" IsVisible="{Binding UpdateAvailable}">
                                <StackPanel Spacing="12">
                                    <TextBlock Classes="subtitle success" Text="{Binding LatestVersionText}"/>

                                    <ScrollViewer MaxHeight="120"
                                                  IsVisible="{Binding ReleaseNotes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Classes="caption" Text="{Binding ReleaseNotes}" TextWrapping="Wrap"/>
                                    </ScrollViewer>

                                    <ProgressBar Value="{Binding DownloadProgress}"
                                                 Minimum="0" Maximum="1" Height="6"
                                                 IsVisible="{Binding IsDownloading}"/>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="primary" Content="{loc:Localize Settings.Updates.DownloadInstall}"
                                                Command="{Binding InstallUpdateCommand}"
                                                IsEnabled="{Binding IsDownloading, Converter={x:Static BoolConverters.Not}}"/>
                                        <Button Content="{loc:Localize Settings.Updates.RemindLater}"
                                                Command="{Binding RemindLaterCommand}"
                                                IsEnabled="{Binding IsDownloading, Converter={x:Static BoolConverters.Not}}"/>
                                        <Button Classes="ghost" Content="{loc:Localize Settings.Updates.SkipVersion}"
                                                Command="{Binding SkipThisVersionCommand}"
                                                IsEnabled="{Binding IsDownloading, Converter={x:Static BoolConverters.Not}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DataTemplate>

                    <!-- GDS Export (GDS toggle + Python environment) -->
                    <DataTemplate DataType="{x:Type vmExport:GdsExportViewModel}">
                        <StackPanel>
                            <TextBlock Classes="headline" Text="{loc:Localize Settings.GdsExport.Title}"/>
                            <TextBlock Classes="caption" Text="{loc:Localize Settings.GdsExport.Description}"
                                       TextWrapping="Wrap" Margin="0,4,0,8"/>

                            <Border Classes="setting">
                                <Grid ColumnDefinitions="*,24,Auto">
                                    <TextBlock Classes="strong" Text="{loc:Localize Settings.GdsExport.GenerateGds}"
                                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    <ToggleSwitch Grid.Column="2" OnContent="" OffContent=""
                                                  IsChecked="{Binding GenerateGdsEnabled}"/>
                                </Grid>
                            </Border>

                            <TextBlock Classes="group" Text="{loc:Localize Settings.GdsExport.PythonEnvTitle}"/>
                            <TextBlock Classes="caption" Text="{loc:Localize Settings.GdsExport.PythonEnvDescription}"
                                       TextWrapping="Wrap" Margin="0,4,0,12"/>

                            <TextBlock Classes="label" Text="{loc:Localize Settings.GdsExport.ActiveInterpreter}" Margin="0,0,0,4"/>
                            <TextBox Classes="mono" Text="{Binding CustomPythonPath}"
                                     IsReadOnly="True"
                                     Watermark="{loc:Localize Settings.GdsExport.NoInterpreter}"/>

                            <Grid ColumnDefinitions="70,*" RowDefinitions="Auto,Auto" Margin="0,12,0,0">
                                <TextBlock Classes="secondary" Text="Python"/>
                                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding PythonStatus}"/>
                                <TextBlock Grid.Row="1" Classes="secondary" Text="Nazca" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono" Text="{Binding NazcaStatus}" Margin="0,4,0,0"/>
                            </Grid>

                            <Button Content="{loc:Localize Settings.GdsExport.Manage}"
                                    Click="OnManageInterpretersClick"
                                    HorizontalAlignment="Left" Margin="0,16,0,0"
                                    ToolTip.Tip="{loc:Localize Settings.GdsExport.ManageTip}"/>
                        </StackPanel>
                    </DataTemplate>

                    <!-- Python Environments (managed venvs with Nazca) -->
                    <DataTemplate DataType="{x:Type vmPyEnv:PythonEnvironmentManagerViewModel}">
                        <panels:PythonEnvironmentManagerPanel/>
                    </DataTemplate>

                    <!-- AI Assistant -->
                    <DataTemplate DataType="{x:Type vmAi:AiAssistantViewModel}">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="headline" Text="{loc:Localize Settings.Ai.Title}"/>
                            <TextBlock Classes="caption" Text="{loc:Localize Settings.Ai.Description}"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <TextBlock Classes="label" Text="{loc:Localize Settings.Ai.ApiKey}" Margin="0,0,0,4"/>
                            <TextBox Classes="mono" Text="{Binding ApiKey}"
                                     Watermark="sk-ant-..."
                                     PasswordChar="•"/>

                            <TextBlock Classes="caption" Text="{Binding StatusText}" Margin="0,8,0,0"
                                       IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </DataTemplate>

                    <!-- Agent bridge (MCP) — local server for external AI agents such as Claude Code -->
                    <DataTemplate DataType="{x:Type vmAgent:AgentBridgeSettingsViewModel}">
                        <StackPanel>
                            <TextBlock Classes="headline" Text="{loc:Localize Settings.AgentBridge.Title}"/>
                            <TextBlock Classes="caption" Text="{loc:Localize Settings.AgentBridge.Description}"
                                       TextWrapping="Wrap" Margin="0,4,0,8"/>

                            <Border Classes="setting">
                                <Grid ColumnDefinitions="*,24,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="strong" Text="{loc:Localize Settings.AgentBridge.Enable}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Classes="caption mono" Text="{Binding StatusText}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="2" OnContent="" OffContent="" VerticalAlignment="Top"
                                                  IsChecked="{Binding IsEnabled}"/>
                                </Grid>
                            </Border>
                            <Border Classes="setting">
                                <Grid ColumnDefinitions="*,24,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="strong" Text="{loc:Localize Settings.AgentBridge.ConnectClaude}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Classes="caption" Text="{loc:Localize Settings.AgentBridge.ConnectClaudeHint}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Classes="primary" VerticalAlignment="Top"
                                            Content="{loc:Localize Settings.AgentBridge.ConnectClaudeButton}"
                                            Command="{Binding ConnectClaudeCodeCommand}"
                                            IsEnabled="{Binding IsConnecting, Converter={x:Static BoolConverters.Not}}"/>
                                </Grid>
                            </Border>
                            <Border Classes="setting">
                                <Grid ColumnDefinitions="*,24,Auto">
                                    <TextBlock Classes="strong" Text="{loc:Localize Settings.AgentBridge.Port}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                        <NumericUpDown Value="{Binding Port}" Minimum="1024" Maximum="65535"
                                                       Increment="1" Width="130" FormatString="F0"/>
                                        <Button Content="{loc:Localize Settings.AgentBridge.ApplyPort}"
                                                Command="{Binding ApplyPortCommand}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Classes="setting">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,24,Auto">
                                        <StackPanel Spacing="2">
                                            <TextBlock Classes="strong" Text="{loc:Localize Settings.AgentBridge.RequireToken}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Classes="caption" Text="{loc:Localize Settings.AgentBridge.RequireTokenHint}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="2" OnContent="" OffContent="" VerticalAlignment="Top"
                                                      IsChecked="{Binding RequireToken}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,8,Auto,8,Auto" IsVisible="{Binding RequireToken}">
                                        <TextBox Classes="mono" Text="{Binding Token}" IsReadOnly="True" PasswordChar="•"/>
                                        <Button Grid.Column="2" Content="{loc:Localize Settings.AgentBridge.Copy}"
                                                Command="{Binding CopyTokenCommand}"/>
                                        <Button Grid.Column="4" Content="{loc:Localize Settings.AgentBridge.RegenerateToken}"
                                                Command="{Binding RegenerateTokenCommand}"/>
                                    </Grid>
                                    <TextBlock Classes="caption" Text="{loc:Localize Settings.AgentBridge.SecurityNote}"
                                               TextWrapping="Wrap" IsVisible="{Binding RequireToken}"/>
                                </StackPanel>
                            </Border>
                            <Border Classes="setting">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="strong" Text="{loc:Localize Settings.AgentBridge.ConnectCommand}"/>
                                    <Grid ColumnDefinitions="*,8,Auto">
                                        <TextBox Classes="mono" Text="{Binding ConnectCommandText, Mode=OneWay}"
                                                 IsReadOnly="True" TextWrapping="Wrap"/>
                                        <Button Grid.Column="2" Classes="primary" VerticalAlignment="Top"
                                                Content="{loc:Localize Settings.AgentBridge.Copy}"
                                                Command="{Binding CopyConnectCommandCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Classes="caption" Text="{Binding FeedbackText}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Classes.success="{Binding !IsFeedbackError}" Classes.danger="{Binding IsFeedbackError}"
                                       IsVisible="{Binding FeedbackText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </DataTemplate>

                    <!-- Tidy3D Cloud — API key for the cloud FDTD S-matrix backend -->
                    <DataTemplate DataType="{x:Type vmSolvers:Tidy3dSettingsViewModel}">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="headline" Text="{loc:Localize Settings.Tidy3d.Title}"/>
                            <TextBlock Classes="caption" Text="{loc:Localize Settings.Tidy3d.Description}"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <TextBlock Classes="label" Text="{loc:Localize Settings.Tidy3d.ApiKey}" Margin="0,0,0,4"/>
                            <!-- LostFocus: saving per keystroke would rewrite the prefs file on every keypress -->
                            <TextBox Classes="mono" Text="{Binding ApiKey, UpdateSourceTrigger=LostFocus}"
                                     Watermark="{loc:Localize Settings.Tidy3d.ApiKeyWatermark}"
                                     PasswordChar="•"/>

                            <TextBlock Classes="caption" Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                            <Button Classes="link" Content="{loc:Localize Settings.Tidy3d.LinkText}"
                                    Command="{Binding OpenPortalCommand}"
                                    HorizontalAlignment="Left" Margin="0,12,0,0"/>
                            <TextBlock Classes="caption" Text="{loc:Localize Settings.Tidy3d.PackageNote}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </DataTemplate>

                    <!-- Chip Size — design-wide footprint of the PIC -->
                    <DataTemplate DataType="{x:Type vmCanvas:ChipSizeViewModel}">
                        <StackPanel>
                            <TextBlock Classes="headline" Text="{loc:Localize Settings.ChipSize.Title}"/>
                            <TextBlock Classes="caption" Text="{loc:Localize Settings.ChipSize.Description}" IsVisible="{Binding CanEditRootChipSize}"
                                       TextWrapping="Wrap" Margin="0,4,0,8"/>
                            <TextBlock Classes="caption" Text="{loc:Localize Settings.ChipSize.DieScopeDescription}"
                                       IsVisible="{Binding !CanEditRootChipSize}" TextWrapping="Wrap" Margin="0,4,0,8"/>

                            <Border Classes="setting" IsEnabled="{Binding CanEditRootChipSize}">
                                <Grid ColumnDefinitions="*,24,200">
                                    <TextBlock Classes="strong" Text="{loc:Localize Settings.ChipSize.Preset}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding Presets}"
                                              SelectedItem="{Binding SelectedPreset}"
                                              DisplayMemberBinding="{Binding Name}"
                                              HorizontalAlignment="Stretch"/>
                                </Grid>
                            </Border>
                            <Border Classes="setting" IsEnabled="{Binding CanEditRootChipSize}">
                                <Grid ColumnDefinitions="*,24,200">
                                    <TextBlock Classes="strong" Text="{loc:Localize Settings.ChipSize.Width}" VerticalAlignment="Center"/>
                                    <NumericUpDown Grid.Column="2" Value="{Binding WidthMillimeters}"
                                                   Minimum="0.25" Maximum="100"
                                                   Increment="1" FormatString="F2"/>
                                </Grid>
                            </Border>
                            <Border Classes="setting" IsEnabled="{Binding CanEditRootChipSize}">
                                <Grid ColumnDefinitions="*,24,200">
                                    <TextBlock Classes="strong" Text="{loc:Localize Settings.ChipSize.Height}" VerticalAlignment="Center"/>
                                    <NumericUpDown Grid.Column="2" Value="{Binding HeightMillimeters}"
                                                   Minimum="0.25" Maximum="100"
                                                   Increment="1" FormatString="F2"/>
                                </Grid>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Classes="caption" Text="{loc:Localize Settings.ChipSize.GridPrefix}"/>
                                <TextBlock Classes="caption mono" Text="{Binding TileColumns}"/>
                                <TextBlock Classes="caption" Text=" × "/>
                                <TextBlock Classes="caption mono" Text="{Binding TileRows}"/>
                                <TextBlock Classes="caption" Text="{loc:Localize Settings.ChipSize.TilesSuffix}"/>
                            </StackPanel>

                            <Button Classes="primary" Content="{loc:Localize Common.Apply}"
                                    Command="{Binding ApplyCommand}"
                                    HorizontalAlignment="Left" Margin="0,16,0,0"/>

                            <TextBlock Classes="caption success" Text="{Binding StatusText}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </DataTemplate>

                    <!-- Interconnect defaults -->
                    <DataTemplate DataType="{x:Type settings:InterconnectSettingsViewModel}">
                        <StackPanel>
                            <TextBlock Classes="headline" Text="{loc:Localize Settings.Interconnect.Title}"/>
                            <TextBlock Classes="caption" Text="{loc:Localize Settings.Interconnect.Description}"
                                       TextWrapping="Wrap" Margin="0,4,0,8"/>

                            <Border Classes="setting">
                                <Grid ColumnDefinitions="*,24,Auto">
                                    <TextBlock Classes="strong" Text="{loc:Localize Settings.Interconnect.Width}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                        <NumericUpDown Value="{Binding WidthMicrometers}"
                                                       Minimum="0.05" Maximum="100" Increment="0.05"
                                                       Width="130" FormatString="F2"/>
                                        <TextBlock Classes="unit" Text="µm"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Classes="setting">
                                <Grid ColumnDefinitions="*,24,Auto">
                                    <TextBlock Classes="strong" Text="{loc:Localize Settings.Interconnect.BendRadius}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                        <NumericUpDown Value="{Binding BendRadiusMicrometers}"
                                                       Minimum="0.5" Maximum="10000" Increment="1"
                                                       Width="130" FormatString="F1"/>
                                        <TextBlock Classes="unit" Text="µm"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Classes="setting">
                                <Grid ColumnDefinitions="*,24,Auto">
                                    <TextBlock Classes="strong" Text="{loc:Localize Settings.Interconnect.GdsLayer}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Classes="mono" Text="{Binding GdsLayerText}" Width="130"
                                             Watermark="{loc:Localize Settings.Interconnect.GdsLayerWatermark}"/>
                                </Grid>
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                                <Button Classes="primary" Content="{loc:Localize Settings.Interconnect.Apply}"
                                        Command="{Binding ApplyCommand}"/>
                                <Button Content="{loc:Localize Settings.Interconnect.Reset}"
                                        Command="{Binding ResetToDefaultsCommand}"/>
                            </StackPanel>

                            <TextBlock Classes="caption success" Text="{Binding StatusText}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </DataTemplate>

                    <!-- Language — UI language picker -->
                    <DataTemplate DataType="{x:Type settings:LanguageSettingsViewModel}">
                        <StackPanel>
                            <TextBlock Classes="headline" Text="{loc:Localize Settings.Language.Title}"/>
                            <TextBlock Classes="caption" Text="{loc:Localize Settings.Language.Description}"
                                       TextWrapping="Wrap" Margin="0,4,0,8"/>

                            <Border Classes="setting">
                                <Grid ColumnDefinitions="*,24,200">
                                    <TextBlock Classes="strong" Text="{loc:Localize Settings.Language.PickerLabel}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding Options}"
                                              SelectedItem="{Binding SelectedOption}"
                                              HorizontalAlignment="Stretch"/>
                                </Grid>
                            </Border>

                            <TextBlock Classes="caption" Text="{loc:Localize Settings.Language.RestartNote}"
                                       TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                    </DataTemplate>

                </ContentControl.DataTemplates>
            </ContentControl>
        </ScrollViewer>

    </Grid>
</Window>
