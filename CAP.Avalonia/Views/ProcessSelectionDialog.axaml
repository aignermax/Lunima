<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vmp="using:CAP.Avalonia.ViewModels.Process"
        xmlns:loc="using:CAP.Avalonia.Services.Localization"
        xmlns:controls="using:CAP.Avalonia.Controls"
        x:Class="CAP.Avalonia.Views.ProcessSelectionDialog"
        x:Name="DialogRoot"
        x:DataType="vmp:ProcessSelectionViewModel"
        x:CompileBindings="True"
        Title="{loc:Localize ProcessSelection.Title}"
        Width="460" Height="400"
        MinWidth="360" MinHeight="280"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="{DynamicResource Padding.Dialog}">

        <TextBlock DockPanel.Dock="Top" Classes="title"
                   Text="{loc:Localize ProcessSelection.Title}"
                   Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Top" Classes="caption"
                   Text="{loc:Localize ProcessSelection.Explanation}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <!-- One entry per derived process group plus a trailing Playground option, marked
             because it produces a non-manufacturable design. A single click confirms and
             closes; Escape cancels, Enter confirms the keyboard selection. -->
        <ListBox ItemsSource="{Binding Choices}"
                 SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                 BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vmp:ProcessChoiceItem">
                    <Border Classes="card interactive" Padding="12,10" Margin="0,2"
                            Tapped="OnChoiceTapped">
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <controls:Icon Data="{StaticResource Icon.TriangleAlert}"
                                               Size="{DynamicResource IconSize.Small}"
                                               Foreground="{DynamicResource Brush.Warning}"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding IsPlayground}"/>
                                <TextBlock Classes="strong" Text="{Binding Title}"
                                           FontSize="{DynamicResource FontSize.BodyLarge}"/>
                            </StackPanel>
                            <TextBlock Classes="caption" Text="{Binding Subtitle}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</Window>
