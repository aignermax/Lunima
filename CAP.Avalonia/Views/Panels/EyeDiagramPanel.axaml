<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CAP.Avalonia.ViewModels"
             xmlns:panels="using:CAP.Avalonia.Views.Panels"
             xmlns:oxy="using:OxyPlot.Avalonia"
             xmlns:controls="using:CAP.Avalonia.Controls"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             x:Class="CAP.Avalonia.Views.Panels.EyeDiagramPanel"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <!-- Dark hover-tracker so it reads on the dark theme instead of OxyPlot's default
             light/yellow popup (round 5 finding 2): clicking the eye/BER heat map showed a
             yellow-background/white-text tracker box. Same values as TimeDomainPanel's
             tracker for cross-chart consistency. -->
        <Style Selector="oxy|TrackerControl">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="LineStroke" Value="{DynamicResource Brush.Text.Tertiary}"/>
        </Style>
        <!-- The design system (Styles/FluentOverrides.axaml) drives input height/padding app-wide; only the
             layout-specific VerticalContentAlignment and label FontSize stay local. -->
        <Style Selector="NumericUpDown">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <StackPanel Margin="{DynamicResource Padding.Panel}">
        <!-- No heading/separator: the tab header already reads "Eye / BER". -->
        <TextBlock Classes="caption" Margin="0,0,0,4" TextWrapping="Wrap"
                   Text="{loc:Localize EyeDiagram.Description}"/>

        <!-- Parameters + Run: laid out horizontally, wrapping responsively (right, then down). -->
        <WrapPanel Orientation="Horizontal">
            <StackPanel Margin="0,0,12,4">
                <TextBlock Classes="caption" Text="{loc:Localize EyeDiagram.BitRate}" Margin="0,0,0,1"/>
                <NumericUpDown Value="{Binding BottomPanel.Analysis.Eye.BitRateGbps}"
                               Minimum="1" Maximum="1000" Increment="5" Width="120" FormatString="F1"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,4">
                <TextBlock Classes="caption" Text="{loc:Localize EyeDiagram.PrbsPattern}" Margin="0,0,0,1"/>
                <ComboBox ItemsSource="{Binding BottomPanel.Analysis.Eye.PrbsOrders}"
                          SelectedItem="{Binding BottomPanel.Analysis.Eye.SelectedPrbsOrder}"
                          Width="110"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,4">
                <TextBlock Classes="caption" Text="{loc:Localize EyeDiagram.Threshold}" Margin="0,0,0,1"/>
                <NumericUpDown Value="{Binding BottomPanel.Analysis.Eye.ThresholdRelative}"
                               Minimum="0.05" Maximum="0.95" Increment="0.05" Width="110" FormatString="F2"/>
            </StackPanel>
            <!-- Run sits to the right of the fields; the spacer aligns it with the field row. -->
            <StackPanel Margin="0,0,12,4" VerticalAlignment="Bottom">
                <TextBlock Text=" " FontSize="{DynamicResource FontSize.Caption}" Margin="0,0,0,1"/>
                <Button Content="{loc:Localize EyeDiagram.RunButton}" Classes="primary"
                        Command="{Binding BottomPanel.Analysis.Eye.RunEyeAnalysisCommand}"
                        IsEnabled="{Binding BottomPanel.Analysis.Eye.IsRunning, Converter={x:Static BoolConverters.Not}}"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,4" VerticalAlignment="Bottom"
                        IsVisible="{Binding BottomPanel.Analysis.Eye.HasResult}">
                <TextBlock Text=" " FontSize="{DynamicResource FontSize.Caption}" Margin="0,0,0,1"/>
                <Button Content="{loc:Localize Common.ExportCsv}" 
                        Command="{Binding BottomPanel.Analysis.Eye.ExportCsvCommand}"/>
            </StackPanel>
            <!-- Plain-language help: what an eye diagram is, why the opening
                 matters, and what Q / BER / threshold mean. Non-modal flyout,
                 same pattern as the Transient tab's "?" button. -->
            <StackPanel Margin="0,0,0,4" VerticalAlignment="Bottom">
                <TextBlock Text=" " FontSize="{DynamicResource FontSize.Caption}" Margin="0,0,0,1"/>
                <controls:HelpFlyoutButton Title="{loc:Localize EyeDiagram.HelpTip}">
                    <controls:HelpFlyoutButton.HelpContent>
                        <panels:EyeHelpFlyout/>
                    </controls:HelpFlyoutButton.HelpContent>
                </controls:HelpFlyoutButton>
            </StackPanel>
        </WrapPanel>

        <!-- Empty state before the first run -->
        <Border Classes="empty-state" IsVisible="{Binding BottomPanel.Analysis.Eye.HasResult, Converter={x:Static BoolConverters.Not}}">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <controls:Icon Data="{StaticResource Icon.Waves}" Size="24" Foreground="{DynamicResource Brush.Text.Tertiary}" HorizontalAlignment="Center"/>
                <TextBlock Classes="secondary" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                           Text="{loc:Localize EyeDiagram.Empty}"/>
            </StackPanel>
        </Border>

        <!-- Status -->
        <TextBlock Classes="caption" Text="{Binding BottomPanel.Analysis.Eye.StatusText}" Margin="0,2,0,2"
                   IsVisible="{Binding BottomPanel.Analysis.Eye.StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   TextWrapping="Wrap"/>

        <!-- Eye heat map. Plain wheel scrolls the analysis dock; Ctrl(/Cmd)+wheel zooms
             (#693, see ScrollFriendlyPlotController assigned in code-behind). -->
        <Border Classes="card fade-in" Classes.shown="{Binding BottomPanel.Analysis.Eye.HasResult}" Padding="0" ClipToBounds="True"
                Height="200" Margin="0,4,0,0"
                IsVisible="{Binding BottomPanel.Analysis.Eye.HasResult}"
                ToolTip.Tip="{loc:Localize Analysis.Chart.ZoomHint}">
            <oxy:PlotView x:Name="EyePlot"
                          Model="{Binding BottomPanel.Analysis.Eye.PlotModel}" Background="Transparent"/>
        </Border>

        <!-- Numeric eye metrics -->
        <TextBlock Classes="mono" Text="{Binding BottomPanel.Analysis.Eye.MetricsText}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,2,0,0"
                   IsVisible="{Binding BottomPanel.Analysis.Eye.MetricsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   TextWrapping="NoWrap"/>
    </StackPanel>

</UserControl>
