<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CAP.Avalonia.ViewModels"
             xmlns:controls="using:CAP.Avalonia.Controls"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             x:Class="CAP.Avalonia.Views.Panels.ConnectionRoutingPanel"
             x:DataType="vm:MainViewModel">

    <!-- Connection Routing: routing style only. The style reshapes the visible canvas curve;
         width/radius are applied automatically from the interconnect defaults (no manual UI). -->
    <StackPanel IsVisible="{Binding CanvasInteraction.IsConnectionSelected}">
        <Border Classes="divider" Margin="0,12,0,8"/>
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="subtitle" Text="{loc:Localize Routing.Connection.Title}" Margin="0,0,0,5" VerticalAlignment="Center"/>
            <!-- Plain-language help: why sharp bends lose light and where the minimum
                 bend radius comes from (the PDK / cross-section). -->
            <controls:HelpFlyoutButton Grid.Column="1"
                                       Title="{loc:Localize BendRadiusHelp.Title}"
                                       VerticalAlignment="Center">
                <controls:HelpFlyoutButton.HelpContent>
                    <StackPanel Spacing="8" MaxWidth="400">
                        <StackPanel.Styles>
                            <!-- Lost-light dots: they radiate out of the sharp bend. -->
                            <Style Selector="Ellipse.leak">
                                <Style.Animations>
                                    <Animation Duration="0:0:2" IterationCount="INFINITE">
                                        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.8"/><Setter Property="Canvas.Left" Value="0"/></KeyFrame>
                                        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0"/><Setter Property="Canvas.Left" Value="22"/></KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </StackPanel.Styles>

                        <TextBlock Classes="caption secondary" TextWrapping="Wrap"
                                   Text="{loc:Localize BendRadiusHelp.Intro}"/>

                        <!-- Diagram: sharp bend leaks, smooth bend keeps the mode. -->
                        <Border Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.S}" Padding="4">
                            <Canvas Width="360" Height="90">
                                <!-- Smooth bend (top). -->
                                <Path Data="M 20,25 L 120,25 C 180,25 180,65 240,65 L 340,65"
                                      Stroke="{DynamicResource Brush.Info}" StrokeThickness="4"/>
                                <Ellipse Canvas.Left="168" Canvas.Top="21" Width="14" Height="14" Fill="{DynamicResource Brush.Warning}"/>
                                <TextBlock Classes="caption" Canvas.Left="10" Canvas.Top="72" Text="{loc:Localize BendRadiusHelp.DiagramSmooth}"/>
                                <!-- Sharp bend (bottom). -->
                                <Path Data="M 20,45 L 160,45 L 160,75 L 340,75"
                                      Stroke="{DynamicResource Brush.Info}" StrokeThickness="4"/>
                                <Ellipse Canvas.Left="162" Canvas.Top="49" Width="8" Height="8" Fill="{DynamicResource Brush.Warning}"/>
                                <Ellipse Classes="leak" Canvas.Left="166" Canvas.Top="42" Width="5" Height="5" Fill="{DynamicResource Brush.Danger}"/>
                                <Ellipse Classes="leak" Canvas.Left="166" Canvas.Top="54" Width="5" Height="5" Fill="{DynamicResource Brush.Danger}"/>
                                <TextBlock Classes="caption" Canvas.Left="10" Canvas.Top="82" Text="{loc:Localize BendRadiusHelp.DiagramSharp}"/>
                            </Canvas>
                        </Border>

                        <TextBlock Classes="strong" Text="{loc:Localize BendRadiusHelp.LossTitle}"/>
                        <TextBlock Classes="secondary" TextWrapping="Wrap"
                                   Text="{loc:Localize BendRadiusHelp.LossBody}"/>

                        <TextBlock Classes="strong" Text="{loc:Localize BendRadiusHelp.PdkTitle}" Margin="0,4,0,0"/>
                        <TextBlock Classes="secondary" TextWrapping="Wrap"
                                   Text="{loc:Localize BendRadiusHelp.PdkBody}"/>

                        <TextBlock Classes="strong" Text="{loc:Localize BendRadiusHelp.AutoTitle}" Margin="0,4,0,0"/>
                        <TextBlock Classes="secondary" TextWrapping="Wrap"
                                   Text="{loc:Localize BendRadiusHelp.AutoBody}"/>

                        <TextBlock Classes="strong" Text="{loc:Localize BendRadiusHelp.SbendTitle}" Margin="0,4,0,0"/>
                        <TextBlock Classes="secondary" TextWrapping="Wrap"
                                   Text="{loc:Localize BendRadiusHelp.SbendBody}"/>
                    </StackPanel>
                </controls:HelpFlyoutButton.HelpContent>
            </controls:HelpFlyoutButton>
        </Grid>

        <!-- Multi-selection (issue #862): the dropdown restyles all selected connections at once. -->
        <TextBlock Text="{Binding BottomPanel.ConnectionRouting.BatchHint}"
                   IsVisible="{Binding BottomPanel.ConnectionRouting.IsBatchSelection}"
                   Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,0,3" TextWrapping="Wrap"/>

        <TextBlock Classes="caption" Text="{loc:Localize Routing.Connection.Style}" Margin="0,0,0,3"/>
        <ComboBox ItemsSource="{Binding BottomPanel.ConnectionRouting.RoutingStyles}"
                  SelectedItem="{Binding BottomPanel.ConnectionRouting.SelectedStyle}"
                  Width="180" Margin="0,0,0,8"/>
        <!-- Names the effective geometry of a direct-styled Auto route (single
             source of truth was the path, not the dropdown — field report). -->
        <TextBlock Text="{Binding BottomPanel.ConnectionRouting.EffectiveStyleText}"
                   Foreground="{DynamicResource Brush.Accent.Hover}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,0,0,4"
                   IsVisible="{Binding BottomPanel.ConnectionRouting.EffectiveStyleText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    </StackPanel>
</UserControl>
