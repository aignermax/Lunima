<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CAP.Avalonia.ViewModels"
             xmlns:controls="using:CAP.Avalonia.Controls"
             xmlns:help="using:CAP.Avalonia.Controls.Help"
             xmlns:ha="using:CAP.Avalonia.Controls.HelpAnimations"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             x:Class="CAP.Avalonia.Views.Panels.DesignChecksPanel"
             x:DataType="vm:MainViewModel">

    <!-- Hosted as the Checks tab of the analysis dock (formerly a right-sidebar section). -->
    <StackPanel Margin="10,8">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:Localize DesignChecks.Title}" Foreground="{DynamicResource Brush.Danger}" Margin="0,0,0,5" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <!-- Plain-language help: why the DRC-lite rules exist (coupling, bend
                 radiation, reflections) and where the limits come from (the PDK). -->
            <controls:HelpFlyoutButton Grid.Column="1"
                                       Title="{loc:Localize DesignChecksHelp.Title}"
                                       VerticalAlignment="Center" Margin="0,-5,0,0">
                <controls:HelpFlyoutButton.HelpContent>
                    <StackPanel Spacing="8" MaxWidth="400">
                        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Primary}"
                                   Text="{loc:Localize DesignChecksHelp.Intro}"/>

                        <TextBlock Text="{loc:Localize DesignChecksHelp.BendTitle}" FontWeight="Bold" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource Brush.Text.Primary}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Text="{loc:Localize DesignChecksHelp.BendBody}"/>

                        <TextBlock Text="{loc:Localize DesignChecksHelp.SpacingTitle}" FontWeight="Bold" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,4,0,0"/>
                        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Text="{loc:Localize DesignChecksHelp.SpacingBody}"/>

                        <TextBlock Text="{loc:Localize DesignChecksHelp.PinsTitle}" FontWeight="Bold" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,4,0,0"/>
                        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Text="{loc:Localize DesignChecksHelp.PinsBody}"/>

                        <TextBlock Text="{loc:Localize DesignChecksHelp.BlockedTitle}" FontWeight="Bold" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,4,0,0"/>
                        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Text="{loc:Localize DesignChecksHelp.BlockedBody}"/>
                        <ha:BlockedWireHelpAnimation Width="336" Height="96" IsHitTestVisible="False"/>

                        <TextBlock Text="{loc:Localize DesignChecksHelp.ChipletTitle}" FontWeight="Bold" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,4,0,0"/>
                        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Text="{loc:Localize DesignChecksHelp.ChipletBody}"/>
                        <ha:ChipletLinkCouplingAnimation Width="336" Height="88" IsHitTestVisible="False"/>

                        <TextBlock Text="{loc:Localize DesignChecksHelp.SourceTitle}" FontWeight="Bold" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,4,0,0"/>
                        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Text="{loc:Localize DesignChecksHelp.SourceBody}"/>
                    </StackPanel>
                </controls:HelpFlyoutButton.HelpContent>
            </controls:HelpFlyoutButton>
        </Grid>
        <Button x:Name="DesignChecksRunButton"
                Content="{loc:Localize DesignChecks.Run}"
                Command="{Binding RunDesignChecksCommand}"
                HorizontalAlignment="Left" Padding="12,4" Margin="0,5,0,5"
                Background="{DynamicResource Brush.Danger.Subtle}"/>
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding RightPanel.DesignValidation.StatusText}"
                       Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,0,0,5" TextWrapping="Wrap"
                       IsVisible="{Binding RightPanel.DesignValidation.StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <!-- (?) help for crossing findings (#1391): why a plain X junction fails and
                 how a Crossing 4-Port fixes it. Only offered while a waveguide crossing
                 is among the findings. -->
            <controls:HelpFlyoutButton x:Name="CrossingHelpButton" Grid.Column="1"
                                       Title="{loc:Localize DesignChecks.CrossingHelp.Title}"
                                       IsVisible="{Binding RightPanel.DesignValidation.HasWaveguideCrossingIssue}"
                                       VerticalAlignment="Top" Margin="6,0,0,0">
                <controls:HelpFlyoutButton.HelpContent>
                    <help:WaveguideCrossingHelpFlyout/>
                </controls:HelpFlyoutButton.HelpContent>
            </controls:HelpFlyoutButton>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,5,0,5"
                    IsVisible="{Binding RightPanel.DesignValidation.HasIssues}">
            <Button Content="{loc:Localize DesignChecks.Prev}"
                    Command="{Binding RightPanel.DesignValidation.PreviousIssueCommand}"
                    MinWidth="70" Margin="0,0,5,0" Background="{DynamicResource Brush.Surface.Hover}"/>
            <TextBlock Text="{Binding RightPanel.DesignValidation.NavigationText}"
                       Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center"
                       Width="50" TextAlignment="Center"/>
            <Button Content="{loc:Localize DesignChecks.Next}"
                    Command="{Binding RightPanel.DesignValidation.NextIssueCommand}"
                    MinWidth="70" Margin="5,0,0,0" Background="{DynamicResource Brush.Surface.Hover}"/>
            <!-- One-click fix (issue #1248): only offered on chiplet-interface findings. -->
            <Button x:Name="AlignChipletButton"
                    Content="{loc:Localize DesignChecks.AlignChiplet}"
                    Command="{Binding RightPanel.DesignValidation.AlignChipletCommand}"
                    IsVisible="{Binding RightPanel.DesignValidation.IsCurrentIssueAlignable}"
                    Margin="10,0,0,0" Padding="12,4" Background="{DynamicResource Brush.Success.Subtle}"/>
        </StackPanel>
    </StackPanel>

</UserControl>
