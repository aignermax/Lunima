<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CAP.Avalonia.ViewModels.Onboarding.FirstStepsTutorial"
             xmlns:controls="using:CAP.Avalonia.Controls"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             x:Class="CAP.Avalonia.Views.Panels.RunProgramTourPanel"
             x:DataType="vm:RunProgramTourViewModel">

  <!-- "Run a program on your chip" tour card (issue #1267, slice 3 of #769):
       shows the current step and progress. Non-modal: the Logic panel and the
       ISA playground stay fully interactive. Hosted by the anchored overlay in
       MainWindow (build/open steps) and in IsaPlaygroundWindow (playground
       steps) — the engine decides via ShowCardInMainWindow/ShowCardInPlayground. -->
  <Border Classes="overlay" Padding="12" Width="340">
    <StackPanel Spacing="8">

      <!-- Header: progress + close -->
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="ghost icon" Command="{Binding SkipCommand}"
                ToolTip.Tip="{loc:Localize Tutorial.Skip}">
          <controls:Icon Data="{StaticResource Icon.X}"/>
        </Button>
        <TextBlock Classes="label" Text="{Binding ProgressText}"
                   VerticalAlignment="Center"/>
      </DockPanel>

      <!-- Current step -->
      <TextBlock Classes="subtitle" Text="{Binding CurrentTitle}" TextWrapping="Wrap"/>
      <TextBlock Classes="secondary" Text="{Binding CurrentBody}" TextWrapping="Wrap"/>

      <!-- Actions -->
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Classes="ghost" Content="{loc:Localize Tutorial.Skip}"
                Command="{Binding SkipCommand}"/>
        <Button Classes="primary" Content="{loc:Localize Tutorial.Next}"
                Command="{Binding NextCommand}"/>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
