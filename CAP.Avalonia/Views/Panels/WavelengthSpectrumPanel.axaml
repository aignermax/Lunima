<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CAP.Avalonia.ViewModels"
             xmlns:controls="using:CAP.Avalonia.Controls"
             xmlns:oxy="using:OxyPlot.Avalonia"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             xmlns:panels="using:CAP.Avalonia.Views.Panels"
             x:Class="CAP.Avalonia.Views.Panels.WavelengthSpectrumPanel"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <!-- Dark hover-tracker, same values as the Transient / Eye tabs for consistency. -->
        <Style Selector="oxy|TrackerControl">
            <Setter Property="Background" Value="#2a2a2a"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="LineStroke" Value="#A0A0A0"/>
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.analysis">
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </UserControl.Styles>

    <StackPanel Margin="6,4">
        <TextBlock Foreground="Gray" FontSize="9" Margin="0,0,0,4" TextWrapping="Wrap"
                   Text="{loc:Localize Spectrum.Description}"/>

        <!-- Sweep parameters + Run: horizontal, wrapping responsively.
             Changing any value after a first run re-sweeps automatically. -->
        <WrapPanel Orientation="Horizontal">
            <StackPanel Margin="0,0,12,4">
                <TextBlock Text="{loc:Localize Spectrum.StartNm}" Foreground="Gray" FontSize="9" Margin="0,0,0,1"/>
                <NumericUpDown Value="{Binding BottomPanel.Analysis.Spectrum.StartNm}"
                               Minimum="200" Maximum="20000" Increment="10" Width="120" FormatString="F0"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,4">
                <TextBlock Text="{loc:Localize Spectrum.EndNm}" Foreground="Gray" FontSize="9" Margin="0,0,0,1"/>
                <NumericUpDown Value="{Binding BottomPanel.Analysis.Spectrum.EndNm}"
                               Minimum="200" Maximum="20000" Increment="10" Width="120" FormatString="F0"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,4">
                <TextBlock Text="{loc:Localize Spectrum.Steps}" Foreground="Gray" FontSize="9" Margin="0,0,0,1"/>
                <NumericUpDown Value="{Binding BottomPanel.Analysis.Spectrum.StepCount}"
                               Minimum="2" Maximum="500" Increment="10" Width="120" FormatString="F0"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,4" VerticalAlignment="Bottom">
                <TextBlock Text=" " FontSize="9" Margin="0,0,0,1"/>
                <Button Content="{loc:Localize Spectrum.RunButton}" Classes="analysis" Background="#5d3d5d"
                        Command="{Binding BottomPanel.Analysis.Spectrum.RunSweepCommand}"
                        IsEnabled="{Binding BottomPanel.Analysis.Spectrum.IsSweeping, Converter={x:Static BoolConverters.Not}}"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,4" VerticalAlignment="Bottom"
                        IsVisible="{Binding BottomPanel.Analysis.Spectrum.IsSweeping}">
                <TextBlock Text=" " FontSize="9" Margin="0,0,0,1"/>
                <Button Content="{loc:Localize Common.Cancel}" Classes="analysis" Background="#3d3d3d"
                        Command="{Binding BottomPanel.Analysis.Spectrum.CancelSweepCommand}"/>
            </StackPanel>
        </WrapPanel>

        <!-- Coherent interference toggle (#1333): routed waveguides carry their
             propagation phase, so a ΔL between arms shows as fringes. Flipping it
             re-runs the sweep automatically once a first result exists. -->
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
            <CheckBox VerticalAlignment="Center"
                      IsChecked="{Binding BottomPanel.Analysis.Spectrum.IsCoherentInterference}"
                      Content="{loc:Localize Spectrum.CoherentToggle}"/>
            <controls:HelpFlyoutButton VerticalAlignment="Center"
                                       Title="{loc:Localize SpectrumCoherentHelp.Title}">
                <controls:HelpFlyoutButton.HelpContent>
                    <panels:SpectrumCoherentHelpFlyout/>
                </controls:HelpFlyoutButton.HelpContent>
            </controls:HelpFlyoutButton>
        </StackPanel>

        <!-- Measured-spectrum overlay (#1335): load a lab CSV, overlay it on the
             simulated transmission, show extracted FSR / n_g. ΔL only feeds the
             n_g formula, so the input hides until an overlay is loaded. -->
        <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
            <StackPanel Margin="0,0,12,4" VerticalAlignment="Bottom">
                <TextBlock Text=" " FontSize="9" Margin="0,0,0,1"/>
                <Button Content="{loc:Localize Spectrum.Measured.LoadButton}" Classes="analysis" Background="#3d3d3d"
                        Command="{Binding BottomPanel.Analysis.Spectrum.Overlay.LoadMeasuredCommand}"
                        IsEnabled="{Binding BottomPanel.Analysis.Spectrum.Overlay.IsLoading, Converter={x:Static BoolConverters.Not}}"
                        ToolTip.Tip="{loc:Localize Spectrum.Measured.LoadTip}"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,4"
                        IsVisible="{Binding BottomPanel.Analysis.Spectrum.Overlay.HasOverlay}">
                <TextBlock Text="{loc:Localize Spectrum.Measured.ArmImbalance}" Foreground="Gray" FontSize="9" Margin="0,0,0,1"/>
                <NumericUpDown Value="{Binding BottomPanel.Analysis.Spectrum.Overlay.ArmImbalanceUm}"
                               Minimum="0" Maximum="10000" Increment="10" Width="120" FormatString="F0"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,4" VerticalAlignment="Bottom"
                        IsVisible="{Binding BottomPanel.Analysis.Spectrum.Overlay.HasOverlay}">
                <TextBlock Text=" " FontSize="9" Margin="0,0,0,1"/>
                <Button Content="×" Classes="analysis" Background="#3d3d3d" Width="26"
                        Command="{Binding BottomPanel.Analysis.Spectrum.Overlay.ClearMeasuredCommand}"
                        ToolTip.Tip="{loc:Localize Spectrum.Measured.ClearTip}"/>
            </StackPanel>
            <controls:HelpFlyoutButton VerticalAlignment="Bottom" Margin="0,0,0,4"
                                       Title="{loc:Localize Spectrum.Measured.HelpTitle}">
                <controls:HelpFlyoutButton.HelpContent>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#cfe0ff" MaxWidth="380"
                               Text="{loc:Localize Spectrum.Measured.HelpBody}"/>
                </controls:HelpFlyoutButton.HelpContent>
            </controls:HelpFlyoutButton>
        </WrapPanel>

        <!-- Measured-spectrum result line: FSR ± std (+ n_g when ΔL > 0), or "no fringes". -->
        <TextBlock Text="{Binding BottomPanel.Analysis.Spectrum.Overlay.ResultText}"
                   Foreground="#a8d8a8" FontSize="10" Margin="0,2,0,2"
                   IsVisible="{Binding BottomPanel.Analysis.Spectrum.Overlay.ResultText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   TextWrapping="Wrap"/>

        <!-- Inline parse error (line number from the reader), never a modal dialog. -->
        <TextBlock Text="{Binding BottomPanel.Analysis.Spectrum.Overlay.ErrorText}"
                   Foreground="#e08080" FontSize="10" Margin="0,2,0,2"
                   IsVisible="{Binding BottomPanel.Analysis.Spectrum.Overlay.ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   TextWrapping="Wrap"/>

        <!-- Status -->
        <TextBlock Text="{Binding BottomPanel.Analysis.Spectrum.StatusText}"
                   Foreground="Gray" FontSize="9" Margin="0,2,0,2"
                   IsVisible="{Binding BottomPanel.Analysis.Spectrum.StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   TextWrapping="Wrap"/>

        <!-- Transmission spectrum. Plain wheel scrolls the analysis dock;
             Ctrl(/Cmd)+wheel zooms (see ScrollFriendlyPlotController in code-behind). -->
        <Border Background="#1a1a1a" BorderBrush="#3d3d3d" BorderThickness="1"
                Height="200" Margin="0,2,0,0"
                IsVisible="{Binding BottomPanel.Analysis.Spectrum.HasResult}"
                ToolTip.Tip="{loc:Localize Analysis.Chart.ZoomHint}">
            <oxy:PlotView x:Name="SpectrumPlot"
                          Model="{Binding BottomPanel.Analysis.Spectrum.PlotModel}" Background="Transparent"/>
        </Border>
    </StackPanel>

</UserControl>
