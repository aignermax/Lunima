<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CAP.Avalonia.ViewModels.Solvers.ModeProbe"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             xmlns:controls="using:CAP.Avalonia.Controls"
             xmlns:panels="using:CAP.Avalonia.Views.Panels"
             x:Class="CAP.Avalonia.Views.Panels.ModeProbePanel"
             x:DataType="vm:ModeProbeViewModel">

  <!-- Non-modal mode-slice probe flyout (issue #691). Opens at the canvas click
       point; the user keeps full access to the canvas while it is shown. -->
  <Border Background="{DynamicResource Brush.Surface.Hover}" BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1"
          CornerRadius="6" Padding="10" Width="300"
          BoxShadow="0 4 12 0 #99000000">
    <StackPanel Spacing="6">

      <!-- Header -->
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="✕" Padding="4,0"
                Background="Transparent" Foreground="{DynamicResource Brush.Text.Secondary}"
                Command="{Binding CloseCommand}"
                ToolTip.Tip="{loc:Localize ModeProbe.CloseTip}"/>
        <controls:HelpFlyoutButton DockPanel.Dock="Right" Margin="0,0,4,0"
                                   VerticalAlignment="Center"
                                   Title="{loc:Localize ModeProbeHelp.Title}">
          <controls:HelpFlyoutButton.HelpContent>
            <panels:ModeProbeHelpFlyout/>
          </controls:HelpFlyoutButton.HelpContent>
        </controls:HelpFlyoutButton>
        <TextBlock Text="{Binding TargetName}" FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center"/>
      </DockPanel>

      <!-- Interference-region notice (MMI etc.) -->
      <Border Background="{DynamicResource Brush.Warning.Subtle}" BorderBrush="{DynamicResource Brush.Warning}" BorderThickness="1"
              CornerRadius="4" Padding="8"
              IsVisible="{Binding IsInterferenceRegion}">
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Brush.Warning}" FontSize="{DynamicResource FontSize.Caption}"
                   Text="{loc:Localize ModeProbe.InterferenceNotice}"/>
      </Border>

      <!-- Probe inputs + results (hidden for interference regions) -->
      <StackPanel Spacing="6" IsVisible="{Binding !IsInterferenceRegion}">

        <!-- Cross-section provenance -->
        <TextBlock Text="{Binding CrossSectionText}" Foreground="{DynamicResource Brush.Accent.Hover}" FontSize="{DynamicResource FontSize.Caption}"/>
        <Border Background="{DynamicResource Brush.Warning.Subtle}" BorderBrush="{DynamicResource Brush.Warning}" BorderThickness="1"
                CornerRadius="4" Padding="6"
                IsVisible="{Binding IsGeometryAssumed}">
          <StackPanel Spacing="2">
            <TextBlock Text="{loc:Localize ModeProbe.GeometryAssumed}" Foreground="{DynamicResource Brush.Warning}"
                       FontSize="{DynamicResource FontSize.Caption}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding GeometrySourceText}" Foreground="{DynamicResource Brush.Text.Secondary}"
                       FontSize="{DynamicResource FontSize.Caption}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <!-- Wavelength + backend, editable inline -->
        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" Margin="0,2,0,0">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="λ (nm):" Foreground="{DynamicResource Brush.Text.Tertiary}"
                     VerticalAlignment="Center" Margin="0,0,6,0"/>
          <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding WavelengthNm}"
                         Minimum="400" Maximum="20000" Increment="10"
                         FontSize="{DynamicResource FontSize.Caption}" Height="28"/>
          <Button Grid.Row="0" Grid.Column="2" Content="{loc:Localize ModeProbe.Solve}" Margin="6,0,0,0"
                  Command="{Binding SolveCommand}"
                  IsEnabled="{Binding !IsSolving}"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Localize ModeProbe.Backend}" Foreground="{DynamicResource Brush.Text.Tertiary}"
                     VerticalAlignment="Center" Margin="0,4,6,0"/>
          <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0"
                    ItemsSource="{x:Static vm:ModeProbeViewModel.AvailableBackends}"
                    SelectedItem="{Binding SelectedBackend}"
                    FontSize="{DynamicResource FontSize.Caption}" HorizontalAlignment="Stretch"/>
        </Grid>

        <!-- Result block -->
        <StackPanel Spacing="4" IsVisible="{Binding HasResult}">
          <Image Source="{Binding ModeFieldImage}" MaxHeight="140"
                 Stretch="Uniform"
                 IsVisible="{Binding ModeFieldImage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="n_eff:" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,8,0"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding NEff, StringFormat={}{0:F4}}" Foreground="{DynamicResource Brush.Text.Primary}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="n_g:" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,8,0"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NGroup, StringFormat={}{0:F4}}" Foreground="{DynamicResource Brush.Text.Primary}"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Localize ModeProbe.Polarisation}" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,8,0"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Polarisation}" Foreground="{DynamicResource Brush.Text.Primary}"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="MFD:" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,8,0"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MfdText}" Foreground="{DynamicResource Brush.Text.Primary}"/>
          </Grid>

          <!-- Fiber overlap (grating/edge couplers only) -->
          <Border Background="{DynamicResource Brush.Surface.Hover}" BorderBrush="{DynamicResource Brush.Info}" BorderThickness="1"
                  CornerRadius="4" Padding="6"
                  IsVisible="{Binding ShowFiberOverlap}">
            <StackPanel Spacing="3">
              <TextBlock Text="{loc:Localize ModeProbe.FiberOverlap}" Foreground="{DynamicResource Brush.Accent.Hover}"
                         FontSize="{DynamicResource FontSize.Caption}" FontWeight="SemiBold"/>
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Localize ModeProbe.FiberMfd}" Foreground="{DynamicResource Brush.Text.Tertiary}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding FiberMfdUm}"
                               Minimum="1" Maximum="50" Increment="0.1"
                               FormatString="F1" FontSize="{DynamicResource FontSize.Caption}" Height="28"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Localize ModeProbe.Efficiency}" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,4,8,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Foreground="{DynamicResource Brush.Text.Primary}"
                           Text="{Binding OverlapPercent, StringFormat={}{0:F1} %}"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Localize ModeProbe.CouplingLoss}" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,8,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Foreground="{DynamicResource Brush.Text.Primary}"
                           Text="{Binding OverlapLossDb, StringFormat={}{0:F2} dB}"/>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <ProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding IsSolving}"/>
      </StackPanel>

      <!-- Status / errors -->
      <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource FontSize.Caption}"
                 TextWrapping="Wrap"
                 IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    </StackPanel>
  </Border>
</UserControl>
