<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CAP.Avalonia.ViewModels"
             xmlns:controls="using:CAP.Avalonia.Controls"
             xmlns:ha="using:CAP.Avalonia.Controls.HelpAnimations"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             x:Class="CAP.Avalonia.Views.Panels.LengthMatchingPanel"
             x:DataType="vm:MainViewModel">

    <!-- Length Matching: visible only while exactly one waveguide connection is selected.
         Stretches the route to an exact target length via a meander (frozen afterwards),
         or clears the intent and hands the route back to the normal router. -->
    <StackPanel IsVisible="{Binding BottomPanel.LengthMatching.HasExactlyOneConnection}">
        <Border Classes="divider" Margin="0,12,0,8"/>
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="subtitle" Text="{loc:Localize Routing.LengthMatch.Title}" Margin="0,0,0,5" VerticalAlignment="Center"/>
            <!-- Plain-language help: why the geometric length of a waveguide matters
                 (phase accumulation and interference) for non-photonics users. -->
            <controls:HelpFlyoutButton Grid.Column="1"
                                       Title="{loc:Localize Routing.LengthMatch.Help.Title}"
                                       VerticalAlignment="Center">
                <controls:HelpFlyoutButton.HelpContent>
                    <StackPanel Spacing="8" MaxWidth="400">
                        <TextBlock Classes="caption secondary" TextWrapping="Wrap"
                                   Text="{loc:Localize Routing.LengthMatch.Help.Intro}"/>

                        <TextBlock Classes="strong" Text="{loc:Localize Routing.LengthMatch.Help.ArrivalTitle}"/>
                        <TextBlock Classes="secondary" TextWrapping="Wrap"
                                   Text="{loc:Localize Routing.LengthMatch.Help.ArrivalBody}"/>
                        <ha:LengthMatchArrivalAnimation Width="336" Height="96" IsHitTestVisible="False"/>

                        <TextBlock Classes="strong" Text="{loc:Localize Routing.LengthMatch.Help.PhaseTitle}" Margin="0,4,0,0"/>
                        <TextBlock Classes="secondary" TextWrapping="Wrap"
                                   Text="{loc:Localize Routing.LengthMatch.Help.PhaseBody}"/>

                        <TextBlock Classes="strong" Text="{loc:Localize Routing.LengthMatch.Help.MeanderTitle}" Margin="0,4,0,0"/>
                        <TextBlock Classes="secondary" TextWrapping="Wrap"
                                   Text="{loc:Localize Routing.LengthMatch.Help.MeanderBody}"/>
                    </StackPanel>
                </controls:HelpFlyoutButton.HelpContent>
            </controls:HelpFlyoutButton>
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,6">
            <TextBlock Classes="caption" Text="{loc:Localize Routing.LengthMatch.CurrentLength}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding BottomPanel.LengthMatching.CurrentLengthText}" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Classes="caption" Text="{loc:Localize Routing.LengthMatch.TargetLength}" Margin="0,0,0,3"/>
        <TextBox Text="{Binding BottomPanel.LengthMatching.TargetLengthText}"
                 Watermark="{loc:Localize Routing.LengthMatch.TargetWatermark}"
                 Width="180" HorizontalAlignment="Left" Margin="0,0,0,8"/>

        <TextBlock Classes="caption" Text="{loc:Localize Routing.LengthMatch.Tolerance}" Margin="0,0,0,3"/>
        <TextBox Text="{Binding BottomPanel.LengthMatching.ToleranceText}"
                 Width="180" HorizontalAlignment="Left" Margin="0,0,0,8"/>

        <TextBlock Classes="caption" Text="{loc:Localize Routing.LengthMatch.BendRadius}" Margin="0,0,0,3"/>
        <TextBox Text="{Binding BottomPanel.LengthMatching.BendRadiusText}"
                 Width="180" HorizontalAlignment="Left" Margin="0,0,0,8"/>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{loc:Localize Routing.LengthMatch.Apply}"
                    Command="{Binding BottomPanel.LengthMatching.ApplyCommand}"/>
            <Button Content="{loc:Localize Routing.LengthMatch.Clear}"
                    Command="{Binding BottomPanel.LengthMatching.ClearCommand}"
                    IsVisible="{Binding BottomPanel.LengthMatching.HasLengthTarget}"/>
        </StackPanel>

        <!-- Error and success are separate blocks: colored without a converter. -->
        <TextBlock Text="{Binding BottomPanel.LengthMatching.StatusMessage}"
                   Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,6,0,0"
                   IsVisible="{Binding BottomPanel.LengthMatching.HasErrorStatus}"/>
        <TextBlock Text="{Binding BottomPanel.LengthMatching.StatusMessage}"
                   Foreground="{DynamicResource Brush.Success}" TextWrapping="Wrap" Margin="0,6,0,0"
                   IsVisible="{Binding BottomPanel.LengthMatching.HasSuccessStatus}"/>
    </StackPanel>
</UserControl>
