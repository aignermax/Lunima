<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             x:Class="CAP.Avalonia.Views.Panels.LogicTimingHelpFlyout">

    <!-- Timing help of the Logic tab (#1206, #1152 pattern): short sections (text
         budget, all five locales) explaining propagation delay and the critical
         path. The pulse-arrival animation lives in the timeline flyout
         (LogicTimelineHelpFlyout) — one animation for both flyouts, per the issue.
         Hosted as the HelpContent of the critical-path HelpFlyoutButton, which
         supplies the title and the ScrollViewer. -->

    <StackPanel Spacing="8" MaxWidth="400">

        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Primary}"
                   Text="{loc:Localize LogicPanelTimingHelp.Intro}"/>

        <TextBlock Text="{loc:Localize LogicPanelTimingHelp.PhysicsTitle}" FontWeight="Bold" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource Brush.Text.Primary}"/>
        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}"
                   Text="{loc:Localize LogicPanelTimingHelp.PhysicsBody}"/>

        <TextBlock Text="{loc:Localize LogicPanelTimingHelp.ClockTitle}" FontWeight="Bold" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,4,0,0"/>
        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}"
                   Text="{loc:Localize LogicPanelTimingHelp.ClockBody}"/>
    </StackPanel>

</UserControl>
