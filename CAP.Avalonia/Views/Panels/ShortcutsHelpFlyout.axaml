<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             x:Class="CAP.Avalonia.Views.Panels.ShortcutsHelpFlyout">

    <!-- Full keyboard-shortcut reference (#1162): opened from the "?" button in the
         status bar. The status bar itself only shows the hints relevant to the current
         canvas mode; everything else lives here so the bar can never overflow. -->

    <StackPanel MaxWidth="380" Spacing="6">
        <TextBlock Text="{loc:Localize StatusBar.ShortcutModesTitle}"
                   FontWeight="Bold" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource Brush.Text.Primary}"/>
        <TextBlock Text="{loc:Localize StatusBar.ShortcutModesBody}"
                   TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}"/>

        <TextBlock Text="{loc:Localize StatusBar.ShortcutEditingTitle}"
                   FontWeight="Bold" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,4,0,0"/>
        <TextBlock Text="{loc:Localize StatusBar.ShortcutEditingBody}"
                   TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}"/>

        <TextBlock Text="{loc:Localize StatusBar.ShortcutViewTitle}"
                   FontWeight="Bold" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,4,0,0"/>
        <TextBlock Text="{loc:Localize StatusBar.ShortcutViewBody}"
                   TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}"/>
    </StackPanel>

</UserControl>
