<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CAP.Avalonia.ViewModels"
             xmlns:controls="using:CAP.Avalonia.Controls"
             xmlns:panels="using:CAP.Avalonia.Views.Panels"
             xmlns:logicTab="using:CAP.Avalonia.Views.Panels.LogicTab"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             xmlns:logic="using:CAP.Avalonia.ViewModels.Analysis.LogicAnalysis"
             xmlns:bus="using:CAP.Avalonia.ViewModels.Analysis.LogicAnalysis.BusView"
             xmlns:mg="using:CAP.Avalonia.ViewModels.Analysis.LogicAnalysis.MakeGate"
             x:Class="CAP.Avalonia.Views.Panels.LogicPanel"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <Style Selector="Grid.logicColumnHeader">
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <!-- Columns after the first carry a hairline divider on their left edge. -->
        <Style Selector="Border.logicColumn">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1,0,0,0"/>
            <Setter Property="Padding" Value="12,0,0,0"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
        </Style>
        <!-- Keeps the overlay scrollbar off the column content (the bus quick-set field). -->
        <Style Selector="ScrollViewer.logicColumnScroll > :is(Control)">
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </UserControl.Styles>

    <!-- Logic tab of the analysis dock (#1183): the dock is a wide, short strip, so the
         actions sit in one toolbar row and the sections stand side by side as columns,
         each scrolling on its own. Below the summed column minimum the column row
         scrolls horizontally instead of clipping. -->
    <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,Auto" Margin="12,6,12,8">
        <logicTab:LogicTabToolbar Grid.ColumnSpan="2"/>
        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" IsIndeterminate="True" Height="3" Margin="0,4,0,0"
                     IsVisible="{Binding RightPanel.Logic.IsProcessing}"/>

        <ScrollViewer Grid.Row="2" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding RightPanel.Logic.HasNetwork, Converter={x:Static BoolConverters.Not}}">
            <Border Classes="empty-state" Padding="12">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <controls:Icon Data="{StaticResource Icon.Binary}" Size="24" Foreground="{DynamicResource Brush.Text.Tertiary}" HorizontalAlignment="Center"/>
                    <TextBlock Classes="secondary" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                               Text="{loc:Localize LogicPanel.Empty}"/>
                    <!-- Groups that are not gates yet: one click back to the Make-gate steps. -->
                    <StackPanel Spacing="4" IsVisible="{Binding RightPanel.Logic.HasGateCandidates}" HorizontalAlignment="Center">
                        <TextBlock Classes="caption" TextAlignment="Center" Text="{loc:Localize LogicPanel.GateCandidates}"/>
                        <ItemsControl x:Name="LogicGateCandidates" ItemsSource="{Binding RightPanel.Logic.GateCandidates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="mg:LogicGateCandidateViewModel">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}" MaxWidth="220"/>
                                        <Button Grid.Column="1" Classes="ghost" Margin="8,0,0,0"
                                                Content="{loc:Localize MakeGate.Open}"
                                                Command="{Binding MakeGateCommand}"
                                                ToolTip.Tip="{loc:Localize LogicPanel.MakeGateTip}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Columns: inputs | outputs + registers | timeline | waveforms. -->
        <ScrollViewer Grid.Row="2" Margin="0,6,0,0"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      IsVisible="{Binding RightPanel.Logic.HasNetwork}">
            <Grid x:Name="LogicColumns">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="130" MaxWidth="260"/>
                    <ColumnDefinition Width="Auto" MinWidth="180" MaxWidth="340"/>
                    <ColumnDefinition Width="Auto" MinWidth="230" MaxWidth="380"/>
                    <ColumnDefinition Width="*" MinWidth="180"/>
                </Grid.ColumnDefinitions>

                <Grid RowDefinitions="Auto,*">
                    <Grid Classes="logicColumnHeader">
                        <TextBlock Classes="label" Text="{loc:Localize LogicPanel.Inputs}" VerticalAlignment="Center"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" Classes="logicColumnScroll" VerticalScrollBarVisibility="Auto">
                        <!-- Bus view (#1068): indexed families (A0–A3) collapse into a bus header
                             with an editable quick-set field; plain names keep their toggle. -->
                        <ItemsControl x:Name="LogicInputRows" ItemsSource="{Binding RightPanel.Logic.InputRows}">
                            <ItemsControl.DataTemplates>
                                <DataTemplate x:DataType="logic:LogicNetworkInputViewModel">
                                    <CheckBox Content="{Binding PinName}" IsChecked="{Binding IsOn}"
                                              Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,1"/>
                                </DataTemplate>
                                <DataTemplate x:DataType="bus:LogicSignalBusInputViewModel">
                                    <StackPanel Margin="0,1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Classes="mono" Text="{Binding HeaderText}" FontSize="{DynamicResource FontSize.Caption}"
                                                       Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding ValueText}" Width="56" Margin="8,0,0,0"
                                                     FontSize="{DynamicResource FontSize.Caption}" Padding="4,1"
                                                     VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Members}" Margin="14,0,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="logic:LogicNetworkInputViewModel">
                                                    <CheckBox Content="{Binding PinName}" IsChecked="{Binding IsOn}"
                                                              Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,1"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.DataTemplates>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Column="1" Classes="logicColumn">
                    <logicTab:LogicOutputsColumn/>
                </Border>

                <Border Grid.Column="2" Classes="logicColumn">
                    <logicTab:LogicTimelineColumn/>
                </Border>

                <!-- Waveform strip (#1129): per-signal 0/1 lanes of the same timeline, a
                     vertical line per clock boundary, a cursor at the replayed instant. -->
                <Border Grid.Column="3" Classes="logicColumn">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Classes="logicColumnHeader">
                            <TextBlock Classes="label" Text="{loc:Localize LogicPanel.Waveforms}" VerticalAlignment="Center"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" Classes="logicColumnScroll" VerticalScrollBarVisibility="Auto">
                            <Border Background="{DynamicResource Brush.Surface.Input}" CornerRadius="{DynamicResource Radius.S}"
                                    VerticalAlignment="Top"
                                    IsVisible="{Binding RightPanel.Logic.HasWaveform}">
                                <controls:LogicWaveformStrip Waveform="{Binding RightPanel.Logic.Waveform}"/>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </Border>

            </Grid>
        </ScrollViewer>

        <!-- Fan-out warnings sit outside the sideways-scrolling columns so they stay in
             view on a narrow dock, and show whenever warnings exist. -->
        <Border Grid.Row="2" Grid.Column="1" Classes="logicColumn" Width="320" Margin="12,6,0,0"
                IsVisible="{Binding RightPanel.Logic.HasFanOutWarnings}">
            <logicTab:LogicFanOutColumn/>
        </Border>
    </Grid>

</UserControl>
