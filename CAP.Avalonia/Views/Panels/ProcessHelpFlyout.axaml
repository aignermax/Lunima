<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             xmlns:ha="using:CAP.Avalonia.Controls.HelpAnimations"
             x:Class="CAP.Avalonia.Views.Panels.ProcessHelpFlyout">

    <!-- Plain-language explainer for the process-management window: short sections
         (#1152 text budget, all five locales) plus the looping LayerStackAnimation
         (the chip is built layer by layer). Hosted as the HelpContent of the
         window's HelpFlyoutButton, which supplies the title and the ScrollViewer. -->

    <StackPanel Spacing="8">

        <TextBlock Text="{loc:Localize ProcessManagement.WhatIsProcess}" FontWeight="Bold" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource Brush.Text.Primary}"/>
        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}"
                   Text="{loc:Localize ProcessManagement.HelpIntro}"/>

        <!-- Fabrication layer-stack animation (cross-section, builds bottom→top). -->
        <Border Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1"
                CornerRadius="4" Padding="4">
            <Canvas Width="360" Height="112">
                <TextBlock Canvas.Left="2" Canvas.Top="2" Text="{loc:Localize ProcessManagement.ChipBuiltLayers}"
                           FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                <ha:LayerStackAnimation Width="360" Height="112" IsHitTestVisible="False"
                                        LoopDuration="0:0:5"/>
                <TextBlock Canvas.Left="306" Canvas.Top="84" Text="{loc:Localize ProcessManagement.LayerSubstrate}" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                <TextBlock Canvas.Left="306" Canvas.Top="70" Text="{loc:Localize ProcessManagement.LayerCore}" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Success}"/>
                <TextBlock Canvas.Left="306" Canvas.Top="56" Text="{loc:Localize ProcessManagement.LayerCladding}" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Accent.Hover}"/>
                <TextBlock Canvas.Left="306" Canvas.Top="42" Text="{loc:Localize ProcessManagement.LayerMetal}" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Warning}"/>
            </Canvas>
        </Border>

        <TextBlock Text="{loc:Localize ProcessManagement.LayersHeading}" FontWeight="Bold" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,4,0,0"/>
        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}"
                   Text="{loc:Localize ProcessManagement.HelpLayersBody}"/>

        <TextBlock Text="{loc:Localize ProcessManagement.CrossSectionsHeading}" FontWeight="Bold" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,4,0,0"/>
        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}"
                   Text="{loc:Localize ProcessManagement.HelpCrossSectionsBody}"/>

        <TextBlock Text="{loc:Localize ProcessManagement.Materials}" FontWeight="Bold" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,4,0,0"/>
        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}"
                   Text="{loc:Localize ProcessManagement.HelpMaterialsBody}"/>

        <TextBlock Text="{loc:Localize ProcessManagement.ElectricalRoutingHeading}" FontWeight="Bold" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,4,0,0"/>
        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}"
                   Text="{loc:Localize ProcessManagement.HelpElectricalBody}"/>

    </StackPanel>

</UserControl>
