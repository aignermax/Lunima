<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             xmlns:ha="using:CAP.Avalonia.Controls.HelpAnimations"
             x:Class="CAP.Avalonia.Views.Panels.LogicFanOutHelpFlyout">

    <!-- Fan-out help of the Logic tab (#1216, #1152 pattern): short sections (text
         budget, all five locales) plus one looping power-splitting diagram — one bright
         pulse leaves a gate, a 1×2 splitter halves it (½ brightness), a second split
         quarters it (¼ brightness); each receiving gate's meter fills against a dashed
         threshold and its badge flips to "1" (½ stays above) or "?" (¼ falls below — the
         bit is lost). The pulses are the LightPulseAlongPath primitive; splitter dots,
         meters, threshold lines, and badges are the bespoke PowerSplittingAnimation
         overlay. Hosted as the HelpContent of the fan-out warning's HelpFlyoutButton,
         which supplies the title and the ScrollViewer. -->

    <StackPanel Spacing="8" MaxWidth="400">

        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#cfe0ff"
                   Text="{loc:Localize LogicPanelFanOutHelp.Intro}"/>

        <!-- splitting divides power: brightness ∝ power; below the dashed threshold
             the receiving gate loses the bit. -->
        <Border Background="#151515" BorderBrush="#3d3d3d" BorderThickness="1"
                CornerRadius="4" Padding="4">
            <StackPanel Spacing="2">
                <Canvas Width="368" Height="122">
                    <!-- Declared first so tracks and pulses slide *under* the gate boxes.
                         Brightness ∝ power: full → ½ (one split) → ¼ (two splits). -->
                    <ha:LightPulseAlongPath Width="368" Height="122" PathPoints="56,65 104,65"
                                            PulseBrush="#FFF176" PulseDiameter="10"
                                            WindowStart="0" WindowEnd="0.18" IsHitTestVisible="False"/>
                    <ha:LightPulseAlongPath Width="368" Height="122" PathPoints="104,65 186,26"
                                            PulseBrush="#A0FFF176" PulseDiameter="8"
                                            WindowStart="0.18" WindowEnd="0.42" IsHitTestVisible="False"/>
                    <ha:LightPulseAlongPath Width="368" Height="122" PathPoints="104,65 150,92"
                                            PulseBrush="#A0FFF176" PulseDiameter="8"
                                            WindowStart="0.18" WindowEnd="0.36" IsHitTestVisible="False"/>
                    <ha:LightPulseAlongPath Width="368" Height="122" PathPoints="150,92 186,65"
                                            PulseBrush="#66FFF176" PulseDiameter="6"
                                            WindowStart="0.36" WindowEnd="0.58" IsHitTestVisible="False"/>
                    <ha:LightPulseAlongPath Width="368" Height="122" PathPoints="150,92 186,104"
                                            PulseBrush="#66FFF176" PulseDiameter="6"
                                            WindowStart="0.36" WindowEnd="0.58" IsHitTestVisible="False"/>
                    <!-- the driving gate and the three receiving gates -->
                    <Border Canvas.Left="12" Canvas.Top="51" Width="40" Height="28"
                            Background="#2a2a3d" BorderBrush="#5d5d8d" BorderThickness="1" CornerRadius="4"/>
                    <Border Canvas.Left="196" Canvas.Top="12" Width="40" Height="28"
                            Background="#2a2a3d" BorderBrush="#5d5d8d" BorderThickness="1" CornerRadius="4"/>
                    <Border Canvas.Left="196" Canvas.Top="51" Width="40" Height="28"
                            Background="#2a2a3d" BorderBrush="#5d5d8d" BorderThickness="1" CornerRadius="4"/>
                    <Border Canvas.Left="196" Canvas.Top="90" Width="40" Height="28"
                            Background="#2a2a3d" BorderBrush="#5d5d8d" BorderThickness="1" CornerRadius="4"/>
                    <!-- splitter dots, power meters, threshold lines, and badges -->
                    <ha:PowerSplittingAnimation Width="368" Height="122" IsHitTestVisible="False"/>
                </Canvas>
                <TextBlock Text="{loc:Localize LogicPanelFanOutHelp.AnimationCaption}"
                           Foreground="Gray" FontSize="9" TextWrapping="Wrap" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <TextBlock Text="{loc:Localize LogicPanelFanOutHelp.PhysicsTitle}" FontWeight="Bold" FontSize="12" Foreground="White"/>
        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="LightGray"
                   Text="{loc:Localize LogicPanelFanOutHelp.PhysicsBody}"/>

        <TextBlock Text="{loc:Localize LogicPanelFanOutHelp.ExamplesTitle}" FontWeight="Bold" FontSize="12" Foreground="White" Margin="0,4,0,0"/>
        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="LightGray"
                   Text="{loc:Localize LogicPanelFanOutHelp.ExamplesBody}"/>
    </StackPanel>

</UserControl>
