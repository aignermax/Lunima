<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CAP.Avalonia.ViewModels"
             xmlns:panels="using:CAP.Avalonia.Views.Panels"
             xmlns:controls="using:CAP.Avalonia.Controls"
             xmlns:behaviors="using:CAP.Avalonia.Behaviors"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             x:Class="CAP.Avalonia.Views.Panels.AnalysisDockPanel"
             x:DataType="vm:MainViewModel">

    <!-- Analysis dock (collapsible, above the Error Console): the whole-design analyses,
         sweeps, checks, netlist and logic tabs. -->
    <Border Classes="dockFrame">
        <StackPanel>
            <!-- Resize grip on the top edge: drag to change the dock height. -->
            <Border x:Name="ResizeGrip" Classes="resizeGrip"
                    IsVisible="{Binding BottomPanel.Analysis.IsVisible}"
                    ToolTip.Tip="{loc:Localize AnalysisDock.ResizeTip}"
                    PointerPressed="ResizeGrip_PointerPressed"
                    PointerMoved="ResizeGrip_PointerMoved"
                    PointerReleased="ResizeGrip_PointerReleased"/>

            <DockPanel Classes="dockHeader">
                <!-- What an S-matrix is and why light splits/recombines as it propagates. -->
                <controls:HelpFlyoutButton DockPanel.Dock="Right"
                                           Title="{loc:Localize SMatrixHelp.Title}"
                                           Margin="0,0,8,0" VerticalAlignment="Center">
                    <controls:HelpFlyoutButton.HelpContent>
                        <StackPanel Spacing="8" MaxWidth="400">
                            <StackPanel.Styles>
                                <!-- Animated coupler: input pulse, split, then recombine. -->
                                <Style Selector="Ellipse.pulse">
                                    <Style.Animations>
                                        <Animation Duration="0:0:2.5" IterationCount="INFINITE">
                                            <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                                            <KeyFrame Cue="15%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                                            <KeyFrame Cue="85%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                                            <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                            </StackPanel.Styles>

                            <TextBlock Classes="secondary" TextWrapping="Wrap"
                                       Text="{loc:Localize SMatrixHelp.Intro}"/>

                            <Border Background="{DynamicResource Brush.Surface.Canvas}"
                                    BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.M}" Padding="4">
                                <Canvas Width="360" Height="80">
                                    <Path Data="M 20,40 L 120,40 C 150,40 150,20 180,20 L 340,20"
                                          Stroke="{DynamicResource Brush.Info}" StrokeThickness="4"/>
                                    <Path Data="M 20,40 L 120,40 C 150,40 150,60 180,60 L 340,60"
                                          Stroke="{DynamicResource Brush.Info}" StrokeThickness="4"/>
                                    <Ellipse Classes="pulse" Canvas.Left="36" Canvas.Top="32"
                                             Width="16" Height="16" Fill="{DynamicResource Brush.Warning}"/>
                                    <Ellipse Classes="pulse" Canvas.Left="148" Canvas.Top="12"
                                             Width="16" Height="16" Fill="{DynamicResource Brush.Success}"/>
                                    <Ellipse Classes="pulse" Canvas.Left="148" Canvas.Top="52"
                                             Width="16" Height="16" Fill="{DynamicResource Brush.Success}"/>
                                    <Ellipse Classes="pulse" Canvas.Left="300" Canvas.Top="12"
                                             Width="16" Height="16" Fill="{DynamicResource Brush.Danger}"/>
                                    <Ellipse Classes="pulse" Canvas.Left="300" Canvas.Top="52"
                                             Width="16" Height="16" Fill="{DynamicResource Brush.Danger}"/>
                                    <TextBlock Classes="caption" Canvas.Left="8" Canvas.Top="62"
                                               Text="{loc:Localize SMatrixHelp.DiagramInput}"/>
                                    <TextBlock Classes="caption" Canvas.Left="292" Canvas.Top="62"
                                               Text="{loc:Localize SMatrixHelp.DiagramOutput}"/>
                                </Canvas>
                            </Border>

                            <TextBlock Classes="strong" Text="{loc:Localize SMatrixHelp.WhatIsTitle}"/>
                            <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{loc:Localize SMatrixHelp.WhatIsBody}"/>

                            <TextBlock Classes="strong" Margin="0,4,0,0" Text="{loc:Localize SMatrixHelp.SplitRecombineTitle}"/>
                            <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{loc:Localize SMatrixHelp.SplitRecombineBody}"/>

                            <TextBlock Classes="strong" Margin="0,4,0,0" Text="{loc:Localize SMatrixHelp.RunTitle}"/>
                            <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{loc:Localize SMatrixHelp.RunBody}"/>
                        </StackPanel>
                    </controls:HelpFlyoutButton.HelpContent>
                </controls:HelpFlyoutButton>

                <Button Classes="dockToggle"
                        Command="{Binding BottomPanel.Analysis.ToggleCommand}"
                        ToolTip.Tip="{loc:Localize AnalysisDock.ToggleTip}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:Icon Classes="chevron" Data="{StaticResource Icon.ChevronRight}"
                                       Classes.open="{Binding BottomPanel.Analysis.IsVisible}"/>
                        <controls:Icon Data="{StaticResource Icon.ChartLine}"/>
                        <TextBlock Classes="dockTitle" Text="{loc:Localize AnalysisDock.Title}"/>
                    </StackPanel>
                </Button>
            </DockPanel>

            <Border Classes="dockBody" IsVisible="{Binding BottomPanel.Analysis.IsVisible}"
                    behaviors:RevealOnShowBehavior.IsEnabled="True" behaviors:RevealOnShowBehavior.FromY="8">
                <StackPanel>
                    <!-- Shared analysis output: every tab evaluates THIS coupler. -->
                    <Border Classes="dockToolbar">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:Icon Data="{StaticResource Icon.Target}" Size="14"
                                           Foreground="{DynamicResource Brush.Text.Tertiary}"
                                           VerticalAlignment="Center"/>
                            <TextBlock Classes="caption" VerticalAlignment="Center"
                                       Text="{loc:Localize AnalysisDock.OutputLabel}"/>
                            <TextBlock Classes="strong" VerticalAlignment="Center"
                                       Text="{Binding BottomPanel.Analysis.Output.OutputDisplayName}"/>
                            <Button Classes="compact"
                                    Command="{Binding BottomPanel.Analysis.Output.PickCommand}"
                                    ToolTip.Tip="{loc:Localize AnalysisDock.PickOutputTip}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:Icon Data="{StaticResource Icon.Crosshair}" Size="12"/>
                                    <TextBlock Text="{loc:Localize AnalysisDock.PickOutput}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="compact ghost"
                                    Content="{loc:Localize AnalysisDock.ClearOutput}"
                                    Command="{Binding BottomPanel.Analysis.Output.ClearCommand}"
                                    IsVisible="{Binding BottomPanel.Analysis.Output.HasOutput}"
                                    ToolTip.Tip="{loc:Localize AnalysisDock.ClearOutputTip}"/>
                        </StackPanel>
                    </Border>

                    <!-- Content height is user-adjustable via the grip. -->
                    <TabControl Classes="dockTabs"
                                Height="{Binding BottomPanel.Analysis.DockHeight}"
                                SelectedIndex="{Binding BottomPanel.Analysis.SelectedTabIndex}">
                        <TabItem Header="{loc:Localize AnalysisDock.TabTransient}">
                            <ScrollViewer Classes="tabPage">
                                <StackPanel>
                                <panels:TimeDomainPanel/>
                                <Border Classes="empty-state" VerticalAlignment="Top"
                                        IsVisible="{Binding !BottomPanel.Analysis.Transient.HasResult}">
                                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                                        <controls:Icon Data="{StaticResource Icon.ChartLine}" Size="24"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                                        <TextBlock Classes="secondary" HorizontalAlignment="Center"
                                                   Text="{loc:Localize AnalysisDock.EmptyState}"/>
                                    </StackPanel>
                                </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="{loc:Localize AnalysisDock.TabEyeBer}">
                            <ScrollViewer Classes="tabPage">
                                <StackPanel>
                                <panels:EyeDiagramPanel/>
                                <Border Classes="empty-state" VerticalAlignment="Top"
                                        IsVisible="{Binding !BottomPanel.Analysis.Eye.HasResult}">
                                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                                        <controls:Icon Data="{StaticResource Icon.ChartLine}" Size="24"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                                        <TextBlock Classes="secondary" HorizontalAlignment="Center"
                                                   Text="{loc:Localize AnalysisDock.EmptyState}"/>
                                    </StackPanel>
                                </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="{loc:Localize AnalysisDock.TabSpectrum}">
                            <ScrollViewer Classes="tabPage">
                                <StackPanel>
                                <panels:WavelengthSpectrumPanel/>
                                <Border Classes="empty-state" VerticalAlignment="Top"
                                        IsVisible="{Binding !BottomPanel.Analysis.Spectrum.HasResult}">
                                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                                        <controls:Icon Data="{StaticResource Icon.ChartLine}" Size="24"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                                        <TextBlock Classes="secondary" HorizontalAlignment="Center"
                                                   Text="{loc:Localize AnalysisDock.EmptyState}"/>
                                    </StackPanel>
                                </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="{loc:Localize AnalysisDock.TabMonteCarlo}">
                            <ScrollViewer Classes="tabPage">
                                <StackPanel>
                                <panels:MonteCarloPanel/>
                                <Border Classes="empty-state" VerticalAlignment="Top"
                                        IsVisible="{Binding !BottomPanel.Analysis.MonteCarlo.HasResult}">
                                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                                        <controls:Icon Data="{StaticResource Icon.ChartLine}" Size="24"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                                        <TextBlock Classes="secondary" HorizontalAlignment="Center"
                                                   Text="{loc:Localize AnalysisDock.EmptyState}"/>
                                    </StackPanel>
                                </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="{loc:Localize AnalysisDock.TabOptimization}">
                            <ScrollViewer Classes="tabPage">
                                <panels:CircuitOptimizationPanel/>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="{loc:Localize AnalysisDock.TabSweep}">
                            <ScrollViewer Classes="tabPage">
                                <panels:ParameterSweepPanel/>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="{loc:Localize AnalysisDock.TabChecks}">
                            <ScrollViewer Classes="tabPage">
                                <panels:DesignChecksPanel/>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="{loc:Localize AnalysisDock.TabNetlist}">
                            <ScrollViewer Classes="tabPage">
                                <panels:NetlistPanel/>
                            </ScrollViewer>
                        </TabItem>
                        <!-- Logic: whole-design build, toggle, step/run clock, timeline. -->
                        <TabItem Header="{loc:Localize AnalysisDock.TabLogic}">
                            <ScrollViewer Classes="tabPage">
                                <panels:LogicPanel/>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>

</UserControl>
