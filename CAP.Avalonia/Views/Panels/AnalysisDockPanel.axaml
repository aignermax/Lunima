<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CAP.Avalonia.ViewModels"
             xmlns:panels="using:CAP.Avalonia.Views.Panels"
             xmlns:controls="using:CAP.Avalonia.Controls"
             xmlns:behaviors="using:CAP.Avalonia.Behaviors"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             xmlns:ws="using:CAP.Avalonia.ViewModels.Workspaces"
             x:Class="CAP.Avalonia.Views.Panels.AnalysisDockPanel"
             x:DataType="vm:MainViewModel">

    <!-- Analysis dock (collapsible, above the Error Console): the whole-design analyses,
         sweeps, checks and logic tabs. -->
    <Border Classes="dockFrame">
        <StackPanel>
            <!-- Resize grip on the top edge: drag to change the dock height. -->
            <Border x:Name="ResizeGrip" Classes="resizeGrip"
                    IsVisible="{Binding BottomPanel.Analysis.IsVisible}"
                    ToolTip.Tip="{loc:Localize AnalysisDock.ResizeTip}"
                    PointerPressed="ResizeGrip_PointerPressed"
                    PointerMoved="ResizeGrip_PointerMoved"
                    PointerReleased="ResizeGrip_PointerReleased"/>

            <DockPanel Classes="dockHeader">
                <!-- Overflow: the workspace shows only its tabs; experts can show every tab. -->
                <Button x:Name="DockOverflowButton" DockPanel.Dock="Right" Classes="ghost icon"
                        Margin="0,0,4,0" VerticalAlignment="Center"
                        ToolTip.Tip="{loc:Localize AnalysisDock.MoreTip}">
                    <controls:Icon Data="{StaticResource Icon.Ellipsis}"/>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Classes="menu" MinWidth="220">
                                <CheckBox x:Name="ShowAllTabsCheckBox"
                                          IsChecked="{Binding BottomPanel.Analysis.ShowAllTabs}"
                                          Content="{loc:Localize AnalysisDock.ShowAllTabs}"
                                          ToolTip.Tip="{loc:Localize AnalysisDock.ShowAllTabsTip}"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <!-- What an S-matrix is and why light splits/recombines as it propagates. -->
                <controls:HelpFlyoutButton DockPanel.Dock="Right"
                                           Title="{loc:Localize SMatrixHelp.Title}"
                                           Margin="0,0,8,0" VerticalAlignment="Center">
                    <controls:HelpFlyoutButton.HelpContent>
                        <StackPanel Spacing="8" MaxWidth="400">
                            <StackPanel.Styles>
                                <!-- Animated coupler: input pulse, split, then recombine. -->
                                <Style Selector="Ellipse.pulse">
                                    <Style.Animations>
                                        <Animation Duration="0:0:2.5" IterationCount="INFINITE">
                                            <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                                            <KeyFrame Cue="15%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                                            <KeyFrame Cue="85%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                                            <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                            </StackPanel.Styles>

                            <TextBlock Classes="secondary" TextWrapping="Wrap"
                                       Text="{loc:Localize SMatrixHelp.Intro}"/>

                            <Border Background="{DynamicResource Brush.Surface.Canvas}"
                                    BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.M}" Padding="4">
                                <Canvas Width="360" Height="80">
                                    <Path Data="M 20,40 L 120,40 C 150,40 150,20 180,20 L 340,20"
                                          Stroke="{DynamicResource Brush.Info}" StrokeThickness="4"/>
                                    <Path Data="M 20,40 L 120,40 C 150,40 150,60 180,60 L 340,60"
                                          Stroke="{DynamicResource Brush.Info}" StrokeThickness="4"/>
                                    <Ellipse Classes="pulse" Canvas.Left="36" Canvas.Top="32"
                                             Width="16" Height="16" Fill="{DynamicResource Brush.Warning}"/>
                                    <Ellipse Classes="pulse" Canvas.Left="148" Canvas.Top="12"
                                             Width="16" Height="16" Fill="{DynamicResource Brush.Success}"/>
                                    <Ellipse Classes="pulse" Canvas.Left="148" Canvas.Top="52"
                                             Width="16" Height="16" Fill="{DynamicResource Brush.Success}"/>
                                    <Ellipse Classes="pulse" Canvas.Left="300" Canvas.Top="12"
                                             Width="16" Height="16" Fill="{DynamicResource Brush.Danger}"/>
                                    <Ellipse Classes="pulse" Canvas.Left="300" Canvas.Top="52"
                                             Width="16" Height="16" Fill="{DynamicResource Brush.Danger}"/>
                                    <TextBlock Classes="caption" Canvas.Left="8" Canvas.Top="62"
                                               Text="{loc:Localize SMatrixHelp.DiagramInput}"/>
                                    <TextBlock Classes="caption" Canvas.Left="292" Canvas.Top="62"
                                               Text="{loc:Localize SMatrixHelp.DiagramOutput}"/>
                                </Canvas>
                            </Border>

                            <TextBlock Classes="strong" Text="{loc:Localize SMatrixHelp.WhatIsTitle}"/>
                            <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{loc:Localize SMatrixHelp.WhatIsBody}"/>

                            <TextBlock Classes="strong" Margin="0,4,0,0" Text="{loc:Localize SMatrixHelp.SplitRecombineTitle}"/>
                            <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{loc:Localize SMatrixHelp.SplitRecombineBody}"/>

                            <TextBlock Classes="strong" Margin="0,4,0,0" Text="{loc:Localize SMatrixHelp.RunTitle}"/>
                            <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{loc:Localize SMatrixHelp.RunBody}"/>
                        </StackPanel>
                    </controls:HelpFlyoutButton.HelpContent>
                </controls:HelpFlyoutButton>

                <Button Classes="dockToggle"
                        Command="{Binding BottomPanel.Analysis.ToggleCommand}"
                        ToolTip.Tip="{loc:Localize AnalysisDock.ToggleTip}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:Icon Classes="chevron" Data="{StaticResource Icon.ChevronRight}"
                                       Classes.open="{Binding BottomPanel.Analysis.IsVisible}"/>
                        <controls:Icon Data="{StaticResource Icon.ChartLine}"/>
                        <TextBlock Classes="dockTitle" Text="{loc:Localize AnalysisDock.Title}"/>
                    </StackPanel>
                </Button>
            </DockPanel>

            <Border Classes="dockBody" IsVisible="{Binding BottomPanel.Analysis.IsVisible}"
                    behaviors:RevealOnShowBehavior.IsEnabled="True" behaviors:RevealOnShowBehavior.FromY="8">
                <StackPanel>
                    <!-- Shared analysis output: every tab evaluates THIS coupler. Only where
                         optical tabs are shown (Optics/System workspaces or "show all tabs"). -->
                    <Border Classes="dockToolbar">
                        <Border.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                <Binding Path="WorkspaceSwitch.IsOpticalWorkspace"/>
                                <Binding Path="BottomPanel.Analysis.ShowAllTabs"/>
                            </MultiBinding>
                        </Border.IsVisible>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:Icon Data="{StaticResource Icon.Target}" Size="14"
                                           Foreground="{DynamicResource Brush.Text.Tertiary}"
                                           VerticalAlignment="Center"/>
                            <TextBlock Classes="caption" VerticalAlignment="Center"
                                       Text="{loc:Localize AnalysisDock.OutputLabel}"/>
                            <TextBlock Classes="strong" VerticalAlignment="Center"
                                       Text="{Binding BottomPanel.Analysis.Output.OutputDisplayName}"/>
                            <Button Classes="compact"
                                    Command="{Binding BottomPanel.Analysis.Output.PickCommand}"
                                    ToolTip.Tip="{loc:Localize AnalysisDock.PickOutputTip}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:Icon Data="{StaticResource Icon.Crosshair}" Size="12"/>
                                    <TextBlock Text="{loc:Localize AnalysisDock.PickOutput}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="compact ghost"
                                    Content="{loc:Localize AnalysisDock.ClearOutput}"
                                    Command="{Binding BottomPanel.Analysis.Output.ClearCommand}"
                                    IsVisible="{Binding BottomPanel.Analysis.Output.HasOutput}"
                                    ToolTip.Tip="{loc:Localize AnalysisDock.ClearOutputTip}"/>
                        </StackPanel>
                    </Border>

                    <!-- System workspace: the chiplets and their cross-chiplet links. -->
                    <Border x:Name="SystemOverviewStrip" Classes="dockToolbar"
                            IsVisible="{Binding WorkspaceSwitch.IsSystem}">
                        <WrapPanel Orientation="Horizontal">
                            <controls:Icon Data="{StaticResource Icon.Boxes}" Size="14" Margin="0,0,8,0"
                                           Foreground="{DynamicResource Brush.Text.Tertiary}"
                                           VerticalAlignment="Center"/>
                            <TextBlock Classes="caption" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Text="{loc:Localize Workspace.System.Chiplets}"
                                       IsVisible="{Binding SystemOverview.HasChiplets}"/>
                            <ItemsControl ItemsSource="{Binding SystemOverview.Chiplets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="ws:ChipletSummaryRow">
                                        <Border Classes="chip info">
                                            <TextBlock>
                                                <Run Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding ProcessName}"/>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="caption" VerticalAlignment="Center" Margin="16,0,8,0"
                                       Text="{loc:Localize Workspace.System.Links}"
                                       IsVisible="{Binding SystemOverview.HasLinks}"/>
                            <ItemsControl ItemsSource="{Binding SystemOverview.Links}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="ws:ChipletLinkRow">
                                        <Border Classes="chip success" Classes.warning="{Binding IsOverBudget}">
                                            <TextBlock>
                                                <Run Text="{Binding Label}"/>
                                                <Run Text="  "/>
                                                <Run Text="{Binding LossText}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="{loc:Localize Workspace.System.NoChiplets}"
                                       IsVisible="{Binding !SystemOverview.HasChiplets}"/>
                        </WrapPanel>
                    </Border>

                    <!-- Content height is user-adjustable via the grip. -->
                    <TabControl Classes="dockTabs"
                                Height="{Binding BottomPanel.Analysis.DockHeight}"
                                SelectedIndex="{Binding BottomPanel.Analysis.SelectedTabIndex}">
                        <TabItem Header="{loc:Localize AnalysisDock.TabTransient}"
                                 IsVisible="{Binding BottomPanel.Analysis.Tabs.Transient}">
                            <ScrollViewer Classes="tabPage">
                                <StackPanel>
                                <!-- Why the tab is empty and the one-click fix, above the settings. -->
                                <StackPanel IsVisible="{Binding !BottomPanel.Analysis.Transient.HasResult}">
                                    <controls:EmptyStateHint IsVisible="{Binding BottomPanel.Analysis.Readiness.NeedsLightSource}"
                                                             IconData="{StaticResource Icon.Lightbulb}"
                                                             Message="{loc:Localize Readiness.NoLightSource}"
                                                             ActionText="{loc:Localize Readiness.PlaceLightSource}"
                                                             ActionIconData="{StaticResource Icon.Plus}"
                                                             ActionCommand="{Binding BottomPanel.Analysis.Readiness.PlaceLightSourceCommand}"/>
                                    <controls:EmptyStateHint IsVisible="{Binding BottomPanel.Analysis.Readiness.NeedsOutputPick}"
                                                             IconData="{StaticResource Icon.Target}"
                                                             Message="{loc:Localize Readiness.NoOutputPicked}"
                                                             ActionText="{loc:Localize AnalysisDock.PickOutput}"
                                                             ActionIconData="{StaticResource Icon.Crosshair}"
                                                             ActionCommand="{Binding BottomPanel.Analysis.Readiness.PickOutputCommand}"/>
                                </StackPanel>
                                <panels:TimeDomainPanel/>
                                <StackPanel IsVisible="{Binding !BottomPanel.Analysis.Transient.HasResult}">
                                    <controls:EmptyStateHint IsVisible="{Binding BottomPanel.Analysis.Readiness.IsReadyForTimeDomain}"
                                                             IconData="{StaticResource Icon.ChartLine}"
                                                             Message="{loc:Localize AnalysisDock.EmptyState}"/>
                                </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="{loc:Localize AnalysisDock.TabEyeBer}"
                                 IsVisible="{Binding BottomPanel.Analysis.Tabs.EyeBer}">
                            <ScrollViewer Classes="tabPage">
                                <StackPanel>
                                <!-- Why the tab is empty and the one-click fix, above the settings. -->
                                <StackPanel IsVisible="{Binding !BottomPanel.Analysis.Eye.HasResult}">
                                    <controls:EmptyStateHint IsVisible="{Binding BottomPanel.Analysis.Readiness.NeedsLightSource}"
                                                             IconData="{StaticResource Icon.Lightbulb}"
                                                             Message="{loc:Localize Readiness.NoLightSource}"
                                                             ActionText="{loc:Localize Readiness.PlaceLightSource}"
                                                             ActionIconData="{StaticResource Icon.Plus}"
                                                             ActionCommand="{Binding BottomPanel.Analysis.Readiness.PlaceLightSourceCommand}"/>
                                    <controls:EmptyStateHint IsVisible="{Binding BottomPanel.Analysis.Readiness.NeedsOutputPick}"
                                                             IconData="{StaticResource Icon.Target}"
                                                             Message="{loc:Localize Readiness.NoOutputPicked}"
                                                             ActionText="{loc:Localize AnalysisDock.PickOutput}"
                                                             ActionIconData="{StaticResource Icon.Crosshair}"
                                                             ActionCommand="{Binding BottomPanel.Analysis.Readiness.PickOutputCommand}"/>
                                </StackPanel>
                                <panels:EyeDiagramPanel/>
                                <StackPanel IsVisible="{Binding !BottomPanel.Analysis.Eye.HasResult}">
                                    <controls:EmptyStateHint IsVisible="{Binding BottomPanel.Analysis.Readiness.IsReadyForTimeDomain}"
                                                             IconData="{StaticResource Icon.ChartLine}"
                                                             Message="{loc:Localize AnalysisDock.EmptyState}"/>
                                </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="{loc:Localize AnalysisDock.TabSpectrum}"
                                 IsVisible="{Binding BottomPanel.Analysis.Tabs.Spectrum}">
                            <ScrollViewer Classes="tabPage">
                                <StackPanel>
                                <!-- Why the tab is empty and the one-click fix, above the settings. -->
                                <StackPanel IsVisible="{Binding !BottomPanel.Analysis.Spectrum.HasResult}">
                                    <controls:EmptyStateHint IsVisible="{Binding BottomPanel.Analysis.Readiness.NeedsLightSource}"
                                                             IconData="{StaticResource Icon.Lightbulb}"
                                                             Message="{loc:Localize Readiness.NoLightSource}"
                                                             ActionText="{loc:Localize Readiness.PlaceLightSource}"
                                                             ActionIconData="{StaticResource Icon.Plus}"
                                                             ActionCommand="{Binding BottomPanel.Analysis.Readiness.PlaceLightSourceCommand}"/>
                                </StackPanel>
                                <panels:WavelengthSpectrumPanel/>
                                <StackPanel IsVisible="{Binding !BottomPanel.Analysis.Spectrum.HasResult}">
                                    <controls:EmptyStateHint IsVisible="{Binding BottomPanel.Analysis.Readiness.HasLightSource}"
                                                             IconData="{StaticResource Icon.ChartLine}"
                                                             Message="{loc:Localize AnalysisDock.EmptyState}"/>
                                </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="{loc:Localize AnalysisDock.TabMonteCarlo}"
                                 IsVisible="{Binding BottomPanel.Analysis.Tabs.MonteCarlo}">
                            <ScrollViewer Classes="tabPage">
                                <StackPanel>
                                <!-- Why the tab is empty and the one-click fix, above the settings. -->
                                <StackPanel IsVisible="{Binding !BottomPanel.Analysis.MonteCarlo.HasResult}">
                                    <controls:EmptyStateHint IsVisible="{Binding BottomPanel.Analysis.Readiness.NeedsLightSource}"
                                                             IconData="{StaticResource Icon.Lightbulb}"
                                                             Message="{loc:Localize Readiness.NoLightSource}"
                                                             ActionText="{loc:Localize Readiness.PlaceLightSource}"
                                                             ActionIconData="{StaticResource Icon.Plus}"
                                                             ActionCommand="{Binding BottomPanel.Analysis.Readiness.PlaceLightSourceCommand}"/>
                                </StackPanel>
                                <panels:MonteCarloPanel/>
                                <StackPanel IsVisible="{Binding !BottomPanel.Analysis.MonteCarlo.HasResult}">
                                    <controls:EmptyStateHint IsVisible="{Binding BottomPanel.Analysis.Readiness.HasLightSource}"
                                                             IconData="{StaticResource Icon.ChartLine}"
                                                             Message="{loc:Localize AnalysisDock.EmptyState}"/>
                                </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="{loc:Localize AnalysisDock.TabOptimization}"
                                 IsVisible="{Binding BottomPanel.Analysis.Tabs.Optimization}">
                            <ScrollViewer Classes="tabPage">
                                <panels:CircuitOptimizationPanel/>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="{loc:Localize AnalysisDock.TabSweep}"
                                 IsVisible="{Binding BottomPanel.Analysis.Tabs.Sweep}">
                            <ScrollViewer Classes="tabPage">
                                <panels:ParameterSweepPanel/>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="{loc:Localize AnalysisDock.TabChecks}"
                                 IsVisible="{Binding BottomPanel.Analysis.Tabs.Checks}">
                            <ScrollViewer Classes="tabPage">
                                <panels:DesignChecksPanel/>
                            </ScrollViewer>
                        </TabItem>
                        <!-- Logic: whole-design build, toggle, step/run clock, timeline. Its columns scroll
                             on their own, so the page itself does not scroll vertically. -->
                        <TabItem Header="{loc:Localize AnalysisDock.TabLogic}"
                                 IsVisible="{Binding BottomPanel.Analysis.Tabs.Logic}">
                            <ScrollViewer Classes="tabPage" VerticalScrollBarVisibility="Disabled">
                                <panels:LogicPanel/>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>

</UserControl>
