<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             xmlns:ha="using:CAP.Avalonia.Controls.HelpAnimations"
             x:Class="CAP.Avalonia.Views.Panels.MonteCarloHelpFlyout">

    <!-- Help of the Monte Carlo tab (#1344, #1152 pattern): two short sections
         (text budget, all five locales) plus one looping scene — the waveguide
         width wobbles (fabrication variance), the transmission dip shifts with
         it, and dots drop into a histogram that builds a bell shape (many virtual
         chips → yield). Hosted as the HelpContent of the panel's HelpFlyoutButton,
         which supplies the title and the ScrollViewer. -->

    <StackPanel Spacing="8" MaxWidth="400">

        <TextBlock Classes="strong" Text="{loc:Localize MonteCarloHelp.ScatterTitle}"/>
        <TextBlock Classes="secondary" TextWrapping="Wrap"
                   Text="{loc:Localize MonteCarloHelp.ScatterBody}"/>

        <Border Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1"
                CornerRadius="{DynamicResource Radius.S}" Padding="4">
            <StackPanel Spacing="2">
                <ha:MonteCarloScatterAnimation Width="368" Height="150" IsHitTestVisible="False"/>
                <TextBlock Classes="caption" Text="{loc:Localize MonteCarloHelp.AnimationCaption}" TextWrapping="Wrap" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <TextBlock Classes="strong" Text="{loc:Localize MonteCarloHelp.YieldTitle}"/>
        <TextBlock Classes="secondary" TextWrapping="Wrap"
                   Text="{loc:Localize MonteCarloHelp.YieldBody}"/>

    </StackPanel>

</UserControl>
