<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             xmlns:ha="using:CAP.Avalonia.Controls.HelpAnimations"
             x:Class="CAP.Avalonia.Views.Panels.EyeHelpFlyout"
             MaxWidth="420">

    <!-- Plain-language explainer for the Eye/BER tab: short sections (#1152 text
         budget) plus the looping EyeStackAnimation (bit-length waveform slices
         stack into an eye). Shown from the panel's "?" button. -->

    <ScrollViewer MaxHeight="440">
        <StackPanel Margin="12" Spacing="8">

            <TextBlock Text="{loc:Localize EyeHelp.Title}"
                       FontWeight="Bold" FontSize="{DynamicResource FontSize.BodyLarge}" Foreground="{DynamicResource Brush.Text.Primary}"/>

            <!-- Looping animation: waveform slices stack up into an eye. -->
            <Border Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.S}" Padding="4">
                <Canvas Width="380" Height="90">
                    <!-- Left: the data waveform, cut into bit-length slices. -->
                    <Polyline Points="10,25 40,25 44,65 74,65 78,25 108,25 112,65 142,65"
                              Stroke="{DynamicResource Brush.Success}" StrokeThickness="2"/>
                    <Line StartPoint="42,15" EndPoint="42,75" Stroke="{DynamicResource Brush.Border.Strong}"
                          StrokeThickness="1" StrokeDashArray="2,2"/>
                    <Line StartPoint="76,15" EndPoint="76,75" Stroke="{DynamicResource Brush.Border.Strong}"
                          StrokeThickness="1" StrokeDashArray="2,2"/>
                    <Line StartPoint="110,15" EndPoint="110,75" Stroke="{DynamicResource Brush.Border.Strong}"
                          StrokeThickness="1" StrokeDashArray="2,2"/>
                    <TextBlock Classes="caption" Canvas.Left="14" Canvas.Top="76" Text="{loc:Localize EyeHelp.DiagramSignal}"/>
                    <!-- Arrow: slices get stacked -->
                    <Line StartPoint="152,45" EndPoint="200,45" Stroke="{DynamicResource Brush.Text.Tertiary}" StrokeThickness="2"/>
                    <Polyline Points="192,39 202,45 192,51" Stroke="{DynamicResource Brush.Text.Tertiary}" StrokeThickness="2"/>
                    <TextBlock Classes="caption" Canvas.Left="148" Canvas.Top="24" Text="{loc:Localize EyeHelp.DiagramStack}"/>
                    <!-- Right: the eye forms from overlaid slices (animated overlay). -->
                    <ha:EyeStackAnimation Width="380" Height="90" IsHitTestVisible="False"
                                          LoopDuration="0:0:4"/>
                    <TextBlock Classes="caption" Canvas.Left="248" Canvas.Top="76" Text="{loc:Localize EyeHelp.DiagramEye}"/>
                </Canvas>
            </Border>

            <TextBlock Classes="secondary" TextWrapping="Wrap"
                       Text="{loc:Localize EyeHelp.Intro}"/>

            <TextBlock Classes="strong" Text="{loc:Localize EyeHelp.RunTitle}" Margin="0,4,0,0"/>
            <TextBlock Classes="secondary" TextWrapping="Wrap"
                       Text="{loc:Localize EyeHelp.RunBody1}"/>

            <TextBlock Classes="strong" Text="{loc:Localize EyeHelp.ReadingTitle}" Margin="0,4,0,0"/>
            <StackPanel Spacing="5">
                <TextBlock Classes="secondary" TextWrapping="Wrap">
                    <Run FontWeight="Bold" Foreground="{DynamicResource Brush.Info}" Text="{loc:Localize EyeHelp.QLabel}"/>
                    <Run Text="{loc:Localize EyeHelp.QBody}"/>
                </TextBlock>
                <TextBlock Classes="secondary" TextWrapping="Wrap">
                    <Run FontWeight="Bold" Foreground="{DynamicResource Brush.Danger}">BER</Run>
                    <Run Text="{loc:Localize EyeHelp.BerBody}"/>
                </TextBlock>
                <TextBlock Classes="secondary" TextWrapping="Wrap">
                    <Run FontWeight="Bold" Foreground="{DynamicResource Brush.Warning}" Text="{loc:Localize EyeHelp.ThresholdLabel}"/>
                    <Run Text="{loc:Localize EyeHelp.ThresholdBody}"/>
                </TextBlock>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</UserControl>
