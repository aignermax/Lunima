<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CAP.Avalonia.ViewModels"
             xmlns:controls="using:CAP.Avalonia.Controls"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             xmlns:logic="using:CAP.Avalonia.ViewModels.Analysis.LogicAnalysis"
             xmlns:panels="using:CAP.Avalonia.Views.Panels"
             x:Class="CAP.Avalonia.Views.Panels.TruthTablePanel"
             x:DataType="vm:MainViewModel">

    <StackPanel Spacing="4">
        <Border Classes="divider" Margin="0,12,0,8"/>
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="subtitle" Text="{loc:Localize TruthTable.Title}" VerticalAlignment="Center"/>
            <!-- Plain-language help (#1207): short sections + the interference
                 animation live in the extracted TruthTableHelpFlyout. -->
            <controls:HelpFlyoutButton Grid.Column="1"
                                       Title="{loc:Localize TruthTableHelp.Title}"
                                       VerticalAlignment="Center">
                <controls:HelpFlyoutButton.HelpContent>
                    <panels:TruthTableHelpFlyout/>
                </controls:HelpFlyoutButton.HelpContent>
            </controls:HelpFlyoutButton>
        </Grid>

        <!-- Hint while anything other than exactly one group is selected -->
        <Border Classes="empty-state" IsVisible="{Binding RightPanel.TruthTable.IsGroupSelected, Converter={x:Static BoolConverters.Not}}">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <controls:Icon Data="{StaticResource Icon.Table}" Size="24" Foreground="{DynamicResource Brush.Text.Tertiary}" HorizontalAlignment="Center"/>
                <TextBlock Classes="secondary" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320"
                           Text="{loc:Localize TruthTable.NoGroupSelected}"/>
            </StackPanel>
        </Border>

        <StackPanel IsVisible="{Binding RightPanel.TruthTable.IsGroupSelected}">
            <Grid ColumnDefinitions="*,110" Margin="0,5,0,2">
                <TextBlock Classes="label" Text="{loc:Localize TruthTable.Inputs}"/>
                <TextBlock Classes="caption" Grid.Column="1" Text="{loc:Localize TruthTable.Signal}"
                           Margin="4,0,0,0"
                           IsVisible="{Binding RightPanel.TruthTable.SignalNamesVisible}"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding RightPanel.TruthTable.InputPins}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="logic:PinSelectionViewModel">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,110">
                                <CheckBox Content="{Binding PinName}" IsChecked="{Binding IsChecked}" Margin="0,1" VerticalAlignment="Center"/>
                                <!-- The signal field edits the group's persisted pin assignment,
                                     so it appears only once the group carries one (after
                                     extraction or load) and the pin is checked as input. -->
                                <TextBox Grid.Column="1" Text="{Binding SignalName}"
                                         Watermark="{loc:Localize TruthTable.SignalWatermark}"
                                         FontSize="{DynamicResource FontSize.Caption}" Classes="compact" Margin="4,0,0,0" VerticalAlignment="Center">
                                    <TextBox.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="IsChecked"/>
                                            <Binding Path="SignalEditingVisible"/>
                                        </MultiBinding>
                                    </TextBox.IsVisible>
                                </TextBox>
                            </Grid>
                            <!-- Live collision hint: warns at typing time about the duplicate
                                 output name or the input/output cross-role name the build would
                                 reject minutes later (issue #1071). Warning only — the build
                                 keeps its authoritative rejection. -->
                            <TextBlock Text="{Binding SignalWarning}" Foreground="{DynamicResource Brush.Warning}" FontSize="{DynamicResource FontSize.Caption}"
                                       TextWrapping="Wrap" Margin="0,0,0,2"
                                       IsVisible="{Binding SignalWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnDefinitions="*,110" Margin="0,8,0,2">
                <TextBlock Classes="label" Text="{loc:Localize TruthTable.Outputs}"/>
                <TextBlock Classes="caption" Grid.Column="1" Text="{loc:Localize TruthTable.Signal}"
                           Margin="4,0,0,0"
                           IsVisible="{Binding RightPanel.TruthTable.SignalNamesVisible}"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding RightPanel.TruthTable.OutputPins}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="logic:PinSelectionViewModel">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,110">
                                <CheckBox Content="{Binding PinName}" IsChecked="{Binding IsChecked}" Margin="0,1" VerticalAlignment="Center"/>
                                <!-- Same persisted-assignment semantics as the input rows:
                                     a named output's tap reads the signal name in the Logic
                                     panel (S0, Cout) instead of the raw gate.pin id.
                                     The inline warning under the field mirrors the input rows. -->
                                <TextBox Grid.Column="1" Text="{Binding SignalName}"
                                         Watermark="{loc:Localize TruthTable.SignalWatermark}"
                                         FontSize="{DynamicResource FontSize.Caption}" Classes="compact" Margin="4,0,0,0" VerticalAlignment="Center">
                                    <TextBox.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="IsChecked"/>
                                            <Binding Path="SignalEditingVisible"/>
                                        </MultiBinding>
                                    </TextBox.IsVisible>
                                </TextBox>
                            </Grid>
                            <TextBlock Text="{Binding SignalWarning}" Foreground="{DynamicResource Brush.Warning}" FontSize="{DynamicResource FontSize.Caption}"
                                       TextWrapping="Wrap" Margin="0,0,0,2"
                                       IsVisible="{Binding SignalWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="label" Text="{loc:Localize TruthTable.Bias}" Margin="0,8,0,2"/>
            <ItemsControl ItemsSource="{Binding RightPanel.TruthTable.BiasPins}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="logic:PinSelectionViewModel">
                        <CheckBox Content="{Binding PinName}" IsChecked="{Binding IsChecked}" Margin="0,1"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,5">
                <TextBlock Classes="label" Text="{loc:Localize TruthTable.Threshold}" VerticalAlignment="Center" Width="70"/>
                <NumericUpDown Value="{Binding RightPanel.TruthTable.Threshold}"
                               Minimum="0.01" Maximum="0.99" Increment="0.05"
                               FormatString="F2" Width="100"/>
            </StackPanel>
            <TextBlock Classes="caption" Text="{Binding RightPanel.TruthTable.WavelengthText}" Margin="0,0,0,5"/>

            <!-- Register designation (#1098): the group's persisted IsRegister flag —
                 feedback loops through the network are legal only via a register. -->
            <CheckBox Content="{loc:Localize TruthTable.Register}"
                      IsChecked="{Binding RightPanel.TruthTable.IsRegister}" Margin="0,4,0,0"/>
            <TextBlock Classes="caption" Text="{loc:Localize TruthTable.RegisterHint}"
                       TextWrapping="Wrap" Margin="24,1,0,5"/>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,4">
                <Button Classes="primary" Content="{loc:Localize TruthTable.Extract}"
                        Command="{Binding RightPanel.TruthTable.ExtractCommand}"
                        IsEnabled="{Binding RightPanel.TruthTable.IsProcessing, Converter={x:Static BoolConverters.Not}}"/>
                <Button Content="{loc:Localize TruthTable.Cancel}"
                        Command="{Binding RightPanel.TruthTable.CancelCommand}"
                        IsVisible="{Binding RightPanel.TruthTable.IsProcessing}"/>
            </StackPanel>
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,5"
                         IsVisible="{Binding RightPanel.TruthTable.IsProcessing}"/>
            <TextBlock Classes="caption" Text="{Binding RightPanel.TruthTable.StatusText}" TextWrapping="Wrap" Margin="0,0,0,5"
                       IsVisible="{Binding RightPanel.TruthTable.StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <!-- Result table: input bit pattern | per output the bit and the raw power -->
            <StackPanel Classes="fade-in" Classes.shown="{Binding RightPanel.TruthTable.HasResult}"
                        IsVisible="{Binding RightPanel.TruthTable.HasResult}">
                <TextBlock Classes="caption" Text="{Binding RightPanel.TruthTable.BiasSummaryText}" Margin="0,5,0,0"
                           IsVisible="{Binding RightPanel.TruthTable.BiasSummaryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,2">
                    <ItemsControl ItemsSource="{Binding RightPanel.TruthTable.InputHeaders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Classes="caption" Text="{Binding}" FontWeight="SemiBold" Width="24"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="|" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="4,0"/>
                    <ItemsControl ItemsSource="{Binding RightPanel.TruthTable.OutputHeaders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Classes="caption" Text="{Binding}" FontWeight="SemiBold" Width="56"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding RightPanel.TruthTable.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="logic:TruthTableRowViewModel">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="mono" Text="{Binding InputBitsText}" Foreground="{DynamicResource Brush.Text.Secondary}"
                                               FontSize="{DynamicResource FontSize.Caption}" Width="48"/>
                                    <TextBlock Text="|" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="4,0"/>
                                    <ItemsControl ItemsSource="{Binding OutputCells}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="logic:TruthTableOutputCellViewModel">
                                                <StackPanel Width="56">
                                                    <TextBlock Classes="mono" Text="{Binding BitText}" FontSize="{DynamicResource FontSize.Caption}" FontWeight="Bold"
                                                               Foreground="{DynamicResource Brush.Success}" IsVisible="{Binding IsOne}"/>
                                                    <TextBlock Classes="mono" Text="{Binding BitText}" FontSize="{DynamicResource FontSize.Caption}" FontWeight="Bold"
                                                               Foreground="{DynamicResource Brush.Text.Secondary}" IsVisible="{Binding IsOne, Converter={x:Static BoolConverters.Not}}"/>
                                                    <TextBlock Classes="mono" Text="{Binding PowerText}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource FontSize.Caption}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </StackPanel>
    </StackPanel>

</UserControl>
