<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             xmlns:ha="using:CAP.Avalonia.Controls.HelpAnimations"
             x:Class="CAP.Avalonia.Views.Panels.LogicTimelineHelpFlyout">

    <!-- Timeline help of the Logic tab (#1206, #1152 pattern): short sections (text
         budget, all five locales) plus one looping pulse-arrival diagram — a pulse
         travels a chain of three gates, each gate's badge flips when the pulse
         arrives, and the waveform lane below draws the step at the same moment
         (arrival time = propagation delay). The pulse is the LightPulseAlongPath
         primitive; badges, step traces, and the time cursor are the bespoke
         PulseArrivalAnimation overlay. Hosted as the HelpContent of the Timeline
         section's HelpFlyoutButton, which supplies the title and the ScrollViewer. -->

    <StackPanel Spacing="8" MaxWidth="400">

        <TextBlock Classes="caption secondary" TextWrapping="Wrap"
                   Text="{loc:Localize LogicPanelTimelineHelp.Intro}"/>

        <!-- arrival time = propagation delay: the badge flips and the step trace
             rises at the instant the pulse reaches each gate. -->
        <Border Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1"
                CornerRadius="{DynamicResource Radius.S}" Padding="4">
            <StackPanel Spacing="2">
                <Canvas Width="368" Height="124">
                    <!-- Declared first so track and pulse slide *under* the gate boxes. -->
                    <ha:LightPulseAlongPath Width="368" Height="124" PathPoints="8,40 344,40"
                                            PulseBrush="{DynamicResource Brush.Warning}" PulseDiameter="10"
                                            WindowStart="0" WindowEnd="0.75" IsHitTestVisible="False"/>
                    <!-- the chain of three gates -->
                    <Border Canvas.Left="74" Canvas.Top="26" Width="40" Height="28"
                            Background="{DynamicResource Brush.Surface.Hover}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1" CornerRadius="4"/>
                    <Border Canvas.Left="164" Canvas.Top="26" Width="40" Height="28"
                            Background="{DynamicResource Brush.Surface.Hover}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1" CornerRadius="4"/>
                    <Border Canvas.Left="254" Canvas.Top="26" Width="40" Height="28"
                            Background="{DynamicResource Brush.Surface.Hover}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1" CornerRadius="4"/>
                    <!-- the waveform lane -->
                    <Border Canvas.Left="8" Canvas.Top="64" Width="336" Height="56"
                            Background="{DynamicResource Brush.Surface.Input}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1" CornerRadius="3"/>
                    <!-- animated badges, step traces, and time cursor -->
                    <ha:PulseArrivalAnimation Width="368" Height="124" IsHitTestVisible="False"/>
                </Canvas>
                <TextBlock Classes="caption" Text="{loc:Localize LogicPanelTimelineHelp.AnimationCaption}" TextWrapping="Wrap" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <TextBlock Classes="strong" Text="{loc:Localize LogicPanelTimelineHelp.PhysicsTitle}"/>
        <TextBlock Classes="secondary" TextWrapping="Wrap"
                   Text="{loc:Localize LogicPanelTimelineHelp.PhysicsBody}"/>

        <TextBlock Classes="strong" Text="{loc:Localize LogicPanelTimelineHelp.OrderTitle}" Margin="0,4,0,0"/>
        <TextBlock Classes="secondary" TextWrapping="Wrap"
                   Text="{loc:Localize LogicPanelTimelineHelp.OrderBody}"/>

        <TextBlock Classes="strong" Text="{loc:Localize LogicPanelTimelineHelp.ClockTitle}" Margin="0,4,0,0"/>
        <TextBlock Classes="secondary" TextWrapping="Wrap"
                   Text="{loc:Localize LogicPanelTimelineHelp.ClockBody}"/>

        <TextBlock Classes="strong" Text="{loc:Localize LogicPanelTimelineHelp.ReplayTitle}" Margin="0,4,0,0"/>
        <TextBlock Classes="secondary" TextWrapping="Wrap"
                   Text="{loc:Localize LogicPanelTimelineHelp.ReplayBody}"/>

        <TextBlock Classes="strong" Text="{loc:Localize LogicPanelTimelineHelp.WaveformTitle}" Margin="0,4,0,0"/>
        <TextBlock Classes="secondary" TextWrapping="Wrap"
                   Text="{loc:Localize LogicPanelTimelineHelp.WaveformBody}"/>

        <TextBlock Classes="secondary" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="{loc:Localize LogicPanelTimelineHelp.PlaybackBody}"/>
    </StackPanel>

</UserControl>
