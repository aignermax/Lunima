<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CAP.Avalonia.ViewModels.Onboarding.FirstStepsTutorial"
             xmlns:controls="using:CAP.Avalonia.Controls"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             x:Class="CAP.Avalonia.Views.Panels.ConnectChipletsTourPanel"
             x:DataType="vm:ConnectChipletsTourViewModel">
  <Border Classes="overlay" Padding="10,6" Width="280" CornerRadius="12">
    <StackPanel Spacing="6">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="{Binding CurrentCue}" FontSize="14" FontWeight="SemiBold"
                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,6,0"/>
        <Button Grid.Column="1" Classes="ghost icon" ToolTip.Tip="{Binding CurrentTitle}" AutomationProperties.Name="{Binding CurrentTitle}">
          <controls:Icon Data="{StaticResource Icon.CircleHelp}"/>
          <Button.Flyout>
            <Flyout>
              <StackPanel MaxWidth="300" Spacing="8">
                <TextBlock Classes="label" Text="{Binding ProgressText}"/>
                <TextBlock Classes="subtitle" Text="{Binding CurrentTitle}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding CurrentBody}" TextWrapping="Wrap"/>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button Grid.Column="2" Classes="ghost icon" Command="{Binding SkipCommand}"
                ToolTip.Tip="{loc:Localize Tutorial.Skip}" AutomationProperties.Name="{loc:Localize Tutorial.Skip}">
          <controls:Icon Data="{StaticResource Icon.X}"/>
        </Button>
      </Grid>
      <Button x:Name="MoveChipletForMeButton" Content="{loc:Localize ConnectChipletsTour.MoveForMe}"
              Command="{Binding MoveReceiverForMeCommand}" IsVisible="{Binding ShowMoveForMeButton}"
              HorizontalAlignment="Left"/>
      <Button x:Name="ChipletTourNextButton" Classes="primary" Content="{loc:Localize Tutorial.Next}"
              Command="{Binding NextCommand}" IsVisible="{Binding CanAdvance}" HorizontalAlignment="Right"/>
    </StackPanel>
  </Border>
</UserControl>
