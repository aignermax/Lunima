<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CAP.Avalonia.ViewModels.Onboarding.FirstStepsTutorial"
             xmlns:controls="using:CAP.Avalonia.Controls"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             x:Class="CAP.Avalonia.Views.Panels.ConnectChipletsTourPanel"
             x:DataType="vm:ConnectChipletsTourViewModel">

  <!-- "Connect two chiplets" tour card (issue #1288, slice 4 of #769): shows
       the current step and progress. Non-modal: the canvas, the toolbar and the
       Design Checks tab stay fully interactive. Hosted by the anchored overlay
       in MainWindow; the move step additionally offers a "do it for me" button
       that shifts the receiver chiplet through the tour engine. -->
  <Border Classes="overlay" Padding="12" Width="340">
    <StackPanel Spacing="8">

      <!-- Header: progress + close -->
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="ghost icon" Command="{Binding SkipCommand}"
                ToolTip.Tip="{loc:Localize Tutorial.Skip}">
          <controls:Icon Data="{StaticResource Icon.X}"/>
        </Button>
        <TextBlock Classes="label" Text="{Binding ProgressText}"
                   VerticalAlignment="Center"/>
      </DockPanel>

      <!-- Current step -->
      <TextBlock Classes="subtitle" Text="{Binding CurrentTitle}" TextWrapping="Wrap"/>
      <TextBlock Classes="secondary" Text="{Binding CurrentBody}" TextWrapping="Wrap"/>

      <!-- Move step helper: shifts the receiver chiplet 5 µm off its facet. -->
      <Button Content="{loc:Localize ConnectChipletsTour.MoveForMe}"
              Command="{Binding MoveReceiverForMeCommand}"
              IsVisible="{Binding ShowMoveForMeButton}"
              HorizontalAlignment="Left"/>

      <!-- Actions -->
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Classes="ghost" Content="{loc:Localize Tutorial.Skip}"
                Command="{Binding SkipCommand}"/>
        <Button Classes="primary" Content="{loc:Localize Tutorial.Next}"
                Command="{Binding NextCommand}"/>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
