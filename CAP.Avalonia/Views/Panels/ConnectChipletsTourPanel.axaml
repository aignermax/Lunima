<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CAP.Avalonia.ViewModels.Onboarding.FirstStepsTutorial"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             x:Class="CAP.Avalonia.Views.Panels.ConnectChipletsTourPanel"
             x:DataType="vm:ConnectChipletsTourViewModel">

  <!-- "Connect two chiplets" tour card (issue #1288, slice 4 of #769): shows
       the current step and progress. Non-modal: the canvas, the toolbar and the
       Design Checks tab stay fully interactive. Hosted by the anchored overlay
       in MainWindow; the move step additionally offers a "do it for me" button
       that shifts the receiver chiplet through the tour engine. -->
  <Border Background="{DynamicResource Brush.Surface.Hover}" BorderBrush="{DynamicResource Brush.Success}" BorderThickness="1"
          CornerRadius="6" Padding="12" Width="340"
          BoxShadow="0 4 12 0 #99000000">
    <StackPanel Spacing="8">

      <!-- Header: progress + close -->
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="✕" Padding="4,0"
                Background="Transparent" Foreground="{DynamicResource Brush.Text.Secondary}"
                Command="{Binding SkipCommand}"
                ToolTip.Tip="{loc:Localize Tutorial.Skip}"/>
        <TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource Brush.Accent.Hover}" FontSize="{DynamicResource FontSize.Caption}"
                   VerticalAlignment="Center"/>
      </DockPanel>

      <!-- Current step -->
      <TextBlock Text="{Binding CurrentTitle}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize.Subtitle}"
                 TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Primary}"/>
      <TextBlock Text="{Binding CurrentBody}" TextWrapping="Wrap"
                 Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource FontSize.Body}"/>

      <!-- Move step helper: shifts the receiver chiplet 5 µm off its facet. -->
      <Button Content="{loc:Localize ConnectChipletsTour.MoveForMe}"
              Command="{Binding MoveReceiverForMeCommand}"
              IsVisible="{Binding ShowMoveForMeButton}"
              HorizontalAlignment="Left" Padding="10,4" FontSize="{DynamicResource FontSize.Caption}"
              Background="{DynamicResource Brush.Accent.Subtle}" Foreground="{DynamicResource Brush.Text.Primary}"/>

      <!-- Actions -->
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="{loc:Localize Tutorial.Skip}"
                Command="{Binding SkipCommand}"
                Background="Transparent" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource FontSize.Caption}"
                Padding="8,4"/>
        <Button Content="{loc:Localize Tutorial.Next}"
                Command="{Binding NextCommand}"
                Background="{DynamicResource Brush.Success.Subtle}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{DynamicResource FontSize.Caption}"
                Padding="10,4"/>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
