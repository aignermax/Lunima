<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CAP.Avalonia.ViewModels.Onboarding.FirstStepsTutorial"
             xmlns:controls="using:CAP.Avalonia.Controls"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             x:Class="CAP.Avalonia.Views.Panels.StoreNumberTourPanel"
             x:DataType="vm:StoreNumberTourViewModel">

  <Border Classes="overlay" Padding="10" Width="280">
    <StackPanel Spacing="6">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="ghost icon" Command="{Binding SkipCommand}"
                AutomationProperties.Name="{loc:Localize Tutorial.Skip}" ToolTip.Tip="{loc:Localize Tutorial.Skip}">
          <controls:Icon Data="{StaticResource Icon.X}"/>
        </Button>
        <Button DockPanel.Dock="Right" Classes="ghost icon" AutomationProperties.Name="{Binding CurrentTitle}">
          <controls:Icon Data="{StaticResource Icon.CircleHelp}"/>
          <Button.Flyout><Flyout><StackPanel Width="280" Spacing="6">
            <TextBlock Text="{Binding ProgressText}" Classes="label"/>
            <TextBlock Text="{Binding CurrentTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding CurrentBody}" TextWrapping="Wrap"/>
          </StackPanel></Flyout></Button.Flyout>
        </Button>
        <TextBlock Text="{Binding CurrentCue}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
      </DockPanel>
      <Button x:Name="StoreTourShowControlsButton" Content="{loc:Localize StoreNumberTour.Controls}"
              Command="{Binding ShowControlsCommand}" IsVisible="{Binding NeedsControlsRecovery}"/>
      <Button x:Name="StoreTourNextButton" Content="{loc:Localize Tutorial.Next}"
              Command="{Binding NextCommand}" IsVisible="{Binding IsClosing}" HorizontalAlignment="Right"/>
    </StackPanel>
  </Border>
</UserControl>
