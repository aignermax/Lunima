<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CAP.Avalonia.ViewModels"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             x:Class="CAP.Avalonia.Views.Panels.RerouteImportedPanel"
             x:DataType="vm:MainViewModel">

    <!-- Re-route imported (frozen) routes: visible while the design holds frozen
         imported routes — on the canvas or inside component groups (the standard GDS
         import groups everything) — or a re-route just ran, so the delta stays readable. -->
    <StackPanel IsVisible="{Binding BottomPanel.RerouteImported.IsPanelVisible}">
        <Border Classes="divider" Margin="0,12,0,8"/>
        <TextBlock Classes="subtitle" Text="{loc:Localize Routing.Reroute.Title}" Margin="0,0,0,5"/>

        <TextBlock Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,0,6" TextWrapping="Wrap"
                   IsVisible="{Binding BottomPanel.RerouteImported.HasFrozenImportedRoutes}"
                   Text="{Binding BottomPanel.RerouteImported.FrozenCountText}"/>

        <TextBlock Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,0,6" TextWrapping="Wrap"
                   IsVisible="{Binding BottomPanel.RerouteImported.HasGroupedFrozenRoutes}"
                   Text="{Binding BottomPanel.RerouteImported.GroupedFrozenText}"/>

        <StackPanel Spacing="6" Margin="0,0,0,6">
            <StackPanel.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                    <Binding Path="BottomPanel.RerouteImported.HasFrozenImportedRoutes"/>
                    <Binding Path="BottomPanel.RerouteImported.HasGroupedFrozenRoutes"/>
                </MultiBinding>
            </StackPanel.IsVisible>
            <TextBlock Classes="caption secondary" TextWrapping="Wrap"
                       Text="{loc:Localize Routing.Reroute.EditImportedHint}"/>
            <WrapPanel Orientation="Horizontal">
                <Button Content="{loc:Localize Routing.Reroute.All}" Margin="0,0,8,4"
                        Command="{Binding BottomPanel.RerouteImported.RerouteAllCommand}"/>
                <Button Content="{loc:Localize Routing.Reroute.Selected}" Margin="0,0,0,4"
                        IsVisible="{Binding BottomPanel.RerouteImported.HasFrozenImportedRoutes}"
                        Command="{Binding BottomPanel.RerouteImported.RerouteSelectedCommand}"/>
            </WrapPanel>
        </StackPanel>

        <TextBlock Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,0,4" TextWrapping="Wrap"
                   IsVisible="{Binding BottomPanel.RerouteImported.HasHandEditedFrozenRoutes}"
                   Text="{Binding BottomPanel.RerouteImported.HandEditedKeptText}"/>

        <TextBlock Foreground="{DynamicResource Brush.Success}" TextWrapping="Wrap"
                   Text="{Binding BottomPanel.RerouteImported.ResultText}"
                   IsVisible="{Binding BottomPanel.RerouteImported.ResultText,
                               Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    </StackPanel>
</UserControl>
