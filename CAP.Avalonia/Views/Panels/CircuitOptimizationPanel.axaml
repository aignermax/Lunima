<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CAP.Avalonia.ViewModels"
             xmlns:opt="using:CAP.Avalonia.ViewModels.Analysis.CircuitOptimization"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             xmlns:controls="using:CAP.Avalonia.Controls"
             xmlns:panels="using:CAP.Avalonia.Views.Panels"
             x:Class="CAP.Avalonia.Views.Panels.CircuitOptimizationPanel"
             x:DataType="vm:MainViewModel">

    <!-- Circuit optimization: seeded hill-climb over all sliders, ranked top-N
         improved variants with undo-safe one-click apply. Laid out for the WIDE
         analysis dock: a narrow config column on the left, the variant cards
         wrapping into as many columns as fit on the right. -->
    <Grid ColumnDefinitions="300,16,*" Margin="{DynamicResource Padding.Panel}"
          IsVisible="{Binding BottomPanel.Analysis.Optimization.HasParameters}">

        <StackPanel Grid.Column="0">
            <TextBlock Classes="subtitle" Text="{loc:Localize Optimize.Title}" Margin="0,0,0,3"/>
            <TextBlock Classes="caption" Text="{loc:Localize Optimize.Hint}"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>

            <TextBlock Classes="caption" Text="{loc:Localize Optimize.Target}" Margin="0,0,0,3"/>
            <ComboBox ItemsSource="{Binding BottomPanel.Analysis.Optimization.Targets}"
                      SelectedItem="{Binding BottomPanel.Analysis.Optimization.SelectedTarget}"
                      HorizontalAlignment="Stretch" Margin="0,0,0,5"/>
            <CheckBox IsChecked="{Binding BottomPanel.Analysis.Optimization.Maximize}"
                      Content="{loc:Localize Optimize.Maximize}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,0,0,5"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Classes="caption" Text="{loc:Localize Optimize.Budget}" VerticalAlignment="Center" Width="60"/>
                <NumericUpDown Value="{Binding BottomPanel.Analysis.Optimization.EvaluationBudget}"
                               Minimum="2" Maximum="2000" Increment="10" Width="130" FormatString="F0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Classes="caption" Text="{loc:Localize Optimize.Seed}" VerticalAlignment="Center" Width="60"/>
                <NumericUpDown Value="{Binding BottomPanel.Analysis.Optimization.Seed}"
                               Minimum="0" Maximum="99999" Increment="1" Width="130" FormatString="F0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5,0,5" Spacing="8">
                <Button Classes="primary" Content="{loc:Localize Optimize.Run}"
                        Command="{Binding BottomPanel.Analysis.Optimization.RunOptimizationCommand}"
                        IsEnabled="{Binding BottomPanel.Analysis.Optimization.IsOptimizing, Converter={x:Static BoolConverters.Not}}"/>
                <Button Content="{loc:Localize Optimize.Cancel}"
                        Command="{Binding BottomPanel.Analysis.Optimization.CancelOptimizationCommand}"
                        IsVisible="{Binding BottomPanel.Analysis.Optimization.IsOptimizing}"/>
                <!-- Plain-language help (#1362): how the seeded hill-climb works, what
                     Budget and Seed mean, and why the result is a local best. Same
                     reusable "?" control as the other analysis tabs. -->
                <controls:HelpFlyoutButton Title="{loc:Localize OptimizeHelp.Title}"
                                           VerticalAlignment="Center">
                    <controls:HelpFlyoutButton.HelpContent>
                        <panels:OptimizationHelpFlyout/>
                    </controls:HelpFlyoutButton.HelpContent>
                </controls:HelpFlyoutButton>
            </StackPanel>

            <TextBlock Classes="caption" Text="{Binding BottomPanel.Analysis.Optimization.StatusText}" Margin="0,0,0,3"
                       TextWrapping="Wrap"
                       IsVisible="{Binding BottomPanel.Analysis.Optimization.StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="{Binding BottomPanel.Analysis.Optimization.BaselineText}" Foreground="{DynamicResource Brush.Success}" FontSize="{DynamicResource FontSize.Caption}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding BottomPanel.Analysis.Optimization.BaselineText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>

        <ItemsControl Grid.Column="2" ItemsSource="{Binding BottomPanel.Analysis.Optimization.Variants}"
                      VerticalAlignment="Top">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="opt:OptimizationVariantViewModel">
                    <Border Background="{DynamicResource Brush.Surface.Hover}" CornerRadius="3" Padding="6" Margin="0,0,6,6" Width="340">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{loc:Localize Optimize.Apply}"
                                        Command="{Binding ApplyCommand}"/>
                                <TextBlock Classes="caption secondary" VerticalAlignment="Center">
                                    <Run Text="#"/><Run Text="{Binding Rank}"/>
                                    <Run Text="  "/><Run Text="{Binding ScoreText}" Foreground="{DynamicResource Brush.Success}"/>
                                    <Run Text=" ("/><Run Text="{Binding ImprovementText}" Foreground="{DynamicResource Brush.Warning}"/><Run Text=")"/>
                                </TextBlock>
                            </DockPanel>
                            <TextBlock Classes="caption" Text="{Binding ParameterSummary}"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                            <TextBlock Text="{loc:Localize Optimize.AppliedBadge}" Foreground="{DynamicResource Brush.Success}" FontSize="{DynamicResource FontSize.Caption}"
                                       IsVisible="{Binding IsApplied}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
