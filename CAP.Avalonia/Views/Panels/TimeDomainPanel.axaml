<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CAP.Avalonia.ViewModels"
             xmlns:vmAnalysis="using:CAP.Avalonia.ViewModels.Analysis"
             xmlns:panels="using:CAP.Avalonia.Views.Panels"
             xmlns:trace="using:CAP.Avalonia.ViewModels.Analysis.TimeTrace"
             xmlns:controls="using:CAP.Avalonia.Controls"
             xmlns:oxy="using:OxyPlot.Avalonia"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             x:Class="CAP.Avalonia.Views.Panels.TimeDomainPanel"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <!-- Dark hover-tracker so it reads on the dark theme instead of OxyPlot's default
             light/yellow popup (round 5 finding 2); same values as EyeDiagramPanel's tracker
             for cross-chart consistency. -->
        <Style Selector="oxy|TrackerControl">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="LineStroke" Value="{DynamicResource Brush.Text.Tertiary}"/>
        </Style>
        <!-- The design system (Styles/FluentOverrides.axaml) drives input height/padding app-wide; only the
             layout-specific VerticalContentAlignment and label FontSize stay local. -->
        <Style Selector="NumericUpDown">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.analysis">
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </UserControl.Styles>

    <StackPanel Margin="6,4">
        <!-- No heading/separator: the tab header already reads "Transient". -->
        <TextBlock Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,0,0,4" TextWrapping="Wrap"
                   Text="{loc:Localize TimeDomain.Description}"/>

        <!-- Parameters + Run: laid out horizontally, wrapping responsively (right, then down). -->
        <WrapPanel Orientation="Horizontal">
            <StackPanel Margin="0,0,12,4">
                <TextBlock Text="{loc:Localize TimeDomain.CenterWavelength}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,0,0,1"/>
                <NumericUpDown Value="{Binding BottomPanel.Analysis.Transient.CenterWavelengthNm}"
                               Minimum="800" Maximum="2000" Increment="10" Width="118" FormatString="F0"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,4">
                <TextBlock Text="{loc:Localize TimeDomain.Span}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,0,0,1"/>
                <NumericUpDown Value="{Binding BottomPanel.Analysis.Transient.SpanNm}"
                               Minimum="1" Maximum="500" Increment="10" Width="110" FormatString="F0"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,4">
                <TextBlock Text="{loc:Localize TimeDomain.FreqPoints}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,0,0,1"/>
                <NumericUpDown Value="{Binding BottomPanel.Analysis.Transient.FreqPoints}"
                               Minimum="16" Maximum="1024" Increment="64" Width="110" FormatString="F0"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,4">
                <TextBlock Text="{loc:Localize TimeDomain.Source}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,0,0,1"/>
                <ComboBox ItemsSource="{x:Static vmAnalysis:TransientSourceSettingsViewModel.SourceTypes}"
                          SelectedItem="{Binding BottomPanel.Analysis.Transient.Source.SourceType}"
                          Width="130" FontSize="{DynamicResource FontSize.Caption}"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,4"
                        IsVisible="{Binding BottomPanel.Analysis.Transient.Source.IsGaussianPulse}">
                <TextBlock Text="{loc:Localize TimeDomain.PulseCenter}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,0,0,1"/>
                <NumericUpDown Value="{Binding BottomPanel.Analysis.Transient.PulseCenterPs}"
                               Minimum="0" Maximum="100" Increment="0.5" Width="118" FormatString="F2"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,4"
                        IsVisible="{Binding BottomPanel.Analysis.Transient.Source.IsGaussianPulse}">
                <TextBlock Text="{loc:Localize TimeDomain.PulseSigma}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,0,0,1"/>
                <NumericUpDown Value="{Binding BottomPanel.Analysis.Transient.PulseSigmaPs}"
                               Minimum="0.01" Maximum="50" Increment="0.1" Width="118" FormatString="F2"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,4"
                        IsVisible="{Binding BottomPanel.Analysis.Transient.Source.IsPrbs}">
                <TextBlock Text="{loc:Localize TimeDomain.Bitrate}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,0,0,1"/>
                <NumericUpDown Value="{Binding BottomPanel.Analysis.Transient.Source.BitrateGbps}"
                               Minimum="0.1" Maximum="400" Increment="1" Width="110" FormatString="F1"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,4"
                        IsVisible="{Binding BottomPanel.Analysis.Transient.Source.IsPrbs}">
                <TextBlock Text="{loc:Localize TimeDomain.PrbsOrder}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,0,0,1"/>
                <ComboBox ItemsSource="{x:Static vmAnalysis:TransientSourceSettingsViewModel.PrbsOrders}"
                          SelectedItem="{Binding BottomPanel.Analysis.Transient.Source.PrbsOrder}"
                          Width="80" FontSize="{DynamicResource FontSize.Caption}"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,4"
                        IsVisible="{Binding BottomPanel.Analysis.Transient.Source.IsPrbs}">
                <TextBlock Text="{loc:Localize TimeDomain.SamplesPerSymbol}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,0,0,1"/>
                <NumericUpDown Value="{Binding BottomPanel.Analysis.Transient.Source.SamplesPerSymbol}"
                               Minimum="16" Maximum="128" Increment="16" Width="110" FormatString="F0"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,4"
                        IsVisible="{Binding BottomPanel.Analysis.Transient.Source.IsPrbs}">
                <TextBlock Text="{loc:Localize TimeDomain.Symbols}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,0,0,1"/>
                <NumericUpDown Value="{Binding BottomPanel.Analysis.Transient.Source.SymbolCount}"
                               Minimum="2" Maximum="4096" Increment="16" Width="110" FormatString="F0"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,4"
                        IsVisible="{Binding BottomPanel.Analysis.Transient.Source.IsPrbs}">
                <TextBlock Text="{loc:Localize TimeDomain.Extinction}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,0,0,1"/>
                <NumericUpDown Value="{Binding BottomPanel.Analysis.Transient.Source.ExtinctionRatioDb}"
                               Minimum="1" Maximum="40" Increment="1" Width="110" FormatString="F1"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,4"
                        IsVisible="{Binding BottomPanel.Analysis.Transient.Source.IsPrbs}">
                <TextBlock Text="{loc:Localize TimeDomain.Seed}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,0,0,1"/>
                <NumericUpDown Value="{Binding BottomPanel.Analysis.Transient.Source.Seed}"
                               Minimum="1" Maximum="65535" Increment="1" Width="100" FormatString="F0"/>
            </StackPanel>
            <!-- Run sits to the right of the fields; the spacer aligns it with the field row. -->
            <StackPanel Margin="0,0,12,4" VerticalAlignment="Bottom">
                <TextBlock Text=" " FontSize="{DynamicResource FontSize.Caption}" Margin="0,0,0,1"/>
                <Button Content="{loc:Localize TimeDomain.RunButton}" Classes="analysis" Background="{DynamicResource Brush.Accent.Subtle}"
                        Command="{Binding BottomPanel.Analysis.Transient.RunTransientCommand}"
                        IsEnabled="{Binding BottomPanel.Analysis.Transient.IsRunning, Converter={x:Static BoolConverters.Not}}"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,4" VerticalAlignment="Bottom"
                        IsVisible="{Binding BottomPanel.Analysis.Transient.HasResult}">
                <TextBlock Text=" " FontSize="{DynamicResource FontSize.Caption}" Margin="0,0,0,1"/>
                <Button Content="{loc:Localize Common.ExportCsv}" Classes="analysis" Background="{DynamicResource Brush.Accent.Subtle}"
                        Command="{Binding BottomPanel.Analysis.Transient.ExportCsvCommand}"/>
            </StackPanel>
            <!-- Plain-language help (#600 feedback, standardized in #907): what transient
                 mode adds over the S-matrix view, the three sources, delays/thresholds, and
                 how to read the plot. Same reusable "?" control as the other panels. -->
            <StackPanel Margin="0,0,0,4" VerticalAlignment="Bottom">
                <TextBlock Text=" " FontSize="{DynamicResource FontSize.Caption}" Margin="0,0,0,1"/>
                <controls:HelpFlyoutButton Title="{loc:Localize TransientHelp.Title}">
                    <controls:HelpFlyoutButton.HelpContent>
                        <panels:TransientHelpFlyout/>
                    </controls:HelpFlyoutButton.HelpContent>
                </controls:HelpFlyoutButton>
            </StackPanel>
        </WrapPanel>

        <!-- Status -->
        <TextBlock Text="{Binding BottomPanel.Analysis.Transient.StatusText}"
                   Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,2,0,2"
                   IsVisible="{Binding BottomPanel.Analysis.Transient.StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   TextWrapping="Wrap"/>

        <!-- Waveform plot: power vs time, one series per output pin.
             Plain wheel scrolls the analysis dock; Ctrl(/Cmd)+wheel zooms (#693,
             see ScrollFriendlyPlotController assigned in code-behind). -->
        <Border Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1"
                Height="200" Margin="0,2,0,0"
                IsVisible="{Binding BottomPanel.Analysis.Transient.HasResult}"
                ToolTip.Tip="{loc:Localize Analysis.Chart.ZoomHint}">
            <oxy:PlotView x:Name="WaveformPlot"
                          Model="{Binding BottomPanel.Analysis.Transient.PlotModel}" Background="Transparent"/>
        </Border>

        <!-- Per-pin visibility toggles (legend): flow horizontally, wrap down (responsive). -->
        <ItemsControl ItemsSource="{Binding BottomPanel.Analysis.Transient.Series}"
                      Margin="0,2,0,0"
                      IsVisible="{Binding BottomPanel.Analysis.Transient.HasResult}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="trace:TimeTraceSeriesViewModel">
                    <CheckBox IsChecked="{Binding IsVisible}" Margin="0,0,10,1">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Border Width="10" Height="10" CornerRadius="2"
                                    VerticalAlignment="Center" Background="{Binding ColorHex}"/>
                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Brush.Text.Secondary}"
                                       FontSize="{DynamicResource FontSize.Caption}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Peak-power summary table. -->
        <ScrollViewer MaxHeight="110" Margin="0,2,0,0"
                      IsVisible="{Binding BottomPanel.Analysis.Transient.ResultText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding BottomPanel.Analysis.Transient.ResultText}"
                       Foreground="{DynamicResource Brush.Accent.Hover}" FontFamily="Consolas" FontSize="{DynamicResource FontSize.Caption}"
                       TextWrapping="NoWrap"/>
        </ScrollViewer>
    </StackPanel>

</UserControl>
