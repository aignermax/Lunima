<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             xmlns:ha="using:CAP.Avalonia.Controls.HelpAnimations"
             x:Class="CAP.Avalonia.Views.Panels.OptimizationHelpFlyout">

    <!-- Help of the Optimization tab (#1362, #1352 pattern): three short sections
         (text budget, all five locales) plus one looping scene — a marker climbs a
         1-D objective curve: uphill steps are kept, a non-improving step bounces
         back with a visibly smaller step, and the best point so far glows green.
         The taller unvisited peak makes the "local best" caveat visible. Hosted as
         the HelpContent of the panel's HelpFlyoutButton, which supplies the title
         and the ScrollViewer. -->

    <StackPanel Spacing="8" MaxWidth="400">

        <TextBlock Classes="strong" Text="{loc:Localize OptimizeHelp.WhatTitle}"/>
        <TextBlock Classes="secondary" TextWrapping="Wrap"
                   Text="{loc:Localize OptimizeHelp.WhatBody}"/>

        <Border Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1"
                CornerRadius="{DynamicResource Radius.S}" Padding="4">
            <StackPanel Spacing="2">
                <ha:HillClimbAnimation Width="368" Height="150" IsHitTestVisible="False"/>
                <TextBlock Classes="caption" Text="{loc:Localize OptimizeHelp.AnimationCaption}" TextWrapping="Wrap" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <TextBlock Classes="strong" Text="{loc:Localize OptimizeHelp.BudgetSeedTitle}"/>
        <TextBlock Classes="secondary" TextWrapping="Wrap"
                   Text="{loc:Localize OptimizeHelp.BudgetSeedBody}"/>

        <TextBlock Classes="strong" Text="{loc:Localize OptimizeHelp.LocalTitle}"/>
        <TextBlock Classes="secondary" TextWrapping="Wrap"
                   Text="{loc:Localize OptimizeHelp.LocalBody}"/>

    </StackPanel>

</UserControl>
