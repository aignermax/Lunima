<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:CAP.Avalonia.Controls"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             x:Class="CAP.Avalonia.Views.Panels.WorkspaceHelpFlyout">

    <!-- The four workspaces, opened from the "?" beside the workspace switch. -->
    <StackPanel MaxWidth="380" Spacing="6">
        <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{loc:Localize Workspace.HelpIntro}"/>

        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
            <controls:Icon Data="{StaticResource Icon.Ruler}" Size="14" Foreground="{DynamicResource Brush.Accent.Hover}"/>
            <TextBlock Classes="strong" Text="{loc:Localize Workspace.Layout}"/>
        </StackPanel>
        <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{loc:Localize Workspace.HelpLayout}"/>

        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
            <controls:Icon Data="{StaticResource Icon.Waves}" Size="14" Foreground="{DynamicResource Brush.Accent.Hover}"/>
            <TextBlock Classes="strong" Text="{loc:Localize Workspace.Optics}"/>
        </StackPanel>
        <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{loc:Localize Workspace.HelpOptics}"/>

        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
            <controls:Icon Data="{StaticResource Icon.Binary}" Size="14" Foreground="{DynamicResource Brush.Accent.Hover}"/>
            <TextBlock Classes="strong" Text="{loc:Localize Workspace.Logic}"/>
        </StackPanel>
        <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{loc:Localize Workspace.HelpLogic}"/>

        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
            <controls:Icon Data="{StaticResource Icon.Boxes}" Size="14" Foreground="{DynamicResource Brush.Accent.Hover}"/>
            <TextBlock Classes="strong" Text="{loc:Localize Workspace.System}"/>
        </StackPanel>
        <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{loc:Localize Workspace.HelpSystem}"/>
    </StackPanel>

</UserControl>