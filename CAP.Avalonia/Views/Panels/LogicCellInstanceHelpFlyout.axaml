<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             xmlns:ha="using:CAP.Avalonia.Controls.HelpAnimations"
             x:Class="CAP.Avalonia.Views.Panels.LogicCellInstanceHelpFlyout">

    <!-- Cell-instance help of the Logic tab (#1411, #1152 pattern): three short
         sentences (text budget, all five locales) plus one looping "one template,
         stamped twice" diagram — a translucent copy of the template slides onto the
         CELL0 slot, then onto the CELL1 slot, then one register bit lights up in
         CELL0 only while CELL1 stays dark: independent state per instance. The
         stamp ghosts and the lit bit are the bespoke CellInstanceStampAnimation
         overlay. Hosted as the HelpContent of the HelpFlyoutButton next to the
         Outputs label (shown only when the network contains cell groups), which
         supplies the title and the ScrollViewer. -->

    <StackPanel Spacing="8" MaxWidth="400">

        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Primary}"
                   Text="{loc:Localize LogicPanelCellHelp.Body}"/>

        <!-- one template, stamped twice; the lit bit lives in CELL0 only. -->
        <Border Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1"
                CornerRadius="4" Padding="4">
            <StackPanel Spacing="2">
                <Canvas Width="368" Height="120">
                    <!-- the reusable template -->
                    <TextBlock Canvas.Left="14" Canvas.Top="16" Text="{loc:Localize LogicPanelCellHelp.DiagramTemplate}"
                               FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                    <Rectangle Canvas.Left="14" Canvas.Top="34" Width="96" Height="52"
                               Fill="{DynamicResource Brush.Surface.Raised}" Stroke="{DynamicResource Brush.Text.Secondary}" StrokeThickness="1"
                               RadiusX="4" RadiusY="4" StrokeDashArray="4,3"/>
                    <Rectangle Canvas.Left="24" Canvas.Top="55" Width="10" Height="10" Fill="{DynamicResource Brush.Surface.Hover}" Stroke="{DynamicResource Brush.Accent}"/>
                    <Rectangle Canvas.Left="44" Canvas.Top="55" Width="10" Height="10" Fill="{DynamicResource Brush.Surface.Hover}" Stroke="{DynamicResource Brush.Accent}"/>
                    <Rectangle Canvas.Left="64" Canvas.Top="55" Width="10" Height="10" Fill="{DynamicResource Brush.Surface.Hover}" Stroke="{DynamicResource Brush.Accent}"/>
                    <Rectangle Canvas.Left="84" Canvas.Top="55" Width="10" Height="10" Fill="{DynamicResource Brush.Surface.Hover}" Stroke="{DynamicResource Brush.Accent}"/>
                    <!-- stamping arrow: template → instances -->
                    <Line StartPoint="114,60" EndPoint="168,60" Stroke="{DynamicResource Brush.Text.Tertiary}" StrokeThickness="2"/>
                    <Polyline Points="160,54 170,60 160,66" Stroke="{DynamicResource Brush.Text.Tertiary}" StrokeThickness="2"/>
                    <!-- instance CELL0 -->
                    <Border Canvas.Left="176" Canvas.Top="8" Width="120" Height="46"
                            Background="{DynamicResource Brush.Surface.Hover}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1" CornerRadius="4"/>
                    <TextBlock Canvas.Left="182" Canvas.Top="12" Text="CELL0" FontSize="{DynamicResource FontSize.Caption}"
                               FontFamily="Consolas" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <Rectangle Canvas.Left="196" Canvas.Top="30" Width="10" Height="10" Fill="{DynamicResource Brush.Surface.Input}" Stroke="{DynamicResource Brush.Border.Strong}"/>
                    <Rectangle Canvas.Left="216" Canvas.Top="30" Width="10" Height="10" Fill="{DynamicResource Brush.Surface.Input}" Stroke="{DynamicResource Brush.Border.Strong}"/>
                    <Rectangle Canvas.Left="236" Canvas.Top="30" Width="10" Height="10" Fill="{DynamicResource Brush.Surface.Input}" Stroke="{DynamicResource Brush.Border.Strong}"/>
                    <Rectangle Canvas.Left="256" Canvas.Top="30" Width="10" Height="10" Fill="{DynamicResource Brush.Surface.Input}" Stroke="{DynamicResource Brush.Border.Strong}"/>
                    <TextBlock Canvas.Left="302" Canvas.Top="30" Text="CELL0/REG00" FontSize="{DynamicResource FontSize.Caption}"
                               FontFamily="Consolas" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                    <!-- instance CELL1 -->
                    <Border Canvas.Left="176" Canvas.Top="66" Width="120" Height="46"
                            Background="{DynamicResource Brush.Surface.Hover}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1" CornerRadius="4"/>
                    <TextBlock Canvas.Left="182" Canvas.Top="70" Text="CELL1" FontSize="{DynamicResource FontSize.Caption}"
                               FontFamily="Consolas" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <Rectangle Canvas.Left="196" Canvas.Top="88" Width="10" Height="10" Fill="{DynamicResource Brush.Surface.Input}" Stroke="{DynamicResource Brush.Border.Strong}"/>
                    <Rectangle Canvas.Left="216" Canvas.Top="88" Width="10" Height="10" Fill="{DynamicResource Brush.Surface.Input}" Stroke="{DynamicResource Brush.Border.Strong}"/>
                    <Rectangle Canvas.Left="236" Canvas.Top="88" Width="10" Height="10" Fill="{DynamicResource Brush.Surface.Input}" Stroke="{DynamicResource Brush.Border.Strong}"/>
                    <Rectangle Canvas.Left="256" Canvas.Top="88" Width="10" Height="10" Fill="{DynamicResource Brush.Surface.Input}" Stroke="{DynamicResource Brush.Border.Strong}"/>
                    <!-- animated stamp ghosts + the lit CELL0 bit -->
                    <ha:CellInstanceStampAnimation Width="368" Height="120" IsHitTestVisible="False"/>
                </Canvas>
                <TextBlock Text="{loc:Localize LogicPanelCellHelp.AnimationCaption}"
                           Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource FontSize.Caption}" TextWrapping="Wrap" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </StackPanel>

</UserControl>
