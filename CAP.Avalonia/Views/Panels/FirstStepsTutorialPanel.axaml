<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CAP.Avalonia.ViewModels.Onboarding.FirstStepsTutorial"
             xmlns:controls="using:CAP.Avalonia.Controls"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             x:Class="CAP.Avalonia.Views.Panels.FirstStepsTutorialPanel"
             x:DataType="vm:TutorialViewModel">

  <!-- The pointer demonstrates the action; this short cue stays beside it.
       Explanation is available on request and never advances the task. -->
  <Border Classes="overlay" Padding="10,6" Width="280" CornerRadius="12">
    <Grid ColumnDefinitions="*,Auto,Auto">
      <TextBlock Text="{Binding CurrentCue}" FontSize="14" FontWeight="SemiBold"
                 VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,6,0"/>
      <Button Grid.Column="1" Classes="ghost icon" ToolTip.Tip="{Binding CurrentTitle}"
              AutomationProperties.Name="{Binding CurrentTitle}">
        <controls:Icon Data="{StaticResource Icon.CircleHelp}"/>
        <Button.Flyout>
          <Flyout>
            <StackPanel MaxWidth="300" Spacing="8">
              <TextBlock Classes="label" Text="{Binding ProgressText}"/>
              <TextBlock Classes="subtitle" Text="{Binding CurrentTitle}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding CurrentBody}" TextWrapping="Wrap"/>
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
      <Button Grid.Column="2" Classes="ghost icon" Command="{Binding SkipCommand}"
              AutomationProperties.Name="{loc:Localize Tutorial.Skip}"
              ToolTip.Tip="{loc:Localize Tutorial.Skip}">
        <controls:Icon Data="{StaticResource Icon.X}"/>
      </Button>
    </Grid>
  </Border>
</UserControl>
