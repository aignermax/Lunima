<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             xmlns:ha="using:CAP.Avalonia.Controls.HelpAnimations"
             x:Class="CAP.Avalonia.Views.Panels.TruthTableHelpFlyout">

    <!-- Main help of the Truth Table panel (#1207, #1196 pattern): short sections
         (text budget, all five locales) plus one looping interference diagram — two
         input pulses and the always-on bias arm meet in a coupler; in phase they add
         (bright output pulse, badge 1), in anti-phase (π marker) they cancel (dark
         output, badge 0). Pulses are the LightPulseAlongPath primitive; output glow
         and badge are the bespoke InterferenceOutputAnimation overlay. Hosted as the
         HelpContent of the panel's HelpFlyoutButton, which supplies the title and
         the ScrollViewer. -->

    <StackPanel Spacing="8" MaxWidth="400">

        <TextBlock Classes="caption secondary" TextWrapping="Wrap"
                   Text="{loc:Localize TruthTableHelp.Intro}"/>

        <!-- interference → 0/1: in-phase inputs add, anti-phase inputs cancel. -->
        <Border Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1"
                CornerRadius="{DynamicResource Radius.S}" Padding="4">
            <StackPanel Spacing="2">
                <Canvas Width="368" Height="112">
                    <!-- Declared first so tracks and pulses slide *under* the coupler box.
                         First loop half (windows 0…0.3): both inputs in phase; second
                         half (0.58…0.88): anti-phase. The dim bias arm runs in both. -->
                    <ha:LightPulseAlongPath Width="368" Height="112" PathPoints="12,26 150,40"
                                            PulseBrush="{DynamicResource Brush.Warning}" PulseDiameter="10"
                                            WindowStart="0" WindowEnd="0.3" IsHitTestVisible="False"/>
                    <ha:LightPulseAlongPath Width="368" Height="112" PathPoints="12,86 150,72"
                                            PulseBrush="{DynamicResource Brush.Info}" PulseDiameter="10"
                                            WindowStart="0" WindowEnd="0.3" IsHitTestVisible="False"/>
                    <ha:LightPulseAlongPath Width="368" Height="112" PathPoints="12,56 150,56"
                                            PulseBrush="{DynamicResource Brush.Warning}" PulseDiameter="7"
                                            WindowStart="0" WindowEnd="0.3" IsHitTestVisible="False"/>
                    <ha:LightPulseAlongPath Width="368" Height="112" PathPoints="12,26 150,40"
                                            PulseBrush="{DynamicResource Brush.Warning}" PulseDiameter="10"
                                            WindowStart="0.58" WindowEnd="0.88" IsHitTestVisible="False"/>
                    <ha:LightPulseAlongPath Width="368" Height="112" PathPoints="12,86 150,72"
                                            PulseBrush="{DynamicResource Brush.Info}" PulseDiameter="10"
                                            WindowStart="0.58" WindowEnd="0.88" IsHitTestVisible="False"/>
                    <ha:LightPulseAlongPath Width="368" Height="112" PathPoints="12,56 150,56"
                                            PulseBrush="{DynamicResource Brush.Warning}" PulseDiameter="7"
                                            WindowStart="0.58" WindowEnd="0.88" IsHitTestVisible="False"/>
                    <!-- input labels -->
                    <TextBlock Classes="caption" Canvas.Left="2" Canvas.Top="12" Text="A"/>
                    <TextBlock Classes="caption" Canvas.Left="2" Canvas.Top="42" Text="BIAS"/>
                    <TextBlock Classes="caption" Canvas.Left="2" Canvas.Top="72" Text="B"/>
                    <!-- the coupler -->
                    <Border Canvas.Left="150" Canvas.Top="29" Width="80" Height="54"
                            Background="{DynamicResource Brush.Surface.Hover}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1" CornerRadius="4">
                        <TextBlock Classes="secondary" Text="{loc:Localize TruthTableHelp.DiagramCoupler}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- output waveguide to the 0/1 badge -->
                    <Line StartPoint="230,56" EndPoint="306,56" Stroke="{DynamicResource Brush.Border.Strong}" StrokeThickness="2"/>
                    <!-- animated output glow + 0/1 badge + π marker -->
                    <ha:InterferenceOutputAnimation Width="368" Height="112" IsHitTestVisible="False"/>
                </Canvas>
                <TextBlock Classes="caption" Text="{loc:Localize TruthTableHelp.AnimationCaption}" TextWrapping="Wrap" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <TextBlock Classes="strong" Text="{loc:Localize TruthTableHelp.SimulationTitle}"/>
        <TextBlock Classes="secondary" TextWrapping="Wrap"
                   Text="{loc:Localize TruthTableHelp.SimulationBody}"/>

        <TextBlock Classes="strong" Text="{loc:Localize TruthTableHelp.ThresholdTitle}" Margin="0,4,0,0"/>
        <TextBlock Classes="secondary" TextWrapping="Wrap"
                   Text="{loc:Localize TruthTableHelp.ThresholdBody}"/>

        <TextBlock Classes="strong" Text="{loc:Localize TruthTableHelp.InterferenceTitle}" Margin="0,4,0,0"/>
        <TextBlock Classes="secondary" TextWrapping="Wrap"
                   Text="{loc:Localize TruthTableHelp.InterferenceBody}"/>

        <TextBlock Classes="strong" Text="{loc:Localize TruthTableHelp.BiasTitle}" Margin="0,4,0,0"/>
        <TextBlock Classes="secondary" TextWrapping="Wrap"
                   Text="{loc:Localize TruthTableHelp.BiasBody}"/>

        <TextBlock Classes="strong" Text="{loc:Localize TruthTableHelp.SignalsTitle}" Margin="0,4,0,0"/>
        <TextBlock Classes="secondary" TextWrapping="Wrap"
                   Text="{loc:Localize TruthTableHelp.SignalsBody}"/>
    </StackPanel>

</UserControl>
