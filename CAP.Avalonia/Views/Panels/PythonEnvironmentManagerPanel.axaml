<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CAP.Avalonia.ViewModels.Export.PythonEnvironmentManager"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             x:Class="CAP.Avalonia.Views.Panels.PythonEnvironmentManagerPanel"
             x:DataType="vm:PythonEnvironmentManagerViewModel">

    <StackPanel x:Name="PanelRoot">
        <TextBlock Text="{loc:Localize PyEnvMgr.Title}" Foreground="{DynamicResource Brush.Info}"
                   Margin="0,0,0,5" FontWeight="SemiBold"/>
        <TextBlock Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="{loc:Localize PyEnvMgr.Description}"/>

        <!-- Create new managed environment (#645); the name is auto-generated from the version (#698). -->
        <TextBlock Text="{loc:Localize PyEnvMgr.CreateHeading}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource FontSize.Caption}"
                   Margin="0,0,0,4"/>
        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
            <TextBlock Text="Python:" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource FontSize.Caption}"
                       VerticalAlignment="Center" Width="50"/>
            <ComboBox ItemsSource="{Binding PythonVersionChoices}"
                      SelectedItem="{Binding PythonVersion}"
                      Width="90" FontSize="{DynamicResource FontSize.Caption}"
                      ToolTip.Tip="{loc:Localize PyEnvMgr.AutoNameTip}"/>
        </StackPanel>
        <Button Content="{loc:Localize PyEnvMgr.CreateInstall}"
                Command="{Binding CreateAndInstallCommand}"
                Background="{DynamicResource Brush.Accent.Subtle}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,0,0,6"
                ToolTip.Tip="{loc:Localize PyEnvMgr.CreateInstallTip}"
                IsEnabled="{Binding IsBusy,
                                    Converter={x:Static BoolConverters.Not}}"/>

        <!-- Progress and cancel -->
        <StackPanel IsVisible="{Binding IsBusy}" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding ProgressText}"
                           Foreground="{DynamicResource Brush.Info}" FontSize="{DynamicResource FontSize.Caption}" TextWrapping="Wrap"/>
                <Button Content="{loc:Localize Common.Cancel}"
                        Command="{Binding CancelCommand}"
                        FontSize="{DynamicResource FontSize.Caption}" Padding="6,2" Background="{DynamicResource Brush.Danger.Subtle}"
                        IsEnabled="{Binding CanCancel}"/>
            </StackPanel>
        </StackPanel>

        <!-- Unified interpreter list: managed environments (with health + remove) and
             discovered system Pythons, each activatable the same way (issue #645). -->
        <Separator Margin="0,6,0,6" Background="{DynamicResource Brush.Surface.Raised}"/>
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
            <TextBlock Grid.Column="0" Text="{loc:Localize PyEnvMgr.AvailableInterpreters}"
                       Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource FontSize.Caption}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="{loc:Localize PyEnvMgr.Rescan}" Padding="10,3" FontSize="{DynamicResource FontSize.Caption}"
                    Command="{Binding RefreshInterpretersCommand}"
                    ToolTip.Tip="{loc:Localize PyEnvMgr.RescanTip}"
                    IsEnabled="{Binding IsDiscoveringInterpreters,
                                        Converter={x:Static BoolConverters.Not}}"/>
        </Grid>

        <!-- Prominent scanning indicator: discovery shells out to every candidate Python and
             can take several seconds, so show an animated bar + explanation (issue #645). -->
        <Border IsVisible="{Binding IsDiscoveringInterpreters}"
                Background="{DynamicResource Brush.Surface.Hover}" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
            <StackPanel Spacing="5">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="🔍" FontSize="{DynamicResource FontSize.Body}" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Localize PyEnvMgr.Searching}"
                               Foreground="{DynamicResource Brush.Info}" FontSize="{DynamicResource FontSize.Caption}" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{loc:Localize PyEnvMgr.Probing}"
                           Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource FontSize.Caption}" TextWrapping="Wrap"/>
                <ProgressBar IsIndeterminate="True" Height="4" Foreground="{DynamicResource Brush.Info}"/>
            </StackPanel>
        </Border>

        <TextBlock Text="{loc:Localize PyEnvMgr.NoInterpreters}"
                   Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource FontSize.Caption}" TextWrapping="Wrap" Margin="0,0,0,4"
                   IsVisible="{Binding ShowNoInterpretersHint}"/>

        <ScrollViewer MaxHeight="260" Margin="0,0,0,6"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      IsVisible="{Binding Interpreters.Count}">
            <ItemsControl ItemsSource="{Binding Interpreters}" x:Name="InterpretersList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Cap at PanelRoot's arranged width: the host's padded ScrollViewer measures
                             this row ~48px too wide (Avalonia deflates Padding only at arrange), which
                             pushed the action buttons past the viewport (issue #698). -->
                        <Border Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1"
                                CornerRadius="3" Margin="0,2,0,0" Padding="6,4"
                                MaxWidth="{Binding #PanelRoot.Bounds.Width}">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" VerticalAlignment="Center">
                                <!-- Interpreter info (not clickable — activation is an explicit button) -->
                                <!-- ClipToBounds: an unbreakable long token (e.g. the path) must never
                                     paint over the action buttons — Grid cells do not clip by default. -->
                                <StackPanel Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center"
                                            ClipToBounds="True">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Grid.Column="0" CornerRadius="3" Padding="4,1" Background="{DynamicResource Brush.Surface.Hover}"
                                                VerticalAlignment="Top" Margin="0,0,6,0"
                                                IsVisible="{Binding HasStatusBadge}">
                                            <TextBlock Text="{Binding StatusBadge}"
                                                       Foreground="{Binding StatusColor}" FontSize="{DynamicResource FontSize.Caption}"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayText}" Foreground="{DynamicResource Brush.Text.Secondary}"
                                                   FontSize="{DynamicResource FontSize.Caption}" TextWrapping="Wrap"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Path}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource FontSize.Caption}"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Path}"/>
                                </StackPanel>

                                <!-- Currently active: static indicator -->
                                <Border Grid.Column="1" IsVisible="{Binding IsActive}"
                                        VerticalAlignment="Center" Margin="2,0,0,0"
                                        CornerRadius="3" Padding="8,3" Background="{DynamicResource Brush.Success.Subtle}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="✓" Foreground="{DynamicResource Brush.Warning}" FontWeight="Bold" FontSize="{DynamicResource FontSize.Caption}"/>
                                        <TextBlock Text="{loc:Localize PyEnvMgr.Active}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource FontSize.Caption}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Not active: explicit button to switch the active interpreter -->
                                <Button Grid.Column="1" Content="{loc:Localize PyEnvMgr.SetActive}"
                                        IsVisible="{Binding !IsActive}"
                                        Command="{Binding #InterpretersList.DataContext.SetActiveInterpreterCommand}"
                                        CommandParameter="{Binding}"
                                        VerticalAlignment="Center" Margin="2,0,0,0"
                                        Padding="10,3" FontSize="{DynamicResource FontSize.Caption}" Background="{DynamicResource Brush.Success.Subtle}"
                                        ToolTip.Tip="{loc:Localize PyEnvMgr.SetActiveTip}"/>

                                <!-- Managed-only: health check -->
                                <Button Grid.Column="2" Content="{loc:Localize PyEnvMgr.Check}"
                                        Command="{Binding #InterpretersList.DataContext.CheckHealthInterpreterCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding IsManaged}"
                                        VerticalAlignment="Center" Margin="4,0,0,0"
                                        Padding="8,3" FontSize="{DynamicResource FontSize.Caption}" Background="{DynamicResource Brush.Accent.Subtle}"
                                        ToolTip.Tip="{loc:Localize PyEnvMgr.CheckTip}"/>

                                <!-- Managed-only: remove -->
                                <Button Grid.Column="3" Content="✕"
                                        Command="{Binding #InterpretersList.DataContext.RemoveInterpreterCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding IsManaged}"
                                        VerticalAlignment="Center" Margin="4,0,0,0"
                                        Padding="8,3" FontSize="{DynamicResource FontSize.Caption}" Background="{DynamicResource Brush.Danger.Subtle}"
                                        ToolTip.Tip="{loc:Localize PyEnvMgr.RemoveTip}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Status (idle) -->
        <TextBlock Text="{Binding ProgressText}"
                   Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="{DynamicResource FontSize.Caption}" TextWrapping="Wrap"
                   IsVisible="{Binding IsBusy,
                                       Converter={x:Static BoolConverters.Not}}"
                   Margin="0,0,0,4"/>
    </StackPanel>

</UserControl>
