<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CAP.Avalonia.ViewModels.Export.PythonEnvironmentManager"
             xmlns:controls="using:CAP.Avalonia.Controls"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             x:Class="CAP.Avalonia.Views.Panels.PythonEnvironmentManagerPanel"
             x:DataType="vm:PythonEnvironmentManagerViewModel">

    <StackPanel x:Name="PanelRoot">
        <TextBlock Classes="subtitle" Text="{loc:Localize PyEnvMgr.Title}" Margin="0,0,0,4"/>
        <TextBlock Classes="caption" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="{loc:Localize PyEnvMgr.Description}"/>

        <!-- Create new managed environment (#645); the name is auto-generated from the version (#698). -->
        <TextBlock Classes="caption" Text="{loc:Localize PyEnvMgr.CreateHeading}"
                   Margin="0,0,0,4"/>
        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
            <TextBlock Classes="caption" Text="Python:"
                       VerticalAlignment="Center" Width="50"/>
            <ComboBox ItemsSource="{Binding PythonVersionChoices}"
                      SelectedItem="{Binding PythonVersion}"
                      Width="90"
                      ToolTip.Tip="{loc:Localize PyEnvMgr.AutoNameTip}"/>
        </StackPanel>
        <Button Classes="primary" Content="{loc:Localize PyEnvMgr.CreateInstall}"
                Command="{Binding CreateAndInstallCommand}" Margin="0,0,0,6"
                ToolTip.Tip="{loc:Localize PyEnvMgr.CreateInstallTip}"
                IsEnabled="{Binding IsBusy,
                                    Converter={x:Static BoolConverters.Not}}"/>

        <!-- Progress and cancel -->
        <StackPanel IsVisible="{Binding IsBusy}" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="caption" Text="{Binding ProgressText}" TextWrapping="Wrap"/>
                <Button Content="{loc:Localize Common.Cancel}"
                        Command="{Binding CancelCommand}"
                        IsEnabled="{Binding CanCancel}"/>
            </StackPanel>
        </StackPanel>

        <!-- Unified interpreter list: managed environments (with health + remove) and
             discovered system Pythons, each activatable the same way (issue #645). -->
        <Border Classes="divider" Margin="0,8"/>
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
            <TextBlock Classes="caption" Grid.Column="0" Text="{loc:Localize PyEnvMgr.AvailableInterpreters}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="{loc:Localize PyEnvMgr.Rescan}"
                    Command="{Binding RefreshInterpretersCommand}"
                    ToolTip.Tip="{loc:Localize PyEnvMgr.RescanTip}"
                    IsEnabled="{Binding IsDiscoveringInterpreters,
                                        Converter={x:Static BoolConverters.Not}}"/>
        </Grid>

        <!-- Prominent scanning indicator: discovery shells out to every candidate Python and
             can take several seconds, so show an animated bar + explanation (issue #645). -->
        <Border IsVisible="{Binding IsDiscoveringInterpreters}"
                Classes="card" Padding="8,6" Margin="0,0,0,6">
            <StackPanel Spacing="5">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <controls:Icon Data="{StaticResource Icon.Search}" Foreground="{DynamicResource Brush.Info}"/>
                    <TextBlock Text="{loc:Localize PyEnvMgr.Searching}"
                               Classes="strong"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Classes="caption" Text="{loc:Localize PyEnvMgr.Probing}" TextWrapping="Wrap"/>
                <ProgressBar IsIndeterminate="True" Height="4" Foreground="{DynamicResource Brush.Info}"/>
            </StackPanel>
        </Border>

        <TextBlock Classes="caption" Text="{loc:Localize PyEnvMgr.NoInterpreters}" TextWrapping="Wrap" Margin="0,0,0,4"
                   IsVisible="{Binding ShowNoInterpretersHint}"/>

        <ScrollViewer MaxHeight="260" Margin="0,0,0,6"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      IsVisible="{Binding Interpreters.Count}">
            <ItemsControl ItemsSource="{Binding Interpreters}" x:Name="InterpretersList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Cap at PanelRoot's arranged width: the host's padded ScrollViewer measures
                             this row ~48px too wide (Avalonia deflates Padding only at arrange), which
                             pushed the action buttons past the viewport (issue #698). -->
                        <Border Classes="card" Margin="0,2,0,0" Padding="8,6"
                                MaxWidth="{Binding #PanelRoot.Bounds.Width}">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" VerticalAlignment="Center">
                                <!-- Interpreter info (not clickable — activation is an explicit button) -->
                                <!-- ClipToBounds: an unbreakable long token (e.g. the path) must never
                                     paint over the action buttons — Grid cells do not clip by default. -->
                                <StackPanel Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center"
                                            ClipToBounds="True">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Grid.Column="0" Classes="chip" Classes.success="{Binding IsHealthy}"
                                                Classes.danger="{Binding IsBroken}" Classes.warning="{Binding IsInProgress}"
                                                VerticalAlignment="Top" Margin="0,0,6,0"
                                                IsVisible="{Binding HasStatusBadge}">
                                            <TextBlock Text="{Binding StatusBadge}"/>
                                        </Border>
                                        <TextBlock Classes="secondary" Grid.Column="1" Text="{Binding DisplayText}" TextWrapping="Wrap"/>
                                    </Grid>
                                    <TextBlock Classes="caption" Text="{Binding Path}"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Path}"/>
                                </StackPanel>

                                <!-- Currently active: static indicator -->
                                <Border Grid.Column="1" IsVisible="{Binding IsActive}"
                                        VerticalAlignment="Center" Margin="2,0,0,0"
                                        CornerRadius="{DynamicResource Radius.S}" Padding="8,3" Background="{DynamicResource Brush.Success.Subtle}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <controls:Icon Data="{StaticResource Icon.Check}" Size="14" Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Center"/>
                                        <TextBlock Classes="secondary" Text="{loc:Localize PyEnvMgr.Active}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Not active: explicit button to switch the active interpreter -->
                                <Button Grid.Column="1" Content="{loc:Localize PyEnvMgr.SetActive}"
                                        IsVisible="{Binding !IsActive}"
                                        Command="{Binding #InterpretersList.DataContext.SetActiveInterpreterCommand}"
                                        CommandParameter="{Binding}"
                                        VerticalAlignment="Center" Margin="2,0,0,0"
                                        ToolTip.Tip="{loc:Localize PyEnvMgr.SetActiveTip}"/>

                                <!-- Managed-only: health check -->
                                <Button Grid.Column="2" Content="{loc:Localize PyEnvMgr.Check}"
                                        Command="{Binding #InterpretersList.DataContext.CheckHealthInterpreterCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding IsManaged}"
                                        VerticalAlignment="Center" Margin="4,0,0,0"
                                        ToolTip.Tip="{loc:Localize PyEnvMgr.CheckTip}"/>

                                <!-- Managed-only: remove -->
                                <Button Classes="ghost icon" Grid.Column="3"
                                        Command="{Binding #InterpretersList.DataContext.RemoveInterpreterCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding IsManaged}"
                                        VerticalAlignment="Center" Margin="4,0,0,0"
                                        ToolTip.Tip="{loc:Localize PyEnvMgr.RemoveTip}">
                <controls:Icon Data="{StaticResource Icon.X}"/>
            </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Status (idle) -->
        <TextBlock Classes="caption" Text="{Binding ProgressText}" TextWrapping="Wrap"
                   IsVisible="{Binding IsBusy,
                                       Converter={x:Static BoolConverters.Not}}"
                   Margin="0,0,0,4"/>
    </StackPanel>

</UserControl>
