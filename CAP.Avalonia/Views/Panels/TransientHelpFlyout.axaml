<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             xmlns:ha="using:CAP.Avalonia.Controls.HelpAnimations"
             x:Class="CAP.Avalonia.Views.Panels.TransientHelpFlyout"
             MaxWidth="420">

    <!-- Plain-language explainer for Transient mode (#600 user feedback): short
         sections (#1152 text budget) plus a looping light-pulse animation (laser →
         your circuit → split to the outputs) composed from the LightPulseAlongPath
         primitive. Shown as the HelpContent of the panel's HelpFlyoutButton, which
         renders the title. -->

    <ScrollViewer MaxHeight="440">
        <StackPanel Margin="12" Spacing="8">

            <!-- Looping animation: laser → chip → split to two outputs. -->
            <Border Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1"
                    CornerRadius="4" Padding="4">
                <Canvas Width="380" Height="80">
                    <!-- Animated light pulses (in, then split top/bottom). Declared first so
                         tracks and pulses slide *under* the chip box: the pulse visibly
                         enters the circuit and the two split pulses emerge from it. -->
                    <ha:LightPulseAlongPath Width="380" Height="80" IsHitTestVisible="False"
                                            PathPoints="36,40 195,40" PulseBrush="{DynamicResource Brush.Warning}" PulseDiameter="12"
                                            WindowStart="0" WindowEnd="0.5"/>
                    <ha:LightPulseAlongPath Width="380" Height="80" IsHitTestVisible="False"
                                            PathPoints="195,40 339,22" PulseBrush="{DynamicResource Brush.Info}" PulseDiameter="10"
                                            WindowStart="0.5" WindowEnd="1"/>
                    <ha:LightPulseAlongPath Width="380" Height="80" IsHitTestVisible="False"
                                            PathPoints="195,40 339,58" PulseBrush="{DynamicResource Brush.Danger}" PulseDiameter="10"
                                            WindowStart="0.5" WindowEnd="1"/>
                    <!-- Laser source -->
                    <Ellipse Canvas.Left="10" Canvas.Top="30" Width="20" Height="20" Fill="{DynamicResource Brush.Warning}"/>
                    <TextBlock Canvas.Left="2" Canvas.Top="54" Text="{loc:Localize TransientHelp.DiagramLightSource}"
                               FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                    <!-- The user's circuit -->
                    <Border Canvas.Left="150" Canvas.Top="18" Width="90" Height="44"
                            Background="{DynamicResource Brush.Surface.Hover}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1" CornerRadius="4">
                        <TextBlock Text="{loc:Localize TransientHelp.DiagramCircuit}" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- Outputs -->
                    <Ellipse Canvas.Left="338" Canvas.Top="16" Width="12" Height="12"
                             Fill="Transparent" Stroke="{DynamicResource Brush.Info}" StrokeThickness="2"/>
                    <Ellipse Canvas.Left="338" Canvas.Top="52" Width="12" Height="12"
                             Fill="Transparent" Stroke="{DynamicResource Brush.Danger}" StrokeThickness="2"/>
                    <TextBlock Canvas.Left="330" Canvas.Top="0" Text="{loc:Localize TransientHelp.DiagramOutputs}"
                               FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                </Canvas>
            </Border>

            <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}"
                       Text="{loc:Localize TransientHelp.Intro1}"/>

            <TextBlock Text="{loc:Localize TransientHelp.SourcesTitle}" FontWeight="Bold" FontSize="{DynamicResource FontSize.Body}"
                       Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,4,0,0"/>
            <StackPanel Spacing="5">
                <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}">
                    <Run FontWeight="Bold" Foreground="{DynamicResource Brush.Warning}" Text="{loc:Localize TransientHelp.GaussianLabel}"/>
                    <Run Text="{loc:Localize TransientHelp.GaussianBody}"/>
                </TextBlock>
                <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}">
                    <Run FontWeight="Bold" Foreground="{DynamicResource Brush.Success}" Text="{loc:Localize TransientHelp.CwLabel}"/>
                    <Run Text="{loc:Localize TransientHelp.CwBody}"/>
                </TextBlock>
                <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}">
                    <Run FontWeight="Bold" Foreground="{DynamicResource Brush.Info}">PRBS-NRZ</Run>
                    <Run Text="{loc:Localize TransientHelp.PrbsBody}"/>
                </TextBlock>
            </StackPanel>

            <TextBlock Text="{loc:Localize TransientHelp.ReadingTitle}" FontWeight="Bold" FontSize="{DynamicResource FontSize.Body}"
                       Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,4,0,0"/>
            <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}"
                       Text="{loc:Localize TransientHelp.ReadingBody}"/>

        </StackPanel>
    </ScrollViewer>

</UserControl>
