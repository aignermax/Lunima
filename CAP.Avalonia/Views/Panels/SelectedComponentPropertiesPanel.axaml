<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CAP.Avalonia.ViewModels"
             xmlns:editors="using:CAP.Avalonia.ViewModels.Properties.Editors"
             xmlns:controls="using:CAP.Avalonia.Controls"
             xmlns:panels="using:CAP.Avalonia.Views.Panels"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             x:Class="CAP.Avalonia.Views.Panels.SelectedComponentPropertiesPanel"
             x:DataType="vm:MainViewModel">

    <StackPanel>
        <!-- Nothing selected: what this panel is for, in one sentence. -->
        <Border Classes="empty-state" Margin="0,32,0,0" IsVisible="{Binding !StatusBar.HasSelection}">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <controls:Icon Data="{StaticResource Icon.MousePointerClick}" Size="24"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                <TextBlock Classes="secondary" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="240"
                           Text="{loc:Localize Properties.EmptyStateShort}"/>
            </StackPanel>
        </Border>

        <!-- Name / position / size readout. Bound to the canonical canvas selection so the
             group name is correct and the position updates live while the component is dragged. -->
        <StackPanel IsVisible="{Binding RightPanel.HasSelectedComponentEditor}" Spacing="2">
            <TextBlock Classes="label" Text="{loc:Localize Properties.SelectedComponent}"/>
            <TextBlock Classes="subtitle" TextTrimming="CharacterEllipsis"
                       Text="{Binding CanvasInteraction.SelectedComponent.DisplayName, FallbackValue='-'}"/>
            <TextBlock Classes="caption" Text="{Binding CanvasInteraction.SelectedComponent.ComponentTypeName}"
                       IsVisible="{Binding CanvasInteraction.SelectedComponent.ComponentTypeName, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}"/>

            <Grid ColumnDefinitions="72,*" RowDefinitions="Auto,Auto" Margin="0,12,0,0">
                <TextBlock Grid.Row="0" Classes="label" VerticalAlignment="Center"
                           Text="{loc:Localize Properties.PositionLabel}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Classes="mono">
                    <Run Text="X "/><Run Text="{Binding CanvasInteraction.SelectedComponent.X, Mode=OneWay, StringFormat={}{0:F1}, FallbackValue='-'}"/>
                    <Run Text="   "/>
                    <Run Text="Y "/><Run Text="{Binding CanvasInteraction.SelectedComponent.Y, Mode=OneWay, StringFormat={}{0:F1}, FallbackValue='-'}"/>
                    <Run Text=" µm"/>
                </TextBlock>
                <TextBlock Grid.Row="1" Classes="label" VerticalAlignment="Center" Margin="0,8,0,0"
                           Text="{loc:Localize Properties.Size}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono" Margin="0,8,0,0">
                    <Run Text="{Binding CanvasInteraction.SelectedComponent.Width, Mode=OneWay, StringFormat={}{0:F0}, FallbackValue='-'}"/>
                    <Run Text=" × "/>
                    <Run Text="{Binding CanvasInteraction.SelectedComponent.Height, Mode=OneWay, StringFormat={}{0:F0}, FallbackValue='-'}"/>
                    <Run Text=" µm"/>
                </TextBlock>
            </Grid>

            <!-- Manual light-source mark: imported GDS cells can't be recognized by name —
                 the toggle gives them the laser editor and the simulation-source role. -->
            <ToggleSwitch Content="{loc:Localize Properties.MarkAsLightSource}"
                          IsChecked="{Binding CanvasInteraction.SelectedComponent.IsUserMarkedLightSource, Mode=TwoWay, FallbackValue=False}"
                          IsVisible="{Binding CanvasInteraction.SelectedComponent.ShowLightSourceMarkToggle, FallbackValue=False}"
                          Margin="0,8,0,0"
                          ToolTip.Tip="{loc:Localize Properties.MarkAsLightSourceTip}"/>
        </StackPanel>

        <!-- Editor host: DataTemplates pick the right view per editor VM type.
             Name/position/size are shown by the readout above, so the templates
             only carry component-specific controls. -->
        <ContentControl Content="{Binding RightPanel.SelectedComponentEditor}"
                        Margin="0,16,0,0"
                        IsVisible="{Binding RightPanel.HasSelectedComponentEditor}">
            <ContentControl.Resources>
                <!-- ONA Analyzer: just an "open window" button -->
                <DataTemplate x:Key="OnaAnalyzerTpl" x:DataType="editors:OnaAnalyzerEditorViewModel">
                    <StackPanel>
                        <TextBlock Text="{loc:Localize SelectedProps.OnaDescription}"
                                   Classes="caption" Margin="0,2,0,8" TextWrapping="Wrap"/>
                        <Button Content="{loc:Localize SelectedProps.OpenOnaSweep}"
                                Command="{Binding OpenSweepCommand}"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </DataTemplate>

                <!-- Parametric components: one labeled, unit-aware row per
                     named physical parameter (e.g. MMI insertion loss / splitting ratio).
                     The header makes explicit that edits drive the SIMULATION MODEL
                     only — the GDS layout/geometry is never touched by these values. -->
                <DataTemplate x:Key="ParamsTpl" x:DataType="editors:ParametricParametersEditorViewModel">
                    <StackPanel>
                        <TextBlock Classes="label" Text="{loc:Localize SelectedProps.SimulationParams}"/>
                        <TextBlock Text="{loc:Localize SelectedProps.SimulationParamsHint}"
                                   Classes="caption" TextWrapping="Wrap" Margin="0,2,0,4"/>
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="editors:ParameterRowViewModel">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                            <TextBlock Classes="caption" Text="{Binding Label}"/>
                                            <TextBlock Classes="caption" IsVisible="{Binding HasUnit}">
                                                <Run Text=" ["/><Run Text="{Binding Unit}"/><Run Text="]"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,80">
                                            <Slider Grid.Column="0"
                                                    Minimum="{Binding Min}" Maximum="{Binding Max}"
                                                    Value="{Binding Value, Mode=TwoWay}"/>
                                            <NumericUpDown Grid.Column="1"
                                                           Value="{Binding Value, Mode=TwoWay}"
                                                           Minimum="{Binding Min}" Maximum="{Binding Max}"
                                                           Increment="1" FormatString="F2"
                                                           ShowButtonSpinner="False"
                                                           VerticalAlignment="Center"
                                                           Margin="6,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>

                <!-- Slider-driven components (phase shifter, tunable coupler) -->
                <DataTemplate x:Key="SliderTpl" x:DataType="editors:SliderEditorViewModel">
                    <StackPanel>
                        <TextBlock Text="{Binding SliderLabel}" Classes="caption" Margin="0,4,0,2"/>
                        <Grid ColumnDefinitions="*,80">
                            <Slider Grid.Column="0"
                                    Minimum="{Binding Min}" Maximum="{Binding Max}"
                                    Value="{Binding Value, Mode=TwoWay}"/>
                            <!-- No spinner buttons (#779): in the 80px column Fluent's two
                                 spinners would cover the value entirely. The slider handles
                                 stepping; this stays a validated numeric text input. -->
                            <NumericUpDown Grid.Column="1"
                                           Value="{Binding Value, Mode=TwoWay}"
                                           Minimum="{Binding Min}" Maximum="{Binding Max}"
                                           Increment="1" FormatString="F2"
                                           ShowButtonSpinner="False"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </DataTemplate>

                <!-- Light-source components (grating coupler, edge coupler).
                     Wavelength is a curated dropdown of simulation-supported values,
                     not a free numeric field. -->
                <DataTemplate x:Key="LightSourceTpl" x:DataType="editors:LightSourceEditorViewModel">
                    <StackPanel>
                        <!-- Laser on/off (#690): a coupler with its laser off is listen-only,
                             i.e. an output. Shares LaserConfig with the canvas laser icon. -->
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,2">
                            <TextBlock Text="{loc:Localize SelectedProps.Laser}" Classes="caption"
                                       VerticalAlignment="Center"/>
                            <!-- Plain-language help (#907, migrated to the extracted
                                 LaserHelpFlyout in #1220): what wavelength/power mean, why
                                 the source is single-wavelength CW, and what the canvas
                                 colors show — plus a looping light-enters-the-circuit
                                 animation. -->
                            <controls:HelpFlyoutButton Title="{loc:Localize LaserHelp.Title}"
                                                       VerticalAlignment="Center">
                                <controls:HelpFlyoutButton.HelpContent>
                                    <panels:LaserHelpFlyout/>
                                </controls:HelpFlyoutButton.HelpContent>
                            </controls:HelpFlyoutButton>
                        </StackPanel>
                        <ToggleSwitch IsChecked="{Binding LaserConfig.IsEnabled, Mode=TwoWay}"
                                      OnContent="{loc:Localize SelectedProps.LaserOn}" OffContent="{loc:Localize SelectedProps.LaserOff}"
                                      Margin="0,0,0,4"/>
                        <TextBlock Text="{loc:Localize SelectedProps.Wavelength}" Classes="caption" Margin="0,4,0,2"/>
                        <ComboBox ItemsSource="{Binding WavelengthOptions}"
                                  SelectedValue="{Binding LaserConfig.WavelengthNm, Mode=TwoWay}"
                                  SelectedValueBinding="{Binding WavelengthNm}"
                                  DisplayMemberBinding="{Binding Label}"
                                  IsEnabled="{Binding LaserConfig.IsEnabled}"
                                  HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
                        <TextBlock Text="{loc:Localize SelectedProps.InputPower}" Classes="caption" Margin="0,0,0,2"/>
                        <Slider Minimum="0" Maximum="1"
                                Value="{Binding LaserConfig.InputPower, Mode=TwoWay}"
                                IsEnabled="{Binding LaserConfig.IsEnabled}"
                                TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                        <TextBlock Classes="caption mono">
                            <Run Text="{loc:Localize SelectedProps.Power}"/>
                            <Run Text="{Binding LaserConfig.InputPower, Mode=OneWay, StringFormat={}{0:F2}}"/>
                        </TextBlock>

                        <!-- Realistic source spectrum (#819): line shape + FWHM linewidth.
                             "Ideal" keeps today's single-wavelength behaviour. -->
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,8,0,2">
                            <TextBlock Text="{loc:Localize SelectedProps.LineShape}" Classes="caption"
                                       VerticalAlignment="Center"/>
                            <Button Classes="rowAction" VerticalAlignment="Center"
                                    ToolTip.Tip="{loc:Localize SelectedProps.LineShapeHint}">
                                <controls:Icon Data="{StaticResource Icon.CircleHelp}"/>
                                <Button.Flyout>
                                    <Flyout>
                                        <!-- Short text + animated spectrum sweep (#1152). -->
                                        <panels:LineShapeHelpFlyout/>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding LineShapeOptions}"
                                  SelectedValue="{Binding LaserConfig.LineShape, Mode=TwoWay}"
                                  SelectedValueBinding="{Binding Value}"
                                  DisplayMemberBinding="{Binding Label}"
                                  IsEnabled="{Binding LaserConfig.IsEnabled}"
                                  HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                        <StackPanel IsVisible="{Binding LaserConfig.IsSpectralShape}">
                            <TextBlock Text="{loc:Localize SelectedProps.Linewidth}" Classes="caption" Margin="0,2,0,2"/>
                            <Grid ColumnDefinitions="*,30">
                                <NumericUpDown Grid.Column="0"
                                               Value="{Binding LaserConfig.LinewidthFwhmNm, Mode=TwoWay}"
                                               Minimum="0.1" Maximum="50" Increment="0.5"
                                               FormatString="F1" ShowButtonSpinner="False"
                                               IsEnabled="{Binding LaserConfig.IsEnabled}"/>
                                <TextBlock Grid.Column="1" Text="nm" Classes="caption"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                            <TextBlock Text="{loc:Localize SelectedProps.LinewidthHint}"
                                       Classes="caption" TextWrapping="Wrap" Margin="0,2,0,2"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,4,0,2">
                            <TextBlock Text="{loc:Localize SelectedProps.Rin}" Classes="caption"
                                       VerticalAlignment="Center"/>
                            <Button Classes="rowAction" VerticalAlignment="Center"
                                    ToolTip.Tip="{loc:Localize SelectedProps.RinHint}">
                                <controls:Icon Data="{StaticResource Icon.CircleHelp}"/>
                                <Button.Flyout>
                                    <Flyout>
                                        <!-- Short text + animated power-wobble trace (#1152). -->
                                        <panels:RinHelpFlyout/>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <Slider Minimum="-200" Maximum="-80"
                                Value="{Binding LaserConfig.RinDbPerHz, Mode=TwoWay}"
                                IsEnabled="{Binding LaserConfig.IsEnabled}"
                                TickFrequency="5" IsSnapToTickEnabled="True"/>
                        <TextBlock Classes="caption mono">
                            <Run Text="{Binding LaserConfig.RinDbPerHz, Mode=OneWay, StringFormat={}{0:F0}}"/>
                            <Run Text="dB/Hz"/>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>

                <!-- Fallback: PDK function only (name/position/size come from the readout above).
                     An explicit hint replaces the previously-empty section so users know the
                     component's S-matrix is fixed rather than suspecting a broken editor. -->
                <DataTemplate x:Key="GenericTpl" x:DataType="editors:GenericComponentEditorViewModel">
                    <StackPanel>
                        <TextBlock Classes="caption mono" Text="{Binding NazcaFunction}" Margin="0,0,0,4"/>
                        <TextBlock Text="{loc:Localize SelectedProps.NoSimulationParams}"
                                   Classes="caption" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    </StackPanel>
                </DataTemplate>
            </ContentControl.Resources>
            <ContentControl.DataTemplates>
                <StaticResource ResourceKey="OnaAnalyzerTpl"/>
                <StaticResource ResourceKey="ParamsTpl"/>
                <StaticResource ResourceKey="SliderTpl"/>
                <StaticResource ResourceKey="LightSourceTpl"/>
                <StaticResource ResourceKey="GenericTpl"/>
            </ContentControl.DataTemplates>
        </ContentControl>
    </StackPanel>

</UserControl>
