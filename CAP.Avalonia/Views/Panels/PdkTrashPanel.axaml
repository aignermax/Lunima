<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmTrash="using:CAP.Avalonia.ViewModels.Panels.PdkTrash"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             x:Class="CAP.Avalonia.Views.Panels.PdkTrashPanel"
             x:DataType="vmTrash:PdkTrashViewModel"
             Width="340">
    <StackPanel>
        <TextBlock Classes="subtitle" Text="{loc:Localize PdkTrash.Title}" Margin="4,2,0,2"/>
        <TextBlock Classes="caption" Text="{loc:Localize PdkTrash.Description}" Margin="4,0,4,6" TextWrapping="Wrap"/>
        <TextBlock Classes="caption" Text="{loc:Localize PdkTrash.Empty}" Margin="4,4"
                   IsVisible="{Binding !HasEntries}"/>
        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vmTrash:PdkTrashEntryViewModel">
                        <Border Background="{DynamicResource Brush.Surface.Raised}" CornerRadius="{DynamicResource Radius.S}" Padding="8,6" Margin="0,0,0,4">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Classes="chip accent" Margin="0,0,6,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding KindLabel}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}"
                                               FontSize="{DynamicResource FontSize.Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Classes="secondary" Text="{Binding Detail}"
                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Classes="caption" Text="{Binding DeletedAtText}"
                                               VerticalAlignment="Center"/>
                                    <Button Content="{loc:Localize PdkTrash.Restore}" Margin="8,0,0,0"
                                            Command="{Binding RestoreCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock Classes="secondary" Text="{Binding StatusText}" Margin="4,6,4,2" TextWrapping="Wrap"
                   IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        <TextBlock Classes="caption" Text="{loc:Localize PdkTrash.AutoDeleteNote}" Margin="4,6,4,2" TextWrapping="Wrap"
                   IsVisible="{Binding HasEntries}"/>
    </StackPanel>
</UserControl>
