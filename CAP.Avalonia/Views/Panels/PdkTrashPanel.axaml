<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmTrash="using:CAP.Avalonia.ViewModels.Panels.PdkTrash"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             x:Class="CAP.Avalonia.Views.Panels.PdkTrashPanel"
             x:DataType="vmTrash:PdkTrashViewModel"
             Width="340">
    <StackPanel>
        <TextBlock Text="{loc:Localize PdkTrash.Title}" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" Margin="4,2,0,2"/>
        <TextBlock Text="{loc:Localize PdkTrash.Description}"
                   FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="4,0,4,6" TextWrapping="Wrap"/>
        <TextBlock Text="{loc:Localize PdkTrash.Empty}"
                   FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="4,4"
                   IsVisible="{Binding !HasEntries}"/>
        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vmTrash:PdkTrashEntryViewModel">
                        <Border Background="{DynamicResource Brush.Surface.Raised}" CornerRadius="4" Padding="8,6" Margin="0,0,0,4">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{DynamicResource Brush.Accent}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding KindLabel}" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}"
                                               FontSize="{DynamicResource FontSize.Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Detail}" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}"
                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="{Binding DeletedAtText}" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}"
                                               VerticalAlignment="Center"/>
                                    <Button Content="{loc:Localize PdkTrash.Restore}" FontSize="{DynamicResource FontSize.Caption}" Padding="7,2" Margin="8,0,0,0"
                                            Background="{DynamicResource Brush.Success.Subtle}" Foreground="{DynamicResource Brush.Text.Primary}"
                                            Command="{Binding RestoreCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock Text="{Binding StatusText}"
                   FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="4,6,4,2" TextWrapping="Wrap"
                   IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        <TextBlock Text="{loc:Localize PdkTrash.AutoDeleteNote}"
                   FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="4,6,4,2" TextWrapping="Wrap"
                   IsVisible="{Binding HasEntries}"/>
    </StackPanel>
</UserControl>
