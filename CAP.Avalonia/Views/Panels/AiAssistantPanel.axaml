<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CAP.Avalonia.ViewModels"
             xmlns:ai="using:CAP.Avalonia.ViewModels.AI"
             xmlns:controls="using:CAP.Avalonia.Controls"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             x:Class="CAP.Avalonia.Views.Panels.AiAssistantPanel"
             x:DataType="vm:MainViewModel">

    <!-- Hosted in the AI Assistant tool window (formerly a right-sidebar section). -->
    <StackPanel>
        <!-- Header row -->
        <DockPanel Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left"
                       Text="{loc:Localize AiAssistant.Title}"
                       Foreground="{DynamicResource Brush.Info}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right"
                    Content="{loc:Localize AiAssistant.Clear}"
                    Command="{Binding RightPanel.AiAssistant.ClearHistoryCommand}"
                    HorizontalAlignment="Right"/>
        </DockPanel>

        <TextBlock Classes="caption" Text="{loc:Localize AiAssistant.Description}" Margin="0,0,0,8" TextWrapping="Wrap"/>

        <!-- Chat history -->
        <Border Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1"
                CornerRadius="{DynamicResource Radius.S}" Margin="0,0,0,8">
            <ScrollViewer Height="220"
                          VerticalScrollBarVisibility="Auto"
                          x:Name="ChatScrollViewer">
                <ItemsControl ItemsSource="{Binding RightPanel.AiAssistant.Messages}"
                              Margin="6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="ai:AiChatMessage">
                            <Border Margin="0,3" Padding="8,6" CornerRadius="{DynamicResource Radius.S}"
                                    Background="{Binding MessageBackground}">
                                <StackPanel>
                                    <TextBlock Classes="caption" Text="{Binding RoleLabel}" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                    <SelectableTextBlock Text="{Binding Content}"
                                                         Foreground="{DynamicResource Brush.Text.Primary}"
                                                         FontSize="{DynamicResource FontSize.Caption}"
                                                         TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Typing indicator -->
        <TextBlock Classes="caption" Text="{loc:Localize AiAssistant.Thinking}" FontStyle="Italic"
                   Margin="0,0,0,5"
                   IsVisible="{Binding RightPanel.AiAssistant.IsTyping}"/>

        <!-- Status text -->
        <TextBlock Classes="caption" Text="{Binding RightPanel.AiAssistant.StatusText}" Margin="0,0,0,5"
                   IsVisible="{Binding RightPanel.AiAssistant.StatusText,
                               Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

        <!-- Input row -->
        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,5">
            <TextBox Grid.Column="0"
                     x:Name="UserInputTextBox"
                     Text="{Binding RightPanel.AiAssistant.UserInput}"
                     Watermark="{loc:Localize AiAssistant.InputPlaceholder}"
                     Background="{DynamicResource Brush.Surface.Panel}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border.Default}"
                     TextWrapping="Wrap" AcceptsReturn="False"
                     FontSize="{DynamicResource FontSize.Caption}" Margin="0,0,5,0"
                     IsEnabled="{Binding RightPanel.AiAssistant.IsTyping,
                                 Converter={x:Static BoolConverters.Not}}"/>
            <Button Grid.Column="1" Classes="primary"
                    Content="{loc:Localize AiAssistant.Send}"
                    Command="{Binding RightPanel.AiAssistant.SendMessageCommand}"
                    Margin="0,0,4,0"/>
            <Button Classes="icon" Grid.Column="2"
                    Command="{Binding RightPanel.AiAssistant.CancelRequestCommand}"
                    ToolTip.Tip="{loc:Localize AiPanel.CancelTip}"
                    IsVisible="{Binding RightPanel.AiAssistant.IsTyping}">
                <controls:Icon Data="{StaticResource Icon.X}"/>
            </Button>
        </Grid>

        <!-- API-key shortcut: visible only when no key is configured yet.
             Clicking opens Settings pre-selected on the AI Assistant page. -->
        <Button Content="{loc:Localize AiAssistant.SetApiKey}"
                Command="{Binding OpenAiSettingsCommand}"
                HorizontalAlignment="Stretch"
                Margin="0,5,0,0"
                IsVisible="{Binding RightPanel.AiAssistant.IsApiKeySet,
                            Converter={x:Static BoolConverters.Not}}"
                ToolTip.Tip="{loc:Localize AiPanel.SetApiKeyTip}"/>
    </StackPanel>

</UserControl>
