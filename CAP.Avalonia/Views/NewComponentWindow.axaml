<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CAP.Avalonia.ViewModels.Components.AddCustomComponent"
        xmlns:edit="using:AvaloniaEdit"
        xmlns:behaviors="using:CAP.Avalonia.Behaviors"
        xmlns:controls="using:CAP.Avalonia.Controls"
        xmlns:cs="using:CAP.Avalonia.ViewModels.ComponentSettings"
        xmlns:solvers="using:CAP.Avalonia.ViewModels.Solvers"
        xmlns:loc="using:CAP.Avalonia.Services.Localization"
        xmlns:panels="using:CAP.Avalonia.Views.Panels"
        x:Class="CAP.Avalonia.Views.NewComponentWindow"
        x:DataType="vm:NewComponentViewModel"
        Title="{Binding WindowTitle}"
        Width="640" Height="920"
        MinWidth="560" MinHeight="700"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      AllowAutoHide="False">
            <StackPanel Margin="24" Spacing="24">

                <Border Classes="card" Background="{DynamicResource Brush.Accent.Subtle}"
                        IsVisible="{Binding IsEditMode}">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="strong accent" Text="{loc:Localize NewComponent.EditModeHeader}"/>
                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   Text="{loc:Localize NewComponent.EditModeDescription}"/>
                    </StackPanel>
                </Border>

                <!-- Target: PDK, process, name -->
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,16,*">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Classes="label" Text="PDK"/>
                            <ComboBox ItemsSource="{Binding PdkChoices}"
                                      SelectedItem="{Binding SelectedPdkChoice}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PdkChoice">
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Classes="label" Text="{loc:Localize NewComponent.FabricationProcess}"/>
                            <TextBlock Classes="secondary" Text="{Binding SelectedProcess.Name}"
                                       Height="28" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="4">
                        <TextBlock Classes="label" Text="{loc:Localize NewComponent.Name}"/>
                        <TextBox Text="{Binding ComponentName}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Structure: code, backend, preview -->
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Grid.Column="0" Classes="label" Text="{loc:Localize NewComponent.StructureLabel}"
                                   VerticalAlignment="Center"/>
                        <controls:HelpFlyoutButton Grid.Column="1" Title="{loc:Localize NewComponent.HelpTitle}"
                                                   Margin="0,0,8,0">
                            <controls:HelpFlyoutButton.HelpContent>
                                <panels:NewComponentHelpFlyout/>
                            </controls:HelpFlyoutButton.HelpContent>
                        </controls:HelpFlyoutButton>
                        <Button Grid.Column="2" Classes="ghost" Command="{Binding LoadCodeFromFileCommand}"
                                ToolTip.Tip="{loc:Localize NewComponent.LoadFromPyTip}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:Icon Data="{StaticResource Icon.FileInput}"/>
                                <TextBlock Text="{loc:Localize NewComponent.LoadFromPy}"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Classes="card" Padding="0" ClipToBounds="True">
                        <edit:TextEditor behaviors:TextEditorBindingBehavior.BoundText="{Binding Code, Mode=TwoWay}"
                                         ShowLineNumbers="True"
                                         WordWrap="False"
                                         FontFamily="{DynamicResource Font.Mono}"
                                         FontSize="{DynamicResource FontSize.Caption}"
                                         Height="200"
                                         Background="{DynamicResource Brush.Surface.Input}"
                                         Foreground="{DynamicResource Brush.Text.Primary}"
                                         HorizontalScrollBarVisibility="Auto"
                                         VerticalScrollBarVisibility="Auto"/>
                    </Border>

                    <Grid ColumnDefinitions="Auto,8,*,8,Auto">
                        <TextBlock Grid.Column="0" Classes="secondary" Text="{loc:Localize NewComponent.Backend}"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding AvailableBackends}"
                                  SelectedItem="{Binding SelectedBackend}"
                                  HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="4" Content="{loc:Localize NewComponent.Preview}"
                                Command="{Binding RunPreviewCommand}"
                                ToolTip.Tip="{loc:Localize NewComponent.PreviewTip}"/>
                    </Grid>

                    <Image x:Name="PreviewThumbnail"
                           Source="{Binding PreviewBitmap}"
                           Height="120"
                           Stretch="Uniform"
                           HorizontalAlignment="Left"
                           Cursor="Hand"
                           IsVisible="{Binding PreviewBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"
                           PointerPressed="OnPreviewThumbnailPointerPressed"
                           ToolTip.Tip="{loc:Localize NewComponent.ClickToEnlarge}"/>
                </StackPanel>

                <!-- S-matrix -->
                <StackPanel Spacing="8">
                    <TextBlock Classes="label" Text="S-matrix"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!-- Split button: compute with the selected backend; the chevron picks the backend. -->
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Content="{Binding ComputeButtonLabel}" Command="{Binding ComputeSMatrixCommand}"
                                   
                                    ToolTip.Tip="{loc:Localize NewComponent.ComputeTip}"/>
                            <Button
                                    IsVisible="{Binding HasBackendSelection}"
                                    ToolTip.Tip="{loc:Localize CompSettings.BackendPickerTip}">
                                <Button.IsEnabled>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="IsBusy" Converter="{x:Static BoolConverters.Not}"/>
                                        <Binding Path="IsAwaitingCloudConfirmation" Converter="{x:Static BoolConverters.Not}"/>
                                    </MultiBinding>
                                </Button.IsEnabled>
                                <controls:Icon Data="{StaticResource Icon.ChevronDown}" Size="12"/>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <StackPanel MinWidth="280" Margin="6" Spacing="4">
                                            <TextBlock Classes="label" Margin="0,0,0,4"
                                                       Text="{loc:Localize CompSettings.ChooseFdtdBackend}"/>
                                            <ItemsControl ItemsSource="{Binding BackendSelection.BackendItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="solvers:FdtdBackendItemViewModel">
                                                        <Button Classes="ghost" HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Left"
                                                                Margin="0,2"
                                                                Command="{Binding SelectCommand}">
                                                            <Grid ColumnDefinitions="22,*">
                                                                <TextBlock Grid.Column="0" Classes="success"
                                                                           Text="{Binding SelectionMark}"
                                                                           VerticalAlignment="Top"/>
                                                                <StackPanel Grid.Column="1">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <TextBlock Text="{Binding Icon}"/>
                                                                        <TextBlock Classes="strong"
                                                                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                                                                   Text="{Binding Name}"
                                                                                   VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                    <TextBlock Classes="caption" Text="{Binding Description}"
                                                                               TextWrapping="Wrap" MaxWidth="230"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <Button Content="{loc:Localize NewComponent.LoadFromFile}"
                                Command="{Binding LoadSMatrixFromFileCommand}"
                                ToolTip.Tip="{loc:Localize NewComponent.LoadSMatrixTip}"/>
                        <Button Classes="ghost" Content="{loc:Localize NewComponent.ShowStoredSMatrices}"
                                Command="{Binding ShowSMatricesCommand}"
                                ToolTip.Tip="{loc:Localize NewComponent.ShowStoredSMatricesTip}"/>
                    </StackPanel>

                    <!-- Hint when the selected backend can't run yet (Docker down / no API key). -->
                    <Border Classes="card" Background="{DynamicResource Brush.Warning.Subtle}" Padding="12,8"
                            IsVisible="{Binding BackendSelection.HasAvailabilityHint, FallbackValue=False}">
                        <StackPanel Spacing="4"
                                    DataContext="{Binding BackendSelection}"
                                    x:DataType="solvers:FdtdBackendSelectionViewModel">
                            <TextBlock Classes="warning" Text="{Binding AvailabilityHint}" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <Button Classes="link" Content="{loc:Localize CompSettings.Tidy3dGetKeyLink}"
                                        Command="{Binding OpenTidy3dPortalCommand}"
                                        HorizontalAlignment="Left"
                                        IsVisible="{Binding ShowMissingKeyLink}"/>
                                <Button Classes="link" Content="{loc:Localize CompSettings.OpenTidy3dSettings}"
                                        Command="{Binding OpenTidy3dSettingsCommand}"
                                        HorizontalAlignment="Left"
                                        IsVisible="{Binding ShowOpenSettingsLink}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Cloud cost confirmation: Tidy3D runs consume credits, so nothing is
                         submitted until the user reviews the estimate and confirms. -->
                    <Border Classes="card" Background="{DynamicResource Brush.Warning.Subtle}" Padding="12,8"
                            IsVisible="{Binding IsAwaitingCloudConfirmation}">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="warning" Text="{Binding CloudCostText}" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{loc:Localize CompSettings.CloudSubmit}"
                                        Command="{Binding ConfirmCloudSubmitCommand}"/>
                                <Button Classes="ghost" Content="{loc:Localize Common.Cancel}"
                                        Command="{Binding CancelCloudSubmitCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="4"/>
                    <!-- SelectableTextBlock so error messages can be copied. -->
                    <SelectableTextBlock Classes="secondary" Text="{Binding StatusText}" TextWrapping="Wrap"
                                         SelectionBrush="{DynamicResource Brush.Accent.Subtle}"/>

                    <Expander Header="{loc:Localize NewComponent.SMatrixData}" IsExpanded="False"
                              HorizontalAlignment="Stretch"
                              IsVisible="{Binding HasSMatrix}">
                        <ItemsControl ItemsSource="{Binding SMatrixEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="cs:SMatrixEntryViewModel">
                                    <Border Classes="card" Padding="12,8" Margin="0,4,0,0">
                                        <Grid ColumnDefinitions="110,80,*">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Classes="strong" Text="{Binding WavelengthLabel}"/>
                                                <TextBlock Classes="caption" Text="{Binding SourceNote}"
                                                           IsVisible="{Binding SourceNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding Dimensions}"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Classes="caption mono success" Text="{Binding MagnitudePreview}"
                                                           TextWrapping="NoWrap"/>
                                                <TextBlock Classes="caption" Text="{Binding PortNamesDisplay}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0"
                Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Classes="primary" Content="{Binding SaveButtonLabel}" Command="{Binding SaveCommand}"
                        ToolTip.Tip="{loc:Localize NewComponent.SaveTip}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
