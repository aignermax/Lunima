<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CAP.Avalonia.ViewModels.Export"
        xmlns:loc="using:CAP.Avalonia.Services.Localization"
        x:Class="CAP.Avalonia.Views.Dialogs.PhotonTorchExportDialog"
        x:DataType="vm:PhotonTorchExportViewModel"
        Title="{loc:Localize PhotonTorchExport.Title}"
        Width="420" SizeToContent="Height" MaxHeight="560"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Grid RowDefinitions="*,Auto">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" Margin="24">
                <StackPanel Spacing="4">
                    <TextBlock Classes="title" Text="{loc:Localize PhotonTorchExport.Heading}"/>
                    <TextBlock Classes="caption" TextWrapping="Wrap"
                               Text="{loc:Localize PhotonTorchExport.Description}"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Classes="label" Text="{loc:Localize PhotonTorchExport.WavelengthNm}"/>
                    <NumericUpDown Value="{Binding WavelengthNm}"
                                   Minimum="1260" Maximum="1625" Increment="10"
                                   FormatString="F0"/>
                </StackPanel>

                <CheckBox Content="{loc:Localize PhotonTorchExport.TimeDomain}"
                          IsChecked="{Binding UseTimeDomain}"/>

                <StackPanel IsVisible="{Binding UseTimeDomain}" Margin="24,0,0,0" Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="label" Text="{loc:Localize PhotonTorchExport.BitRate}"/>
                        <NumericUpDown Value="{Binding BitRateGbps}"
                                       Minimum="0.1" Maximum="100" Increment="1"
                                       FormatString="F1"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Classes="label" Text="{loc:Localize PhotonTorchExport.TimeSteps}"/>
                        <NumericUpDown Value="{Binding TimeDomainSteps}"
                                       Minimum="100" Maximum="10000" Increment="100"
                                       FormatString="F0"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Classes="caption" Foreground="{DynamicResource Brush.Info}" TextWrapping="Wrap"
                           Text="{Binding LastExportStatus}"
                           IsVisible="{Binding LastExportStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0"
                Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="{loc:Localize Common.OpenFolder}"
                        Command="{Binding OpenOutputDirectoryCommand}"
                        IsVisible="{Binding LastExportSucceeded}"/>
                <Button Content="{loc:Localize Common.Close}" x:Name="CloseButton" Click="OnCloseClicked"/>
                <Button Classes="primary" Content="{loc:Localize Common.ExportEllipsis}"
                        Command="{Binding ExportCommand}"
                        IsEnabled="{Binding IsExporting, Converter={x:Static BoolConverters.Not}}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
