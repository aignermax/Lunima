<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CAP.Avalonia.ViewModels.Export.OpenEbl"
        xmlns:loc="using:CAP.Avalonia.Services.Localization"
        xmlns:controls="using:CAP.Avalonia.Controls"
        x:Class="CAP.Avalonia.Views.Dialogs.OpenEblCheckDialog"
        x:DataType="vm:OpenEblCheckViewModel"
        Title="{loc:Localize OpenEblCheck.WindowTitle}"
        Width="540" Height="620"
        MinWidth="420" MinHeight="420"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" Margin="24">

                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="title" Text="{loc:Localize OpenEblCheck.Heading}"
                                   VerticalAlignment="Center"/>
                        <controls:HelpFlyoutButton Grid.Column="1"
                                                   Title="{loc:Localize OpenEblCheck.Help.Title}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center">
                            <controls:HelpFlyoutButton.HelpContent>
                                <StackPanel Spacing="8" MaxWidth="380">
                                    <TextBlock Classes="secondary" TextWrapping="Wrap"
                                               Text="{loc:Localize OpenEblCheck.Help.Line1}"/>
                                    <TextBlock Classes="secondary" TextWrapping="Wrap"
                                               Text="{loc:Localize OpenEblCheck.Help.Line2}"/>
                                    <TextBlock Classes="secondary" TextWrapping="Wrap"
                                               Text="{loc:Localize OpenEblCheck.Help.Line3}"/>
                                </StackPanel>
                            </controls:HelpFlyoutButton.HelpContent>
                        </controls:HelpFlyoutButton>
                    </Grid>
                    <TextBlock Classes="caption" TextWrapping="Wrap"
                               Text="{loc:Localize OpenEblCheck.Description}"/>
                </StackPanel>

                <!-- Inputs -->
                <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto,8,Auto,8,Auto">
                    <TextBlock Grid.Row="0" Classes="secondary" VerticalAlignment="Center"
                               Text="{loc:Localize OpenEblCheck.Username}"/>
                    <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding Username}"/>
                    <TextBlock Grid.Row="2" Classes="secondary" VerticalAlignment="Center"
                               Text="{loc:Localize OpenEblCheck.DesignName}"/>
                    <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding DesignName}"/>
                    <TextBlock Grid.Row="4" Classes="secondary" VerticalAlignment="Center"
                               Text="{loc:Localize OpenEblCheck.FileName}"/>
                    <TextBox Grid.Row="4" Grid.Column="2" Classes="mono" Text="{Binding FileName}"/>
                </Grid>

                <!-- Pre-flight findings: shown above the external result; errors hold the run
                     until "Check anyway", warnings only annotate it -->
                <Border Classes="card" IsVisible="{Binding PreflightIssues.Count}">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="label danger"
                                   Text="{loc:Localize OpenEblCheck.Preflight.ErrorsHeading}"
                                   IsVisible="{Binding HasPreflightErrors}"/>
                        <TextBlock Classes="label warning"
                                   Text="{loc:Localize OpenEblCheck.Preflight.WarningsHeading}"
                                   IsVisible="{Binding !HasPreflightErrors}"/>
                        <ItemsControl ItemsSource="{Binding PreflightIssues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:OpenEblPreflightIssueViewModel">
                                    <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                                        <Border Grid.Column="0" Classes="chip danger" Margin="0,0,8,0"
                                                VerticalAlignment="Top" IsVisible="{Binding IsError}">
                                            <TextBlock Text="{Binding SeverityLabel}"/>
                                        </Border>
                                        <Border Grid.Column="0" Classes="chip warning" Margin="0,0,8,0"
                                                VerticalAlignment="Top" IsVisible="{Binding !IsError}">
                                            <TextBlock Text="{Binding SeverityLabel}"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding Message}"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Result -->
                <Border Classes="card" IsVisible="{Binding HasResult}">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="subtitle" Text="{Binding Headline}"
                                   Foreground="{Binding HeadlineColor}" TextWrapping="Wrap"/>

                        <!-- Per-check outcomes -->
                        <StackPanel Spacing="4" IsVisible="{Binding ShowCheckOutcomes}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="secondary" MinWidth="150"
                                           Text="{loc:Localize OpenEblCheck.SubmissionChecks}"/>
                                <StackPanel Orientation="Horizontal" Spacing="6"
                                            IsVisible="{Binding SubmissionPassed}">
                                    <controls:Icon Data="{StaticResource Icon.CircleCheck}" Size="14"
                                                   Foreground="{DynamicResource Brush.Success}"/>
                                    <TextBlock Classes="success" Text="{loc:Localize OpenEblCheck.Passed}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6"
                                            IsVisible="{Binding !SubmissionPassed}">
                                    <controls:Icon Data="{StaticResource Icon.CircleX}" Size="14"
                                                   Foreground="{DynamicResource Brush.Danger}"/>
                                    <TextBlock Classes="danger" Text="{loc:Localize OpenEblCheck.Failed}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="secondary" MinWidth="150"
                                           Text="{loc:Localize OpenEblCheck.Verification}"/>
                                <StackPanel Orientation="Horizontal" Spacing="6"
                                            IsVisible="{Binding VerificationPassed}">
                                    <controls:Icon Data="{StaticResource Icon.CircleCheck}" Size="14"
                                                   Foreground="{DynamicResource Brush.Success}"/>
                                    <TextBlock Classes="success" Text="{loc:Localize OpenEblCheck.Passed}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6"
                                            IsVisible="{Binding !VerificationPassed}">
                                    <controls:Icon Data="{StaticResource Icon.CircleX}" Size="14"
                                                   Foreground="{DynamicResource Brush.Danger}"/>
                                    <TextBlock Classes="danger" Text="{loc:Localize OpenEblCheck.Failed}"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Classes="secondary" Text="{Binding DieSizeText}"
                                       IsVisible="{Binding DieSizeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>

                        <!-- Toolchain missing: pip hint + copy button -->
                        <Border Classes="card" Background="{DynamicResource Brush.Warning.Subtle}"
                                Padding="12,8" IsVisible="{Binding IsToolchainMissing}">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="warning" Text="{Binding ToolchainMessage}" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="mono" Text="{Binding PipInstallCommand}"
                                               VerticalAlignment="Center"/>
                                    <Button Content="{loc:Localize OpenEblCheck.CopyPipHint}"
                                            Command="{Binding CopyPipHintCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Classes="danger" Text="{Binding DetailMessage}" TextWrapping="Wrap"
                                   IsVisible="{Binding DetailMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                        <!-- Typed error list -->
                        <StackPanel Spacing="4" IsVisible="{Binding Errors.Count}">
                            <TextBlock Classes="label" Text="{loc:Localize OpenEblCheck.ErrorsHeading}"/>
                            <ItemsControl ItemsSource="{Binding Errors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:OpenEblCheckErrorItemViewModel">
                                        <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                                            <Border Grid.Column="0" Classes="chip info" Margin="0,0,8,0"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding CategoryLabel}"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Classes="secondary" Text="{Binding Message}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Classes="caption mono" Text="{Binding Location}"
                                                           IsVisible="{Binding HasLocation}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Classes="caption" Text="{Binding GdsPathText}" TextWrapping="Wrap"
                                   IsVisible="{Binding GdsPathText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            IsVisible="{Binding IsChecking}">
                    <ProgressBar IsIndeterminate="True" Width="120" Height="4" VerticalAlignment="Center"/>
                    <TextBlock Classes="caption" Text="{Binding StatusText}" VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="danger" Content="{loc:Localize Common.Cancel}"
                            Command="{Binding CancelCommand}"
                            IsVisible="{Binding IsChecking}"/>
                    <Button Content="{loc:Localize OpenEblCheck.Preflight.CheckAnyway}"
                            Command="{Binding CheckAnywayCommand}"
                            IsVisible="{Binding HasPreflightErrors}"
                            IsEnabled="{Binding !IsChecking}"/>
                    <Button Content="{loc:Localize Common.Close}" Click="OnCloseClicked"/>
                    <Button Classes="primary" Content="{loc:Localize OpenEblCheck.ExportAndCheck}"
                            Command="{Binding ExportAndCheckCommand}"
                            IsEnabled="{Binding !IsChecking}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
