<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CAP.Avalonia.ViewModels.Export"
        xmlns:loc="using:CAP.Avalonia.Services.Localization"
        x:Class="CAP.Avalonia.Views.Dialogs.GdsFactoryExportDialog"
        x:DataType="vm:GdsFactoryExportViewModel"
        Title="{loc:Localize GdsFactoryExport.Title}"
        Width="460" SizeToContent="Height" MaxHeight="560"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Grid RowDefinitions="*,Auto">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" Margin="24">
                <StackPanel Spacing="4">
                    <TextBlock Classes="title" Text="{loc:Localize GdsFactoryExport.Heading}"/>
                    <TextBlock Classes="caption" TextWrapping="Wrap"
                               Text="{loc:Localize GdsFactoryExport.Description}"/>
                </StackPanel>

                <Border Classes="card" Background="{DynamicResource Brush.Warning.Subtle}"
                        IsVisible="{Binding UnmappedComponents.Count}">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="label warning" Text="{loc:Localize GdsFactoryExport.StubGeometry}"/>
                        <ItemsControl ItemsSource="{Binding UnmappedComponents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Classes="caption" Text="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Classes="caption" Foreground="{DynamicResource Brush.Info}" TextWrapping="Wrap"
                           Text="{Binding StatusText}"
                           IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0"
                Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="{loc:Localize Common.Close}" x:Name="CloseButton" Click="OnCloseClicked"/>
                <Button Classes="primary" Content="{loc:Localize Common.ExportEllipsis}"
                        Command="{Binding ExportCommand}"
                        IsEnabled="{Binding IsExporting, Converter={x:Static BoolConverters.Not}}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
