<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CAP.Avalonia.ViewModels.Export"
        xmlns:loc="using:CAP.Avalonia.Services.Localization"
        x:Class="CAP.Avalonia.Views.Dialogs.VerilogAExportDialog"
        x:DataType="vm:VerilogAExportViewModel"
        Title="{loc:Localize VerilogAExport.Title}"
        Width="460" SizeToContent="Height" MaxHeight="560"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Grid RowDefinitions="*,Auto">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" Margin="24">
                <StackPanel Spacing="4">
                    <TextBlock Classes="title" Text="{loc:Localize VerilogAExport.Heading}"/>
                    <TextBlock Classes="caption" TextWrapping="Wrap"
                               Text="{loc:Localize VerilogAExport.Description}"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Classes="label" Text="{loc:Localize VerilogAExport.WavelengthLabel}"/>
                    <ComboBox ItemsSource="{Binding WavelengthOptions}"
                              SelectedValue="{Binding WavelengthNm}"
                              HorizontalAlignment="Stretch"/>
                </StackPanel>

                <CheckBox Content="{loc:Localize VerilogAExport.IncludeTestBench}"
                          IsChecked="{Binding IncludeTestBench}"/>

                <!-- Tells the user up-front which simulator chain the generated files target
                     (OpenVAF + NGSpice OSDI, not arbitrary SPICE). -->
                <Expander Header="{loc:Localize VerilogAExport.CaveatsHeader}" IsExpanded="False"
                          HorizontalAlignment="Stretch">
                    <TextBlock Classes="caption" TextWrapping="Wrap"
                               Text="{loc:Localize VerilogAExport.CaveatsBody}"/>
                </Expander>

                <TextBlock Classes="caption success" TextWrapping="Wrap"
                           Text="{Binding StatusText}"
                           IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0"
                Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="{loc:Localize Common.OpenFolder}"
                        Command="{Binding OpenOutputDirectoryCommand}"
                        IsVisible="{Binding LastExportSucceeded}"/>
                <Button Content="{loc:Localize Common.Close}" x:Name="CloseButton" Click="OnCloseClicked"/>
                <Button Classes="primary" Content="{loc:Localize Common.ExportEllipsis}"
                        Command="{Binding ExportCommand}"
                        IsEnabled="{Binding IsExporting, Converter={x:Static BoolConverters.Not}}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
