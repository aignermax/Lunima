<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CAP.Avalonia.ViewModels.PdkResolution"
        xmlns:loc="using:CAP.Avalonia.Services.Localization"
        xmlns:controls="using:CAP.Avalonia.Controls"
        xmlns:res="using:CAP_Core.Export.PdkResolution"
        x:Class="CAP.Avalonia.Views.Dialogs.PdkResolutionCheckDialog"
        x:DataType="vm:PdkResolutionCheckViewModel"
        Title="{loc:Localize PdkCheck.WindowTitle}"
        Width="720" Height="560"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" Margin="24">

                <StackPanel Spacing="4">
                    <TextBlock Classes="title" Text="{loc:Localize PdkCheck.Title}"/>
                    <TextBlock Classes="caption" TextWrapping="Wrap" Text="{loc:Localize PdkCheck.Description}"/>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Pdks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PdkResolutionGroupViewModel">
                            <StackPanel Spacing="4" Margin="0,0,0,16">

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="subtitle" Text="{Binding PdkName}"/>
                                    <TextBlock Classes="caption mono" VerticalAlignment="Center" Text="{Binding FileName}"/>
                                    <TextBlock Classes="caption secondary" VerticalAlignment="Center" Text="{Binding Summary}"/>
                                </StackPanel>

                                <TextBlock Classes="danger" Text="{Binding Error}"
                                           TextWrapping="Wrap" IsVisible="{Binding HasError}"/>

                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PdkResolutionRowViewModel">
                                            <Border Padding="4,3" Background="Transparent">
                                                <Grid ColumnDefinitions="28,180,190,*">
                                                    <controls:Icon Grid.Column="0" Size="14" VerticalAlignment="Top" Margin="0,1,0,0"
                                                                   Data="{StaticResource Icon.CircleCheck}"
                                                                   Foreground="{DynamicResource Brush.Success}"
                                                                   IsVisible="{Binding Status, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static res:PdkResolutionStatus.Ok}}"/>
                                                    <controls:Icon Grid.Column="0" Size="14" VerticalAlignment="Top" Margin="0,1,0,0"
                                                                   Data="{StaticResource Icon.TriangleAlert}"
                                                                   Foreground="{DynamicResource Brush.Warning}"
                                                                   IsVisible="{Binding Status, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static res:PdkResolutionStatus.Warning}}"/>
                                                    <controls:Icon Grid.Column="0" Size="14" VerticalAlignment="Top" Margin="0,1,0,0"
                                                                   Data="{StaticResource Icon.CircleX}"
                                                                   Foreground="{DynamicResource Brush.Danger}"
                                                                   IsVisible="{Binding Status, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static res:PdkResolutionStatus.Error}}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ComponentName}"
                                                               VerticalAlignment="Top" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Classes="mono secondary"
                                                               VerticalAlignment="Top"
                                                               Text="{Binding FunctionPath}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Message}"
                                                               VerticalAlignment="Top" TextWrapping="Wrap"
                                                               Classes.success="{Binding Status, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static res:PdkResolutionStatus.Ok}}"
                                                               Classes.warning="{Binding Status, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static res:PdkResolutionStatus.Warning}}"
                                                               Classes.danger="{Binding Status, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static res:PdkResolutionStatus.Error}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="secondary" VerticalAlignment="Center" TextWrapping="Wrap"
                           Margin="0,0,16,0" Text="{Binding StatusText}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="{loc:Localize PdkCheck.CopyFailingList}"
                            Command="{Binding CopyFailingListCommand}"
                            IsEnabled="{Binding HasFailures}"
                            ToolTip.Tip="{loc:Localize PdkCheck.CopyFailingListTip}"/>
                    <Button Content="{loc:Localize Common.Close}" Click="OnCloseClicked"/>
                    <Button Classes="primary" Content="{loc:Localize PdkCheck.RunCheck}"
                            Command="{Binding RunCheckCommand}"
                            IsEnabled="{Binding !IsRunning}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
