<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CAP.Avalonia.ViewModels.Analysis.OnaAnalysis"
        xmlns:loc="using:CAP.Avalonia.Services.Localization"
        xmlns:oxy="using:OxyPlot.Avalonia"
        xmlns:controls="using:CAP.Avalonia.Controls"
        xmlns:helpAnim="using:CAP.Avalonia.Controls.HelpAnimations"
        x:Class="CAP.Avalonia.Views.Dialogs.OnaAnalyzerWindow"
        x:DataType="vm:OnaSweepViewModel"
        Title="{Binding WindowTitle}"
        Width="780" Height="560"
        MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!-- Dark hover-tracker so its text is readable instead of the default
             lemon-yellow box that clashes with the dark theme. -->
        <Style Selector="oxy|TrackerControl">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Overlay}"/>
            <Setter Property="LineStroke" Value="{DynamicResource Color.Gray300}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="0">

        <StackPanel Grid.Row="0" Margin="24,24,24,16" Spacing="4">
            <TextBlock Classes="title" Text="{Binding WindowTitle}"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="caption" Text="{loc:Localize Ona.Subtitle}" VerticalAlignment="Center"/>
                <controls:HelpFlyoutButton Title="{loc:Localize Ona.HelpTitle}">
                    <controls:HelpFlyoutButton.HelpContent>
                        <StackPanel Spacing="8" MaxWidth="400">
                            <TextBlock Classes="subtitle" Text="{loc:Localize Ona.HelpSweepTitle}"/>
                            <TextBlock Classes="secondary" TextWrapping="Wrap"
                                       Text="{loc:Localize Ona.HelpSweepBody}"/>
                            <Border Classes="card" Padding="2">
                                <helpAnim:OnaSweepAnimation Width="360" Height="90"/>
                            </Border>
                            <TextBlock Classes="subtitle" Margin="0,4,0,0" Text="{loc:Localize Ona.HelpDipsTitle}"/>
                            <TextBlock Classes="secondary" TextWrapping="Wrap"
                                       Text="{loc:Localize Ona.HelpDipsBody}"/>
                        </StackPanel>
                    </controls:HelpFlyoutButton.HelpContent>
                </controls:HelpFlyoutButton>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="24,0">
            <!-- Left: sweep parameters -->
            <StackPanel Width="270" Margin="0,0,16,0" Spacing="8">
                <TextBlock Classes="label" Text="{loc:Localize Ona.SweepParameters}"/>

                <Grid ColumnDefinitions="80,*">
                    <TextBlock Classes="secondary" Text="{loc:Localize Ona.StartNm}" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="1" Value="{Binding StartNm}" Minimum="400" Maximum="2500" Increment="10" FormatString="F0"/>
                </Grid>
                <Grid ColumnDefinitions="80,*">
                    <TextBlock Classes="secondary" Text="{loc:Localize Ona.EndNm}" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="1" Value="{Binding EndNm}" Minimum="400" Maximum="2500" Increment="10" FormatString="F0"/>
                </Grid>
                <Grid ColumnDefinitions="80,*">
                    <TextBlock Classes="secondary" Text="{loc:Localize Ona.Steps}" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="1" Value="{Binding StepCount}" Minimum="2" Maximum="500" Increment="1" FormatString="F0"/>
                </Grid>

                <TextBlock Classes="caption warning" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="{Binding WarningText}"
                           IsVisible="{Binding WarningText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>

            <!-- Centre: plot -->
            <Border Grid.Column="1" Classes="card" Padding="0" ClipToBounds="True">
                <oxy:PlotView Model="{Binding PlotModel}" Background="Transparent"/>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="0,16,0,0" Padding="24,12"
                BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="caption" Text="{Binding StatusText}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="{loc:Localize Common.ExportCsv}"
                            Command="{Binding ExportCsvCommand}"
                            IsVisible="{Binding HasResult}"/>
                    <Button Classes="danger" Content="{loc:Localize Common.Cancel}"
                            Command="{Binding CancelSweepCommand}"
                            IsVisible="{Binding IsSweeping}"/>
                    <Button Classes="primary" Content="{loc:Localize Common.Run}"
                            Command="{Binding RunSweepCommand}"
                            IsEnabled="{Binding IsSweeping, Converter={x:Static BoolConverters.Not}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
