<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CAP.Avalonia.ViewModels.Solvers"
        xmlns:loc="using:CAP.Avalonia.Services.Localization"
        xmlns:controls="using:CAP.Avalonia.Controls"
        xmlns:help="using:CAP.Avalonia.Controls.HelpAnimations"
        x:Class="CAP.Avalonia.Views.Dialogs.ModeSolverDialog"
        x:DataType="vm:ModeSolverViewModel"
        Title="{loc:Localize ModeSolver.WindowTitle}"
        Width="480" Height="700"
        MinWidth="400" MinHeight="460"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" Margin="24">

                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="title" Text="{loc:Localize ModeSolver.Title}" VerticalAlignment="Center"/>
                        <controls:HelpFlyoutButton Title="{loc:Localize ModeSolver.HelpTitle}"
                                                   VerticalAlignment="Center">
                            <controls:HelpFlyoutButton.HelpContent>
                                <StackPanel Spacing="8" MaxWidth="380">
                                    <TextBlock Classes="subtitle" Text="{loc:Localize ModeSolver.HelpModeTitle}"/>
                                    <TextBlock Classes="secondary" TextWrapping="Wrap"
                                               Text="{loc:Localize ModeSolver.HelpModeBody}"/>
                                    <Border Classes="card" Padding="4" HorizontalAlignment="Left">
                                        <help:ModeConfinementAnimation
                                            CladTickLabel="{loc:Localize ModeSolver.HelpAnimCladTick}"
                                            CoreTickLabel="{loc:Localize ModeSolver.HelpAnimCoreTick}"/>
                                    </Border>
                                    <TextBlock Classes="subtitle" Margin="0,4,0,0"
                                               Text="{loc:Localize ModeSolver.HelpNeffTitle}"/>
                                    <TextBlock Classes="secondary" TextWrapping="Wrap"
                                               Text="{loc:Localize ModeSolver.HelpNeffBody}"/>
                                </StackPanel>
                            </controls:HelpFlyoutButton.HelpContent>
                        </controls:HelpFlyoutButton>
                    </StackPanel>
                    <TextBlock Classes="caption" TextWrapping="Wrap" Text="{loc:Localize ModeSolver.Description}"/>
                </StackPanel>

                <!-- Cross-section geometry -->
                <StackPanel Spacing="8">
                    <TextBlock Classes="label" Text="{loc:Localize ModeSolver.GeometrySection}"/>
                    <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,8,Auto,8,Auto">
                        <TextBlock Grid.Row="0" Classes="secondary" Text="{loc:Localize ModeSolver.CoreWidth}"
                                   VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Row="0" Grid.Column="2" Value="{Binding Width}"
                                       Minimum="0.1" Maximum="5.0" Increment="0.05" FormatString="F3"/>

                        <TextBlock Grid.Row="2" Classes="secondary" Text="{loc:Localize ModeSolver.CoreHeight}"
                                   VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Row="2" Grid.Column="2" Value="{Binding Height}"
                                       Minimum="0.05" Maximum="2.0" Increment="0.02" FormatString="F3"/>

                        <TextBlock Grid.Row="4" Classes="secondary" Text="{loc:Localize ModeSolver.SlabHeight}"
                                   VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Row="4" Grid.Column="2" Value="{Binding SlabHeight}"
                                       Minimum="0.0" Maximum="2.0" Increment="0.01" FormatString="F3"/>
                    </Grid>
                </StackPanel>

                <!-- Refractive indices -->
                <StackPanel Spacing="8">
                    <TextBlock Classes="label" Text="{loc:Localize ModeSolver.RefractiveIndicesSection}"/>
                    <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,8,Auto">
                        <TextBlock Grid.Row="0" Classes="secondary" Text="{loc:Localize ModeSolver.CoreIndex}"
                                   VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Row="0" Grid.Column="2" Value="{Binding CoreIndex}"
                                       Minimum="1.0" Maximum="5.0" Increment="0.01" FormatString="F3"/>

                        <TextBlock Grid.Row="2" Classes="secondary" Text="{loc:Localize ModeSolver.CladIndex}"
                                   VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Row="2" Grid.Column="2" Value="{Binding CladIndex}"
                                       Minimum="1.0" Maximum="4.0" Increment="0.01" FormatString="F3"/>
                    </Grid>
                </StackPanel>

                <!-- Solver settings -->
                <StackPanel Spacing="8">
                    <TextBlock Classes="label" Text="{loc:Localize ModeSolver.SolverSettingsSection}"/>
                    <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,8,Auto,8,Auto">
                        <TextBlock Grid.Row="0" Classes="secondary" Text="{loc:Localize ModeSolver.Wavelength}"
                                   VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Row="0" Grid.Column="2" Value="{Binding WavelengthNm}"
                                       Minimum="400" Maximum="2500" Increment="10" FormatString="F0"/>

                        <TextBlock Grid.Row="2" Classes="secondary" Text="{loc:Localize ModeSolver.MaxModes}"
                                   VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Row="2" Grid.Column="2" Value="{Binding NumModes}"
                                       Minimum="1" Maximum="20" Increment="1" FormatString="F0"/>

                        <TextBlock Grid.Row="4" Classes="secondary" Text="{loc:Localize ModeSolver.Backend}"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="4" Grid.Column="2" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Static vm:ModeSolverViewModel.AvailableBackends}"
                                  SelectedItem="{Binding SelectedBackend}"/>
                    </Grid>
                </StackPanel>

                <TextBlock Classes="secondary" Text="{Binding StatusText}" TextWrapping="Wrap"/>

                <!-- Results table -->
                <StackPanel IsVisible="{Binding HasResult}" Spacing="8">
                    <TextBlock Classes="label" Text="{loc:Localize ModeSolver.Results}"/>

                    <Border Classes="card" Padding="0">
                        <StackPanel>
                            <Border Background="{DynamicResource Brush.Surface.Hover}" Padding="8,4"
                                    CornerRadius="10,10,0,0">
                                <Grid ColumnDefinitions="70,48,85,75,55">
                                    <TextBlock Grid.Column="0" Classes="label" Text="λ (µm)"/>
                                    <TextBlock Grid.Column="1" Classes="label" Text="{loc:Localize ModeSolver.ColMode}"/>
                                    <TextBlock Grid.Column="2" Classes="label" Text="n_eff"/>
                                    <TextBlock Grid.Column="3" Classes="label" Text="n_g"/>
                                    <TextBlock Grid.Column="4" Classes="label" Text="{loc:Localize ModeSolver.ColPol}"/>
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Modes}" MaxHeight="160">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,3" Background="Transparent">
                                            <Grid ColumnDefinitions="70,48,85,75,55">
                                                <TextBlock Grid.Column="0" Classes="mono" Text="{Binding Wavelength, StringFormat=F4}"/>
                                                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding ModeIndex}"/>
                                                <TextBlock Grid.Column="2" Classes="mono success" Text="{Binding NEff, StringFormat=F5}"/>
                                                <TextBlock Grid.Column="3" Classes="mono accent" Text="{Binding NGroup, StringFormat=F4}"/>
                                                <TextBlock Grid.Column="4" Classes="warning" Text="{Binding Polarisation}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Raw stderr expander — shown only on failure with stderr -->
                <Expander IsVisible="{Binding HasStderr}"
                          Header="{loc:Localize ModeSolver.RawOutputHeader}">
                    <TextBox Classes="mono" Text="{Binding RawStderr}"
                             IsReadOnly="True"
                             Foreground="{DynamicResource Brush.Danger}"
                             FontSize="{DynamicResource FontSize.Caption}"
                             MaxHeight="120"
                             TextWrapping="Wrap"/>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0"
                Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Classes="danger" Content="{loc:Localize ModeSolver.CancelSolve}"
                        Command="{Binding CancelSolveCommand}"
                        IsVisible="{Binding IsSolving}"/>
                <Button Content="{loc:Localize Common.Close}" x:Name="CloseButton" Click="OnCloseClicked"/>
                <Button Classes="primary" Content="{loc:Localize ModeSolver.Solve}"
                        Command="{Binding SolveCommand}"
                        IsEnabled="{Binding CanSolve}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
