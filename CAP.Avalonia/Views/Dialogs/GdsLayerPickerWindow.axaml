<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CAP.Avalonia.ViewModels.GdsImport.LayerPicker"
        xmlns:ctrl="clr-namespace:CAP.Avalonia.Controls.GdsImport"
        xmlns:controls="using:CAP.Avalonia.Controls"
        xmlns:loc="using:CAP.Avalonia.Services.Localization"
        x:Class="CAP.Avalonia.Views.Dialogs.GdsLayerPickerWindow"
        x:DataType="vm:GdsLayerPickerViewModel"
        Title="{loc:Localize GdsImport.LayerPickerTitle}"
        Width="680" Height="640"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <Grid RowDefinitions="*,Auto">
        <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="24">

            <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="4">
                <TextBlock Classes="title" Text="{loc:Localize GdsImport.LayerPickerTitle}"/>
                <TextBlock Classes="caption" Text="{loc:Localize GdsImport.LayerPickerHint}" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- The clickable geometry preview -->
            <Border Grid.Row="1" Classes="card" Padding="0" ClipToBounds="True">
                <ctrl:GdsLayerPickView ViewModel="{Binding}" Cursor="Hand"/>
            </Border>

            <!-- Legend: one row per layer, clickable as an alternative to geometry clicks -->
            <Border Grid.Row="2" Classes="card" Margin="0,16,0,0" Padding="4" MaxHeight="150">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GdsLayerPickerLayerRow">
                                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        MinHeight="24" Padding="6,2" Margin="0,1"
                                        Command="{Binding $parent[Window].((vm:GdsLayerPickerViewModel)DataContext).SelectRowCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <controls:Icon Data="{StaticResource Icon.ChevronRight}" Size="12"
                                                       VerticalAlignment="Center" IsVisible="{Binding IsSelected}"/>
                                        <Border Background="{Binding Swatch}" Width="14" Height="10"
                                                CornerRadius="2" VerticalAlignment="Center"/>
                                        <TextBlock Classes="caption mono" Text="{Binding PairText}"
                                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                                   MinWidth="64" VerticalAlignment="Center"/>
                                        <TextBlock Classes="caption secondary" Text="{Binding CountsText}" VerticalAlignment="Center"/>
                                        <TextBlock Classes="caption success" Text="{Binding AssignmentText}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Selection status + assignment buttons -->
            <StackPanel Grid.Row="3" Spacing="8" Margin="0,16,0,0">
                <TextBlock Classes="caption secondary" Text="{Binding SelectionText}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{loc:Localize GdsImport.LayerPickerAssignWaveguide}"
                            Command="{Binding AssignWaveguideCommand}"/>
                    <Button Content="{loc:Localize GdsImport.LayerPickerAssignMetal}"
                            Command="{Binding AssignMetalCommand}"/>
                    <Button Content="{loc:Localize GdsImport.LayerPickerAssignPortLabels}"
                            Command="{Binding AssignPortLabelsCommand}"/>
                    <Button Classes="ghost" Content="{loc:Localize GdsImport.LayerPickerAssignIgnore}"
                            Command="{Binding AssignIgnoreCommand}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0"
                Padding="24,12">
            <Button Classes="primary" Content="{loc:Localize Common.Close}" HorizontalAlignment="Right"
                    Click="OnCloseClicked"/>
        </Border>
    </Grid>
</Window>
