<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CAP.Avalonia.ViewModels.Solvers.DockerSetup"
        xmlns:loc="using:CAP.Avalonia.Services.Localization"
        xmlns:controls="using:CAP.Avalonia.Controls"
        x:Class="CAP.Avalonia.Views.Dialogs.DockerSetupDialog"
        x:DataType="vm:DockerSetupViewModel"
        Title="{loc:Localize DockerSetup.WindowTitle}"
        Width="560" SizeToContent="Height"
        MinWidth="460"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel>
        <StackPanel Margin="24" Spacing="16">

            <TextBlock Classes="title" Text="{loc:Localize DockerSetup.Heading}"/>

            <Border Classes="card" Background="{DynamicResource Brush.Warning.Subtle}" Padding="12,8">
                <TextBlock Classes="warning" Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
            </Border>

            <!-- Linux: not installed — copyable install commands -->
            <StackPanel Spacing="8" IsVisible="{Binding ShowLinuxInstall}">
                <TextBlock Classes="secondary" Text="{loc:Localize DockerSetup.LinuxInstallHint}" TextWrapping="Wrap"/>
                <Grid ColumnDefinitions="*,8,Auto">
                    <TextBox Grid.Column="0" Classes="mono"
                             Text="{Binding LinuxInstallCommandsText, Mode=OneWay}"
                             IsReadOnly="True" AcceptsReturn="True"/>
                    <Button Grid.Column="2" Classes="icon" VerticalAlignment="Top"
                            ToolTip.Tip="{loc:Localize Context.Copy}"
                            Command="{Binding CopyInstallCommandsCommand}">
                        <controls:Icon Data="{StaticResource Icon.Copy}"/>
                    </Button>
                </Grid>
                <TextBlock Classes="caption" Text="{loc:Localize DockerSetup.LinuxRelogNote}" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Windows / macOS: not installed — download button -->
            <StackPanel Spacing="8" IsVisible="{Binding ShowDesktopInstall}">
                <TextBlock Classes="secondary" Text="{loc:Localize DockerSetup.DesktopInstallHint}" TextWrapping="Wrap"/>
                <Button HorizontalAlignment="Left"
                        Command="{Binding OpenDownloadPageCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:Icon Data="{StaticResource Icon.ExternalLink}"/>
                        <TextBlock Text="{loc:Localize DockerSetup.DownloadDockerDesktop}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Linux: engine stopped — copyable start command -->
            <StackPanel Spacing="8" IsVisible="{Binding ShowLinuxStart}">
                <TextBlock Classes="secondary" Text="{loc:Localize DockerSetup.LinuxStartHint}" TextWrapping="Wrap"/>
                <Grid ColumnDefinitions="*,8,Auto">
                    <TextBox Grid.Column="0" Classes="mono"
                             Text="{Binding LinuxStartCommandText, Mode=OneWay}"
                             IsReadOnly="True"/>
                    <Button Grid.Column="2" Classes="icon" VerticalAlignment="Top"
                            ToolTip.Tip="{loc:Localize Context.Copy}"
                            Command="{Binding CopyStartCommandCommand}">
                        <controls:Icon Data="{StaticResource Icon.Copy}"/>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Linux: engine running but socket access denied — group / re-login guidance -->
            <StackPanel Spacing="8" IsVisible="{Binding ShowLinuxPermission}">
                <TextBlock Classes="secondary" Text="{loc:Localize DockerSetup.LinuxPermissionHint}" TextWrapping="Wrap"/>
                <Grid ColumnDefinitions="*,8,Auto">
                    <TextBox Grid.Column="0" Classes="mono"
                             Text="{Binding LinuxPermissionCommandText, Mode=OneWay}"
                             IsReadOnly="True"/>
                    <Button Grid.Column="2" Classes="icon" VerticalAlignment="Top"
                            ToolTip.Tip="{loc:Localize Context.Copy}"
                            Command="{Binding CopyPermissionCommandCommand}">
                        <controls:Icon Data="{StaticResource Icon.Copy}"/>
                    </Button>
                </Grid>
                <Grid ColumnDefinitions="Auto,*">
                    <controls:Icon Data="{StaticResource Icon.TriangleAlert}" Foreground="{DynamicResource Brush.Warning}"
                                   VerticalAlignment="Top" Margin="0,2,8,0"/>
                    <TextBlock Grid.Column="1" Classes="strong warning"
                               Text="{loc:Localize DockerSetup.LinuxPermissionWarning}" TextWrapping="Wrap"/>
                </Grid>
            </StackPanel>

            <!-- Windows / macOS: engine stopped — start hint -->
            <StackPanel Spacing="8" IsVisible="{Binding ShowDesktopStart}">
                <TextBlock Classes="secondary" Text="{loc:Localize DockerSetup.DesktopStartHint}" TextWrapping="Wrap"/>
            </StackPanel>

            <TextBlock Classes="caption success" Text="{Binding CopyFeedback}"
                       IsVisible="{Binding CopyFeedback, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>

        <Border BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="{loc:Localize Common.Cancel}" Click="OnCancelClick"/>
                <Button Classes="primary" Content="{loc:Localize DockerSetup.CheckAgain}"
                        Command="{Binding CheckAgainCommand}"
                        IsEnabled="{Binding !IsChecking}"
                        IsDefault="True"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
