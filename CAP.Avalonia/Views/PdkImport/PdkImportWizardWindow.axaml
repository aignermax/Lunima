<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CAP.Avalonia.ViewModels.PdkImport"
        xmlns:controls="using:CAP.Avalonia.Controls"
        xmlns:loc="using:CAP.Avalonia.Services.Localization"
        x:Class="CAP.Avalonia.Views.PdkImport.PdkImportWizardWindow"
        x:DataType="vm:PdkImportWizardViewModel"
        Title="{loc:Localize PdkImport.WindowTitle}"
        Width="700" Height="560"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="24,24,24,16" Spacing="8">
            <StackPanel Spacing="4">
                <TextBlock Classes="title" Text="{loc:Localize PdkImport.WindowTitle}"/>
                <TextBlock Classes="caption mono" Text="{Binding PyFilePath}" TextWrapping="Wrap"/>
            </StackPanel>
            <!-- Step indicator: the current step is the accent chip -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="chip" Classes.accent="{Binding IsParsingStep}">
                    <TextBlock Text="{loc:Localize PdkImport.StepParse}"/>
                </Border>
                <controls:Icon Data="{StaticResource Icon.ChevronRight}" Size="12"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                <Border Classes="chip" Classes.accent="{Binding IsReviewStep}">
                    <TextBlock Text="{loc:Localize PdkImport.StepReview}"/>
                </Border>
                <controls:Icon Data="{StaticResource Icon.ChevronRight}" Size="12"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                <Border Classes="chip" Classes.accent="{Binding IsSaveStep}">
                    <TextBlock Text="{loc:Localize PdkImport.StepSave}"/>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Content area switches by step -->
        <Grid Grid.Row="1" Margin="24,0">

            <!-- ═══ Step 1: Parsing ═══ -->
            <StackPanel IsVisible="{Binding IsParsingStep}" Spacing="16">
                <TextBlock Classes="subtitle" Text="{loc:Localize PdkImport.ParsingTitle}"/>
                <ProgressBar IsIndeterminate="{Binding IsLoading}" Height="4" Minimum="0" Maximum="1"/>
                <TextBlock Classes="secondary" Text="{Binding StatusText}" TextWrapping="Wrap"/>

                <Border Classes="card" Background="{DynamicResource Brush.Danger.Subtle}"
                        IsVisible="{Binding HasError}">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="label danger" Text="{loc:Localize PdkImport.ParseError}"/>
                        <TextBlock Classes="caption mono" Text="{Binding ErrorText}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Danger}"/>
                    </StackPanel>
                </Border>

                <!-- Component list (populated after parsing) -->
                <StackPanel IsVisible="{Binding IsLoading, Converter={x:Static BoolConverters.Not}}"
                            Spacing="8">
                    <TextBlock Classes="label"
                               Text="{Binding ParsedComponents.Count, StringFormat='Components found: {0}'}"/>
                    <Border Classes="card" Padding="4">
                        <ListBox ItemsSource="{Binding ParsedComponents}" MaxHeight="260">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ComponentParseResultViewModel">
                                    <Grid ColumnDefinitions="90,*,Auto" Margin="4,2">
                                        <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                                                   Foreground="{Binding StatusColor}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"/>
                                        <TextBlock Grid.Column="2" Classes="caption" Text="{Binding Category}"
                                                   Margin="8,0,4,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- ═══ Step 2: Review ═══ -->
            <StackPanel IsVisible="{Binding IsReviewStep}" Spacing="8">
                <TextBlock Classes="subtitle" Text="{loc:Localize PdkImport.ReviewTitle}"/>
                <TextBlock Classes="secondary" Text="{Binding StatusText}" TextWrapping="Wrap"/>
                <TextBlock Classes="caption" Text="{loc:Localize PdkImport.ReviewHint}"/>

                <Border Classes="card" Padding="4">
                    <ListBox ItemsSource="{Binding ParsedComponents}" MaxHeight="300">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ComponentParseResultViewModel">
                                <Grid ColumnDefinitions="Auto,*,100,80,90" Margin="4,3">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                              Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Classes="caption" Text="{Binding Category}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Classes="caption mono" Text="{Binding DimensionsText}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding StatusText}"
                                               Foreground="{Binding StatusColor}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <TextBlock Classes="caption"
                           Text="{Binding ParsedComponents.Count, StringFormat='Total: {0} component(s)'}"/>
            </StackPanel>

            <!-- ═══ Step 3: Save ═══ -->
            <StackPanel IsVisible="{Binding IsSaveStep}" Spacing="16">
                <TextBlock Classes="subtitle" Text="{loc:Localize PdkImport.SaveTitle}"/>

                <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,12,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="secondary"
                               Text="{loc:Localize PdkImport.PdkNameLabel}" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PdkName}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="secondary"
                               Text="{loc:Localize PdkImport.OutputFileLabel}" VerticalAlignment="Center"/>
                    <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,8,Auto">
                        <TextBox Grid.Column="0" Text="{Binding OutputPath}"/>
                        <Button Grid.Column="2" Classes="icon" Command="{Binding BrowseOutputPathCommand}"
                                ToolTip.Tip="{loc:Localize PdkImport.BrowseTip}">
                            <controls:Icon Data="{StaticResource Icon.FolderOpen}"/>
                        </Button>
                    </Grid>
                </Grid>

                <TextBlock Classes="caption"
                           Text="{Binding ParsedComponents.Count, StringFormat='Components to import: {0}'}"/>

                <Border Classes="card" Background="{DynamicResource Brush.Danger.Subtle}"
                        IsVisible="{Binding HasError}">
                    <TextBlock Classes="caption mono" Text="{Binding ErrorText}" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Danger}"/>
                </Border>

                <TextBlock Classes="secondary" Text="{Binding StatusText}" TextWrapping="Wrap"/>
            </StackPanel>

        </Grid>

        <!-- Footer (always visible) -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0"
                Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="{loc:Localize Common.Cancel}" Command="{Binding CancelCommand}"/>
                <Button Content="{loc:Localize PdkImport.Retry}" Command="{Binding RetryParsingCommand}"
                        IsVisible="{Binding HasError}"/>
                <Button Content="{loc:Localize PdkImport.Back}" Command="{Binding BackToReviewCommand}"
                        IsVisible="{Binding IsSaveStep}"/>
                <Button Classes="primary" Content="{loc:Localize PdkImport.Next}"
                        Command="{Binding ProceedToSaveCommand}"
                        IsVisible="{Binding IsReviewStep}"/>
                <Button Classes="primary" Content="{loc:Localize PdkImport.SaveAndLoad}"
                        Command="{Binding SaveAndLoadCommand}"
                        IsVisible="{Binding IsSaveStep}"
                        IsEnabled="{Binding IsLoading, Converter={x:Static BoolConverters.Not}}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
