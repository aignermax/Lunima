<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="using:CAP.Avalonia.Controls"
        xmlns:loc="using:CAP.Avalonia.Services.Localization"
        xmlns:reg="using:CAP.Avalonia.ViewModels.ComponentRegistry.RegistryBrowser"
        x:Class="CAP.Avalonia.Views.RegistryBrowserWindow"
        x:DataType="reg:RegistryBrowserViewModel"
        Title="{loc:Localize Registry.WindowTitle}"
        Width="1100" Height="720"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!-- Trust status chips: the registry status decides the semantic color. -->
        <Style Selector="Border.chip[Tag=verified]"><Setter Property="Background" Value="{DynamicResource Brush.Success.Subtle}"/></Style>
        <Style Selector="Border.chip[Tag=verified] > TextBlock"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/></Style>
        <Style Selector="Border.chip[Tag=demo]"><Setter Property="Background" Value="{DynamicResource Brush.Warning.Subtle}"/></Style>
        <Style Selector="Border.chip[Tag=demo] > TextBlock"><Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/></Style>
        <Style Selector="Border.chip[Tag=disputed]"><Setter Property="Background" Value="{DynamicResource Brush.Danger.Subtle}"/></Style>
        <Style Selector="Border.chip[Tag=disputed] > TextBlock"><Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/></Style>
        <Style Selector="Border.chip[Tag=withdrawn]"><Setter Property="Background" Value="{DynamicResource Brush.Danger.Subtle}"/></Style>
        <Style Selector="Border.chip[Tag=withdrawn] > TextBlock"><Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/></Style>
        <Style Selector="Border.preview">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Canvas}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.M}"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
    </Window.Styles>

    <DockPanel Margin="24" LastChildFill="True">

        <!-- Header: title + one-line intro -->
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,16">
            <TextBlock Classes="headline" Text="{loc:Localize Registry.Title}"/>
            <TextBlock Classes="caption" Text="{loc:Localize Registry.Intro}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Filter bar: free-text search, process + status dropdowns, cache-bypassing refresh -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,12">
            <TextBox Grid.Column="0" Watermark="{loc:Localize Registry.SearchWatermark}"
                     Text="{Binding SearchText}" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding ProcessFilters}"
                      SelectedItem="{Binding SelectedProcessFilter}"
                      MinWidth="150" Margin="0,0,8,0"
                      ToolTip.Tip="{loc:Localize Registry.AllProcesses}"/>
            <ComboBox Grid.Column="2" ItemsSource="{Binding StatusFilters}"
                      SelectedItem="{Binding SelectedStatusFilter}"
                      MinWidth="120" Margin="0,0,8,0"
                      ToolTip.Tip="{loc:Localize Registry.AllStatuses}"/>
            <Button Grid.Column="3" Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding IsLoading, Converter={x:Static BoolConverters.Not}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ctrl:Icon Data="{StaticResource Icon.RefreshCw}"/>
                    <TextBlock Text="{loc:Localize Registry.Refresh}"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Status line: loading, non-blocking error, offline/cache note -->
        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,8">
            <TextBlock Classes="caption" Text="{loc:Localize Registry.Loading}"
                       IsVisible="{Binding IsLoading}"/>
            <TextBlock Classes="caption danger" Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Classes="caption warning" Text="{Binding SourceNote}" TextWrapping="Wrap"
                       IsVisible="{Binding SourceNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>

        <!-- Main area: tile grid on the left, detail column on the right -->
        <Grid ColumnDefinitions="*,330">

            <ListBox Grid.Column="0" ItemsSource="{Binding FilteredComponents}"
                     SelectedItem="{Binding SelectedComponent}"
                     Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="4"/>
                        <Setter Property="CornerRadius" Value="{DynamicResource Radius.L}"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="reg:RegistryComponentItemViewModel">
                        <Border Classes="card" Width="220" Padding="12">
                            <StackPanel Spacing="8">
                                <!-- Geometry preview: the registry's SVG rendered as native
                                     geometry. The chip icon stays as placeholder while the
                                     preview loads, for entries without a published preview, and
                                     whenever the download or parse fails. -->
                                <Border Classes="preview" Height="64">
                                    <Panel>
                                        <ctrl:Icon Data="{StaticResource Icon.Microchip}" Size="24"
                                                   Foreground="{DynamicResource Brush.Text.Disabled}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   IsVisible="{Binding PreviewSvg, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                                        <ctrl:RegistryPreviewControl Svg="{Binding PreviewSvg}"
                                            IsVisible="{Binding PreviewSvg, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </Panel>
                                </Border>
                                <TextBlock Classes="strong" Text="{Binding Name}"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Classes="caption" Text="{Binding ProcessAndPortsText}"/>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Border Classes="chip" Tag="{Binding Status}">
                                        <TextBlock Text="{Binding Status}"/>
                                    </Border>
                                    <Border Classes="chip danger" IsVisible="{Binding IsProcessMismatch}">
                                        <TextBlock Text="{loc:Localize Registry.DifferentProcess}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Classes="caption mono" Text="{Binding TiersText}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state when the filters match nothing -->
            <StackPanel Grid.Column="0" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsVisible="{Binding HasNoResults}">
                <ctrl:Icon Data="{StaticResource Icon.Search}" Size="24" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                <TextBlock Classes="secondary" Text="{loc:Localize Registry.NoResults}"/>
            </StackPanel>

            <!-- Detail column for the selected component -->
            <Border Grid.Column="1" Classes="card" Margin="12,0,0,0">
                <Panel>
                    <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsVisible="{Binding SelectedComponent, Converter={x:Static ObjectConverters.IsNull}}">
                        <ctrl:Icon Data="{StaticResource Icon.Pointer}" Size="24" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                        <TextBlock Classes="secondary" Text="{loc:Localize Registry.SelectPrompt}"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  IsVisible="{Binding SelectedComponent, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="title" Text="{Binding SelectedComponent.Name, FallbackValue=''}"
                                       TextWrapping="Wrap"/>
                            <!-- Larger geometry preview of the selected component. -->
                            <Border Classes="preview" Height="130"
                                    IsVisible="{Binding SelectedComponent.PreviewSvg, FallbackValue='', Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <ctrl:RegistryPreviewControl
                                    Svg="{Binding SelectedComponent.PreviewSvg, FallbackValue=''}"/>
                            </Border>
                            <TextBlock Classes="caption" Text="{loc:Localize Registry.LoadingDetails}"
                                       IsVisible="{Binding Details.IsLoading}"/>
                            <TextBlock Classes="caption danger" Text="{Binding Details.ErrorMessage}" TextWrapping="Wrap"
                                       IsVisible="{Binding Details.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Text="{Binding Details.Description}" TextWrapping="Wrap"/>
                            <TextBlock Classes="caption" Text="{Binding Details.PortsText}"
                                       IsVisible="{Binding Details.PortsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                            <TextBlock Classes="label" Text="{loc:Localize Registry.Parameters}" Margin="0,8,0,0"
                                       IsVisible="{Binding Details.HasParameters}"/>
                            <ItemsControl ItemsSource="{Binding Details.Parameters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Classes="caption secondary mono" Text="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Classes="label" Text="{loc:Localize Registry.Artifacts}" Margin="0,8,0,0"
                                       IsVisible="{Binding Details.HasArtifacts}"/>
                            <ItemsControl ItemsSource="{Binding Details.Artifacts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="reg:RegistryArtifactDisplay">
                                        <StackPanel Margin="0,4" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Classes="caption success" Text="{Binding Tier}"/>
                                                <TextBlock Classes="caption secondary mono" Text="{Binding File}" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                                <Border Classes="chip" Tag="{Binding Status}">
                                                    <TextBlock Text="{Binding Status}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Classes="caption" Text="{Binding Provenance}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Classes="caption" Margin="0,4,0,0"
                                       IsVisible="{Binding Details.License, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <Run Text="{loc:Localize Registry.LicensePrefix}"/><Run Text="{Binding Details.License}"/>
                            </TextBlock>

                            <!-- Download into the local library: adopts the component's real
                                 simulated/measured S-parameters into a process-bound "Registry" PDK.
                                 Disabled without a usable artifact or when the process mismatches. -->
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Button Classes="primary" Command="{Binding DownloadCommand}"
                                        ToolTip.Tip="{Binding DownloadUnavailableReason}"
                                        ToolTip.ShowOnDisabled="True">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ctrl:Icon Data="{StaticResource Icon.Download}"/>
                                        <TextBlock Text="{loc:Localize Registry.Download}"/>
                                    </StackPanel>
                                </Button>
                                <ctrl:HelpFlyoutButton Title="{loc:Localize Registry.DownloadHelpTitle}"
                                                       VerticalAlignment="Center">
                                    <ctrl:HelpFlyoutButton.HelpContent>
                                        <TextBlock Classes="body" MaxWidth="280" TextWrapping="Wrap"
                                                   Text="{loc:Localize Registry.DownloadHelpContent}"/>
                                    </ctrl:HelpFlyoutButton.HelpContent>
                                </ctrl:HelpFlyoutButton>
                            </StackPanel>
                            <Border Background="{DynamicResource Brush.Danger.Subtle}"
                                    CornerRadius="{DynamicResource Radius.M}" Padding="12"
                                    IsVisible="{Binding PendingDisputedConfirm}">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="caption danger" Text="{loc:Localize Registry.DisputedWarning}"
                                               TextWrapping="Wrap"/>
                                    <Button Classes="danger" Content="{loc:Localize Registry.DownloadAnyway}"
                                            Command="{Binding ConfirmDisputedDownloadCommand}"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Classes="caption" Text="{Binding DownloadMessage}"
                                       Classes.danger="{Binding DownloadIsError}"
                                       Classes.success="{Binding !DownloadIsError}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding DownloadMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Panel>
            </Border>
        </Grid>
    </DockPanel>

</Window>
