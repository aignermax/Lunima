<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CAP.Avalonia.ViewModels.PdkOffset"
        xmlns:libvm="using:CAP.Avalonia.ViewModels.Library"
        xmlns:conv="using:CAP.Avalonia.Converters"
        xmlns:controls="using:CAP.Avalonia.Controls"
        xmlns:loc="using:CAP.Avalonia.Services.Localization"
        x:Class="CAP.Avalonia.Views.PdkOffsetEditorWindow"
        x:DataType="vm:PdkOffsetEditorViewModel"
        Title="{loc:Localize PdkOffset.Title}"
        Width="1000" Height="700"
        MinWidth="700" MinHeight="500">

    <Window.Resources>
        <conv:StatusBadgeConverter x:Key="StatusBadge"/>
    </Window.Resources>

    <Grid ColumnDefinitions="280,1,*" RowDefinitions="*">

        <!-- Left panel: component list -->
        <DockPanel Grid.Column="0" Margin="16" Background="Transparent">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12" Spacing="8">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{loc:Localize PdkOffset.LoadPdk}"
                            Command="{Binding LoadPdkFileCommand}"/>
                    <TextBlock Classes="label" Text="{loc:Localize PdkOffset.PdkComponents}"
                               VerticalAlignment="Center"/>
                </DockPanel>
                <ComboBox ItemsSource="{Binding AvailablePdks}"
                          SelectedItem="{Binding SelectedInstalledPdk}"
                          PlaceholderText="{loc:Localize PdkOffset.SelectPdkPlaceholder}"
                          HorizontalAlignment="Stretch"
                          ToolTip.Tip="{loc:Localize PdkOffset.LoadInstalledPdkTip}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="libvm:PdkInfoViewModel">
                            <TextBlock Text="{Binding DisplayText}"
                                       ToolTip.Tip="{Binding FilePath}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <Border DockPanel.Dock="Top" Classes="card" Padding="12" Margin="0,0,0,12">
                <StackPanel Spacing="8">
                    <TextBlock Classes="label" Text="{loc:Localize PdkOffset.BatchOperations}"/>
                    <Grid ColumnDefinitions="*,8,*">
                        <Button Grid.Column="0" Content="{loc:Localize PdkOffset.CheckAll}"
                                Command="{Binding CheckAllCommand}"
                                HorizontalAlignment="Stretch"
                                ToolTip.Tip="{loc:Localize PdkOffset.CheckAllTip}"/>
                        <Button Grid.Column="2" Content="{loc:Localize PdkOffset.TryFixAll}"
                                Command="{Binding TryFixAllCommand}"
                                HorizontalAlignment="Stretch"
                                ToolTip.Tip="{loc:Localize PdkOffset.TryFixAllTip}"/>
                    </Grid>
                    <ProgressBar IsIndeterminate="True" Height="3"
                                 IsVisible="{Binding IsBatchRunning}"/>
                    <TextBlock Classes="caption" Text="{Binding BatchProgress}"
                               IsVisible="{Binding BatchProgress, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextTrimming="CharacterEllipsis"/>
                    <Button Classes="ghost" Content="{loc:Localize PdkOffset.Cancel}"
                            Command="{Binding CancelBatchCommand}"
                            IsVisible="{Binding IsBatchRunning}"
                            HorizontalAlignment="Stretch"/>
                    <TextBlock Classes="caption warning" Text="{Binding BatchSummary}"
                               IsVisible="{Binding BatchSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <ListBox ItemsSource="{Binding Components}"
                     SelectedItem="{Binding SelectedComponent}"
                     SelectionMode="Single">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PdkComponentOffsetItemViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    ToolTip.Tip="{Binding StatusDescription}">
                            <controls:Icon VerticalAlignment="Center" Size="14"
                                           Data="{Binding StatusBadge, Converter={StaticResource StatusBadge}, ConverterParameter=icon}"
                                           Foreground="{Binding StatusBadge, Converter={StaticResource StatusBadge}}"/>
                            <TextBlock Text="{Binding ComponentName}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" ResizeDirection="Columns" Width="1"/>

        <!-- Right panel: editor -->
        <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" Margin="24">

                <!-- Component header -->
                <StackPanel Spacing="4">
                    <StackPanel Spacing="8" HorizontalAlignment="Left"
                                IsVisible="{Binding SelectedComponent, Converter={x:Static ObjectConverters.IsNull}}">
                        <controls:Icon Data="{StaticResource Icon.Pointer}" Size="24"
                                       Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                        <TextBlock Classes="secondary" Text="{loc:Localize PdkOffset.NoComponentSelected}"/>
                    </StackPanel>
                    <StackPanel Spacing="2"
                                IsVisible="{Binding SelectedComponent, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Classes="headline" Text="{Binding SelectedComponent.ComponentName}"/>
                        <TextBlock Classes="caption" Text="{Binding SelectedComponent.PdkName}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <controls:Icon VerticalAlignment="Center" Size="14"
                                           Data="{Binding SelectedComponent.StatusBadge, Converter={StaticResource StatusBadge}, ConverterParameter=icon}"
                                           Foreground="{Binding SelectedComponent.StatusBadge, Converter={StaticResource StatusBadge}}"/>
                            <TextBlock Classes="secondary" Text="{Binding SelectedComponent.StatusDescription}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Offset editor -->
                <Border Classes="card"
                        IsVisible="{Binding SelectedComponent, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="subtitle" Text="{loc:Localize PdkOffset.OriginOffset}"/>
                        <Grid ColumnDefinitions="Auto,120,24,Auto,120,*,Auto">
                            <TextBlock Grid.Column="0" Classes="secondary" Text="X" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <NumericUpDown Grid.Column="1" Value="{Binding OffsetX}"
                                           FormatString="F3" Increment="0.5"/>
                            <TextBlock Grid.Column="3" Classes="secondary" Text="Y" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <NumericUpDown Grid.Column="4" Value="{Binding OffsetY}"
                                           FormatString="F3" Increment="0.5"/>
                            <Button Grid.Column="6" Classes="primary" Content="{loc:Localize Common.Apply}"
                                    Command="{Binding ApplyOffsetCommand}"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,120,24,Auto,120,*">
                            <TextBlock Grid.Column="0" Classes="secondary" Text="{loc:Localize PdkOffset.Width}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <NumericUpDown Grid.Column="1" Value="{Binding ComponentWidth}"
                                           FormatString="F3" Increment="0.5" Minimum="0.001"/>
                            <TextBlock Grid.Column="3" Classes="secondary" Text="{loc:Localize PdkOffset.Height}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <NumericUpDown Grid.Column="4" Value="{Binding ComponentHeight}"
                                           FormatString="F3" Increment="0.5" Minimum="0.001"/>
                        </Grid>
                        <Button Command="{Binding AutoCalibrateCommand}"
                                HorizontalAlignment="Left"
                                ToolTip.Tip="{loc:Localize PdkOffset.AutoCalibrateTip}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:Icon Data="{StaticResource Icon.Crosshair}"/>
                                <TextBlock Text="{loc:Localize PdkOffset.AutoCalibrate}"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Classes="caption" Text="{loc:Localize PdkOffset.ApplyHint}" TextWrapping="Wrap"/>
                        <ProgressBar IsIndeterminate="True" Height="3"
                                     IsVisible="{Binding IsNazcaRendering}"/>
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Grid.Column="0" Classes="caption warning"
                                       Text="{Binding NazcaOverlayStatus}"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Button Grid.Column="1" Classes="ghost icon"
                                    Command="{Binding CopyStatusCommand}"
                                    Margin="4,0"
                                    ToolTip.Tip="{loc:Localize PdkOffset.CopyStatusTip}"
                                    IsVisible="{Binding NazcaOverlayStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    VerticalAlignment="Center">
                                <controls:Icon Data="{StaticResource Icon.Copy}"/>
                            </Button>
                            <CheckBox Grid.Column="2"
                                      Content="{loc:Localize PdkOffset.ShowNazcaGds}"
                                      IsChecked="{Binding ShowNazcaOverlay}"
                                      ToolTip.Tip="{loc:Localize PdkOffset.ShowNazcaGdsTip}"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Classes="caption" Foreground="{DynamicResource Brush.Info}"
                                   Text="{Binding PinAlignmentSummary}"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding PinAlignmentSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <Expander Header="{loc:Localize PdkOffset.PerPinDeltas}"
                                  HorizontalAlignment="Stretch"
                                  IsExpanded="False"
                                  IsVisible="{Binding PinAlignmentResults.Count}">
                            <ItemsControl ItemsSource="{Binding PinAlignmentResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="90,90,100,100,Auto" Margin="0,2">
                                            <TextBlock Grid.Column="0" Text="{Binding LunimaPinName}"/>
                                            <TextBlock Grid.Column="1" Classes="caption" Text="{Binding NearestNazcaPinName, StringFormat='→ {0}'}"/>
                                            <TextBlock Grid.Column="2" Classes="mono secondary" Text="{Binding DeltaXMicrometers, StringFormat='Δx={0:F2}µm'}"/>
                                            <TextBlock Grid.Column="3" Classes="mono secondary" Text="{Binding DeltaYMicrometers, StringFormat='Δy={0:F2}µm'}"/>
                                            <TextBlock Grid.Column="4" Classes="warning" Text="{Binding AlignedLabel}" Margin="8,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                        <Expander Header="{loc:Localize PdkOffset.PreviewSource}"
                                  HorizontalAlignment="Stretch"
                                  IsExpanded="False"
                                  IsVisible="{Binding PreviewSource, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBox Classes="mono" Text="{Binding PreviewSource}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     Height="140"/>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- Visual overlay canvas -->
                <Border Classes="card"
                        IsVisible="{Binding SelectedComponent, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Classes="subtitle" Text="{loc:Localize PdkOffset.VisualPinOverlay}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        HorizontalAlignment="Right" Spacing="8">
                                <TextBlock Classes="secondary" Text="{loc:Localize PdkOffset.Zoom}"
                                           VerticalAlignment="Center"/>
                                <Slider x:Name="ZoomSlider"
                                        Minimum="0.25" Maximum="8.0" Value="1.0"
                                        Width="160"
                                        TickFrequency="0.25" IsSnapToTickEnabled="False"
                                        ToolTip.Tip="{loc:Localize PdkOffset.ZoomTip}"/>
                                <TextBlock Classes="mono secondary" Text="{Binding #ZoomSlider.Value, StringFormat={}{0:F2}x}"
                                           VerticalAlignment="Center" Width="44"/>
                                <Button Content="1:1" Command="{Binding ResetZoomCommand}"
                                        ToolTip.Tip="{loc:Localize PdkOffset.ResetZoomTip}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Classes="caption" Text="{loc:Localize PdkOffset.OverlayLegend}" TextWrapping="Wrap"/>
                        <!-- Render problem banner: failed render OR empty geometry. Shown AT the
                             component so the dashed box never poses as a successful preview. -->
                        <Border Background="{DynamicResource Brush.Danger.Subtle}"
                                CornerRadius="{DynamicResource Radius.M}" Padding="12,8"
                                IsVisible="{Binding OverlayErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Classes="caption danger" Text="{Binding OverlayErrorText}" TextWrapping="Wrap"/>
                        </Border>
                        <ScrollViewer x:Name="OverlayScrollViewer"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      Height="450"
                                      Background="{DynamicResource Brush.Surface.Canvas}"
                                      Cursor="Hand">
                            <!-- LayoutTransformControl re-measures its child after applying
                                 the scale, so the ScrollViewer learns the true rendered size
                                 and produces scrollbars on zoom-in. -->
                            <LayoutTransformControl>
                                <LayoutTransformControl.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding #ZoomSlider.Value}"
                                                    ScaleY="{Binding #ZoomSlider.Value}"/>
                                </LayoutTransformControl.LayoutTransform>
                                <Canvas x:Name="OverlayCanvas"
                                        Background="{DynamicResource Brush.Surface.Canvas}"
                                        ClipToBounds="True"/>
                            </LayoutTransformControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Pin positions table -->
                <Border Classes="card"
                        IsVisible="{Binding SelectedComponent, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="subtitle" Text="{loc:Localize PdkOffset.PinPositionsTitle}"/>
                        <Grid ColumnDefinitions="90,90,90,90,90">
                            <TextBlock Grid.Column="0" Classes="label" Text="{loc:Localize PdkOffset.Pin}"/>
                            <TextBlock Grid.Column="1" Classes="label" Text="{loc:Localize PdkOffset.LocalX}"/>
                            <TextBlock Grid.Column="2" Classes="label" Text="{loc:Localize PdkOffset.LocalY}"/>
                            <TextBlock Grid.Column="3" Classes="label" Text="{loc:Localize PdkOffset.NazcaX}"/>
                            <TextBlock Grid.Column="4" Classes="label" Text="{loc:Localize PdkOffset.NazcaY}"/>
                        </Grid>
                        <Border Classes="divider" Height="1"/>
                        <ItemsControl ItemsSource="{Binding PinPositions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PinPositionViewModel">
                                    <Grid ColumnDefinitions="90,90,90,90,90" Margin="0,2">
                                        <TextBlock Grid.Column="0" Text="{Binding PinName}"/>
                                        <TextBlock Grid.Column="1" Classes="mono secondary" Text="{Binding LocalXText}"/>
                                        <TextBlock Grid.Column="2" Classes="mono secondary" Text="{Binding LocalYText}"/>
                                        <TextBlock Grid.Column="3" Classes="mono accent" Text="{Binding NazcaXText}"/>
                                        <TextBlock Grid.Column="4" Classes="mono accent" Text="{Binding NazcaYText}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Batch report -->
                <Border Classes="card" IsVisible="{Binding BatchCheckResults.Count}">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Grid.Column="0" Classes="subtitle" Text="{loc:Localize PdkOffset.BatchReport}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="{loc:Localize PdkOffset.CopyReport}"
                                    Command="{Binding CopyBatchReportCommand}" Margin="0,0,8,0"
                                    ToolTip.Tip="{loc:Localize PdkOffset.CopyReportTip}"/>
                            <Button Grid.Column="2" Content="{loc:Localize PdkOffset.CopyErrors}"
                                    Command="{Binding CopyBatchErrorsCommand}"
                                    ToolTip.Tip="{loc:Localize PdkOffset.CopyErrorsTip}"/>
                        </Grid>
                        <Grid ColumnDefinitions="24,*,80,80,140">
                            <TextBlock Grid.Column="1" Classes="label" Text="{loc:Localize PdkOffset.Component}"/>
                            <TextBlock Grid.Column="2" Classes="label" Text="{loc:Localize PdkOffset.PinsLN}"/>
                            <TextBlock Grid.Column="3" Classes="label" Text="{loc:Localize PdkOffset.DeltaMax}"/>
                            <TextBlock Grid.Column="4" Classes="label" Text="{loc:Localize PdkOffset.Status}"/>
                        </Grid>
                        <Border Classes="divider" Height="1"/>
                        <ItemsControl ItemsSource="{Binding BatchCheckResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="24,*,80,80,140" Margin="0,2"
                                          ToolTip.Tip="{Binding Message}">
                                        <controls:Icon Grid.Column="0" Size="14" HorizontalAlignment="Left"
                                                       Data="{Binding StatusBadge, Converter={StaticResource StatusBadge}, ConverterParameter=icon}"
                                                       Foreground="{Binding StatusBadge, Converter={StaticResource StatusBadge}}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ComponentName}"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <TextBlock Classes="mono secondary"
                                                       Text="{Binding LunimaPinCount, StringFormat='{}{0}/'}"/>
                                            <TextBlock Classes="mono secondary" Text="{Binding NazcaPinCount}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Classes="mono secondary"
                                                   Text="{Binding WorstDeltaMicrometers, StringFormat='{}{0:F2} µm'}"/>
                                        <!-- MultiBinding: the second input binds the LocalizationService
                                             indexer, so a live language switch ("Item" notification)
                                             re-translates the Status column; its value is ignored. -->
                                        <TextBlock Grid.Column="4" Classes="warning">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{x:Static conv:ComponentCheckStatusToTextConverter.Instance}">
                                                    <Binding Path="Status"/>
                                                    <Binding Source="{x:Static loc:LocalizationService.Instance}"
                                                             Path="[PdkOffset.Status]"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Save + status bar -->
                <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="primary"
                            Command="{Binding SavePdkCommand}"
                            ToolTip.Tip="{loc:Localize PdkOffset.SavePdkTip}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:Icon Data="{StaticResource Icon.Save}"/>
                            <TextBlock Text="{loc:Localize PdkOffset.SavePdk}"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Classes="secondary" Text="{Binding StatusText}"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Window>
