<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CAP.Avalonia.ViewModels"
             xmlns:controls="using:CAP.Avalonia.Controls"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             x:Class="CAP.Avalonia.Views.MainView"
             x:DataType="vm:MainViewModel">

    <DockPanel>
        <!-- Toolbar -->
        <ScrollViewer DockPanel.Dock="Top"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Background="{DynamicResource Brush.Surface.Raised}"
                      Height="40">
            <StackPanel Orientation="Horizontal">
                <Button Content="+" Command="{Binding ZoomInCommand}" Margin="5"/>
                <Button Content="-" Command="{Binding ZoomOutCommand}" Margin="5"/>
                <Button Content="{loc:Localize MainView.ResetZoom}" Command="{Binding ResetZoomCommand}" Margin="5"/>
                <TextBlock Text="{Binding ZoomLevel, StringFormat=Zoom: {0:P0}}"
                           VerticalAlignment="Center" Margin="10,0" Foreground="{DynamicResource Brush.Text.Primary}"/>
                <Border Width="1" Background="{DynamicResource Brush.Border.Strong}" Margin="5,5"/>
                <Button Content="{loc:Localize MainView.Simulate}" Command="{Binding RunSimulationCommand}" Margin="5"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Surface.Panel}" Height="25">
            <Grid ColumnDefinitions="Auto,Auto,*">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                           VerticalAlignment="Center" Margin="10,0" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                <Button Grid.Column="1" Content="{loc:Localize Routing.Status.Stop}"
                        Command="{Binding Canvas.StopRoutingCommand}"
                        IsVisible="{Binding Canvas.IsRouting}"
                        VerticalAlignment="Center" Margin="6,0,0,0"
                        ToolTip.Tip="{loc:Localize Routing.Status.StopTip}"/>
            </Grid>
        </Border>

        <!-- Main Canvas -->
        <controls:DesignCanvas ViewModel="{Binding Canvas}"
                               Zoom="{Binding ZoomLevel}"/>
    </DockPanel>
</UserControl>
