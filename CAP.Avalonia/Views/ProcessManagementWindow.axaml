<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CAP.Avalonia.ViewModels"
        xmlns:controls="using:CAP.Avalonia.Controls"
        xmlns:panels="using:CAP.Avalonia.Views.Panels"
        xmlns:loc="using:CAP.Avalonia.Services.Localization"
        x:Class="CAP.Avalonia.Views.ProcessManagementWindow"
        x:CompileBindings="False"
        Title="{loc:Localize ProcessManagement.Title}"
        Width="820" Height="680"
        MinWidth="500" MinHeight="400"
        Background="#1e1e1e"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="14">

        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{loc:Localize ProcessManagement.Header}" FontWeight="SemiBold" FontSize="16" Foreground="LightBlue"/>
                <!-- Plain-language explainer for non-physicists (#682 / #570): what a process,
                     layers, cross-sections and materials are, and why electrical routing needs
                     its own metal cross-section. -->
                <controls:HelpFlyoutButton Title="{loc:Localize ProcessManagement.HelpTitle}" VerticalAlignment="Center">
                    <controls:HelpFlyoutButton.HelpContent>
                        <!-- Short localized sections + looping layer-stack animation (#1152). -->
                        <panels:ProcessHelpFlyout/>
                    </controls:HelpFlyoutButton.HelpContent>
                </controls:HelpFlyoutButton>
            </StackPanel>
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#9999bb"
                       Text="{loc:Localize ProcessManagement.Intro}"/>

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                <Button Content="{loc:Localize ProcessManagement.SaveToPdk}" Command="{Binding SaveProcessCommand}" IsVisible="{Binding HasProcess}"
                        Padding="12,6" Background="#2a4a2a"
                        ToolTip.Tip="{loc:Localize ProcessManagement.SaveTip}"/>
                <TextBlock Text="{loc:Localize ProcessManagement.ProcessLabel}" VerticalAlignment="Center" Foreground="#aaa"/>
                <TextBox Text="{Binding ProcessName}" Width="220" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#aaccaa" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasProcess}">
            <StackPanel Spacing="14">

                <!-- Layers -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{loc:Localize ProcessManagement.LayerStack}" FontWeight="SemiBold" Foreground="#aaaacc" FontSize="13" VerticalAlignment="Center"/>
                    <Button Content="{loc:Localize ProcessManagement.AddLayer}" Command="{Binding AddLayerCommand}" FontSize="10" Padding="6,1" Background="#2a4a2a"/>
                </StackPanel>
                <Grid ColumnDefinitions="2*,1*,1*,1*,3*">
                    <TextBlock Grid.Column="0" Text="{loc:Localize ProcessManagement.ColName}" Foreground="#888" FontSize="10"/>
                    <TextBlock Grid.Column="1" Text="{loc:Localize ProcessManagement.ColLayer}" Foreground="#888" FontSize="10"/>
                    <TextBlock Grid.Column="2" Text="{loc:Localize ProcessManagement.ColDatatype}" Foreground="#888" FontSize="10"/>
                    <TextBlock Grid.Column="3" Text="{loc:Localize ProcessManagement.ColField}" Foreground="#888" FontSize="10"/>
                    <TextBlock Grid.Column="4" Text="{loc:Localize ProcessManagement.ColDescription}" Foreground="#888" FontSize="10"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Layers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="2*,1*,1*,1*,3*" Margin="0,1">
                                <TextBox Grid.Column="0" Text="{Binding Name}" FontSize="11" Margin="0,0,2,0"/>
                                <TextBox Grid.Column="1" Text="{Binding Layer}" FontSize="11" Margin="0,0,2,0"/>
                                <TextBox Grid.Column="2" Text="{Binding Datatype}" FontSize="11" Margin="0,0,2,0"/>
                                <TextBox Grid.Column="3" Text="{Binding Field}" FontSize="11" Margin="0,0,2,0"/>
                                <TextBox Grid.Column="4" Text="{Binding Description}" FontSize="11"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Cross-sections -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{loc:Localize ProcessManagement.CrossSectionsTitle}" FontWeight="SemiBold" Foreground="#aaaacc" FontSize="13" VerticalAlignment="Center"/>
                    <Button Content="{loc:Localize ProcessManagement.AddXsection}" Command="{Binding AddXsectionCommand}" FontSize="10" Padding="6,1" Background="#2a4a2a"/>
                    <Button Content="{loc:Localize ProcessManagement.AddMetal}" Command="{Binding AddMetalXsectionCommand}" FontSize="10" Padding="6,1" Background="#4a3a2a"
                            ToolTip.Tip="{loc:Localize ProcessManagement.AddMetalTip}"/>
                </StackPanel>
                <Grid ColumnDefinitions="2*,1*,1*,1.2*,1.4*,2*">
                    <TextBlock Grid.Column="0" Text="{loc:Localize ProcessManagement.ColName}" Foreground="#888" FontSize="10"/>
                    <TextBlock Grid.Column="1" Text="{loc:Localize ProcessManagement.ColKind}" Foreground="#888" FontSize="10"/>
                    <TextBlock Grid.Column="2" Text="{loc:Localize ProcessManagement.ColWidth}" Foreground="#888" FontSize="10"/>
                    <TextBlock Grid.Column="3" Text="{loc:Localize ProcessManagement.ColMinR}" Foreground="#888" FontSize="10"/>
                    <TextBlock Grid.Column="4" Text="{loc:Localize ProcessManagement.ColRecR}" Foreground="#888" FontSize="10"/>
                    <TextBlock Grid.Column="5" Text="{loc:Localize ProcessManagement.ColDescription}" Foreground="#888" FontSize="10"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Xsections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="2*,1*,1*,1.2*,1.4*,2*" Margin="0,1">
                                <TextBox Grid.Column="0" Text="{Binding Name}" FontSize="11" Margin="0,0,2,0"/>
                                <ComboBox Grid.Column="1" FontSize="11" Margin="0,0,2,0" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Static vm:ProcessManagementViewModel.XsectionKinds}"
                                          SelectedItem="{Binding Kind}"
                                          ToolTip.Tip="{loc:Localize ProcessManagement.KindTip}"/>
                                <TextBox Grid.Column="2" Text="{Binding WidthUm}" FontSize="11" Margin="0,0,2,0"/>
                                <TextBox Grid.Column="3" Text="{Binding MinRadiusUm}" FontSize="11" Margin="0,0,2,0"/>
                                <TextBox Grid.Column="4" Text="{Binding RecommendedRadiusUm}" FontSize="11" Margin="0,0,2,0"/>
                                <TextBox Grid.Column="5" Text="{Binding Description}" FontSize="11"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <CheckBox IsChecked="{Binding MetalMayCrossPhotonic}" Margin="0,8,0,2"
                          Foreground="White" FontSize="11"
                          ToolTip.Tip="{loc:Localize ProcessManagement.MetalMayCrossPhotonicTip}">
                    <TextBlock Text="{loc:Localize ProcessManagement.MetalMayCrossPhotonic}" TextWrapping="Wrap"/>
                </CheckBox>

                <!-- Materials -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{loc:Localize ProcessManagement.Materials}" FontWeight="SemiBold" Foreground="#aaaacc" FontSize="13" VerticalAlignment="Center"/>
                    <Button Content="{loc:Localize ProcessManagement.AddMaterial}" Command="{Binding AddMaterialCommand}" FontSize="10" Padding="6,1" Background="#2a4a2a"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Materials}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="2*,2*" Margin="0,1">
                                <TextBox Grid.Column="0" Text="{Binding Name}" FontSize="11" Margin="0,0,2,0"/>
                                <TextBox Grid.Column="1" Text="{Binding Role}" FontSize="11"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{loc:Localize ProcessManagement.MaterialsNote}"
                           FontSize="10" Foreground="#777799" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
