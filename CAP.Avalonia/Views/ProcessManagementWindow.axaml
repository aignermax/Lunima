<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CAP.Avalonia.ViewModels"
        xmlns:controls="using:CAP.Avalonia.Controls"
        xmlns:panels="using:CAP.Avalonia.Views.Panels"
        xmlns:loc="using:CAP.Avalonia.Services.Localization"
        x:Class="CAP.Avalonia.Views.ProcessManagementWindow"
        x:CompileBindings="False"
        Title="{loc:Localize ProcessManagement.Title}"
        Width="820" Height="680"
        MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="24">

        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="headline" Text="{loc:Localize ProcessManagement.Header}"/>
                <!-- Plain-language explainer for non-physicists: what a process,
                     layers, cross-sections and materials are, and why electrical routing needs
                     its own metal cross-section. -->
                <controls:HelpFlyoutButton Title="{loc:Localize ProcessManagement.HelpTitle}" VerticalAlignment="Center">
                    <controls:HelpFlyoutButton.HelpContent>
                        <panels:ProcessHelpFlyout/>
                    </controls:HelpFlyoutButton.HelpContent>
                </controls:HelpFlyoutButton>
            </StackPanel>
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="{loc:Localize ProcessManagement.Intro}"/>

            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Classes="primary"
                        Command="{Binding SaveProcessCommand}" IsVisible="{Binding HasProcess}"
                        ToolTip.Tip="{loc:Localize ProcessManagement.SaveTip}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:Icon Data="{StaticResource Icon.Save}"/>
                        <TextBlock Text="{loc:Localize ProcessManagement.SaveToPdk}"/>
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="secondary" Text="{loc:Localize ProcessManagement.ProcessLabel}"
                               VerticalAlignment="Center"/>
                    <TextBox Text="{Binding ProcessName}" Width="240" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
            <TextBlock Classes="caption success" Text="{Binding StatusText}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Empty state until a process is loaded or started -->
        <Border Classes="empty-state" IsVisible="{Binding !HasProcess}">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <controls:Icon Data="{StaticResource Icon.Layers}" Size="24" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                <TextBlock Classes="secondary" Text="{loc:Localize ProcessManagement.NoProcess}"
                           TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasProcess}">
            <StackPanel Spacing="16">

                <!-- Layers -->
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding AddLayerCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <controls:Icon Data="{StaticResource Icon.Plus}"/>
                                    <TextBlock Text="{loc:Localize ProcessManagement.AddLayer}"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Classes="subtitle" Text="{loc:Localize ProcessManagement.LayerStack}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid ColumnDefinitions="2*,1*,1*,1*,3*">
                            <TextBlock Grid.Column="0" Classes="label" Text="{loc:Localize ProcessManagement.ColName}"/>
                            <TextBlock Grid.Column="1" Classes="label" Text="{loc:Localize ProcessManagement.ColLayer}"/>
                            <TextBlock Grid.Column="2" Classes="label" Text="{loc:Localize ProcessManagement.ColDatatype}"/>
                            <TextBlock Grid.Column="3" Classes="label" Text="{loc:Localize ProcessManagement.ColField}"/>
                            <TextBlock Grid.Column="4" Classes="label" Text="{loc:Localize ProcessManagement.ColDescription}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Layers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="2*,1*,1*,1*,3*" Margin="0,2">
                                        <TextBox Grid.Column="0" Classes="compact" Text="{Binding Name}" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="1" Classes="compact mono" Text="{Binding Layer}" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="2" Classes="compact mono" Text="{Binding Datatype}" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="3" Classes="compact mono" Text="{Binding Field}" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="4" Classes="compact" Text="{Binding Description}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Cross-sections -->
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                                <Button Command="{Binding AddXsectionCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <controls:Icon Data="{StaticResource Icon.Plus}"/>
                                        <TextBlock Text="{loc:Localize ProcessManagement.AddXsection}"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding AddMetalXsectionCommand}"
                                        ToolTip.Tip="{loc:Localize ProcessManagement.AddMetalTip}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <controls:Icon Data="{StaticResource Icon.Zap}"/>
                                        <TextBlock Text="{loc:Localize ProcessManagement.AddMetal}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Classes="subtitle" Text="{loc:Localize ProcessManagement.CrossSectionsTitle}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid ColumnDefinitions="2*,1*,1*,1.2*,1.4*,2*">
                            <TextBlock Grid.Column="0" Classes="label" Text="{loc:Localize ProcessManagement.ColName}"/>
                            <TextBlock Grid.Column="1" Classes="label" Text="{loc:Localize ProcessManagement.ColKind}"/>
                            <TextBlock Grid.Column="2" Classes="label" Text="{loc:Localize ProcessManagement.ColWidth}"/>
                            <TextBlock Grid.Column="3" Classes="label" Text="{loc:Localize ProcessManagement.ColMinR}"/>
                            <TextBlock Grid.Column="4" Classes="label" Text="{loc:Localize ProcessManagement.ColRecR}"/>
                            <TextBlock Grid.Column="5" Classes="label" Text="{loc:Localize ProcessManagement.ColDescription}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Xsections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="2*,1*,1*,1.2*,1.4*,2*" Margin="0,2">
                                        <TextBox Grid.Column="0" Classes="compact" Text="{Binding Name}" Margin="0,0,4,0"/>
                                        <ComboBox Grid.Column="1" Classes="compact" Margin="0,0,4,0" HorizontalAlignment="Stretch"
                                                  ItemsSource="{x:Static vm:ProcessManagementViewModel.XsectionKinds}"
                                                  SelectedItem="{Binding Kind}"
                                                  ToolTip.Tip="{loc:Localize ProcessManagement.KindTip}"/>
                                        <TextBox Grid.Column="2" Classes="compact mono" Text="{Binding WidthUm}" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="3" Classes="compact mono" Text="{Binding MinRadiusUm}" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="4" Classes="compact mono" Text="{Binding RecommendedRadiusUm}" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="5" Classes="compact" Text="{Binding Description}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <CheckBox IsChecked="{Binding MetalMayCrossPhotonic}" Margin="0,8,0,0"
                                  ToolTip.Tip="{loc:Localize ProcessManagement.MetalMayCrossPhotonicTip}">
                            <TextBlock Text="{loc:Localize ProcessManagement.MetalMayCrossPhotonic}" TextWrapping="Wrap"/>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- Materials -->
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding AddMaterialCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <controls:Icon Data="{StaticResource Icon.Plus}"/>
                                    <TextBlock Text="{loc:Localize ProcessManagement.AddMaterial}"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Classes="subtitle" Text="{loc:Localize ProcessManagement.Materials}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Materials}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,*" Margin="0,2">
                                        <TextBox Grid.Column="0" Classes="compact" Text="{Binding Name}" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="1" Classes="compact" Text="{Binding Role}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="caption" Text="{loc:Localize ProcessManagement.MaterialsNote}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
