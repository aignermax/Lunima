<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CAP.Avalonia.ViewModels"
        xmlns:vmLib="using:CAP.Avalonia.ViewModels.Library"
        xmlns:diagnostics="using:CAP.Avalonia.ViewModels.Diagnostics"
        xmlns:controls="using:CAP.Avalonia.Controls"
        xmlns:converters="using:CAP.Avalonia.Converters"
        xmlns:tour="using:CAP.Avalonia.Controls.TourAnchor"
        xmlns:views="using:CAP.Avalonia.Views"
        xmlns:behaviors="using:CAP.Avalonia.Behaviors"
        xmlns:panels="using:CAP.Avalonia.Views.Panels"
        xmlns:loc="using:CAP.Avalonia.Services.Localization"
        xmlns:ws="using:CAP.Avalonia.ViewModels.Workspaces"
        x:Class="CAP.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Width="1800" Height="900">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+G" Command="{Binding CreateGroupCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+G" Command="{Binding UngroupCommand}" />
        <KeyBinding Gesture="F12" Command="{Binding BottomPanel.ErrorConsole.ToggleCommand}" />
        <KeyBinding Gesture="Ctrl+D1" Command="{Binding WorkspaceSwitch.SelectCommand}" CommandParameter="{x:Static ws:Workspace.Layout}" />
        <KeyBinding Gesture="Ctrl+D2" Command="{Binding WorkspaceSwitch.SelectCommand}" CommandParameter="{x:Static ws:Workspace.Optics}" />
        <KeyBinding Gesture="Ctrl+D3" Command="{Binding WorkspaceSwitch.SelectCommand}" CommandParameter="{x:Static ws:Workspace.Logic}" />
        <KeyBinding Gesture="Ctrl+D4" Command="{Binding WorkspaceSwitch.SelectCommand}" CommandParameter="{x:Static ws:Workspace.System}" />
    </Window.KeyBindings>

    <Grid>
    <DockPanel>
        <!-- ══ Toolbar ═══════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Classes="toolbar" Height="44" Padding="8,0">
            <Grid ColumnDefinitions="*,Auto">
                <ScrollViewer Grid.Column="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="MainToolbar" Orientation="Horizontal" Spacing="2"
                                VerticalAlignment="Center">
                        <Button Classes="toolbar" Command="{Binding ShowHomeCommand}"
                                ToolTip.Tip="{loc:Localize Home.ToolbarTip}">
                            <controls:Icon Data="{StaticResource Icon.House}"/>
                        </Button>

                        <Border Classes="divider"/>

                        <!-- Canvas modes: one segmented group, the active mode carries .active -->
                        <Button Classes="toolbar" Command="{Binding SetSelectModeCommand}"
                                Classes.active="{Binding CanvasInteraction.CurrentMode, Converter={x:Static converters:EnumEqualsConverter.Instance}, ConverterParameter=Select}"
                                ToolTip.Tip="{loc:Localize Toolbar.SelectModeTip}">
                            <controls:Icon Data="{StaticResource Icon.MousePointer2}"/>
                        </Button>
                        <Button Classes="toolbar" Command="{Binding SetConnectModeCommand}"
                                Classes.active="{Binding CanvasInteraction.CurrentMode, Converter={x:Static converters:EnumEqualsConverter.Instance}, ConverterParameter=Connect}"
                                ToolTip.Tip="{loc:Localize Toolbar.ConnectModeTip}">
                            <controls:Icon Data="{StaticResource Icon.Spline}"/>
                        </Button>
                        <Button Classes="toolbar" Command="{Binding SetDeleteModeCommand}"
                                Classes.active="{Binding CanvasInteraction.CurrentMode, Converter={x:Static converters:EnumEqualsConverter.Instance}, ConverterParameter=Delete}"
                                ToolTip.Tip="{loc:Localize Toolbar.DeleteModeTip}">
                            <controls:Icon Data="{StaticResource Icon.Eraser}"/>
                        </Button>
                        <Button Classes="toolbar" Command="{Binding SetProbeModeCommand}"
                                Classes.active="{Binding CanvasInteraction.CurrentMode, Converter={x:Static converters:EnumEqualsConverter.Instance}, ConverterParameter=Probe}"
                                ToolTip.Tip="{loc:Localize Toolbar.ProbeModeTip}">
                            <controls:Icon Data="{StaticResource Icon.ScanSearch}"/>
                        </Button>
                        <Button Classes="toolbar" Command="{Binding SetCutModeCommand}"
                                Classes.active="{Binding CanvasInteraction.CurrentMode, Converter={x:Static converters:EnumEqualsConverter.Instance}, ConverterParameter=Cut}"
                                ToolTip.Tip="{loc:Localize Toolbar.CutModeTip}">
                            <controls:Icon Data="{StaticResource Icon.Scissors}"/>
                        </Button>

                        <Border Classes="divider"/>

                        <!-- View -->
                        <Button Classes="toolbar" Command="{Binding ZoomOutCommand}"
                                ToolTip.Tip="{loc:Localize Toolbar.ZoomOutTip}">
                            <controls:Icon Data="{StaticResource Icon.ZoomOut}"/>
                        </Button>
                        <Button Classes="toolbar" Command="{Binding ZoomInCommand}"
                                ToolTip.Tip="{loc:Localize Toolbar.ZoomInTip}">
                            <controls:Icon Data="{StaticResource Icon.ZoomIn}"/>
                        </Button>
                        <Button x:Name="ZoomToFitButton" Classes="toolbar" Click="ZoomToFitButton_Click"
                                ToolTip.Tip="{loc:Localize Toolbar.ZoomToFitTip}">
                            <controls:Icon Data="{StaticResource Icon.Scan}"/>
                        </Button>
                        <ToggleButton x:Name="GridSnapToggle" Classes="toolbar"
                                      IsChecked="{Binding Canvas.GridSnap.IsEnabled, Mode=TwoWay}"
                                      Click="GridSnapToggle_Click"
                                      ToolTip.Tip="{loc:Localize Toolbar.GridSnapTip}">
                            <controls:Icon Data="{StaticResource Icon.Grid3x3}"/>
                        </ToggleButton>

                        <Border Classes="divider"/>

                        <!-- Workspace switch: decides what Run does and which dock tabs show (Ctrl+1..4). -->
                        <Border x:Name="WorkspaceSwitchBar" Classes="segmented">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Classes="toolbar segment" Content="{loc:Localize Workspace.Layout}"
                                        Classes.active="{Binding WorkspaceSwitch.IsLayout}"
                                        Command="{Binding WorkspaceSwitch.SelectCommand}"
                                        CommandParameter="{x:Static ws:Workspace.Layout}"
                                        ToolTip.Tip="{loc:Localize Workspace.LayoutTip}"/>
                                <Button Classes="toolbar segment" Content="{loc:Localize Workspace.Optics}"
                                        Classes.active="{Binding WorkspaceSwitch.IsOptics}"
                                        Command="{Binding WorkspaceSwitch.SelectCommand}"
                                        CommandParameter="{x:Static ws:Workspace.Optics}"
                                        ToolTip.Tip="{loc:Localize Workspace.OpticsTip}"/>
                                <Button Classes="toolbar segment" Content="{loc:Localize Workspace.Logic}"
                                        Classes.active="{Binding WorkspaceSwitch.IsLogic}"
                                        Command="{Binding WorkspaceSwitch.SelectCommand}"
                                        CommandParameter="{x:Static ws:Workspace.Logic}"
                                        ToolTip.Tip="{loc:Localize Workspace.LogicTip}"/>
                                <Button Classes="toolbar segment" Content="{loc:Localize Workspace.System}"
                                        Classes.active="{Binding WorkspaceSwitch.IsSystem}"
                                        Command="{Binding WorkspaceSwitch.SelectCommand}"
                                        CommandParameter="{x:Static ws:Workspace.System}"
                                        ToolTip.Tip="{loc:Localize Workspace.SystemTip}"/>
                            </StackPanel>
                        </Border>
                        <controls:HelpFlyoutButton Margin="2,0,4,0" VerticalAlignment="Center"
                                                   Title="{loc:Localize Workspace.HelpTitle}">
                            <controls:HelpFlyoutButton.HelpContent>
                                <panels:WorkspaceHelpFlyout/>
                            </controls:HelpFlyoutButton.HelpContent>
                        </controls:HelpFlyoutButton>

                        <!-- Run: the one primary action; its label names what the workspace runs. -->
                        <Button x:Name="RunSimulationButton" Classes="toolbar primary"
                                Command="{Binding RunWorkspaceCommand}"
                                ToolTip.Tip="{Binding WorkspaceSwitch.RunTip}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <controls:Icon Data="{StaticResource Icon.Play}" Size="14"/>
                                <TextBlock Text="{Binding WorkspaceSwitch.RunLabel}" VerticalAlignment="Center"/>
                                <Border Classes="keyHint">
                                    <TextBlock Text="L"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <!-- Power-flow overlay on/off (P): separate from Run, so Run always runs. -->
                        <Button x:Name="PowerOverlayToggle" Classes="toolbar" Margin="2,0,0,0"
                                Classes.active="{Binding Canvas.ShowPowerFlow}"
                                Command="{Binding TogglePowerOverlayCommand}"
                                IsVisible="{Binding WorkspaceSwitch.IsOpticalWorkspace}"
                                ToolTip.Tip="{loc:Localize Toolbar.PowerOverlayTip}">
                            <Panel>
                                <controls:Icon Data="{StaticResource Icon.Eye}" IsVisible="{Binding Canvas.ShowPowerFlow}"/>
                                <controls:Icon Data="{StaticResource Icon.EyeOff}" IsVisible="{Binding !Canvas.ShowPowerFlow}"/>
                            </Panel>
                        </Button>
                        <ComboBox Classes="toolbar" Width="104" Margin="4,0,0,0"
                                  SelectedIndex="{Binding SimulationModeIndex}"
                                  IsVisible="{Binding WorkspaceSwitch.IsOptics}"
                                  ToolTip.Tip="{loc:Localize Toolbar.SimulationModeTip}">
                            <ComboBoxItem>CW</ComboBoxItem>
                            <ComboBoxItem>Transient</ComboBoxItem>
                        </ComboBox>

                        <Border Classes="divider"/>

                        <!-- Edit -->
                        <Button Classes="toolbar" Command="{Binding UndoCommand}"
                                ToolTip.Tip="{loc:Localize Toolbar.UndoTip}">
                            <controls:Icon Data="{StaticResource Icon.Undo2}"/>
                        </Button>
                        <Button Classes="toolbar" Command="{Binding RedoCommand}"
                                ToolTip.Tip="{loc:Localize Toolbar.RedoTip}">
                            <controls:Icon Data="{StaticResource Icon.Redo2}"/>
                        </Button>
                        <Button Classes="toolbar" Command="{Binding CreateGroupCommand}"
                                ToolTip.Tip="{loc:Localize Toolbar.CreateGroupTip}">
                            <controls:Icon Data="{StaticResource Icon.Group}"/>
                        </Button>
                        <Button Classes="toolbar" Command="{Binding UngroupCommand}"
                                ToolTip.Tip="{loc:Localize Toolbar.UngroupTip}">
                            <controls:Icon Data="{StaticResource Icon.Ungroup}"/>
                        </Button>

                        <Border Classes="divider"/>

                        <!-- File -->
                        <Button Classes="toolbar" Command="{Binding NewProjectCommand}"
                                ToolTip.Tip="{loc:Localize Toolbar.NewProjectTip}">
                            <controls:Icon Data="{StaticResource Icon.FilePlus}"/>
                        </Button>
                        <Button Classes="toolbar" Command="{Binding LoadDesignCommand}"
                                ToolTip.Tip="{loc:Localize Toolbar.LoadDesignTip}">
                            <controls:Icon Data="{StaticResource Icon.FolderOpen}"/>
                        </Button>
                        <Button Classes="toolbar" Command="{Binding SaveDesignCommand}"
                                ToolTip.Tip="{loc:Localize Toolbar.SaveDesignTip}">
                            <controls:Icon Data="{StaticResource Icon.Save}"/>
                        </Button>
                        <Button Classes="toolbar" Command="{Binding SaveDesignAsCommand}"
                                ToolTip.Tip="{loc:Localize Toolbar.SaveDesignAsTip}">
                            <controls:Icon Data="{StaticResource Icon.FilePen}"/>
                        </Button>

                        <Border Classes="divider"/>

                        <!-- Import / export / tools -->
                        <Button Classes="toolbar" Command="{Binding GdsImport.OpenGdsImportDialogCommand}"
                                ToolTip.Tip="{loc:Localize GdsImport.OpenTip}">
                            <controls:Icon Data="{StaticResource Icon.FileInput}"/>
                        </Button>
                        <!-- Unified Export flyout — add formats via IExportFormat + ExportMenuViewModel, no axaml changes needed -->
                        <Button Classes="toolbar menu" ToolTip.Tip="{loc:Localize Toolbar.ExportTip}">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <controls:Icon Data="{StaticResource Icon.FileOutput}"/>
                                <controls:Icon Classes="chevron" Data="{StaticResource Icon.ChevronDown}"/>
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <StackPanel Classes="menu" MinWidth="260">
                                        <TextBlock Classes="label menuHeader" Text="{loc:Localize Toolbar.ChooseExportFormat}"/>
                                        <ItemsControl ItemsSource="{Binding ExportMenu.Formats}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Classes="menuItem"
                                                            Command="{Binding ExportCommand}"
                                                            ToolTip.Tip="{Binding Description}">
                                                        <Grid ColumnDefinitions="Auto,*">
                                                            <controls:Icon Classes="menuIcon" Data="{StaticResource Icon.FileOutput}"/>
                                                            <StackPanel Grid.Column="1" Spacing="2">
                                                                <TextBlock Classes="strong" Text="{Binding Name}"/>
                                                                <TextBlock Classes="caption" Text="{Binding Description}"
                                                                           TextWrapping="Wrap" MaxWidth="220"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Checking precedes tapeout export, so the design checks live here too. -->
                                        <Separator Classes="menu"/>
                                        <Button Classes="menuItem"
                                                Command="{Binding RunDesignChecksCommand}"
                                                Click="CheckDesignMenuItem_Click"
                                                ToolTip.Tip="{loc:Localize Toolbar.CheckDesignTip}">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <controls:Icon Classes="menuIcon" Data="{StaticResource Icon.CircleCheck}"/>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Classes="strong" Text="{loc:Localize Toolbar.CheckDesign}"/>
                                                    <TextBlock Classes="caption" Text="{loc:Localize Toolbar.CheckDesignDescription}"
                                                               TextWrapping="Wrap" MaxWidth="220"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <Button Classes="menuItem"
                                                Click="CheckOpenEblMenuItem_Click"
                                                ToolTip.Tip="{loc:Localize Toolbar.CheckOpenEblTip}">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <controls:Icon Classes="menuIcon" Data="{StaticResource Icon.FlaskConical}"/>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Classes="strong" Text="{loc:Localize Toolbar.CheckOpenEbl}"/>
                                                    <TextBlock Classes="caption" Text="{loc:Localize Toolbar.CheckOpenEblDescription}"
                                                               TextWrapping="Wrap" MaxWidth="220"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button x:Name="ToolsMenuButton" Classes="toolbar menu"
                                ToolTip.Tip="{loc:Localize Toolbar.ToolsTip}">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <controls:Icon Data="{StaticResource Icon.Wrench}"/>
                                <controls:Icon Classes="chevron" Data="{StaticResource Icon.ChevronDown}"/>
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <StackPanel Classes="menu" MinWidth="250">
                                        <!-- Load PDK + format help share one row: the help opens the
                                             PDK JSON documentation the loader expects. -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Button Grid.Column="0" Classes="menuItem"
                                                    Command="{Binding LoadPdkCommand}"
                                                    ToolTip.Tip="{loc:Localize Toolbar.LoadPdkTip}">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:Icon Classes="menuIcon" Data="{StaticResource Icon.Package}"/>
                                                    <TextBlock Text="{loc:Localize Toolbar.LoadPdk}"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1" Classes="ghost icon" Margin="4,0,0,0"
                                                    Command="{Binding OpenPdkHelpCommand}"
                                                    ToolTip.Tip="{loc:Localize Toolbar.PdkHelpTip}">
                                                <controls:Icon Data="{StaticResource Icon.CircleHelp}"/>
                                            </Button>
                                        </Grid>
                                        <Button Classes="menuItem"
                                                Command="{Binding OpenPdkOffsetEditorCommand}"
                                                ToolTip.Tip="{loc:Localize Toolbar.PdkOffsetEditorTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:Icon Classes="menuIcon" Data="{StaticResource Icon.Ruler}"/>
                                                <TextBlock Text="{loc:Localize Toolbar.PdkOffsetEditor}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="menuItem" Click="OpenModeSolverDialog_Click"
                                                ToolTip.Tip="{loc:Localize Toolbar.ComputeModesTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:Icon Classes="menuIcon" Data="{StaticResource Icon.Waves}"/>
                                                <TextBlock Text="{loc:Localize Toolbar.ComputeModes}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="menuItem" Click="OpenPdkResolutionCheckDialog_Click"
                                                ToolTip.Tip="{loc:Localize Toolbar.CheckPdksTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:Icon Classes="menuIcon" Data="{StaticResource Icon.Search}"/>
                                                <TextBlock Text="{loc:Localize Toolbar.CheckPdks}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="menuItem" Click="OpenRegistryBrowser_Click"
                                                ToolTip.Tip="{loc:Localize Registry.OpenTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:Icon Classes="menuIcon" Data="{StaticResource Icon.Globe}"/>
                                                <TextBlock Text="{loc:Localize Toolbar.ComponentRegistry}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="IsaPlaygroundToolButton" Classes="menuItem"
                                                Click="OpenIsaPlayground_Click"
                                                ToolTip.Tip="{loc:Localize Toolbar.IsaPlaygroundTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:Icon Classes="menuIcon" Data="{StaticResource Icon.Cpu}"/>
                                                <TextBlock Text="{loc:Localize Toolbar.IsaPlayground}"/>
                                            </StackPanel>
                                        </Button>
                                        <Separator Classes="menu"/>
                                        <Button x:Name="CleanUpCrossingsToolButton" Classes="menuItem"
                                                Command="{Binding Canvas.CleanUpCrossingsCommand}"
                                                ToolTip.Tip="{loc:Localize Toolbar.CleanUpCrossingsTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:Icon Classes="menuIcon" Data="{StaticResource Icon.Eraser}"/>
                                                <TextBlock Text="{loc:Localize Toolbar.CleanUpCrossings}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="menuItem"
                                                Command="{Binding BottomPanel.ElementLock.UnlockAllCommand}"
                                                ToolTip.Tip="{loc:Localize Toolbar.UnlockAllTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:Icon Classes="menuIcon" Data="{StaticResource Icon.LockOpen}"/>
                                                <TextBlock Text="{loc:Localize Toolbar.UnlockAll}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Border Classes="divider"/>

                        <!-- AI Design Assistant — own tool window -->
                        <Button Classes="toolbar" Click="OpenAiAssistant_Click"
                                ToolTip.Tip="{loc:Localize Toolbar.AiAssistantTip}">
                            <controls:Icon Data="{StaticResource Icon.Sparkles}"/>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Column="1" Classes="toolbar" Margin="8,0,0,0" VerticalAlignment="Center"
                        Command="{Binding OpenSettingsWindowCommand}"
                        ToolTip.Tip="{loc:Localize Toolbar.SettingsTip}">
                    <controls:Icon Data="{StaticResource Icon.Settings}"/>
                </Button>
            </Grid>
        </Border>
        <!-- ══ Status bar: fixed fields ═══════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom" Classes="statusbar" Height="26">
            <DockPanel x:Name="StatusBarRoot" LastChildFill="True">
                <!-- Full keyboard-shortcut reference; the bar itself carries no cheat sheet. -->
                <controls:HelpFlyoutButton DockPanel.Dock="Right" VerticalAlignment="Center"
                                           Margin="4,0,8,0"
                                           Title="{loc:Localize StatusBar.ShortcutsFlyoutTitle}">
                    <controls:HelpFlyoutButton.HelpContent>
                        <panels:ShortcutsHelpFlyout/>
                    </controls:HelpFlyoutButton.HelpContent>
                </controls:HelpFlyoutButton>
                <!-- Active process: fixed right-hand column so it never covers other fields.
                     Dot: green = real process, amber = Playground (not manufacturable). -->
                <Border DockPanel.Dock="Right" x:Name="ActiveProcessIndicator"
                        Classes="chip processChip" MinWidth="170" Margin="4,0"
                        Classes.playground="{Binding IsPlayground}"
                        Classes.none="{Binding FileOperations.ActiveProcess, Converter={x:Static ObjectConverters.IsNull}}"
                        ToolTip.Tip="{loc:Localize StatusBar.ActiveProcessTip}">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <Ellipse Classes="processDot" Width="6" Height="6" VerticalAlignment="Center"/>
                        <TextBlock Classes="statusText" Text="{Binding ActiveProcessLabel}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                    </StackPanel>
                </Border>
                <Border DockPanel.Dock="Right" Classes="statusDivider"/>
                <StackPanel DockPanel.Dock="Right" Classes="statusField"
                            ToolTip.Tip="{loc:Localize StatusBar.ZoomTip}">
                    <controls:Icon Data="{StaticResource Icon.ZoomIn}"/>
                    <TextBlock Classes="statusText mono" MinWidth="36"
                               Text="{Binding ViewportControl.ZoomLevel, StringFormat={}{0:P0}}"/>
                </StackPanel>
                <!-- Blocked / unrouted connections: hidden at 0, click walks through them. -->
                <Button DockPanel.Dock="Right" x:Name="BlockedConnectionsChip" Classes="statusChip danger"
                        Margin="4,0"
                        IsVisible="{Binding BlockedConnections.HasBlocked}"
                        Command="{Binding BlockedConnections.SelectNextBlockedCommand}"
                        ToolTip.Tip="{loc:Localize StatusBar.BlockedTip}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <controls:Icon Data="{StaticResource Icon.TriangleAlert}"/>
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="{Binding BlockedConnections.BlockedCount}"/>
                            <Run Text="{loc:Localize StatusBar.BlockedSuffix}"/>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <!-- Stop for a full re-route: visible only while routing runs. -->
                <Button DockPanel.Dock="Right" x:Name="StopRoutingButton" Classes="statusChip" Margin="4,0"
                        Command="{Binding Canvas.StopRoutingCommand}"
                        IsVisible="{Binding Canvas.IsRouting}"
                        ToolTip.Tip="{loc:Localize Routing.Status.StopTip}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <controls:Icon Data="{StaticResource Icon.CircleStop}"/>
                        <TextBlock Text="{loc:Localize Routing.Status.Stop}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel DockPanel.Dock="Left" x:Name="StatusBarModeField" Classes="statusField"
                            Margin="8,0,0,0"
                            ToolTip.Tip="{Binding CanvasInteraction.ModeShortcutHints}">
                    <controls:Icon Data="{StaticResource Icon.MousePointer2}"/>
                    <TextBlock Classes="statusText strong" Text="{Binding StatusBar.ModeLabel}"/>
                </StackPanel>
                <Border DockPanel.Dock="Left" Classes="statusDivider"/>
                <StackPanel DockPanel.Dock="Left" Classes="statusField"
                            ToolTip.Tip="{loc:Localize StatusBar.SelectionTip}">
                    <controls:Icon Data="{StaticResource Icon.SquareDashed}"/>
                    <TextBlock Classes="statusText" Text="{Binding StatusBar.SelectionSummary}"
                               TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                </StackPanel>
                <Border DockPanel.Dock="Left" Classes="statusDivider"/>
                <TextBlock Classes="statusText muted" Text="{Binding StatusText}" Margin="8,0"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- ══ Error console (collapsible, F12) ═════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom" Classes="dockFrame">
            <StackPanel>
                <DockPanel Classes="dockHeader">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2"
                                VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button Classes="headerIcon"
                                Command="{Binding BottomPanel.ErrorConsole.CopyAllCommand}"
                                ToolTip.Tip="{loc:Localize ErrorConsole.CopyAllTip}">
                            <controls:Icon Data="{StaticResource Icon.Copy}"/>
                        </Button>
                        <Button Classes="headerIcon"
                                Command="{Binding BottomPanel.ErrorConsole.ClearCommand}"
                                ToolTip.Tip="{loc:Localize ErrorConsole.ClearTip}">
                            <controls:Icon Data="{StaticResource Icon.Trash2}"/>
                        </Button>
                    </StackPanel>
                    <Button Classes="dockToggle"
                            Command="{Binding BottomPanel.ErrorConsole.ToggleCommand}"
                            ToolTip.Tip="{loc:Localize ErrorConsole.ToggleTip}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:Icon Classes="chevron" Data="{StaticResource Icon.ChevronRight}"
                                           Classes.open="{Binding BottomPanel.ErrorConsole.IsVisible}"/>
                            <controls:Icon Data="{StaticResource Icon.Terminal}"/>
                            <TextBlock Classes="dockTitle" Text="{loc:Localize ErrorConsole.Title}"/>
                            <Border Classes="chip danger" IsVisible="{Binding BottomPanel.ErrorConsole.HasErrors}">
                                <TextBlock Text="{Binding BottomPanel.ErrorConsole.ErrorCount}"/>
                            </Border>
                            <Border Classes="chip warning" IsVisible="{Binding BottomPanel.ErrorConsole.HasWarnings}">
                                <TextBlock Text="{Binding BottomPanel.ErrorConsole.WarningCount}"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </DockPanel>

                <Border Classes="dockBody" IsVisible="{Binding BottomPanel.ErrorConsole.IsVisible}" Height="180"
                        behaviors:RevealOnShowBehavior.IsEnabled="True" behaviors:RevealOnShowBehavior.FromY="8">
                    <ListBox x:Name="ErrorConsoleListBox"
                             Classes="console"
                             ItemsSource="{Binding BottomPanel.ErrorConsole.DisplayEntries}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="diagnostics:LogDisplayEntry">
                                <TextBlock Classes="mono" Text="{Binding Text}"
                                           Foreground="{Binding Color}"
                                           FontSize="{DynamicResource FontSize.Caption}"
                                           TextWrapping="NoWrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </StackPanel>
        </Border>

        <!-- Analysis Dock Panel (collapsible, above the Error Console) -->
        <panels:AnalysisDockPanel DockPanel.Dock="Bottom"/>

        <!-- ══ Left: icon rail + one full-height pane ═════════════════════════════ -->
        <Grid DockPanel.Dock="Left" ColumnDefinitions="320,Auto" Name="LeftPanelGrid">
            <Border Grid.Column="0" Name="LeftPanelBorder" Classes="sidePanel left"
                    MinWidth="248" MaxWidth="800">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Classes="rail">
                        <StackPanel Spacing="4">
                            <Button Classes="rail" Command="{Binding LeftRail.ShowLibraryCommand}"
                                    Classes.active="{Binding LeftRail.IsLibraryActive}"
                                    ToolTip.Tip="{loc:Localize LeftPanel.ComponentLibrary}"
                                    ToolTip.Placement="Right">
                                <controls:Icon Data="{StaticResource Icon.Shapes}" Size="18"/>
                            </Button>
                            <Button Classes="rail" Command="{Binding LeftRail.ShowHierarchyCommand}"
                                    Classes.active="{Binding LeftRail.IsHierarchyActive}"
                                    ToolTip.Tip="{loc:Localize Hierarchy.Title}"
                                    ToolTip.Placement="Right">
                                <controls:Icon Data="{StaticResource Icon.ListTree}" Size="18"/>
                            </Button>
                            <Button Classes="rail" Command="{Binding LeftRail.ShowPdksCommand}"
                                    Classes.active="{Binding LeftRail.IsPdksActive}"
                                    ToolTip.Tip="{loc:Localize LeftRail.Pdks}"
                                    ToolTip.Placement="Right">
                                <controls:Icon Data="{StaticResource Icon.Package}" Size="18"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Panel>
                        <!-- ── Library (default): saved groups + components, one scroll ── -->
                        <DockPanel Classes="railPane" IsVisible="{Binding LeftRail.IsLibraryActive}"
                                   behaviors:RevealOnShowBehavior.IsEnabled="True" behaviors:RevealOnShowBehavior.FromX="-8">
                            <DockPanel DockPanel.Dock="Top" Classes="paneHeader">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                                    <!-- Online, community-shared counterpart to this local library -->
                                    <Button Classes="headerIcon" Click="OpenRegistryBrowser_Click"
                                            ToolTip.Tip="{loc:Localize Registry.OpenTip}">
                                        <controls:Icon Data="{StaticResource Icon.Globe}"/>
                                    </Button>
                                    <Button Classes="headerIcon" Command="{Binding GdsImport.OpenGdsImportDialogCommand}"
                                            ToolTip.Tip="{loc:Localize GdsImport.OpenTip}">
                                        <controls:Icon Data="{StaticResource Icon.FileInput}"/>
                                    </Button>
                                    <Button Classes="headerIcon" Command="{Binding LeftPanel.OpenNewComponentCommand}"
                                            ToolTip.Tip="{loc:Localize LeftPanel.NewComponentTip}">
                                        <controls:Icon Data="{StaticResource Icon.Plus}"/>
                                    </Button>
                                </StackPanel>
                                <TextBlock Classes="paneTitle" Text="{loc:Localize LeftPanel.ComponentLibrary}"/>
                            </DockPanel>
                            <TextBox DockPanel.Dock="Top" Classes="search" Margin="12,0,12,8"
                                     Watermark="{loc:Localize LeftPanel.SearchWatermark}"
                                     Text="{Binding LeftPanel.SearchText}">
                                <TextBox.InnerLeftContent>
                                    <controls:Icon Data="{StaticResource Icon.Search}" Size="14"
                                                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                                                   Margin="8,0,0,0"/>
                                </TextBox.InnerLeftContent>
                            </TextBox>

                            <!-- Online-registry hit line under the local hits: visible only while
                                 it has something to say, styled as a link so it is never mistaken
                                 for a placeable local template. -->
                            <Button DockPanel.Dock="Bottom" Classes="link" Margin="12,6,12,8"
                                    HorizontalAlignment="Left"
                                    Click="OpenRegistrySearchHint_Click"
                                    IsVisible="{Binding LeftPanel.RegistrySearchHintText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    ToolTip.Tip="{loc:Localize Registry.SearchHintTip}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:Icon Data="{StaticResource Icon.Globe}" Size="12"/>
                                    <TextBlock Classes="caption" Foreground="{DynamicResource Brush.Text.Link}"
                                               Text="{Binding LeftPanel.RegistrySearchHintText}"/>
                                </StackPanel>
                            </Button>

                            <ScrollViewer x:Name="ComponentLibraryScroll"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          behaviors:ScrollPositionBehavior.VerticalOffset="{Binding LeftPanel.LibraryScrollOffset, Mode=TwoWay}">
                                <StackPanel Margin="0,0,0,8">
                                    <!-- Saved groups: a collapsible category of the library -->
                                    <ToggleButton x:Name="SavedGroupsToggle" Classes="sectionHeader" IsChecked="True"
                                                  AutomationProperties.Name="{loc:Localize LeftPanel.SavedGroups}"
                                                  ToolTip.Tip="{loc:Localize LeftPanel.SavedGroupsTip}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:Icon Classes="chevron" Data="{StaticResource Icon.ChevronRight}"
                                                           Classes.open="{Binding #SavedGroupsToggle.IsChecked}"/>
                                            <TextBlock Classes="label" Text="{loc:Localize LeftPanel.SavedGroups}"/>
                                        </StackPanel>
                                    </ToggleButton>
                                    <StackPanel IsVisible="{Binding #SavedGroupsToggle.IsChecked}" Margin="8,0,8,4">
                                        <TextBlock Classes="caption" Margin="8,0,8,4" TextWrapping="Wrap"
                                                   Text="{Binding LeftPanel.ComponentLibrary.StatusText}"
                                                   IsVisible="{Binding LeftPanel.ComponentLibrary.StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <ListBox x:Name="UserGroupsListBox"
                                                 Classes="library"
                                                 behaviors:LibraryDragBehavior.IsEnabled="True"
                                                 ItemsSource="{Binding LeftPanel.ComponentLibrary.UserGroups}"
                                                 SelectionChanged="OnUserGroupsSelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vmLib:GroupTemplateItemViewModel">
                                                    <Border Classes="libraryRow"
                                                            ToolTip.Tip="{Binding Template.Description}"
                                                            PointerEntered="OnGroupItemPointerEntered"
                                                            PointerExited="OnGroupItemPointerExited">
                                                        <Border.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="{loc:Localize Common.Rename}" Command="{Binding RenameCommand}"/>
                                                                <MenuItem Header="{loc:Localize Common.Delete}" Command="{Binding DeleteCommand}"/>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Classes="rowAction danger"
                                                                    IsVisible="{Binding IsHovered}"
                                                                    Command="{Binding DeleteCommand}"
                                                                    ToolTip.Tip="{loc:Localize LeftPanel.DeleteSavedGroupTip}">
                                                                <controls:Icon Data="{StaticResource Icon.Trash2}"/>
                                                            </Button>
                                                            <Border DockPanel.Dock="Left" Classes="thumb">
                                                                <controls:Icon Data="{StaticResource Icon.Group}"/>
                                                            </Border>
                                                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                                                <TextBlock Classes="rowTitle" Text="{Binding Template.Name}"/>
                                                                <TextBlock Classes="caption">
                                                                    <Run Text="{Binding Template.ComponentCount}"/>
                                                                    <Run Text="{loc:Localize LeftPanel.ComponentsSuffix}"/>
                                                                    <Run Text=" · "/>
                                                                    <Run Text="{Binding Template.WidthMicrometers, StringFormat={}{0:F0}}"/>
                                                                    <Run Text="×"/>
                                                                    <Run Text="{Binding Template.HeightMicrometers, StringFormat={}{0:F0}}"/>
                                                                    <Run Text="µm"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <TextBlock Classes="label" Margin="8,8,8,4" Text="{loc:Localize LeftPanel.PdkMacros}"
                                                   IsVisible="{Binding LeftPanel.ComponentLibrary.PdkGroups.Count}"/>
                                        <ListBox x:Name="PdkGroupsListBox"
                                                 Classes="library"
                                                 behaviors:LibraryDragBehavior.IsEnabled="True"
                                                 ItemsSource="{Binding LeftPanel.ComponentLibrary.PdkGroups}"
                                                 SelectionChanged="OnPdkGroupsSelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vmLib:GroupTemplateItemViewModel">
                                                    <Border Classes="libraryRow"
                                                            ToolTip.Tip="{Binding Template.Description}"
                                                            PointerEntered="OnGroupItemPointerEntered"
                                                            PointerExited="OnGroupItemPointerExited">
                                                        <Border.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="{loc:Localize Common.Rename}" Command="{Binding RenameCommand}"/>
                                                                <MenuItem Header="{loc:Localize Common.Delete}" Command="{Binding DeleteCommand}"/>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Classes="rowAction danger"
                                                                    IsVisible="{Binding IsHovered}"
                                                                    Command="{Binding DeleteCommand}"
                                                                    ToolTip.Tip="{loc:Localize LeftPanel.DeleteSavedGroupTip}">
                                                                <controls:Icon Data="{StaticResource Icon.Trash2}"/>
                                                            </Button>
                                                            <Border DockPanel.Dock="Left" Classes="thumb">
                                                                <controls:Icon Data="{StaticResource Icon.Boxes}"/>
                                                            </Border>
                                                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                                                <TextBlock Classes="rowTitle" Text="{Binding Template.Name}"/>
                                                                <TextBlock Classes="caption">
                                                                    <Run Text="{Binding Template.ComponentCount}"/>
                                                                    <Run Text="{loc:Localize LeftPanel.ComponentsSuffix}"/>
                                                                    <Run Text=" · "/>
                                                                    <Run Text="{Binding Template.WidthMicrometers, StringFormat={}{0:F0}}"/>
                                                                    <Run Text="×"/>
                                                                    <Run Text="{Binding Template.HeightMicrometers, StringFormat={}{0:F0}}"/>
                                                                    <Run Text="µm"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>

                                    <Border Classes="divider" Height="1" Margin="12,4,12,4"/>
                                    <TextBlock Classes="label" Margin="16,8,16,2" Text="{loc:Localize LeftPanel.Components}"/>
                                    <TextBlock Classes="caption" Margin="16,0,16,6" TextWrapping="Wrap"
                                               Text="{loc:Localize LeftPanel.PlaceHint}"/>
                                    <ListBox x:Name="ComponentLibraryList"
                                             Classes="library" Margin="8,0"
                                             ItemsSource="{Binding LeftPanel.FilteredTemplates}"
                                             behaviors:LibraryDragBehavior.IsEnabled="True"
                                             SelectedItem="{Binding CanvasInteraction.SelectedTemplate}"
                                             controls:ComponentPreview.RenderService="{Binding GdsPreviewRenderService}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vmLib:ComponentTemplate">
                                                <DockPanel>
                                                    <!-- Edit/delete appear on hover or selection only: the palette
                                                         stays calm but the actions remain discoverable. -->
                                                    <StackPanel Classes="itemActions" DockPanel.Dock="Right"
                                                                Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                        <Button Classes="rowAction" Click="TemplateEditComponent_Click"
                                                                ToolTip.Tip="{loc:Localize LeftPanel.EditComponentTip}">
                                                            <controls:Icon Data="{StaticResource Icon.Pencil}"/>
                                                        </Button>
                                                        <!-- Only where there is something to delete or restore. -->
                                                        <Button Classes="rowAction danger" Click="TemplateDeleteComponent_Click"
                                                                IsVisible="{Binding IsDeletable}"
                                                                ToolTip.Tip="{loc:Localize LeftPanel.DeleteComponentTip}">
                                                            <controls:Icon Data="{StaticResource Icon.Trash2}"/>
                                                        </Button>
                                                    </StackPanel>
                                                    <Border DockPanel.Dock="Left" Classes="previewFrame">
                                                        <controls:ComponentPreview
                                                            Width="52" Height="32"
                                                            WidthMicrometers="{Binding WidthMicrometers}"
                                                            HeightMicrometers="{Binding HeightMicrometers}"
                                                            PinDefinitions="{Binding PinDefinitions}"
                                                            NazcaModuleName="{Binding NazcaModuleName}"
                                                            NazcaFunctionName="{Binding NazcaFunctionName}"
                                                            NazcaParameters="{Binding NazcaParameters}"
                                                            GdsFactoryFunction="{Binding GdsFactoryFunction}"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                                        <!-- DockPanel, not a horizontal StackPanel: the title needs a finite
                                                             width to wrap and trim. Long PDK names (several "Directional
                                                             Coupler …" variants) wrap to two lines; the tooltip has the rest. -->
                                                        <DockPanel>
                                                            <!-- User-global S-matrix override: applies to every project. -->
                                                            <controls:Icon DockPanel.Dock="Right" Margin="4,0,0,0"
                                                                           Data="{StaticResource Icon.ChartLine}" Size="12"
                                                                           Foreground="{DynamicResource Brush.Info}"
                                                                           VerticalAlignment="Center"
                                                                           IsVisible="{Binding HasUserGlobalSMatrixOverride}"
                                                                           ToolTip.Tip="{loc:Localize LeftPanel.SMatrixOverrideTip}"/>
                                                            <TextBlock Classes="rowTitle" Text="{Binding Name}"
                                                                       TextWrapping="Wrap" MaxLines="2"
                                                                       ToolTip.Tip="{Binding Name}"/>
                                                        </DockPanel>
                                                        <TextBlock Classes="caption" Text="{Binding Category}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- ── Hierarchy ── -->
                        <Border Classes="railPane" IsVisible="{Binding LeftRail.IsHierarchyActive}"
                                behaviors:RevealOnShowBehavior.IsEnabled="True" behaviors:RevealOnShowBehavior.FromX="-8">
                            <views:HierarchyPanel DataContext="{Binding LeftPanel.HierarchyPanel}"/>
                        </Border>

                        <!-- ── PDKs ── -->
                        <DockPanel Classes="railPane" IsVisible="{Binding LeftRail.IsPdksActive}"
                                   behaviors:RevealOnShowBehavior.IsEnabled="True" behaviors:RevealOnShowBehavior.FromX="-8">
                            <DockPanel DockPanel.Dock="Top" Classes="paneHeader">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                                    <Button Classes="headerIcon" Command="{Binding LeftPanel.PdkManager.EnableAllCommand}"
                                            ToolTip.Tip="{loc:Localize LeftPanel.EnableAllPdksTip}">
                                        <controls:Icon Data="{StaticResource Icon.SquareCheckBig}"/>
                                    </Button>
                                    <Button Classes="headerIcon" Command="{Binding LeftPanel.PdkManager.DisableAllCommand}"
                                            ToolTip.Tip="{loc:Localize LeftPanel.DisableAllPdksTip}">
                                        <controls:Icon Data="{StaticResource Icon.Square}"/>
                                    </Button>
                                    <!-- Recover deleted PDKs / removed components from user-pdks/.trash -->
                                    <Button Classes="headerIcon" Command="{Binding LeftPanel.PdkTrash.OpenCommand}"
                                            ToolTip.Tip="{loc:Localize LeftPanel.TrashTip}">
                                        <controls:Icon Data="{StaticResource Icon.Trash2}"/>
                                        <Button.Flyout>
                                            <Flyout Placement="Bottom">
                                                <panels:PdkTrashPanel DataContext="{Binding LeftPanel.PdkTrash}"/>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Button Classes="headerIcon" Click="PdkCreate_Click"
                                            ToolTip.Tip="{loc:Localize LeftPanel.CreatePdkTip}">
                                        <controls:Icon Data="{StaticResource Icon.Plus}"/>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="paneTitle" Text="{loc:Localize LeftRail.Pdks}"/>
                                    <!-- What a PDK is, what its process defines, and why a component
                                         only seats on a chiplet of its own process. -->
                                    <controls:HelpFlyoutButton Title="{loc:Localize PdkHelp.Title}" VerticalAlignment="Center">
                                        <controls:HelpFlyoutButton.HelpContent>
                                            <panels:PdkHelpFlyout/>
                                        </controls:HelpFlyoutButton.HelpContent>
                                    </controls:HelpFlyoutButton>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top" Classes="caption" Margin="16,0,16,8" TextWrapping="Wrap"
                                       Text="{Binding LeftPanel.PdkManager.StatusText}"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl Margin="8,0,8,8" ItemsSource="{Binding LeftPanel.PdkManager.LoadedPdks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vmLib:PdkInfoViewModel">
                                            <Border Classes="pdkRow">
                                                <DockPanel>
                                                    <StackPanel Classes="itemActions" DockPanel.Dock="Right"
                                                                Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                        <!-- Bundled PDKs save as a custom fork; design-scoped sets have no file. -->
                                                        <Button Classes="rowAction" IsVisible="{Binding !IsDesignScoped}"
                                                                Click="PdkEditProcess_Click"
                                                                ToolTip.Tip="{loc:Localize LeftPanel.EditPdkTip}">
                                                            <controls:Icon Data="{StaticResource Icon.Pencil}"/>
                                                        </Button>
                                                        <Button Classes="rowAction danger" IsVisible="{Binding CanDelete}"
                                                                Click="PdkDelete_Click"
                                                                ToolTip.Tip="{loc:Localize LeftPanel.DeletePdkTip}">
                                                            <controls:Icon Data="{StaticResource Icon.Trash2}"/>
                                                        </Button>
                                                    </StackPanel>
                                                    <StackPanel Spacing="1">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <CheckBox IsChecked="{Binding IsEnabled}"
                                                                      Content="{Binding Name}"
                                                                      IsEnabled="{Binding !IsLockedByProcess}"/>
                                                            <controls:Icon Data="{StaticResource Icon.Lock}" Size="12"
                                                                           Foreground="{DynamicResource Brush.Text.Tertiary}"
                                                                           VerticalAlignment="Center"
                                                                           IsVisible="{Binding IsLockedByProcess}"
                                                                           ToolTip.Tip="{loc:Localize LeftPanel.PdkLockedTip}"/>
                                                        </StackPanel>
                                                        <TextBlock Classes="caption" Margin="28,0,0,0">
                                                            <Run Text="{Binding SourceBadge}"/>
                                                            <Run Text=" · "/>
                                                            <Run Text="{Binding ComponentCount}"/>
                                                            <Run Text="{loc:Localize LeftPanel.ComponentsSuffix}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Panel>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Classes="shellSplitter"
                          ResizeDirection="Columns"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"/>
        </Grid>

        <!-- ══ Right: properties of the current selection only ════════════════════ -->
        <Grid DockPanel.Dock="Right" ColumnDefinitions="Auto,*" Name="RightPanelGrid">
            <GridSplitter Grid.Column="0" Classes="shellSplitter"
                          ResizeDirection="Columns"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"/>

            <Border Grid.Column="1" Name="RightPanelBorder" Classes="sidePanel right"
                    MinWidth="200" MaxWidth="800">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Classes="paneHeader">
                        <TextBlock Classes="paneTitle" Text="{loc:Localize RightPanel.Properties}"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16,4,16,16">
                            <!-- Whole-design tools live on their own surfaces (analysis dock,
                                 AI Assistant window); this sidebar shows the selection only. -->
                            <panels:SelectedComponentPropertiesPanel/>
                            <panels:ConnectionRoutingPanel/>
                            <panels:LengthMatchingPanel/>
                            <panels:GdsLayerVisibilityPanel/>
                            <panels:RerouteImportedPanel/>
                            <panels:TruthTablePanel/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ══ Canvas with banners ════════════════════════════════════════════════ -->
        <DockPanel>
            <!-- Update banner -->
            <Border DockPanel.Dock="Top" Classes="banner success"
                    IsVisible="{Binding Update.UpdateAvailable}">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <controls:Icon Grid.Column="0" Data="{StaticResource Icon.Download}"
                                   Foreground="{DynamicResource Brush.Success}"
                                   VerticalAlignment="Top" Margin="0,2,12,0"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="strong" Text="{Binding Update.LatestVersionText}"/>
                        <TextBlock Classes="secondary" Text="{Binding Update.StatusText}" TextWrapping="Wrap"
                                   IsVisible="{Binding Update.StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="ghost" Content="{loc:Localize Update.SkipVersion}"
                                Command="{Binding Update.SkipThisVersionCommand}"
                                IsEnabled="{Binding Update.IsDownloading, Converter={x:Static BoolConverters.Not}}"/>
                        <Button Content="{loc:Localize Update.Skip}"
                                Command="{Binding Update.RemindLaterCommand}"
                                IsEnabled="{Binding Update.IsDownloading, Converter={x:Static BoolConverters.Not}}"/>
                        <Button Classes="primary" Content="{loc:Localize Update.Download}"
                                Command="{Binding Update.InstallUpdateCommand}"
                                IsEnabled="{Binding Update.IsDownloading, Converter={x:Static BoolConverters.Not}}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Classes="caption"
                               Margin="0,8,0,0" TextWrapping="Wrap" MaxHeight="72"
                               Text="{Binding Update.ReleaseNotes}"
                               IsVisible="{Binding Update.ReleaseNotes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <ProgressBar Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                 Margin="0,8,0,0" Height="4" Minimum="0" Maximum="1"
                                 Value="{Binding Update.DownloadProgress}"
                                 IsVisible="{Binding Update.IsDownloading}"/>
                </Grid>
            </Border>

            <!-- "Connect Claude Code" offer: Claude Code installed, Lunima not registered yet -->
            <Border DockPanel.Dock="Top" Classes="banner"
                    IsVisible="{Binding ClaudeConnectPrompt.IsVisible, FallbackValue=False}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <controls:Icon Grid.Column="0" Data="{StaticResource Icon.Terminal}"
                                   Foreground="{DynamicResource Brush.Accent}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="strong" Text="{loc:Localize AgentBridge.Prompt.Title}"/>
                        <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{loc:Localize AgentBridge.Prompt.Body}"
                                   IsVisible="{Binding ClaudeConnectPrompt.ResultText, Converter={x:Static StringConverters.IsNullOrEmpty}, FallbackValue=True}"/>
                        <SelectableTextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding ClaudeConnectPrompt.ResultText}"
                                             IsVisible="{Binding ClaudeConnectPrompt.ResultText, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="ghost" Content="{loc:Localize AgentBridge.Prompt.NotNow}"
                                Command="{Binding ClaudeConnectPrompt.NotNowCommand}"
                                IsVisible="{Binding !ClaudeConnectPrompt.IsDone, FallbackValue=True}"/>
                        <Button Classes="primary" Content="{loc:Localize AgentBridge.Prompt.Connect}"
                                Command="{Binding ClaudeConnectPrompt.ConnectCommand}"
                                IsEnabled="{Binding !ClaudeConnectPrompt.IsConnecting, FallbackValue=True}"
                                IsVisible="{Binding !ClaudeConnectPrompt.IsDone, FallbackValue=True}"/>
                        <Button Content="{loc:Localize AgentBridge.Prompt.Close}"
                                Command="{Binding ClaudeConnectPrompt.CloseCommand}"
                                IsVisible="{Binding ClaudeConnectPrompt.IsDone, FallbackValue=False}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Group edit mode banner -->
            <Border DockPanel.Dock="Top" Classes="banner warning"
                    IsVisible="{Binding Canvas.IsInGroupEditMode}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <controls:Icon Data="{StaticResource Icon.Pencil}" Foreground="{DynamicResource Brush.Warning}"/>
                        <TextBlock Classes="strong warning" Text="{loc:Localize EditMode.Title}" VerticalAlignment="Center"/>
                        <TextBlock Classes="secondary" VerticalAlignment="Center">
                            <Run Text="{loc:Localize EditMode.Editing}"/>
                            <Run Text="{Binding Canvas.CurrentEditGroup.GroupName}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Content="{loc:Localize EditMode.ExitButton}"
                            Command="{Binding Canvas.ExitToRootCommand}"
                            ToolTip.Tip="{loc:Localize EditMode.ExitTip}"/>
                </Grid>
            </Border>

            <!-- Design canvas with the floating mode-probe flyout overlay -->
            <Panel>
            <controls:DesignCanvas x:Name="DesignCanvasControl"
                                   ViewModel="{Binding Canvas}"
                                   Zoom="{Binding ViewportControl.ZoomLevel, Mode=TwoWay}"
                                   MainViewModel="{Binding}">
                <controls:DesignCanvas.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{loc:Localize Context.EditComponent}" Command="{Binding CanvasInteraction.OpenSelectedComponentSettingsCommand}">
                        <MenuItem.Icon><controls:Icon Data="{StaticResource Icon.Settings}"/></MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="{loc:Localize Context.Copy}" Command="{Binding CopySelectedCommand}" InputGesture="Ctrl+C">
                        <MenuItem.Icon><controls:Icon Data="{StaticResource Icon.Copy}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{loc:Localize Context.Paste}" Command="{Binding PasteSelectedCommand}" InputGesture="Ctrl+V">
                        <MenuItem.Icon><controls:Icon Data="{StaticResource Icon.ClipboardPaste}"/></MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="{loc:Localize Context.CreateGroup}" Command="{Binding CreateGroupCommand}" InputGesture="Ctrl+G">
                        <MenuItem.Icon><controls:Icon Data="{StaticResource Icon.Group}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{loc:Localize Context.MakeGate}" Command="{Binding MakeGateCommand}"
                              ToolTip.Tip="{loc:Localize Context.MakeGateTip}">
                        <MenuItem.Icon><controls:Icon Data="{StaticResource Icon.Binary}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{loc:Localize Context.Ungroup}" Command="{Binding UngroupCommand}" InputGesture="Ctrl+Shift+G">
                        <MenuItem.Icon><controls:Icon Data="{StaticResource Icon.Ungroup}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{loc:Localize Context.RenameGroup}" Command="{Binding CanvasInteraction.RenameGroupCommand}">
                        <MenuItem.Icon><controls:Icon Data="{StaticResource Icon.Pencil}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{loc:Localize Context.SaveAsPrefab}" Command="{Binding CanvasInteraction.SaveGroupAsCommand}">
                        <MenuItem.Icon><controls:Icon Data="{StaticResource Icon.Bookmark}"/></MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="{loc:Localize Common.Delete}" Command="{Binding DeleteSelectedCommand}" InputGesture="Delete">
                        <MenuItem.Icon><controls:Icon Data="{StaticResource Icon.Trash2}"/></MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </controls:DesignCanvas.ContextMenu>
            </controls:DesignCanvas>

            <!-- Mode-probe flyout: non-modal, anchored at the probe click point.
                 The overlay Canvas has no background, so canvas interaction stays live. -->
            <Canvas IsVisible="{Binding ModeProbe.IsOpen, FallbackValue=False}">
                <panels:ModeProbePanel DataContext="{Binding ModeProbe}"
                                       Canvas.Left="{Binding PanelX}"
                                       Canvas.Top="{Binding PanelY}"/>
            </Canvas>
            </Panel>
        </DockPanel>
    </DockPanel>

    <!-- Guided-tour overlays: the card docks to the control the current step acts on —
         spotlight, arrow, card beside it; non-modal so the canvas stays interactive. -->
    <tour:TourAnchorOverlay IsVisible="{Binding Tutorial.IsActive, FallbackValue=False}"
                                TargetName="{Binding Tutorial.CurrentTargetName}">
        <tour:TourAnchorOverlay.Card>
            <panels:FirstStepsTutorialPanel DataContext="{Binding Tutorial}"/>
        </tour:TourAnchorOverlay.Card>
    </tour:TourAnchorOverlay>

    <tour:TourAnchorOverlay IsVisible="{Binding FirstGateTour.IsActive, FallbackValue=False}"
                                TargetName="{Binding FirstGateTour.CurrentTargetName}">
        <tour:TourAnchorOverlay.Card>
            <panels:FirstGateTourPanel DataContext="{Binding FirstGateTour}"/>
        </tour:TourAnchorOverlay.Card>
    </tour:TourAnchorOverlay>

    <tour:TourAnchorOverlay IsVisible="{Binding WatchTour.IsActive, FallbackValue=False}"
                                TargetName="{Binding WatchTour.CurrentTargetName}">
        <tour:TourAnchorOverlay.Card>
            <panels:WatchComputeTourPanel DataContext="{Binding WatchTour}"/>
        </tour:TourAnchorOverlay.Card>
    </tour:TourAnchorOverlay>

    <!-- Hosts the steps that anchor in this window (Logic Build, Tools menu); the
         playground steps are hosted by the overlay in IsaPlaygroundWindow. -->
    <tour:TourAnchorOverlay IsVisible="{Binding RunProgramTour.ShowCardInMainWindow, FallbackValue=False}"
                                TargetName="{Binding RunProgramTour.CurrentTargetName}">
        <tour:TourAnchorOverlay.Card>
            <panels:RunProgramTourPanel DataContext="{Binding RunProgramTour}"/>
        </tour:TourAnchorOverlay.Card>
    </tour:TourAnchorOverlay>

    <tour:TourAnchorOverlay IsVisible="{Binding ConnectChipletsTour.IsActive, FallbackValue=False}"
                                TargetName="{Binding ConnectChipletsTour.CurrentTargetName}">
        <tour:TourAnchorOverlay.Card>
            <panels:ConnectChipletsTourPanel DataContext="{Binding ConnectChipletsTour}"/>
        </tour:TourAnchorOverlay.Card>
    </tour:TourAnchorOverlay>

    <tour:TourAnchorOverlay IsVisible="{Binding StoreNumberTour.IsActive, FallbackValue=False}"
                                TargetName="{Binding StoreNumberTour.CurrentTargetName}">
        <tour:TourAnchorOverlay.Card>
            <panels:StoreNumberTourPanel DataContext="{Binding StoreNumberTour}"/>
        </tour:TourAnchorOverlay.Card>
    </tour:TourAnchorOverlay>

    <!-- Home screen overlay: compact centered card over the dimmed editor, shown until a
         project is opened/created; reopenable via the Home button. -->
    <Border IsVisible="{Binding Home.IsHomeVisible}" Background="{DynamicResource Brush.Scrim}">
        <views:HomeView DataContext="{Binding Home}"/>
    </Border>
    </Grid>
</Window>
