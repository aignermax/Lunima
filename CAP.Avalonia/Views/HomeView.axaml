<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:home="using:CAP.Avalonia.ViewModels.Home"
             xmlns:services="using:CAP.Avalonia.Services"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             xmlns:controls="using:CAP.Avalonia.Controls"
             xmlns:behaviors="using:CAP.Avalonia.Behaviors"
             xmlns:conv="using:CAP.Avalonia.Converters"
             x:Class="CAP.Avalonia.Views.HomeView"
             x:DataType="home:HomeViewModel">

    <UserControl.Resources>
        <conv:IconKeyConverter x:Key="IconKey"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Full-width list row (recent project, learning step): quiet until hovered. -->
        <Style Selector="Button.row">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
        </Style>

        <Style Selector="Button.row.optical-start">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <!-- Example tile: a calm card that lifts its border on hover. -->
        <Style Selector="Button.tile">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Base}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.L}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,10"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}"/>
        </Style>
        <Style Selector="Button.tile controls|Icon">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}"/>
        </Style>
        <Style Selector="Button.tile:pointerover controls|Icon">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Hover}"/>
        </Style>

        <!-- Step number badge of the learning list. -->
        <Style Selector="Border.step-number">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}"/>
        </Style>
        <Style Selector="Border.step-number > TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Hover}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="controls|Icon.pin">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}"/>
        </Style>
        <Style Selector="controls|Icon.pin.pinned">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
        </Style>
    </UserControl.Styles>

    <!-- Compact centered card over the dimmed editor, laid out wide rather than tall:
         recent projects on the left (where a returning user looks first), learning
         steps and the example tiles on the right.
         Disabled while the startup project (CLI arg / reopen preference) loads
         so a click can't interleave with the in-flight load. -->
    <Border x:Name="HomeCard" Classes="overlay" Width="860"
            behaviors:RevealOnShowBehavior.IsEnabled="True" behaviors:RevealOnShowBehavior.FromY="10"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            IsEnabled="{Binding !IsStartupLoadInProgress}"
            Padding="32,28">
        <Border.RenderTransform>
            <TranslateTransform/>
        </Border.RenderTransform>
        <StackPanel Spacing="20">

            <!-- Hero: name and tagline left, the two file actions right. -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <Button Classes="primary" Command="{Binding NewProjectCommand}"
                            AutomationProperties.Name="{loc:Localize Home.NewProject}"
                            ToolTip.Tip="{loc:Localize Home.NewProjectTip}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:Icon Data="{StaticResource Icon.FilePlus}"/>
                            <TextBlock Text="{loc:Localize Home.NewProject}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenProjectCommand}"
                            AutomationProperties.Name="{loc:Localize Home.OpenProject}"
                            ToolTip.Tip="{loc:Localize Home.OpenProjectTip}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:Icon Data="{StaticResource Icon.FolderOpen}"/>
                            <TextBlock Text="{loc:Localize Home.OpenProject}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <controls:LunimaWordmark Height="34" HorizontalAlignment="Left" Margin="-6,0,0,0"/>
                    <TextBlock Classes="secondary" Text="{loc:Localize Home.Subtitle}"/>
                </StackPanel>
            </DockPanel>

            <Border Classes="divider" Height="1"/>

            <Grid ColumnDefinitions="*,32,*">

                <!-- ── Left: recent projects ── -->
                <StackPanel Grid.Column="0" Spacing="8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Classes="link"
                                Content="{loc:Localize Home.ClearAll}"
                                Command="{Binding ClearRecentProjectsCommand}"
                                IsVisible="{Binding HasAnyRecentProjects}"
                                ToolTip.Tip="{loc:Localize Home.ClearAllTip}"/>
                        <TextBlock Classes="label" Text="{loc:Localize Home.RecentProjects}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <TextBox Classes="compact" Watermark="{loc:Localize Home.SearchWatermark}"
                             Text="{Binding SearchText}"
                             IsVisible="{Binding HasAnyRecentProjects}"/>

                    <Border Classes="empty-state" Padding="16,32"
                            IsVisible="{Binding !HasAnyRecentProjects}">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <controls:Icon Data="{StaticResource Icon.History}" Size="24"
                                           Foreground="{DynamicResource Brush.Text.Tertiary}"
                                           HorizontalAlignment="Center"/>
                            <TextBlock Classes="secondary" Text="{loc:Localize Home.EmptyState}"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RecentProjects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="home:RecentProjectItemViewModel">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <Button Grid.Column="0" Classes="row"
                                                Command="{Binding $parent[ItemsControl].DataContext.OpenRecentProjectCommand}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding FileName}"
                                                ToolTip.Tip="{Binding FullPath}">
                                            <StackPanel Spacing="1">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Classes="strong" Text="{Binding FileName}"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                                    <Border Classes="chip danger" IsVisible="{Binding IsMissing}">
                                                        <TextBlock Text="{loc:Localize Home.MissingBadge}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Classes="caption" Text="{Binding LastOpenedDisplay}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Classes="ghost icon"
                                                Command="{Binding $parent[ItemsControl].DataContext.TogglePinCommand}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="{loc:Localize Home.PinTip}">
                                            <controls:Icon Classes="pin" Classes.pinned="{Binding IsPinned}"
                                                           Data="{StaticResource Icon.Bookmark}"/>
                                        </Button>
                                        <Button Grid.Column="2" Classes="ghost icon"
                                                Command="{Binding $parent[ItemsControl].DataContext.RemoveRecentProjectCommand}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="{loc:Localize Home.RemoveTip}">
                                            <controls:Icon Data="{StaticResource Icon.X}" Size="14"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- ── Right: learning steps and example tiles ── -->
                <StackPanel Grid.Column="2" Spacing="20">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="label" Text="{loc:Localize Home.LearnTutorial}"/>
                        <Button Classes="primary" Command="{Binding LearningPath.ResumeCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding LearningPath.ResumeLabel}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding LearningPath.ProgressText}" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Expander Header="{loc:Localize LearningPath.AllChapters}" IsExpanded="False">
                        <!-- The guided tours in learning order: the number says it is a sequence. -->
                        <ItemsControl ItemsSource="{Binding TourEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="home:HomeTourEntry">
                                    <Button Classes="row" Classes.optical-start="{Binding IsOpticalStart}" Command="{Binding Command}"
                                            AutomationProperties.Name="{Binding Name}">
                                        <ToolTip.Tip>
                                            <StackPanel MaxWidth="280" Spacing="4">
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                                <TextBlock Classes="caption" Text="{Binding Tip}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </ToolTip.Tip>
                                        <Grid ColumnDefinitions="Auto,12,*,Auto" RowDefinitions="Auto,Auto">
                                            <Border Classes="step-number">
                                                <TextBlock Text="{Binding Number}"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Name}"
                                                       FontWeight="Medium" TextWrapping="Wrap"
                                                       VerticalAlignment="Center"/>
                                            <controls:Icon Grid.Column="3" Size="14"
                                                           Data="{Binding IconKey, Converter={StaticResource IconKey}}"
                                                           Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                                            <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                                                        IsVisible="{Binding IsOpticalStart}" Orientation="Horizontal"
                                                        Spacing="6" Margin="0,10,0,0">
                                                <controls:Icon Data="{StaticResource Icon.Box}" Size="14"/>
                                                <TextBlock Classes="caption" Text="{loc:Localize Home.Optical.Place}"/>
                                                <controls:Icon Data="{StaticResource Icon.ArrowRight}" Size="12"/>
                                                <controls:Icon Data="{StaticResource Icon.Link}" Size="14"/>
                                                <TextBlock Classes="caption" Text="{loc:Localize Home.Optical.Connect}"/>
                                                <controls:Icon Data="{StaticResource Icon.ArrowRight}" Size="12"/>
                                                <controls:Icon Data="{StaticResource Icon.Sun}" Size="14"/>
                                                <TextBlock Classes="caption" Text="{loc:Localize Home.Optical.Light}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </Expander>
                    </StackPanel>

                    <!-- Shipped example designs in learning-path order; the one-line
                         description is the tooltip. -->
                    <StackPanel Spacing="8" IsVisible="{Binding HasExamples}">
                        <TextBlock Classes="label" Text="{loc:Localize Home.Examples}"/>
                        <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Examples}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="services:ExampleDesign">
                                        <Button Classes="tile" Margin="0,0,6,6" Height="72"
                                                AutomationProperties.Name="{Binding Name}"
                                                Command="{Binding $parent[ItemsControl].DataContext.OpenExampleCommand}"
                                                CommandParameter="{Binding}">
                                            <ToolTip.Tip>
                                                <StackPanel MaxWidth="280" Spacing="4">
                                                    <TextBlock Classes="strong" Text="{Binding Name}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                               IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    <TextBlock Classes="caption" Text="{loc:Localize Home.ExampleTip}"/>
                                                </StackPanel>
                                            </ToolTip.Tip>
                                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                <controls:Icon Size="20" HorizontalAlignment="Center"
                                                               Data="{Binding IconKey, Converter={StaticResource IconKey}}"/>
                                                <TextBlock Classes="caption secondary" Text="{Binding ShortName}"
                                                           TextAlignment="Center" TextWrapping="Wrap" MaxLines="2"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="86"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border Classes="divider" Height="1"/>

            <!-- Footer -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding ReopenLastProjectOnStartup}"
                          ToolTip.Tip="{loc:Localize Home.ReopenOnStartupTip}">
                    <TextBlock Classes="secondary" Text="{loc:Localize Home.ReopenOnStartup}"/>
                </CheckBox>
                <Button Grid.Column="2" Classes="ghost"
                        Content="{loc:Localize Home.ContinueWithoutProject}"
                        Command="{Binding ContinueWithoutProjectCommand}"
                        ToolTip.Tip="{loc:Localize Home.ContinueTip}"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
