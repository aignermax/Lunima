<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CAP.Avalonia.ViewModels.Canvas"
             xmlns:core="clr-namespace:CAP_Core.Components.Core;assembly=CAP-Core"
             xmlns:loc="using:CAP.Avalonia.Services.Localization"
             x:Class="CAP.Avalonia.Views.BreadcrumbBar"
             x:DataType="vm:DesignCanvasViewModel">

  <Border Background="{DynamicResource Brush.Surface.Hover}"
          BorderBrush="{DynamicResource Brush.Border.Default}"
          BorderThickness="0,0,0,1"
          Padding="10,5"
          IsVisible="{Binding IsInGroupEditMode}">
    <StackPanel Orientation="Horizontal" Spacing="5">
      <!-- Exit to Root button -->
      <Button Content="{loc:Localize Breadcrumb.Exit}"
              Background="{DynamicResource Brush.Surface.Hover}"
              Foreground="{DynamicResource Brush.Info}"
              Padding="8,4"
              ToolTip.Tip="{loc:Localize Breadcrumb.ExitTip}"
              Command="{Binding $parent[UserControl].((vm:DesignCanvasViewModel)DataContext).ExitToRootCommand}" />

      <TextBlock Text="📁" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" />

      <!-- Root breadcrumb -->
      <Button Content="{loc:Localize Breadcrumb.Root}"
              Background="Transparent"
              Foreground="{DynamicResource Brush.Text.Secondary}"
              Padding="5,2"
              ToolTip.Tip="{loc:Localize Breadcrumb.RootTip}"
              Command="{Binding $parent[UserControl].((vm:DesignCanvasViewModel)DataContext).NavigateToBreadcrumbLevelCommand}"
              CommandParameter="{x:Null}" />

      <!-- Breadcrumb path -->
      <ItemsControl ItemsSource="{Binding BreadcrumbPath}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="5" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="core:ComponentGroup">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="›" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" />
              <Button Content="{Binding GroupName}"
                      Background="Transparent"
                      Foreground="{DynamicResource Brush.Text.Primary}"
                      FontWeight="SemiBold"
                      Padding="5,2"
                      ToolTip.Tip="{Binding Description}"
                      Command="{Binding $parent[UserControl].((vm:DesignCanvasViewModel)DataContext).NavigateToBreadcrumbLevelCommand}"
                      CommandParameter="{Binding}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Current edit indicator -->
      <TextBlock Text="{loc:Localize Breadcrumb.Editing}"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource Brush.Warning}"
                 FontStyle="Italic"
                 Margin="5,0,0,0" />
    </StackPanel>
  </Border>
</UserControl>
