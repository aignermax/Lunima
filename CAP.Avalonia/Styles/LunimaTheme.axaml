<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    The Lunima design system. Include once, directly after FluentTheme:
      Tokens.axaml           colors, type scale, spacing, radii, motion
      FluentOverrides.axaml  Fluent resource keys mapped onto the tokens
      Icons.axaml            line icon geometry for controls:Icon
      Typography / Controls / Containers — the style classes views use
  -->
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://CAP.Avalonia/Styles/FluentOverrides.axaml"/>
        <ResourceInclude Source="avares://CAP.Avalonia/Styles/Icons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <StyleInclude Source="avares://CAP.Avalonia/Styles/Typography.axaml"/>
  <StyleInclude Source="avares://CAP.Avalonia/Styles/Controls.axaml"/>
  <StyleInclude Source="avares://CAP.Avalonia/Styles/Containers.axaml"/>
</Styles>
