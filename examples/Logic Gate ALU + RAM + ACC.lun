          "f5b4d35d-9117-4bf7-bf25-de188dcb1a17"
        ],
        "GridX": 0,
        "GridY": 0,
        "PhysicalX": 41200,
        "PhysicalY": 500,
        "Rotation90CounterClock": 0,
