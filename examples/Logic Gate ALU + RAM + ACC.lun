          "8a16fc27-1863-42fb-bc88-d08c6faf84ea",
          "cbd39353-571c-4d74-a4c3-33c2779bf740",
          "d881393b-1b54-4295-a403-cb64e68760a7"
        ],
        "GridX": 0,
        "GridY": 0,
        "PhysicalX": 41200,
        "PhysicalY": 500,
        "Rotation90CounterClock": 0,
        "ChildComponentIds": [
          "input_a_eef14a97653845fe880b281ff130e4f4",
          "input_b_103958ec7c874013868b3f7427bb5c2c",
