        "PhysicalY": 6100,
        "Rotation90CounterClock": 0,
        "ChildComponentIds": [
          "input_a_66209add1d394d268d127a8410445bf2",
          "input_b_5b68077fe35b47a6851d6094d5a4e0b3",
          "combine_e01a833f9a134d23b9f628706fe76f32",
          "phase_7d937412670443959f2c828a644c9a09",
          "recombine_32785a3fb3b046c086f03ce703f7f09b",
          "output_65b1aa4ee79444f8af8203051db896b3"
        ],
