          "2512c396-a0af-4497-b1a8-b158de46ef6e"
        ],
        "GridX": 0,
        "GridY": 0,
        "PhysicalX": 35200,
        "PhysicalY": 4100,
        "Rotation90CounterClock": 0,
        "ChildComponentIds": [
