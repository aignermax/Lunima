        "PhysicalX": 41200,
        "PhysicalY": 100,
        "Rotation90CounterClock": 0,
        "ChildComponentIds": [
          "input_a_1f01b3b5af744b72b52d6d09a11d5573",
          "input_b_6d5fdc5f37934260ac40275de6b9dccc",
          "combine_2822b77bdb23498582bbc0295c6b376b",
          "phase_590529baaa0148bc8f8333d8a839b94c",
          "recombine_d88b3d9326d441c6af11d453e78200ea",
