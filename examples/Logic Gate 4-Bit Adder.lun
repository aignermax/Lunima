          "5a80d9fd-0b1e-4020-9e2b-a6f826f606b8",
          "e39452df-e252-4bc2-a65a-fd995346706a",
          "072f1a04-8c9b-4373-9f00-de1221a0966a"
        ],
        "GridX": 0,
        "GridY": 0,
        "PhysicalX": 7600,
        "PhysicalY": 6900,
        "Rotation90CounterClock": 0,
        "ChildComponentIds": [
          "input_a_ac53e4e3e5e5447eb0af1842104fd959",
          "input_b_53c4d774e0434f42853cba3dbb5da839",
          "combine_36ebd0b939a049538be079cb19e760bf",
          "phase_bcf8a51d3e5344fb84869c54255197ad",
          "recombine_f9efcd2a5e5148ddbde811557cb44809",
          "output_1c759942aefb4cbf94b225c1c758a45e"
        ],
