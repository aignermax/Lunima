  "Groups": [
    {
      "GroupDto": {
        "GroupName": "AND0",
        "Description": "AND reading (inputs A and B, BIAS and BIAS2 constantly on, threshold 0.25) of the shipped \u0027Logic Gate AND-from-NAND\u0027 gate. Role in the 4-bit AND: bit slice 0 of the ISA AND datapath \u2014 Y0 = A0 AND B0. The 4-bit word operation composes at the logic layer, not optically: every gate\u0027s truth table is extracted once in isolation, so each slice restores clean 0/1 levels by construction and the four slices run side by side without a single wire between them.",
        "Identifier": "group_bd56524e5ed44176ba519e42746e958c",
        "IdGuid": "e643ba7b-c026-4fe1-95d5-d561fd51be71",
