          "84790c4b-7e8c-4e0f-a328-c83c77e31285",
          "3dfd4a00-3d3b-443b-b353-ca7be69b0699",
          "dc38b939-67e9-4a67-b332-2a839f9a74e3"
        ],
        "GridX": 0,
        "GridY": 0,
        "PhysicalX": 5200,
        "PhysicalY": 1300,
        "Rotation90CounterClock": 0,
        "ChildComponentIds": [
          "input_a_80b68e4e6dfd4c23b090174b322731af",
          "input_b_d53b5b37cd224901a01361d4247353b6",
