<?xml version="1.0" encoding="utf-8"?>
<!--
  Lunima MSI installer definition (WiX v4).

  This file defines:
    - Package metadata (name, version, upgrade code)
    - .NET 8 Desktop Runtime prerequisite check
    - Installation directory: %ProgramFiles%\Lunima
    - Desktop shortcut with Lunima icon
    - Start Menu shortcut with Lunima icon
    - Optional, default-on "Connect Claude Code" feature (registers the
      MCP agent bridge with the Claude Code CLI for the installing user)
    - MajorUpgrade rule (prevents downgrades, handles upgrades cleanly)

  IMPORTANT: Never change UpgradeCode after first release — it is the
  permanent identity used to locate installed versions for upgrades.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx">

  <Package
      Name="Lunima"
      Manufacturer="Lunima Team"
      Version="$(var.ProductVersion)"
      UpgradeCode="F8E4A2B6-3C5D-7F91-A0E4-B8D6F2C4A8E0"
      Scope="perMachine"
      Compressed="yes">

    <!-- ─────────────────────────────────────────────────────── -->
    <!-- Upgrade behaviour                                        -->
    <!-- ─────────────────────────────────────────────────────── -->

    <!--
      Remove any existing Lunima installation before installing
      the new version (MajorUpgrade), and block downgrading.
    -->
    <MajorUpgrade
        DowngradeErrorMessage="A newer version of Lunima is already installed. Uninstall it before proceeding." />

    <MediaTemplate EmbedCab="yes" />

    <!-- ─────────────────────────────────────────────────────── -->
    <!-- Branding                                                 -->
    <!-- ─────────────────────────────────────────────────────── -->

    <!-- Icon shown in Programs and Features / Add-Remove Programs -->
    <Icon Id="LunimaIcon.ico" SourceFile="LunimaIcon.ico" />
    <Property Id="ARPPRODUCTICON" Value="LunimaIcon.ico" />
    <Property Id="ARPHELPLINK"    Value="https://github.com/aignermax/Connect-A-PIC-Pro" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/aignermax/Connect-A-PIC-Pro" />

    <!-- ─────────────────────────────────────────────────────── -->
    <!-- .NET 8 Desktop Runtime prerequisite                     -->
    <!-- ─────────────────────────────────────────────────────── -->

    <!--
      Detect whether .NET 8 Desktop Runtime (x64) is present.
      The DOTNET8_PRESENT property is set to "1" when found.
    -->
    <netfx:DotNetCompatibilityCheck
        Property="DOTNET8_PRESENT"
        Platform="x64"
        RollForward="latestMajor"
        RuntimeType="desktop"
        Version="8.0.0" />

    <!--
      Block installation if .NET 8 is absent (except during uninstall
      or upgrade where the package is already registered).
    -->
    <Launch
        Condition="Installed OR DOTNET8_PRESENT"
        Message="Lunima requires the .NET 8 Desktop Runtime (x64) or later.&#13;&#10;&#13;&#10;Please download and install it from:&#13;&#10;https://dotnet.microsoft.com/download/dotnet/8.0" />

    <!-- ─────────────────────────────────────────────────────── -->
    <!-- Installer UI                                             -->
    <!-- ─────────────────────────────────────────────────────── -->

    <!--
      WixUI_FeatureTree: the Custom Setup page lists the optional
      "Connect Claude Code" feature (checked by default) and lets the
      user change the install directory (Browse, via ConfigurableDirectory).
    -->
    <ui:WixUI Id="WixUI_FeatureTree" />

    <!-- ─────────────────────────────────────────────────────── -->
    <!-- Directory structure                                      -->
    <!-- ─────────────────────────────────────────────────────── -->

    <!-- %ProgramFiles%\Lunima  (64-bit) -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="Lunima" />
    </StandardDirectory>

    <!-- Desktop -->
    <StandardDirectory Id="DesktopFolder" />

    <!-- Start Menu  →  Programs\Lunima -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="LunimaStartMenuDir" Name="Lunima" />
    </StandardDirectory>

    <!-- ─────────────────────────────────────────────────────── -->
    <!-- Desktop shortcut component                              -->
    <!-- ─────────────────────────────────────────────────────── -->

    <!--
      Non-advertised shortcut on the Desktop.
      KeyPath is a registry value so Windows Installer can track
      the component reliably.
    -->
    <Component Id="DesktopShortcutComp" Directory="DesktopFolder" Guid="A1F3C5E7-B2D4-6F80-91A3-C5E7B9D1F3A5">
      <Shortcut
          Id="DesktopShortcut"
          Name="Lunima"
          Description="Lunima – Photonic Circuit Designer"
          Target="[INSTALLDIR]CAP.Desktop.exe"
          WorkingDirectory="INSTALLDIR"
          Icon="LunimaIcon.ico"
          IconIndex="0" />
      <RegistryValue
          Root="HKCU"
          Key="Software\Lunima"
          Name="DesktopShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>

    <!-- ─────────────────────────────────────────────────────── -->
    <!-- Start Menu shortcut component                           -->
    <!-- ─────────────────────────────────────────────────────── -->

    <Component Id="StartMenuShortcutComp" Directory="LunimaStartMenuDir" Guid="B2D4E6F8-C3A5-7091-A2B4-D6E8F0A2C4B6">
      <Shortcut
          Id="StartMenuShortcut"
          Name="Lunima"
          Description="Lunima – Photonic Circuit Designer"
          Target="[INSTALLDIR]CAP.Desktop.exe"
          WorkingDirectory="INSTALLDIR"
          Icon="LunimaIcon.ico"
          IconIndex="0" />
      <!-- Remove the Programs\Lunima folder on uninstall -->
      <RemoveFolder Id="RemoveLunimaStartMenuDir" Directory="LunimaStartMenuDir" On="uninstall" />
      <RegistryValue
          Root="HKCU"
          Key="Software\Lunima"
          Name="StartMenuShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>

    <!-- ─────────────────────────────────────────────────────── -->
    <!-- Feature tree                                            -->
    <!-- ─────────────────────────────────────────────────────── -->

    <!--
      Single feature that includes:
        - All application files (harvested from publish directory)
        - Desktop shortcut
        - Start Menu shortcut
    -->
    <Feature Id="MainFeature" Title="Lunima" Level="1" AllowAbsent="no"
             ConfigurableDirectory="INSTALLDIR" Display="expand">
      <!-- Auto-harvested application files (from HarvestDirectory in .wixproj) -->
      <ComponentGroupRef Id="HarvestedAppFiles" />
      <!-- Shortcuts -->
      <ComponentRef Id="DesktopShortcutComp" />
      <ComponentRef Id="StartMenuShortcutComp" />
      <ComponentRef Id="InstallRootMarker" />

      <!--
        Optional, checked by default: turns on the agent bridge and registers
        it with Claude Code for the installing user. Unchecking it (or
        msiexec … ADDLOCAL=MainFeature) skips the registration.
      -->
      <Feature Id="ClaudeCodeFeature" Level="1" AllowAdvertise="no"
               Title="Connect Claude Code (register the Lunima MCP server)"
               Description="Turns on the local agent bridge and registers it with Claude Code for your account, so Claude can inspect and edit the open design. Skipped if Claude Code is not installed; connect later in Settings.">
        <ComponentRef Id="ClaudeCodeConnectComp" />
      </Feature>
    </Feature>

    <!-- ─────────────────────────────────────────────────────── -->
    <!-- Connect Claude Code: marker component + custom actions  -->
    <!-- ─────────────────────────────────────────────────────── -->

    <!-- Machine-owned location: portable/source copies must never launch an MSI update. -->
    <Component Id="InstallRootMarker" Directory="INSTALLDIR" Guid="A7B68FC3-5B37-4CB4-871C-E83096B846F4" Bitness="always64">
      <RegistryValue Root="HKLM" Key="Software\Lunima\Installer" Name="InstallRoot"
                     Type="string" Value="[INSTALLDIR]" KeyPath="yes" />
    </Component>

    <!-- Marker so the optional feature installs something; its state drives the actions below. -->
    <Component Id="ClaudeCodeConnectComp" Directory="INSTALLDIR" Guid="C3E5F7A9-D4B6-8102-B3C5-E7F9A1B3D5C7">
      <RegistryValue
          Root="HKCU"
          Key="Software\Lunima"
          Name="ClaudeCodeConnect"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>

    <!--
      Runs the installed app headless as the installing user (Impersonate)
      once the files are in place: it enables the agent bridge in the user's
      Lunima preferences and registers it with Claude Code (claude mcp add, user scope) when the
      Claude Code CLI is installed. The app always exits 0 and the action
      ignores the result, so a missing Claude Code never fails setup.
    -->
    <CustomAction
        Id="RegisterClaudeCode"
        Directory="INSTALLDIR"
        ExeCommand="&quot;[INSTALLDIR]CAP.Desktop.exe&quot; --register-claude-code"
        Execute="deferred"
        Impersonate="yes"
        Return="ignore" />

    <!-- Best-effort removal of the Claude Code registration on a real uninstall (not on upgrade). -->
    <CustomAction
        Id="UnregisterClaudeCode"
        Directory="INSTALLDIR"
        ExeCommand="&quot;[INSTALLDIR]CAP.Desktop.exe&quot; --unregister-claude-code"
        Execute="deferred"
        Impersonate="yes"
        Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RegisterClaudeCode" After="InstallFiles"
              Condition="&amp;ClaudeCodeFeature=3 AND NOT REMOVE" />
      <Custom Action="UnregisterClaudeCode" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND !ClaudeCodeFeature=3" />
    </InstallExecuteSequence>

  </Package>
</Wix>
